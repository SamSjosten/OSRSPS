# Runs deploy/auto-deploy.sh once; started every minute by osrsps-deploy.timer. Log: journalctl -u osrsps-deploy
[Unit]
Description=Redeploy the OSRSPS server when main has moved
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=sam
WorkingDirectory=/srv/rsps/OSRSPS
ExecStart=/srv/rsps/OSRSPS/deploy/auto-deploy.sh
# A first build downloads Gradle and every dependency.
TimeoutStartSec=30min
