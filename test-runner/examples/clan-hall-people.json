{
 "name": "The clan hall's people (::keys on): in a clan made by ::clanmake, Raqueel at the bar sells a beer for 5 coins, Hannibal in the kitchen is petted, and a banker's Bank opens the bank",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::clandisband", "expectMessage": "lan", "comment": "test's own clan from another run, if any"},
  {"step": "command", "text": "::clandisband People Gate", "expectMessage": "lan", "comment": "the last run's clan, if any"},
  {"step": "command", "text": "::clanmake People Gate", "expectMessage": "Clan People Gate made"},
  {"step": "command", "text": "::clanjoin People Gate recruiter", "expectMessage": "Joined clan People Gate as a recruiter"},
  {"step": "command", "text": "::item 995 5"},
  {"step": "command", "text": "::tele 3185 3471 0", "expectMessage": "Teleported to 3185, 3471, 0", "comment": "west of the clan hall portal (3186, 3471)"},
  {"step": "waitTicks", "ticks": 3, "comment": "a teleport into a new region"},
  {"step": "locOption", "locId": 41724, "option": "Enter", "timeoutMs": 20000},
  {"step": "waitTicks", "ticks": 4, "comment": "into the hall's instance, a new region"},
  {"step": "npcOption", "npc": "Raqueel", "option": "Talk-to", "timeoutMs": 30000, "comment": "the barmaid by the bar, north of the arrival"},
  {"step": "assertDialogue", "contains": "[clan_hall_people.raqueel_hi_again]", "timeoutMs": 20000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[clan_hall_people.raqueel_greeting_"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[clan_hall_people.raqueel_buy]"},
  {"step": "assertDialogue", "contains": "[clan_hall_people.raqueel_buy]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[clan_hall_people.raqueel_price]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[clan_hall_people.raqueel_buy_option]"},
  {"step": "assertInventory", "item": "Beer", "count": 1, "timeoutMs": 10000},
  {"step": "assertInventory", "item": "Coins", "count": 0},
  {"step": "npcOption", "npc": "Hannibal", "option": "Pet", "timeoutMs": 30000, "comment": "the cat on his stool in the kitchen"},
  {"step": "assertMessage", "contains": "[clan_hall_people.hannibal_pet_", "timeoutMs": 20000},
  {"step": "npcOption", "npc": "Banker", "option": "Bank", "timeoutMs": 30000, "comment": "a banker behind the booths"},
  {"step": "assertInterface", "interfaceId": 12, "timeoutMs": 20000},
  {"step": "command", "text": "::clandisband People Gate", "expectMessage": "Clan People Gate deleted"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
