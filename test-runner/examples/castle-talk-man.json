{
 "name": "Lumbridge Castle: Talk-to a man (::keys on, so keys show whatever data/dialogue.txt holds)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::tele 3216 3219 0",
   "expectMessage": "Teleported to 3216, 3219, 0"
  },
  {
   "step": "assertLocation",
   "x": 3216,
   "y": 3219,
   "plane": 0
  },
  {
   "step": "npcOption",
   "npc": "Man",
   "option": "Talk-to"
  },
  {
   "step": "assertDialogue",
   "contains": "[man.hello]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[man."
  },
  {
   "step": "finishDialogue",
   "comment": "which talk follows is random: click through it (the first option on a menu) so the chatbox is free for the next script"
  },
  {
   "step": "assertNoDialogue"
  }
 ]
}
