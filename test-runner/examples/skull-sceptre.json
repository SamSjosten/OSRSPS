  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now", "comment": "the Sepulchre's ankou and ghosts are aggressive"},
  {"step": "command", "text": "::item 9008"},
  {"step": "command", "text": "::item 9007"},
  {"step": "command", "text": "::item 9010"},
  {"step": "command", "text": "::item 9011"},
  {"step": "useItemOnItem", "item": "Left skull half", "onItem": "Right skull half"},
  {"step": "assertMessage", "contains": "skull_sceptre.join_skull", "timeoutMs": 10000},
  {"step": "useItemOnItem", "item": "Top of sceptre", "onItem": "Bottom of sceptre"},
  {"step": "assertMessage", "contains": "skull_sceptre.join_sceptre", "timeoutMs": 10000},
  {"step": "useItemOnItem", "item": "Strange skull", "onItem": "Runed sceptre"},
