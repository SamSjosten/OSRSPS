  {"step": "chooseOption", "text": "[solztun.treasure]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "solztun.show_boots", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "solztun.imbue_done", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "item": "Skull sceptre (i)", "count": 1, "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
