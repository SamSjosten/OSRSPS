{
 "name": "Clan vexillum Recruit, two players (run with clan-vexillum-recruit-test2.json on the other VM at the same time): test, a recruiter of a clan made by ::clanmake, wields its vexillum and gets Recruit; test2 says Yes and joins at rank 0; in the clan made again, test2 says No, and test asking again at once is told test2 is busy",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "keys"},
  {"step": "command", "text": "::clandisband", "expectMessage": "lan", "comment": "test's own clan from another run, if any"},
  {"step": "command", "text": "::clandisband Recruit Gate", "expectMessage": "lan", "comment": "the last run's clan, if any"},
  {"step": "command", "text": "::clanmake Recruit Gate", "expectMessage": "Clan Recruit Gate made"},
  {"step": "command", "text": "::clanjoin Recruit Gate recruiter", "expectMessage": "Joined clan Recruit Gate as a recruiter", "comment": "the top rank: the Recruitment permission allows it"},
  {"step": "command", "text": "::tele 3234 3232 0", "expectMessage": "Teleported", "comment": "two tiles east of test2's meeting tile"},
  {"step": "assertPlayerOption", "option": "Recruit", "absent": true, "comment": "no vexillum yet"},
  {"step": "command", "text": "::item 25721", "comment": "a blue clan vexillum, the colour of a clan that never picked one"},
  {"step": "assertInventory", "itemId": 25721, "count": 1, "timeoutMs": 10000},
  {"step": "itemOption", "itemId": 25721, "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "itemId": 25721, "timeoutMs": 10000},
  {"step": "assertPlayerOption", "option": "Recruit", "timeoutMs": 10000},
  {"step": "playerOption", "player": "test2", "option": "Recruit", "x": 3232, "y": 3232, "timeoutMs": 180000, "comment": "once test2 stands on the meeting tile, after its ::keys on and Accept Aid on; wait 5 minutes after a run before the next, or the last run's No still reads as busy"},
  {"step": "assertMessage", "contains": "[clan.recruit_sent name=test2]"},
  {"step": "assertMessage", "contains": "[clan.recruit_accepted name=test2]", "timeoutMs": 60000, "comment": "test2 says Yes"},
  {"step": "command", "text": "::clan", "expectMessage": "Clan Recruit Gate: test (rank 126), test2 (rank 0)"},
  {"step": "playerOption", "player": "test2", "option": "Recruit"},
  {"step": "assertMessage", "contains": "[clan.already_in_clan name=test2]"},
  {"step": "command", "text": "::clandisband Recruit Gate", "expectMessage": "Clan Recruit Gate deleted", "comment": "test2 is in no clan again"},
  {"step": "command", "text": "::clanmake Recruit Gate", "expectMessage": "Clan Recruit Gate made"},
  {"step": "command", "text": "::clanjoin Recruit Gate recruiter", "expectMessage": "Joined clan Recruit Gate as a recruiter"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "playerOption", "player": "test2", "option": "Recruit"},
  {"step": "assertMessage", "contains": "[clan.recruit_declined name=test2]", "timeoutMs": 60000, "comment": "test2 says No this time"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "playerOption", "player": "test2", "option": "Recruit"},
  {"step": "assertMessage", "contains": "[clan.recruit_busy name=test2]", "comment": "asking again so soon after a No reads as busy"},
  {"step": "waitTicks", "ticks": 10, "comment": "time for test2's checks"},
  {"step": "command", "text": "::clandisband Recruit Gate", "expectMessage": "Clan Recruit Gate deleted"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
