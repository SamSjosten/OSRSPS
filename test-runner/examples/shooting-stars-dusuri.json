{
 "name": "Shooting stars step 2: Dusuri by the Mining Guild in Falador, Trade after his introduction, his shop paid in stardust, a bag full of gems and a soft clay pack (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts it back"},
  {"step": "command", "text": "::varbit 11887 0", "comment": "star_trader_met off: Dusuri shows Talk-to only"},
  {"step": "command", "text": "::varbit 11886 0", "comment": "star_mined off: never touched a star"},
  {"step": "command", "text": "::tele 3022 3339 0", "expectMessage": "Teleported to 3022, 3339, 0", "comment": "south of Dusuri's tile, by the Mining Guild's entrance; Falador isn't built"},
  {"step": "waitTicks", "ticks": 3, "comment": "after a teleport into a new region"},

  {"step": "npcOption", "npc": "Dusuri", "option": "Talk-to"},
  {"step": "assertDialogue", "contains": "[dusuri.hello]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[dusuri.what_do_you_do]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[dusuri.i_specialise]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[dusuri.where_from]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[dusuri.in_stars]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[dusuri.shooting_stars]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[dusuri.they_fall]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[dusuri.happy_to_trade]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[dusuri.bear_in_mind]"},
  {"step": "assertVarbit", "id": 11887, "value": 1, "comment": "star_trader_met, set once happy_to_trade is continued: Dusuri gains Trade"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[dusuri.good_luck]"},
  {"step": "continueDialogue"},

  {"step": "command", "text": "::item 25527 2500", "expectMessage": "Added 2500 x Stardust"},
  {"step": "npcOption", "npc": "Dusuri", "option": "Trade"},
  {"step": "assertInterface", "interfaceId": 300},
  {"step": "clickWidget", "interfaceId": 300, "component": 16, "slot": 1, "op": 2, "comment": "Buy 1 celestial ring for 2,000 stardust"},
  {"step": "assertInventory", "itemId": 25539},
  {"step": "clickWidget", "interfaceId": 300, "component": 16, "slot": 3, "op": 2, "comment": "Buy 1 bag full of gems for 300"},
  {"step": "assertInventory", "itemId": 25537},
  {"step": "clickWidget", "interfaceId": 300, "component": 16, "slot": 4, "op": 2, "comment": "Buy 1 soft clay pack for 150"},
  {"step": "assertInventory", "itemId": 25533},
  {"step": "assertInventory", "itemId": 25527, "count": 50},
  {"step": "walk", "x": 3022, "y": 3338, "comment": "a step south closes the shop"},

  {"step": "itemOption", "item": "Bag full of gems", "option": "Open"},
  {"step": "assertInventory", "itemId": 1624, "comment": "noted uncut sapphires: half the 40 on average"},
  {"step": "itemOption", "item": "Soft clay pack", "option": "Open"},
  {"step": "assertInventory", "itemId": 1762, "count": 100, "comment": "100 noted soft clay"},
  {"step": "itemOption", "item": "Celestial ring (uncharged)", "option": "Wear", "comment": "an invisible +4 to mining rolls; HeadlessShootingStarsTest and DusuriTest check the boost"},

  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
