{
 "name": "Lumbridge Castle: Talk-to a woman (::keys on, so keys show whatever data/dialogue.txt holds)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::tele 3217 3206 0",
   "expectMessage": "Teleported to 3217, 3206, 0"
  },
  {
   "step": "assertLocation",
   "x": 3217,
   "y": 3206,
   "plane": 0
  },
  {
   "step": "npcOption",
   "npc": "Woman",
   "option": "Talk-to"
  },
  {
   "step": "assertDialogue",
   "contains": "[woman.hello]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[woman."
  },
  {
   "step": "finishDialogue",
   "comment": "which talk follows is random: click through it (the first option on a menu) so the chatbox is free for the next script"
  },
  {
   "step": "assertNoDialogue"
  }
 ]
}
