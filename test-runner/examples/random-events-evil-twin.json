{
  "name": "Random events: Evil twin, Postie Pete's message, Molly's briefing, the claw controls, and leaving early",
  "account": "test",
  "runOnLogin": false,
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"comment": "Off first, so the timer can't send a second event mid-script.", "step": "command", "text": "::randomevent off", "expectMessage": "Random events off"},
    {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied"},
    {"step": "command", "text": "::tele 3222 3218", "expectMessage": "Teleported to 3222, 3218"},
    {"step": "command", "text": "::randomevent evil_twin", "expectMessage": "Started random event evil_twin"},
    {"step": "npcOption", "npc": "Postie Pete", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Postie Pete", "contains": "[evil_twin_postie.needs_help", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[evil_twin_postie.sure]"},
    {"step": "assertDialogue", "contains": "[evil_twin_postie.sure]"},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"comment": "Molly's room: look that Molly stands west of the door, and through the window five suspects in the pen, one dressed like her.", "step": "waitTicks", "ticks": 3},
    {"step": "locOption", "loc": "Door", "option": "Open", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[molly.wait]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[molly.no_i_dont]"},
    {"step": "assertDialogue", "contains": "[molly.no_i_dont]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.come_over]"},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"step": "npcOption", "npc": "Molly", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[molly.thanks_for_coming]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.whats_the_problem]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.evil_sister]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.to_do_with_me]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.glad_you_asked]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.through_that_door]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.lured]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.what_do_i_do]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.catch_my_sister]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.no_more_bother]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.easy_enough]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.take_a_look]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.two_attempts]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.do_my_best]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.controls]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[molly.yes_please_option]"},
    {"step": "assertDialogue", "contains": "[molly.yes_please]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.glowing_mark]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.click_direction]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.lever_points]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.hit_the_button]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.be_careful]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.my_sister]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.does_that_help]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.covers_everything]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[molly.good_luck]"},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"step": "locOption", "loc": "Door", "option": "Open", "timeoutMs": 20000},
    {"comment": "The walk to the door can take several ticks from where Molly stood; a click on the panel before the door is reached would cancel it.", "step": "waitTicks", "ticks": 8},
    {"step": "locOption", "loc": "Control panel", "option": "Use", "timeoutMs": 20000},
    {"comment": "The claw controls: look that four arrows and a grab button replace the side panel.", "step": "assertInterface", "interfaceId": 277, "timeoutMs": 20000},
    {"comment": "Right twice: look that the claw and its glowing mark move two tiles east.", "step": "clickWidget", "interfaceId": 277, "component": 7, "op": 1},
    {"step": "waitTicks", "ticks": 1},
    {"step": "clickWidget", "interfaceId": 277, "component": 7, "op": 1},
    {"step": "waitTicks", "ticks": 1},
    {"step": "locOption", "loc": "Door", "option": "Open", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[molly.finish_first]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[molly.but_leave]"},
    {"step": "assertDialogue", "contains": "[molly.but_leave]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Molly", "contains": "[molly.there_i_was]"},
    {"step": "continueDialogue"},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0, "timeoutMs": 20000},
    {"step": "assertInventory", "item": "Uncut sapphire", "count": 0}
  ]
}
