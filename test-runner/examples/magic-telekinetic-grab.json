  {"step": "assertInventory", "item": "Coins", "count": 250, "timeoutMs": 5000},
  {"step": "assertLocation", "x": 3222, "y": 3218, "comment": "cast from where they stood"},
  {"step": "assertInventory", "item": "Law rune", "count": 1},
  {"step": "waitTicks", "ticks": 3, "comment": "the spell's 3 ticks"},
  {"step": "castOnGroundItem", "interfaceId": 218, "component": 30, "item": "Logs", "x": 3236, "y": 3218, "comment": "14 tiles east: walks 4 first"},
  {"step": "assertInventory", "item": "Logs", "count": 1, "timeoutMs": 10000},
  {"step": "assertInventory", "item": "Law rune", "count": 0},
