  {"step": "waitTicks", "ticks": 2},
  {"step": "command", "text": "::groundobj 995 250", "expectMessage": "Put Coins (995) x 250 on 3230, 3218"},
  {"step": "command", "text": "::tele 3236 3218", "expectMessage": "Teleported"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "command", "text": "::groundobj 1511 1", "expectMessage": "Put Logs (1511) x 1 on 3236, 3218"},
