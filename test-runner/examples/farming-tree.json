{
 "name": "Farming step 4: at Lumbridge's tree patch, a plant pot filled, an acorn planted in it, watered and grown into a sapling, the sapling planted with a spade, grown, checked, chopped to its stump and dug up for four roots; then another made ill with ::farmdisease and pruned with secateurs, read off farming_transmit_a (varbit 4771) (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario farming", "expectMessage": "Started scenario farming.", "comment": "99 Farming and every patch overgrown; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::farmclock pause", "expectMessage": "Farming clock paused", "comment": "the tree grows only by ::farmtick"},
  {"step": "command", "text": "::tele 3193 3229 0", "expectMessage": "Teleported to 3193, 3229, 0", "comment": "south of the tree patch west of Lumbridge castle (tree_patch_4, 3192-3194, 3230-3232)"},
  {"step": "command", "text": "::setlevel woodcutting 99", "expectMessage": "99"},
  {"step": "command", "text": "::item 5341 1", "comment": "a rake"},
  {"step": "command", "text": "::item 5325 1", "comment": "a gardening trowel"},
  {"step": "command", "text": "::item 952 1", "comment": "a spade"},
  {"step": "command", "text": "::item 5350 1", "comment": "an empty plant pot"},
  {"step": "command", "text": "::item 5312 1", "comment": "an acorn"},
  {"step": "command", "text": "::item 5340 1", "comment": "a full watering can"},
  {"step": "locOption", "locId": 8391, "option": "Rake", "x": 3192, "y": 3230, "timeoutMs": 20000, "comment": "the multiloc tree_patch_4, drawn as Tree patch while overgrown"},
  {"step": "assertMessage", "contains": "[farming.raked]", "timeoutMs": 30000},
  {"step": "assertVarbit", "id": 4771, "value": 3, "timeoutMs": 5000},
  {"step": "useItemOnLoc", "itemId": 5350, "locId": 8391, "x": 3192, "y": 3230},
  {"step": "assertMessage", "contains": "[farming.pot_filled]", "timeoutMs": 10000},
  {"step": "assertInventory", "itemId": 5354, "count": 1, "timeoutMs": 5000, "comment": "the filled pot"},
  {"step": "useItemOnItem", "itemId": 5312, "onItemId": 5354},
  {"step": "assertMessage", "contains": "[farming.seedling_planted seed=acorn]", "timeoutMs": 10000},
  {"step": "assertInventory", "itemId": 5358, "count": 1, "timeoutMs": 5000, "comment": "Oak seedling"},
  {"step": "useItemOnItem", "itemId": 5340, "onItemId": 5358},
  {"step": "assertInventory", "itemId": 5364, "count": 1, "timeoutMs": 5000, "comment": "Oak seedling (w)"},
  {"step": "command", "text": "::farmtick 1", "expectMessage": "Farming clock moved on 1 tick", "comment": "a watered seedling grows into a sapling at the next farming tick"},
  {"step": "assertInventory", "itemId": 5370, "count": 1, "timeoutMs": 5000, "comment": "Oak sapling"},
  {"step": "assertVarbit", "id": 4771, "value": 2, "timeoutMs": 5000, "comment": "a weed grew back on the bare patch meanwhile"},
  {"step": "locOption", "locId": 8391, "option": "Rake", "x": 3192, "y": 3230, "timeoutMs": 20000},
  {"step": "assertVarbit", "id": 4771, "value": 3, "timeoutMs": 15000},
  {"step": "useItemOnLoc", "itemId": 5370, "locId": 8391, "x": 3192, "y": 3230},
  {"step": "assertMessage", "contains": "[farming.sapling_planted sapling=oak sapling patch=[farming.patch_tree]]", "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 4771, "value": 8, "timeoutMs": 5000, "comment": "Oak, stage 1"},
  {"step": "assertInventory", "itemId": 5350, "count": 1, "timeoutMs": 5000, "comment": "the pot back"},
  {"step": "command", "text": "::farmtick 32", "expectMessage": "Farming clock moved on 32 ticks", "comment": "four 40-minute growths"},
  {"step": "assertVarbit", "id": 4771, "value": 12, "timeoutMs": 5000, "comment": "Oak with Check-health"},
  {"step": "locOption", "locId": 8391, "option": "Check-health", "x": 3192, "y": 3230, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.checked]", "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 4771, "value": 13, "timeoutMs": 5000, "comment": "Oak with Chop down"},
  {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied.", "comment": "27 free slots for the logs: the oak falls before they fill 97% of the time (1 log in 8)"},
  {"step": "command", "text": "::item 1351 1", "comment": "a bronze axe, alone in the pack"},
  {"step": "locOption", "locId": 8391, "option": "Chop down", "x": 3192, "y": 3230, "timeoutMs": 20000},
  {"step": "assertVarbit", "id": 4771, "value": 14, "timeoutMs": 180000, "comment": "Oak tree stump: 1 log in 8 fells it"},
  {"step": "assertInventory", "item": "Oak logs", "timeoutMs": 5000},
  {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied.", "comment": "room for the four roots"},
  {"step": "command", "text": "::item 952 1", "comment": "a spade"},
  {"step": "locOption", "locId": 8391, "option": "Clear", "x": 3192, "y": 3230, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.stump_cleared]", "timeoutMs": 20000, "comment": "never a miss at 99"},
  {"step": "assertVarbit", "id": 4771, "value": 3, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Oak roots", "count": 4, "timeoutMs": 5000, "comment": "four at 99"},
  {"step": "command", "text": "::item 5370 1", "comment": "another oak sapling"},
  {"step": "useItemOnLoc", "itemId": 5370, "locId": 8391, "x": 3192, "y": 3230},
  {"step": "assertVarbit", "id": 4771, "value": 8, "timeoutMs": 15000},
  {"step": "command", "text": "::farmtick 8", "expectMessage": "Farming clock moved on 8 ticks", "comment": "one growth: the first can't bring disease"},
  {"step": "assertVarbit", "id": 4771, "value": 9, "timeoutMs": 5000},
  {"step": "command", "text": "::farmdisease lumbridge_tree"},
  {"step": "assertVarbit", "id": 4771, "value": 73, "timeoutMs": 5000, "comment": "Diseased Oak with Prune"},
  {"step": "command", "text": "::item 5329 1", "comment": "secateurs"},
  {"step": "locOption", "locId": 8391, "option": "Prune", "x": 3192, "y": 3230, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.pruned]", "timeoutMs": 60000, "comment": "3 tries in 4 work"},
  {"step": "assertVarbit", "id": 4771, "value": 9, "timeoutMs": 5000, "comment": "well again"},
  {"step": "assertInventory", "item": "Oak leaves", "timeoutMs": 5000},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
