{
 "name": "Edgeville piece step 13b: the Stronghold of Security's third floor. Down the Catacomb of Famine's ladder, back up the dripping vine, the Box of Health once (coins, the Idea emote, a lowered stat restored), the portal to it, a pair of oozing barriers passed without a question once it is claimed, and up the goo covered vine to the start of the floor (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now", "comment": "the catablepons, spiders and scorpions are aggressive"},
  {"step": "command", "text": "::varbit 2311 0", "comment": "sos_emote_idea: the Box of Health not yet opened"},
  {"step": "command", "text": "::tele 2026 5217 0", "expectMessage": "Teleported to 2026, 5217, 0", "comment": "south of the Catacomb of Famine's ladder down"},
  {"step": "locOption", "locId": 19004, "option": "Climb-down", "x": 2026, "y": 5218},
  {"step": "assertLocation", "x": 2123, "y": 5252, "plane": 0, "timeoutMs": 10000, "comment": "north of the Pit of Pestilence's dripping vine up (the landing is guessed)"},
  {"step": "locOption", "locId": 23705, "option": "Climb-up", "x": 2123, "y": 5251},
  {"step": "assertLocation", "x": 2026, "y": 5217, "plane": 0, "timeoutMs": 10000, "comment": "back beside the ladder down"},
  {"step": "command", "text": "::boost strength 1", "comment": "a lowered stat the box puts back (assuming Strength is above 1 on the account)"},
  {"step": "command", "text": "::tele 2145 5280 0", "expectMessage": "Teleported to 2145, 5280, 0", "comment": "east of the Box of Health"},
  {"step": "locOption", "locId": 23709, "option": "Open", "x": 2144, "y": 5280},
  {"step": "assertDialogue", "contains": "stronghold_of_security.box_open", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "stronghold_of_security.box_reward", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "item": "Coins", "count": 5000, "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 2311, "value": 1, "timeoutMs": 10000, "comment": "sos_emote_idea: Idea unlocked, the reward claimed"},
  {"step": "command", "text": "::tele 2121 5258 0", "expectMessage": "Teleported to 2121, 5258, 0", "comment": "beside the floor's portal"},
  {"step": "locOption", "locId": 23707, "option": "Use", "x": 2120, "y": 5258},
  {"step": "assertMessage", "contains": "stronghold_of_security.portal_enter", "timeoutMs": 10000},
  {"step": "assertLocation", "x": 2145, "y": 5280, "plane": 0, "timeoutMs": 10000, "comment": "beside the Box of Health (the landing is guessed)"},
  {"step": "command", "text": "::tele 2123 5288 0", "expectMessage": "Teleported to 2123, 5288, 0", "comment": "west of the pair of oozing barriers at x 2124 and 2127"},
  {"step": "locOption", "locId": 23653, "option": "Open", "x": 2124, "y": 5288},
  {"step": "assertLocation", "x": 2124, "y": 5288, "plane": 0, "timeoutMs": 10000},
  {"step": "command", "text": "::tele 2126 5288 0", "expectMessage": "Teleported to 2126, 5288, 0"},
  {"step": "locOption", "locId": 23653, "option": "Open", "x": 2127, "y": 5288},
  {"step": "assertLocation", "x": 2127, "y": 5288, "plane": 0, "timeoutMs": 10000, "comment": "no question once the box is opened"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::tele 2150 5279 0", "expectMessage": "Teleported to 2150, 5279, 0", "comment": "beside the goo covered vine"},
  {"step": "locOption", "locId": 23703, "option": "Climb-up", "x": 2150, "y": 5278},
  {"step": "assertLocation", "x": 2123, "y": 5252, "plane": 0, "timeoutMs": 10000, "comment": "back at the start of the floor, by its dripping vine up (inferred, as the Catacomb's ropes)"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
