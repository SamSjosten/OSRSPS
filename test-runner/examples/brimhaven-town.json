{
  "name": "Karamja step K3.2: Davon's talk opening his amulet store, the Dead Man's Chest's bartender selling Karamjan rum for 27 coins, Alfonse the waiter's talk opening the Shrimp and Parrot, and the ropeswings to Moss Giant Island and back (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "any scenario: ::reset at the end puts the account's backpack and levels back"},
    {"step": "command", "text": "::empty"},
    {"step": "command", "text": "::item 995 30"},
    {"step": "command", "text": "::tele 2803 3153 0", "expectMessage": "Teleported to 2803, 3153, 0", "comment": "Brimhaven's south shore, beside Davon"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "Davon", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[davon.pssst]"},
    {"step": "chooseOption", "text": "[davon.selling]"},
    {"step": "assertInterface", "interfaceId": 300, "timeoutMs": 5000, "comment": "the shop"},
    {"step": "command", "text": "::tele 2796 3156 0", "expectMessage": "Teleported to 2796, 3156, 0", "comment": "the Dead Man's Chest, before the bar"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "npcOption", "npc": "Bartender", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[deadmans_bartender.greeting]"},
    {"step": "chooseOption", "text": "[deadmans_bartender.rum]"},
    {"step": "continueDialogue", "comment": "the player asks"},
    {"step": "continueDialogue", "comment": "[deadmans_bartender.twenty_seven]"},
    {"step": "assertInventory", "item": "Karamjan rum", "count": 1, "timeoutMs": 5000},
    {"step": "assertInventory", "item": "Coins", "count": 3},
    {"step": "command", "text": "::tele 2793 3186 0", "expectMessage": "Teleported to 2793, 3186, 0", "comment": "the Shrimp and Parrot"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "npcOption", "npc": "Alfonse the waiter", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[alfonse.welcome]"},
    {"step": "chooseOption", "text": "[alfonse.yes]"},
    {"step": "continueDialogue", "comment": "the player says it"},
    {"step": "assertInterface", "interfaceId": 300, "timeoutMs": 5000, "comment": "the shop"},
    {"step": "command", "text": "::setlevel agility 10"},
    {"step": "command", "text": "::tele 2709 3209 0", "expectMessage": "Teleported to 2709, 3209, 0", "comment": "Brimhaven's side of the ropeswing"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "locOption", "locId": 23568, "option": "Swing-on", "x": 2705, "y": 3209},
    {"step": "assertLocation", "x": 2704, "y": 3209, "plane": 0, "timeoutMs": 10000, "comment": "Moss Giant Island"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "walk", "x": 2704, "y": 3205},
    {"step": "assertLocation", "x": 2704, "y": 3205, "plane": 0, "timeoutMs": 10000},
    {"step": "locOption", "locId": 23569, "option": "Swing-on", "x": 2703, "y": 3205},
    {"step": "assertLocation", "x": 2709, "y": 3205, "plane": 0, "timeoutMs": 10000, "comment": "back in Brimhaven"},

    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
