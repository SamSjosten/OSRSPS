{
 "name": "Trade, two players (run with social-trade-test2.json on the other VM at the same time): test offers 10 coins for test2's bronze axe, both accept twice, and the items swap; ::reset puts the account back",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "keys"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "nothing carried"},
  {"step": "command", "text": "::item 995 100", "expectMessage": "Added"},
  {"step": "command", "text": "::tele 3222 3218 0", "expectMessage": "Teleported"},
  {"step": "playerOption", "player": "test2", "option": "Trade with", "x": 3224, "y": 3218, "timeoutMs": 180000, "comment": "once test2 stands beside us, which it does only after its setup"},
  {"step": "assertInterface", "interfaceId": 335, "timeoutMs": 60000, "comment": "test2 accepted"},
  {"step": "clickWidget", "interfaceId": 336, "component": 0, "slot": 0, "op": 3, "comment": "Offer-10 on the coins"},
  {"step": "assertInventory", "itemId": 995, "count": 90},
  {"step": "assertWidgetText", "interfaceId": 335, "component": 9, "contains": "[trade.free_slots name=test2 count=28]", "timeoutMs": 60000, "comment": "test2 offered its only item, its axe: all 28 slots free"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "clickWidget", "interfaceId": 335, "component": 10, "comment": "Accept"},
  {"step": "assertInterface", "interfaceId": 334, "timeoutMs": 60000, "comment": "both accepted: the second screen"},
  {"step": "assertWidgetText", "interfaceId": 334, "component": 23, "contains": "[trade.give value=10]"},
  {"step": "clickWidget", "interfaceId": 334, "component": 13, "comment": "Accept again"},
  {"step": "assertMessage", "contains": "[trade.accepted]", "timeoutMs": 60000},
  {"step": "assertInterface", "interfaceId": 334, "absent": true},
  {"step": "assertInventory", "itemId": 995, "count": 90},
  {"step": "assertInventory", "itemId": 1351, "count": 1},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
