{
 "name": "Lumbridge Castle: Talk-to Hatius Cosaintus (::keys on, so keys show whatever data/dialogue.txt holds)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::tele 3234 3215 0",
   "expectMessage": "Teleported to 3234, 3215, 0"
  },
  {
   "step": "assertLocation",
   "x": 3234,
   "y": 3215,
   "plane": 0
  },
  {
   "step": "npcOption",
   "npc": "Hatius Cosaintus",
   "option": "Talk-to"
  },
  {
   "step": "assertDialogue",
   "contains": "[hatius.who_are_you]"
  },
  {
   "step": "chooseOption",
   "text": "[hatius.farewell]"
  },
  {
   "step": "assertDialogue",
   "contains": "[hatius.farewell]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[hatius.goodbye]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertNoDialogue"
  }
 ]
}
