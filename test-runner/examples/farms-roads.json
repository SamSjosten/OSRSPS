{
 "name": "Misthalin piece 7 step 5: farms and roads from Lumbridge to Varrock: Fayeth and a Tool Leprechaun by the castle, Seth Groats, Vasquen, Dreven, Tarquin at the canoe station, Rat Burgiss on the road and Treznor by the palace; the gardeners' and leprechauns' Farming options refuse (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats (Woodcutting 1) and an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::tele 3193 3233 0", "expectMessage": "Teleported to 3193, 3233, 0", "comment": "Fayeth's tree patch west of Lumbridge Castle"},
  {"step": "npcOption", "npc": "Fayeth", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "chooseOption", "text": "[gardener.another_time]"},
  {"step": "assertDialogue", "contains": "[gardener.another_time]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "npcOption", "npc": "Fayeth", "option": "Pay", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farms_roads.farming_later]", "timeoutMs": 10000, "comment": "Farming isn't built: the gardeners' payments are the Farming skill thread's"},
  {"step": "npcOption", "npc": "Tool Leprechaun", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[tool_leprechaun.greeting]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[tool_leprechaun.no_thanks]"},
  {"step": "assertDialogue", "contains": "[tool_leprechaun.no_thanks]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[tool_leprechaun.dafter]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "npcOption", "npc": "Tool Leprechaun", "option": "Exchange", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farms_roads.farming_later]", "timeoutMs": 10000},
  {"step": "command", "text": "::tele 3223 3293 0", "expectMessage": "Teleported to 3223, 3293, 0", "comment": "north of Groats' farm, Seth Groats's tile"},
  {"step": "npcOption", "npc": "Seth Groats", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[seth_groats.morning]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::tele 3226 3311 0", "expectMessage": "Teleported to 3226, 3311, 0", "comment": "Vasquen's hops patch north of Lumbridge"},
  {"step": "npcOption", "npc": "Vasquen", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "chooseOption", "text": "[gardener.look_after]"},
  {"step": "assertDialogue", "contains": "[gardener.look_after]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[farms_roads.farming_later]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::tele 3181 3359 0", "expectMessage": "Teleported to 3181, 3359, 0", "comment": "Dreven's bush patch south of the Champions' Guild"},
  {"step": "npcOption", "npc": "Dreven", "option": "Trade", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farms_roads.farming_later]", "timeoutMs": 10000},
  {"step": "command", "text": "::tele 3203 3344 0", "expectMessage": "Teleported to 3203, 3344, 0", "comment": "the canoe station by the Champions' Guild"},
  {"step": "npcOption", "npc": "Tarquin", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[tarquin.hello]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[tarquin.old_bean]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[tarquin.teach]"},
  {"step": "assertDialogue", "contains": "[tarquin.teach_said]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[tarquin.no_skill]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[tarquin.level_12]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[tarquin.quicker]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::tele 3267 3333 0", "expectMessage": "Teleported to 3267, 3333, 0", "comment": "the Lumbridge to Varrock road, Rat Burgiss's tile"},
  {"step": "npcOption", "npc": "Rat Burgiss", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[rat_burgiss.hello]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[rat_burgiss.busy]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[rat_burgiss.sorry]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[rat_burgiss.farewell]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::tele 3226 3458 0", "expectMessage": "Teleported to 3226, 3458, 0", "comment": "Treznor's tree patch outside Varrock Palace"},
  {"step": "npcOption", "npc": "Treznor", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "chooseOption", "text": "[gardener.advice]"},
  {"step": "assertDialogue", "contains": "[gardener.advice]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[farms_roads.farming_later]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
