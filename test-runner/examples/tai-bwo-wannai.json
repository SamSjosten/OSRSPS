{
  "name": "Karamja step K4.2: the jungle refusing a player who hasn't met Murcaily, his greeting, light jungle hacked for a thatch spar, the rotten fence repaired with it, his trading sticks for the favour, the Hardwood Grove's door in for 100 sticks and out for free, Gabooty's Co-op, and Safta Doc's opal machete (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "any scenario: ::reset at the end puts the account's backpack and levels back"},
    {"step": "command", "text": "::empty"},
    {"step": "command", "text": "::varp tbw_cleanup 0", "comment": "not met Murcaily, nothing hacked or repaired"},
    {"step": "command", "text": "::varbit 907 0", "comment": "no favour"},
    {"step": "command", "text": "::varbit 900 1", "comment": "Murcaily shown with sticks"},
    {"step": "command", "text": "::setlevel woodcutting 99"},
    {"step": "command", "text": "::item 975 1", "comment": "a machete"},
    {"step": "command", "text": "::tele 2770 3060 0", "expectMessage": "Teleported to 2770, 3060, 0", "comment": "south of the light jungle at 2770,3061"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "locOption", "locId": 9010, "option": "Hack", "x": 2770, "y": 3061},
    {"step": "assertMessage", "contains": "tbw_cleanup.not_met", "timeoutMs": 10000},
    {"step": "command", "text": "::tele 2815 3083 0", "expectMessage": "Teleported to 2815, 3083, 0", "comment": "by Murcaily, outside the grove"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "Murcaily", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[tbw_villager.greeting]"},
    {"step": "chooseOption", "text": "[tbw_villager.ok_thanks]"},
    {"step": "continueDialogue", "comment": "the player says it"},
    {"step": "command", "text": "::tele 2770 3060 0", "expectMessage": "Teleported to 2770, 3060, 0"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "locOption", "locId": 9010, "option": "Hack", "x": 2770, "y": 3061},
    {"step": "assertInventory", "item": "Thatch spar light", "count": 1, "timeoutMs": 60000, "comment": "a cycle is 8 ticks at 99; the roll can fail"},
    {"step": "command", "text": "::tele 2773 3064 0", "expectMessage": "Teleported to 2773, 3064, 0", "comment": "beside the rotten fence at 2772,3064"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 9025, "option": "Repair", "x": 2772, "y": 3064},
    {"step": "assertInventory", "item": "Thatch spar light", "count": 0, "timeoutMs": 10000},
    {"step": "command", "text": "::tele 2815 3083 0", "expectMessage": "Teleported to 2815, 3083, 0"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "Murcaily", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[murcaily.repaired]"},
    {"step": "continueDialogue", "comment": "[tbw_villager.got_sticks sticks=4 favour=0]"},
    {"step": "assertInventory", "item": "Trading sticks", "count": 4, "comment": "0.3% from the hack and 0.1% from the repair, a stick a tenth"},
    {"step": "command", "text": "::item 6306 100"},
    {"step": "locOption", "locId": 9038, "option": "Open", "x": 2817, "y": 3083},
    {"step": "assertLocation", "x": 2817, "y": 3083, "plane": 0, "timeoutMs": 10000, "comment": "in the grove; the inside tile is guessed"},
    {"step": "assertInventory", "item": "Trading sticks", "count": 4, "comment": "the 100-stick fee"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 9038, "option": "Open", "x": 2817, "y": 3083},
    {"step": "assertLocation", "x": 2816, "y": 3083, "plane": 0, "timeoutMs": 10000, "comment": "out for free"},
    {"step": "command", "text": "::tele 2795 3066 0", "expectMessage": "Teleported to 2795, 3066, 0", "comment": "by Gabooty"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "Gabooty", "option": "Trade-Co-op", "timeoutMs": 20000},
    {"step": "assertInterface", "interfaceId": 300, "timeoutMs": 10000, "comment": "the Tai Bwo Wannai Cooperative"},
    {"step": "clickWidget", "interfaceId": 300, "component": 1, "slot": 11, "op": 1, "comment": "shopmain:frame's close button"},

    {"step": "command", "text": "::item 6306 300", "comment": "Safta Doc's opal machete: 300 sticks, a gout tuber, three opals"},
    {"step": "command", "text": "::item 6311 1"},
    {"step": "command", "text": "::item 1609 3"},
    {"step": "command", "text": "::tele 2790 3099 0", "expectMessage": "Teleported to 2790, 3099, 0", "comment": "by Safta Doc at the anvil"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "Safta Doc", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "chooseOption", "text": "[tbw_villager.what]"},
    {"step": "continueDialogue", "comment": "the player says it"},
    {"step": "continueDialogue", "comment": "[safta_doc.what]"},
    {"step": "continueDialogue", "comment": "[safta_doc.deal]"},
    {"step": "chooseOption", "text": "[safta_doc.yes_machete]"},
    {"step": "continueDialogue", "comment": "the player says it"},
    {"step": "continueDialogue", "comment": "[safta_doc.three_types]"},
    {"step": "chooseOption", "text": "[safta_doc.opal]"},
    {"step": "continueDialogue", "comment": "the opal machete's box"},
    {"step": "chooseOption", "text": "[safta_doc.order_opal]"},
    {"step": "continueDialogue", "comment": "[safta_doc.need_opal]"},
    {"step": "continueDialogue", "comment": "[safta_doc.there_you_go_opal]"},
    {"step": "assertInventory", "item": "Opal machete", "count": 1, "timeoutMs": 10000},
    {"step": "assertInventory", "item": "Opal", "count": 0},

    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
