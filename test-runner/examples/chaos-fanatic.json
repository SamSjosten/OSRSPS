{
  "name": "Wilderness step W4.3: the Chaos Fanatic west of the Lava Maze (level 42) fought under ::god, killed with ::kill, his kill count's key and his bones on the floor (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off)."},
    {"step": "command", "text": "::item 1333", "comment": "a melee weapon of its own: a bow left worn with no ammo by an earlier script fights with no hitsplat (nightly 2026-11-27)"},
    {"step": "itemOption", "item": "Rune scimitar", "option": "Wield"},
    {"step": "waitTicks", "ticks": 1},
    {"step": "command", "text": "::tele 2979 3842 0", "expectMessage": "Teleported to 2979, 3842, 0", "comment": "south of his spawn at 2979,3846"},
    {"step": "npcOption", "npc": "Chaos Fanatic", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Chaos Fanatic", "timeoutMs": 30000, "comment": "the player's punches on him"},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Chaos Fanatic #"},
    {"step": "assertMessage", "contains": "[wilderness_boss.kill_count boss=Chaos Fanatic count=", "timeoutMs": 15000},
    {"step": "assertGroundItem", "item": "Bones", "timeoutMs": 15000},
    {"step": "command", "text": "::tele 3222 3218 0", "expectMessage": "Teleported to 3222, 3218, 0", "comment": "out of the Wilderness before ::god goes off, so nothing hits the player"},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
