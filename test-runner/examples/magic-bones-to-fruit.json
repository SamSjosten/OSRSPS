{
 "name": "Magic utility step U7a: Bones to Bananas changes bones and big bones but not dragon bones, refusals for no bones and unsuitable bones, then Bones to Peaches at 60 (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::setlevel magic 15", "expectMessage": "Magic set to level 15"},
  {"step": "command", "text": "::item 561 3", "expectMessage": "Added 3 x Nature rune"},
  {"step": "command", "text": "::item 555 6", "expectMessage": "Added 6 x Water rune"},
  {"step": "command", "text": "::item 557 6", "expectMessage": "Added 6 x Earth rune"},
  {"step": "clickWidget", "interfaceId": 218, "component": 20, "op": 1, "comment": "magic_spellbook:bones_bananas with no bones"},
  {"step": "assertMessage", "contains": "[bones_to_fruit.no_bones]", "timeoutMs": 5000},
  {"step": "command", "text": "::item 536 1", "expectMessage": "Added 1 x Dragon bones"},
  {"step": "clickWidget", "interfaceId": 218, "component": 20, "op": 1, "comment": "only dragon bones"},
  {"step": "assertMessage", "contains": "[bones_to_fruit.unsuitable]", "timeoutMs": 5000},
  {"step": "command", "text": "::item 526 3", "expectMessage": "Added 3 x Bones"},
  {"step": "command", "text": "::item 532 2", "expectMessage": "Added 2 x Big bones"},
  {"step": "clickWidget", "interfaceId": 218, "component": 20, "op": 1, "comment": "Bones to Bananas"},
  {"step": "assertAnimation", "id": 722, "timeoutMs": 5000, "comment": "human_castbonestobananas"},
  {"step": "assertSpotanim", "id": 141, "timeoutMs": 5000, "comment": "bonestobananas_casting"},
  {"step": "assertInventory", "item": "Banana", "count": 5, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Bones", "count": 0},
  {"step": "assertInventory", "item": "Big bones", "count": 0},
  {"step": "assertInventory", "item": "Dragon bones", "count": 1},
  {"step": "command", "text": "::item 526 2", "expectMessage": "Added 2 x Bones"},
  {"step": "clickWidget", "interfaceId": 218, "component": 53, "op": 1, "comment": "magic_spellbook:bones_peaches at level 15"},
  {"step": "assertMessage", "contains": "[combat.magic_level]", "timeoutMs": 5000},
  {"step": "command", "text": "::setlevel magic 60", "expectMessage": "Magic set to level 60"},
  {"step": "clickWidget", "interfaceId": 218, "component": 53, "op": 1, "comment": "Bones to Peaches, open in this world without the Arena's points (guessed)"},
  {"step": "assertInventory", "item": "Peach", "count": 2, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Bones", "count": 0},
  {"step": "assertInventory", "item": "Nature rune", "count": 0},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
