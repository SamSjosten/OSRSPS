{
 "name": "The clan hall party chest (::keys on): in a clan made by ::clanmake, open the party chest in the clan's hall, offer a bronze dagger from the side panel and confirm it into the chest, pull the lever for 1,000 coins and burst a balloon",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::clandisband", "expectMessage": "lan", "comment": "test's own clan from another run, if any"},
  {"step": "command", "text": "::clandisband Party Gate", "expectMessage": "lan", "comment": "the last run's clan, if any"},
  {"step": "command", "text": "::clanmake Party Gate", "expectMessage": "Clan Party Gate made"},
  {"step": "command", "text": "::clanjoin Party Gate recruiter", "expectMessage": "Joined clan Party Gate as a recruiter"},
  {"step": "command", "text": "::item 995 1000", "comment": "slot 0: the lever's cost"},
  {"step": "command", "text": "::item 1205 1", "comment": "slot 1: a bronze dagger to offer"},
  {"step": "command", "text": "::tele 3185 3471 0", "expectMessage": "Teleported to 3185, 3471, 0", "comment": "west of the clan hall portal (3186, 3471)"},
  {"step": "waitTicks", "ticks": 3, "comment": "a teleport into a new region"},
  {"step": "locOption", "locId": 41724, "option": "Enter", "timeoutMs": 20000},
  {"step": "waitTicks", "ticks": 4, "comment": "into the hall's instance, a new region"},
  {"step": "locOption", "locId": 46248, "option": "Open", "timeoutMs": 30000, "comment": "the party chest in the main room's south-east corner"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "locOption", "locId": 46249, "option": "Deposit", "timeoutMs": 30000, "comment": "the chest opens only once the player has walked there from the hall's entrance (about 24 tiles, longer than 10 s at a walk; nightly 26 Nov)"},
  {"step": "assertInterface", "interfaceId": 783, "timeoutMs": 10000, "comment": "Clan Party Drop Chest"},
  {"step": "assertInterface", "interfaceId": 266, "comment": "and its side panel"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 266, "component": 0, "slot": 1, "op": 1, "comment": "Offer 1 of the dagger"},
  {"step": "assertInventory", "item": "Bronze dagger", "count": 0, "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 783, "component": 17, "op": 1, "comment": "Confirm: into the chest"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "locOption", "locId": 46250, "option": "Pull", "timeoutMs": 20000, "comment": "the lever beside the chest"},
  {"step": "assertMessage", "contains": "[clan_party.pulled name=", "timeoutMs": 30000, "comment": "the walk round to the lever can take longer than 10 s (nightly 27 Nov)"},
  {"step": "assertInventory", "item": "Coins", "count": 0, "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 2},
  {"step": "locOption", "loc": "Party Balloon", "option": "Burst", "timeoutMs": 30000, "comment": "the nearest balloon"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "command", "text": "::clandisband Party Gate", "expectMessage": "Clan Party Gate deleted"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
