{
  "name": "Wilderness step W6.4: the Wilderness Agility Course: the way-in door refused at Agility 51 and walked through at 99, one lap of the pipe, ropeswing, stepping stones, log balance and rocks with its lap count, the dispenser's Tag giving a ticket and Redeem taking it for 200 XP, the dungeon ladder down and up, and the gate back out (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "level 50 to 56, with skeletons about"},
    {"step": "command", "text": "::xprate 1", "expectMessage": "XP rate set to 1x", "comment": "live's rate; ::xprate restore at the end goes back"},
    {"step": "command", "text": "::setlevel agility 51", "expectMessage": "51", "comment": "below the way-in door's 52"},
    {"step": "command", "text": "::tele 2998 3915 0", "expectMessage": "Teleported to 2998, 3915, 0", "comment": "south of the way-in door (2998,3917)"},
    {"step": "locOption", "locId": 23555, "option": "Open", "x": 2998, "y": 3917},
    {"step": "assertMessage", "contains": "[agility.level level=52]", "timeoutMs": 10000},
    {"step": "command", "text": "::setlevel agility 99", "expectMessage": "99", "comment": "98% on each obstacle that can fail (Mod Ash): a fall here is the roll, not a bug, so run again"},
    {"step": "locOption", "locId": 23555, "option": "Open", "x": 2998, "y": 3917},
    {"step": "assertLocation", "x": 2998, "y": 3931, "plane": 0, "timeoutMs": 20000, "comment": "along the ridge into the course; the tiles are inferred from the map and 2004Scape"},
    {"step": "walk", "x": 3004, "y": 3937},
    {"step": "assertLocation", "x": 3004, "y": 3937, "plane": 0, "timeoutMs": 20000},
    {"step": "locOption", "locId": 23137, "option": "Squeeze-through", "x": 3004, "y": 3938},
    {"step": "assertLocation", "x": 3004, "y": 3950, "plane": 0, "timeoutMs": 20000, "comment": "obstacle 1 of 5 crossed"},
    {"step": "waitTicks", "ticks": 2, "comment": "the obstacle's script ends before the next click (clicks while it runs are dropped)"},
    {"step": "locOption", "locId": 23132, "option": "Swing-on", "x": 3005, "y": 3952},
    {"step": "assertLocation", "x": 3005, "y": 3958, "plane": 0, "timeoutMs": 20000, "comment": "obstacle 2 of 5 crossed"},
    {"step": "waitTicks", "ticks": 2, "comment": "the obstacle's script ends before the next click (clicks while it runs are dropped)"},
    {"step": "locOption", "locId": 23556, "option": "Cross", "x": 3001, "y": 3960},
    {"step": "assertLocation", "x": 2996, "y": 3960, "plane": 0, "timeoutMs": 20000, "comment": "obstacle 3 of 5 crossed"},
    {"step": "waitTicks", "ticks": 2, "comment": "the obstacle's script ends before the next click (clicks while it runs are dropped)"},
    {"step": "locOption", "locId": 23542, "option": "Walk-across", "x": 3001, "y": 3945},
    {"step": "assertLocation", "x": 2994, "y": 3945, "plane": 0, "timeoutMs": 20000, "comment": "obstacle 4 of 5 crossed"},
    {"step": "waitTicks", "ticks": 2, "comment": "the obstacle's script ends before the next click (clicks while it runs are dropped)"},
    {"step": "locOption", "locId": 23640, "option": "Climb", "x": 2994, "y": 3936},
    {"step": "assertLocation", "x": 2994, "y": 3933, "plane": 0, "timeoutMs": 20000, "comment": "obstacle 5 of 5 crossed"},
    {"step": "waitTicks", "ticks": 2, "comment": "the obstacle's script ends before the next click (clicks while it runs are dropped)"},
    {"step": "assertMessage", "contains": "[agility.wilderness_laps count=", "timeoutMs": 5000},
    {"step": "locOption", "locId": 53224, "option": "Tag", "x": 3005, "y": 3936},
    {"step": "assertMessage", "contains": "[wilderness_agility.ticket]", "timeoutMs": 20000},
    {"step": "assertInventory", "item": "Wilderness agility ticket", "count": 1, "timeoutMs": 5000},
    {"step": "locOption", "locId": 53224, "option": "Redeem", "x": 3005, "y": 3936},
    {"step": "assertMessage", "contains": "[wilderness_agility.redeemed count=1 xp=200]", "timeoutMs": 10000},
    {"step": "assertInventory", "item": "Wilderness agility ticket", "count": 0, "timeoutMs": 5000},
    {"step": "command", "text": "::tele 3005 3962 0", "expectMessage": "Teleported to 3005, 3962, 0", "comment": "south of the ladder down past the ropeswing (3005,3963)"},
    {"step": "locOption", "locId": 14758, "option": "Climb-down", "x": 3005, "y": 3963},
    {"step": "assertLocation", "x": 3005, "y": 10362, "plane": 0, "timeoutMs": 20000, "comment": "the Wilderness Agility Course Dungeon"},
    {"step": "locOption", "locId": 17385, "option": "Climb-up", "x": 3005, "y": 10363},
    {"step": "assertLocation", "x": 3005, "y": 3962, "plane": 0, "timeoutMs": 20000},
    {"step": "command", "text": "::tele 2998 3932 0", "expectMessage": "Teleported to 2998, 3932, 0"},
    {"step": "locOption", "locId": 23552, "option": "Open", "x": 2998, "y": 3931},
    {"step": "assertLocation", "x": 2998, "y": 3916, "plane": 0, "timeoutMs": 20000, "comment": "back out along the ridge"},
    {"step": "command", "text": "::xprate restore", "expectMessage": "XP rate back to "},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
