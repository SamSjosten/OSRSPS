{
 "name": "Hunter step 1: a bird snare laid from the backpack among Feldip's crimson swifts at 99 Hunter (a sure catch), its animation and the step off its tile, a swift caught and Check giving its drops; then at level 1 among the tropical wagtails (19) a snare that always fails, Reset laying it again and Dismantle taking it up (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario hunter", "expectMessage": "Started scenario hunter.", "comment": "Feldip, 40 Hunter and five bird snares; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::setlevel hunter 99", "expectMessage": "Hunter set to level 99", "comment": "a crimson swift's catch is sure at 99 (164%)"},
  {"step": "command", "text": "::tele 2609 2918 0", "comment": "a crimson swift's spawn tile (npc-spawns/hunter-birds.json); four more spawn within 11 tiles"},
  {"step": "assertLocation", "x": 2609, "y": 2918, "plane": 0},
  {"step": "itemOption", "item": "Bird snare", "option": "Lay"},
  {"step": "assertMessage", "contains": "hunter.laying"},
  {"step": "assertAnimation", "id": 5208, "comment": "human_laytrap"},
  {"step": "assertLoc", "locId": 9345, "x": 2609, "y": 2918, "option": "Dismantle", "comment": "hunting_ojibway_trap, stood on the skill clock's fourth tick"},
  {"step": "assertLocation", "x": 2608, "y": 2918, "plane": 0, "comment": "a step west off the trap"},
  {"step": "assertInventory", "item": "Bird snare", "count": 4},
  {"step": "assertLoc", "locId": 9373, "x": 2609, "y": 2918, "option": "Check", "timeoutMs": 60000, "comment": "a swift within 2 tiles walks in; the trap collapses a minute after it stood if none comes, so a rerun may be needed on a quiet spawn"},
  {"step": "locOption", "locId": 9373, "option": "Check", "x": 2609, "y": 2918},
  {"step": "assertMessage", "contains": "hunter.caught", "timeoutMs": 15000},
  {"step": "assertInventory", "item": "Bird snare", "count": 5},
  {"step": "assertInventory", "item": "Raw bird meat", "count": 1},
  {"step": "assertInventory", "item": "Bones", "count": 1},
  {"step": "command", "text": "::setlevel hunter 1", "expectMessage": "Hunter set to level 1", "comment": "below the wagtail's 19: every one that walks in gets away"},
  {"step": "command", "text": "::tele 2513 2911 0", "comment": "a tropical wagtail's spawn tile, with two more within 3 tiles"},
  {"step": "assertLocation", "x": 2513, "y": 2911, "plane": 0},
  {"step": "itemOption", "item": "Bird snare", "option": "Lay"},
  {"step": "assertLoc", "locId": 9345, "x": 2513, "y": 2911, "option": "Investigate"},
  {"step": "assertLoc", "locId": 9344, "x": 2513, "y": 2911, "option": "Reset", "timeoutMs": 60000, "comment": "hunting_ojibway_trap_broken, the Oct 2026 failed state"},
  {"step": "locOption", "locId": 9344, "option": "Reset", "x": 2513, "y": 2911},
  {"step": "assertMessage", "contains": "hunter.dismantled", "timeoutMs": 15000},
  {"step": "assertLoc", "locId": 9345, "x": 2513, "y": 2911, "option": "Dismantle", "timeoutMs": 15000, "comment": "laid again where it stood"},
  {"step": "assertInventory", "item": "Bird snare", "count": 4},
  {"step": "locOption", "locId": 9345, "option": "Dismantle", "x": 2513, "y": 2911},
  {"step": "assertInventory", "item": "Bird snare", "count": 5, "timeoutMs": 15000},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
