{
 "name": "Magic utility step U4: teleport jewellery. A ring of dueling(2) rubbed to Castle Wars leaves a ring of dueling(1); a worn amulet of glory(1)'s Edgeville uses its last charge, leaving the uncharged amulet, which then has none; a skills necklace(1)'s second page and back to the Fishing Guild (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::item 2564", "expectMessage": "Added 1 x Ring of dueling(2)"},
  {"step": "command", "text": "::item 1706", "expectMessage": "Added 1 x Amulet of glory(1)"},
  {"step": "command", "text": "::item 11111", "expectMessage": "Added 1 x Skills necklace(1)"},
  {"step": "itemOption", "item": "Ring of dueling(2)", "option": "Rub"},
  {"step": "assertDialogue", "contains": "[jewellery_teleport.menu_title]", "timeoutMs": 5000},
  {"step": "chooseOption", "text": "Castle Wars"},
  {"step": "assertMessage", "contains": "[jewellery_teleport.one_use_left item=ring of dueling]", "timeoutMs": 5000},
  {"step": "assertAnimation", "id": 714, "timeoutMs": 5000, "comment": "human_castteleport, as the spells (guessed)"},
  {"step": "assertLocation", "x": 2440, "y": 3090, "plane": 0, "timeoutMs": 10000, "comment": "the Wiki's tile"},
  {"step": "assertInventory", "item": "Ring of dueling(1)", "count": 1},
  {"step": "waitTicks", "ticks": 3, "comment": "a new region"},
  {"step": "itemOption", "item": "Amulet of glory(1)", "option": "Wear"},
  {"step": "assertEquipment", "slot": "neck", "item": "Amulet of glory(1)", "timeoutMs": 5000},
  {"step": "wornOption", "slot": "neck", "option": "Edgeville"},
  {"step": "assertMessage", "contains": "[jewellery_teleport.last_charge item=amulet of glory]", "timeoutMs": 5000},
  {"step": "assertLocation", "x": 3087, "y": 3496, "plane": 0, "timeoutMs": 10000, "comment": "the Wiki's tile"},
  {"step": "assertEquipment", "slot": "neck", "item": "Amulet of glory", "timeoutMs": 5000},
  {"step": "waitTicks", "ticks": 3, "comment": "a new region"},
  {"step": "wornOption", "slot": "neck", "option": "Rub"},
  {"step": "assertMessage", "contains": "[jewellery_teleport.no_charges item=amulet of glory]", "timeoutMs": 5000},
  {"step": "itemOption", "item": "Skills necklace(1)", "option": "Rub"},
  {"step": "assertDialogue", "contains": "Cooking Guild", "timeoutMs": 5000},
  {"step": "chooseOption", "text": "[jewellery_teleport.more]"},
  {"step": "assertDialogue", "contains": "Farming Guild", "timeoutMs": 5000},
  {"step": "chooseOption", "text": "[jewellery_teleport.more]"},
  {"step": "assertDialogue", "contains": "Fishing Guild", "timeoutMs": 5000},
  {"step": "chooseOption", "text": "Fishing Guild"},
  {"step": "assertLocation", "x": 2611, "y": 3390, "plane": 0, "timeoutMs": 10000, "comment": "the Wiki's tile"},
  {"step": "assertInventory", "item": "Skills necklace", "count": 1},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
