{
  "name": "Inferno step IN1: TzHaar-Ket-Keh taking a fire cape (inferno_sacrificed_firecape set back to 0 first), Jump-in on the Inferno's entrance into an Inferno of one's own with its three rocky supports, wave 1 coming in, Quick-exit paying nothing for no wave done, and ::inferno 66 then ::inferno next bringing the supports down for wave 67 (::keys on, ::god on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off)."},
    {"step": "command", "text": "::empty", "comment": "an empty backpack: the fire cape below is the only one"},
    {"step": "command", "text": "::varbit 5646 0", "comment": "inferno_sacrificed_firecape: not given yet, so TzHaar-Ket-Keh asks for the cape"},
    {"step": "command", "text": "::item 6570 1"},
    {"step": "command", "text": "::tele 2496 5121 0", "expectMessage": "Teleported to 2496, 5121, 0", "comment": "between TzHaar-Ket-Keh (2496,5115) and the Inferno's entrance (2493,5124)"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "TzHaar-Ket-Keh", "option": "Talk-to"},
    {"step": "assertDialogue", "contains": "[ket_keh.greeting caste=JalYt-", "speaker": "TzHaar-Ket-Keh"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[ket_keh.help]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[ket_keh.prove]", "speaker": "TzHaar-Ket-Keh"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[ket_keh.take_word]", "speaker": "TzHaar-Ket-Keh"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[ket_keh.yes]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[ket_keh.hand_over]", "speaker": "TzHaar-Ket-Keh"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[ket_keh.yes]"},
    {"step": "assertDialogue", "contains": "[ket_keh.handed]"},
    {"step": "finishDialogue"},
    {"step": "assertInventory", "itemId": 6570, "count": 0},
    {"step": "locOption", "locId": 30352, "option": "Jump-in", "x": 2493, "y": 5124},
    {"step": "assertMessage", "contains": "[inferno.wave wave=1]", "timeoutMs": 15000},
    {"step": "command", "text": "::inferno status", "expectMessage": "Wave 1: "},
    {"step": "locOption", "locId": 30283, "option": "Quick-exit"},
    {"step": "assertLocation", "x": 2496, "y": 5122, "plane": 0, "timeoutMs": 30000},
    {"step": "command", "text": "::inferno 66", "expectMessage": "Inferno: wave 66"},
    {"step": "assertMessage", "contains": "[inferno.wave wave=66]", "timeoutMs": 15000},
    {"step": "command", "text": "::inferno next", "expectMessage": "Took wave 66's monsters out."},
    {"step": "assertMessage", "contains": "[inferno.wave wave=67]", "timeoutMs": 20000},
    {"step": "command", "text": "::inferno status", "expectMessage": "supports none"},
    {"step": "command", "text": "::inferno leave", "expectMessage": "Left the Inferno."},
    {"step": "command", "text": "::empty"},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
