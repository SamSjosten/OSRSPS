{
 "name": "Achievement diaries: rune darts fletched in Varrock do the elite task only as ten at once from tips smithed in Varrock; nine, or ten from bought tips, do nothing (::keys on)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "::reset at the end puts the account back"
  },
  {
   "step": "waitTicks",
   "ticks": 3,
   "comment": "let the client settle: a command typed straight away can be lost"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::diary reset varrock",
   "expectMessage": "Reset varrock"
  },
  {
   "step": "assertVarbit",
   "id": 6322,
   "value": 0,
   "comment": "varrock_elite_count"
  },
  {
   "step": "command",
   "text": "::setlevel fletching 81"
  },
  {
   "step": "command",
   "text": "::tele 3230 3430 0",
   "expectMessage": "Teleported to 3230, 3430, 0",
   "comment": "Varrock square, inside the walls"
  },
  {
   "step": "waitTicks",
   "ticks": 3
  },
  {
   "step": "command",
   "text": "::item 314 30",
   "comment": "feathers for 9 + 10 + 10 darts"
  },
  {
   "step": "command",
   "text": "::item 824 9"
  },
  {
   "step": "useItemOnItem",
   "itemId": 314,
   "onItemId": 824
  },
  {
   "step": "assertInventory",
   "itemId": 811,
   "count": 9,
   "timeoutMs": 5000,
   "comment": "nine rune darts"
  },
  {
   "step": "waitTicks",
   "ticks": 2
  },
  {
   "step": "assertVarbit",
   "id": 6322,
   "value": 0,
   "comment": "nine darts aren't the task's ten"
  },
  {
   "step": "command",
   "text": "::item 824 10"
  },
  {
   "step": "useItemOnItem",
   "itemId": 314,
   "onItemId": 824
  },
  {
   "step": "assertInventory",
   "itemId": 811,
   "count": 19,
   "timeoutMs": 5000,
   "comment": "ten more at once, from bought tips"
  },
  {
   "step": "waitTicks",
   "ticks": 2
  },
  {
   "step": "assertVarbit",
   "id": 6322,
   "value": 0,
   "comment": "bought tips: the task's tips are smithed in Varrock"
  },
  {
   "step": "command",
   "text": "::setlevel smithing 89"
  },
  {
   "step": "command",
   "text": "::item 2347 1",
   "comment": "a hammer"
  },
  {
   "step": "command",
   "text": "::item 2363 1",
   "comment": "a runite bar"
  },
  {
   "step": "command",
   "text": "::tele 3190 3429 0",
   "expectMessage": "Teleported to 3190, 3429, 0",
   "comment": "by the west Varrock smithy (inferred tile)"
  },
  {
   "step": "waitTicks",
   "ticks": 3
  },
  {
   "step": "locOption",
   "loc": "Anvil",
   "option": "Smith",
   "comment": "the nearest anvil"
  },
  {
   "step": "assertInterface",
   "interfaceId": 312,
   "timeoutMs": 15000
  },
  {
   "step": "clickWidget",
   "interfaceId": 312,
   "component": 29,
   "comment": "rune dart tips"
  },
  {
   "step": "assertInventory",
   "itemId": 824,
   "count": 10,
   "timeoutMs": 20000,
   "comment": "ten tips from one bar"
  },
  {
   "step": "assertMessage",
   "contains": "[diary.stage stage=1]",
   "timeoutMs": 5000,
   "comment": "the stage message"
  },
  {
   "step": "assertVarbit",
   "id": 6322,
   "value": 0
  },
  {
   "step": "useItemOnItem",
   "itemId": 314,
   "onItemId": 824
  },
  {
   "step": "assertInventory",
   "itemId": 811,
   "count": 29,
   "timeoutMs": 5000,
   "comment": "ten from the smithed tips"
  },
  {
   "step": "assertVarbit",
   "id": 6322,
   "value": 1,
   "timeoutMs": 5000,
   "comment": "the elite count goes to 1"
  },
  {
   "step": "command",
   "text": "::diary reset varrock",
   "expectMessage": "Reset varrock"
  },
  {
   "step": "command",
   "text": "::reset",
   "expectMessage": "Back to how you were"
  },
  {
   "step": "command",
   "text": "::keys off"
  }
 ]
}
