{
  "name": "Wilderness boss loot, two players (start with artio-left-fight.json on the other VM at the same time): test2 does 440 of Artio's 450 hitpoints, leaves her lair before test finishes her, and gets no kill count for her (exploit review rounds 40 and 42, ::keys on)",
  "account": "test2",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off)."},
    {"step": "command", "text": "::varp 3761 0", "expectMessage": "Varp 3761:", "comment": "Artio's kill count from nothing, to show none is added"},
    {"step": "command", "text": "::tele 3116 3674 0", "expectMessage": "Teleported to 3116, 3674, 0"},
    {"step": "command", "text": "::varbit 14693 0"},
    {"step": "command", "text": "::varbit 14694 0"},
    {"step": "command", "text": "::item 995 50000"},
    {"step": "locOption", "locId": 47141, "option": "Enter", "x": 3115, "y": 3676},
    {"step": "waitTicks", "ticks": 3},
    {"step": "chooseOption", "text": "[wildy_lair_fee.yes]"},
    {"step": "waitTicks", "ticks": 10, "comment": "test is in her lair too, so the fight goes on without us"},
    {"step": "command", "text": "::hit 440 Artio", "expectMessage": "for 440: 10/450 hp"},
    {"step": "locOption", "locId": 47122, "option": "Exit", "x": 1758, "y": 11531},
    {"step": "waitTicks", "ticks": 6},
    {"step": "assertLocation", "x": 3116, "y": 3675, "plane": 0},
    {"step": "waitTicks", "ticks": 50, "comment": "test finishes her meanwhile"},
    {"step": "assertVarp", "id": 3761, "value": 0, "comment": "no kill count for one who walked away; before the fix our 440 took it"},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
