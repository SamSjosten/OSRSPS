{
 "name": "Grand Exchange step 4: the messages as an offer fills and is aborted, collecting from an offer's details, and the collection box's Collect to bank",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack and no offers; ::reset at the end puts it back"},
  {"step": "command", "text": "::gemarket off", "expectMessage": "The Grand Exchange market is off.", "comment": "so only ::gefill fills"},
  {"step": "command", "text": "::item coins 1000", "expectMessage": "Added 1,000 x Coins"},
  {"step": "command", "text": "::geoffer buy feather 100 5", "expectMessage": "Placed: Slot 0: buy 100 x Feather (314) at 5"},
  {"step": "command", "text": "::gefill 0 40", "expectMessage": "Filled 40 in slot 0."},
  {"step": "assertMessage", "contains": "Feather", "comment": "the part-filled message: its words are on 214, ge.bought"},
  {"step": "command", "text": "::ge"},
  {"step": "assertInterface", "interfaceId": 465, "timeoutMs": 10000},
  {"step": "clickWidget", "interfaceId": 465, "component": 7, "slot": 2, "op": 1, "comment": "View offer on slot 0"},
  {"step": "assertVarbit", "id": 4439, "value": 1},
  {"step": "clickWidget", "interfaceId": 465, "component": 24, "slot": 2, "op": 1, "comment": "the details' item box: Collect-notes, which for feathers (they stack) is feathers"},
  {"step": "assertInventory", "item": "Feather", "count": 40},
  {"step": "clickWidget", "interfaceId": 465, "component": 7, "slot": 2, "op": 2, "comment": "Abort offer"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 465, "component": 24, "slot": 3, "op": 2, "comment": "Collect on the coins box: the 300 for the 60 not bought"},
  {"step": "assertInventory", "item": "Coins", "count": 800},
  {"step": "command", "text": "::geoffer list", "expectMessage": "No offers.", "comment": "collected, so the slot is free"},
  {"step": "clickWidget", "interfaceId": 465, "component": 4, "comment": "Back"},
  {"step": "command", "text": "::geoffer sell feather 40 3", "expectMessage": "Placed: Slot 0: sell 40 x Feather (314) at 3"},
  {"step": "command", "text": "::gefill 0", "expectMessage": "Filled 40 in slot 0."},
  {"step": "command", "text": "::gecollect"},
  {"step": "assertInterface", "interfaceId": 402, "timeoutMs": 10000, "comment": "ge_collect, the collection box"},
  {"step": "clickWidget", "interfaceId": 402, "component": 4, "comment": "Collect to bank: the 120 coins"},
  {"step": "command", "text": "::geoffer list", "expectMessage": "No offers."},
  {"step": "assertInventory", "item": "Coins", "count": 800, "comment": "the 120 went to the bank, not here"},
  {"step": "command", "text": "::gemarket on", "expectMessage": "The Grand Exchange market is on."},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
