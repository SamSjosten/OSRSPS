{
 "name": "Magic utility step U5: more teleport jewellery. A necklace of passage(1) to The Outpost, crumbling away; a digsite pendant (2) to the Digsite; a ring of returning(2) straight back to Lumbridge; then a burning amulet(1)'s Wilderness warning, refused then accepted, to the Chaos Temple, crumbling (last, as the Wilderness there can kill a new account) (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::item 21175", "expectMessage": "Added 1 x Burning amulet(1)"},
  {"step": "command", "text": "::item 21155", "expectMessage": "Added 1 x Necklace of passage(1)"},
  {"step": "command", "text": "::item 11191", "expectMessage": "Added 1 x Digsite pendant (2)"},
  {"step": "command", "text": "::item 21136", "expectMessage": "Added 1 x Ring of returning(2)"},
  {"step": "itemOption", "item": "Necklace of passage(1)", "option": "Rub"},
  {"step": "chooseOption", "text": "The Outpost"},
  {"step": "assertMessage", "contains": "[jewellery_teleport.crumbles_away item=necklace of passage]", "timeoutMs": 5000},
  {"step": "assertLocation", "x": 2430, "y": 3349, "plane": 0, "timeoutMs": 10000, "comment": "the Wiki's tile"},
  {"step": "waitTicks", "ticks": 5, "comment": "a new region"},
  {"step": "itemOption", "item": "Digsite pendant (2)", "option": "Rub"},
  {"step": "chooseOption", "text": "Digsite"},
  {"step": "assertMessage", "contains": "[jewellery_teleport.one_use_left item=Digsite Pendant]", "timeoutMs": 5000},
  {"step": "assertLocation", "x": 3341, "y": 3445, "plane": 0, "timeoutMs": 10000, "comment": "the Wiki's tile"},
  {"step": "assertInventory", "item": "Digsite pendant (1)", "count": 1},
  {"step": "waitTicks", "ticks": 5, "comment": "a new region"},
  {"step": "itemOption", "item": "Ring of returning(2)", "option": "Rub"},
  {"step": "assertMessage", "contains": "[jewellery_teleport.one_use_left item=ring of returning]", "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Ring of returning(1)", "count": 1, "timeoutMs": 5000},
  {"step": "waitTicks", "ticks": 5, "comment": "lands within 2 of 3221, 3219 (the Wiki's Lumbridge respawn), so no exact tile to assert"},
  {"step": "itemOption", "item": "Burning amulet(1)", "option": "Rub"},
  {"step": "chooseOption", "text": "Chaos Temple"},
  {"step": "assertDialogue", "contains": "[jewellery_teleport.wilderness_warning place=Chaos Temple]", "timeoutMs": 5000},
  {"step": "chooseOption", "text": "[jewellery_teleport.wilderness_no]"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "assertInventory", "item": "Burning amulet(1)", "count": 1, "comment": "No keeps the charge"},
  {"step": "itemOption", "item": "Burning amulet(1)", "option": "Rub"},
  {"step": "chooseOption", "text": "Chaos Temple"},
  {"step": "chooseOption", "text": "[jewellery_teleport.wilderness_yes]"},
  {"step": "assertMessage", "contains": "[jewellery_teleport.crumbles item=burning amulet]", "timeoutMs": 5000},
  {"step": "assertLocation", "x": 3234, "y": 3634, "plane": 0, "timeoutMs": 10000, "comment": "the Wiki's tile, level 15 Wilderness"},
  {"step": "assertInventory", "item": "Burning amulet(1)", "count": 0},
  {"step": "waitTicks", "ticks": 2},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
