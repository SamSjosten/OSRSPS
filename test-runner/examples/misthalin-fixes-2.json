{
 "name": "Misthalin fixes 2: Martin the Master Gardener's talk and Pickpocket, Draynor's Town Crier, and Fluffs upstairs in the Lumber Yard talking through a catspeak amulet (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts it back"},
  {"step": "command", "text": "::tele 3080 3256 0", "expectMessage": "Teleported to 3080, 3256, 0", "comment": "by the G.A.G. pig pen in Draynor's market"},
  {"step": "npcOption", "npc": "Martin the Master Gardener", "option": "Talk-to", "timeoutMs": 30000},
  {"step": "chooseOption", "text": "[martin.ask_quest]", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[martin.solved]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "speaker": "Martin the Master Gardener", "contains": "[martin.reserve]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[martin.godfather]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "speaker": "Martin the Master Gardener", "contains": "[martin.crops]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::setlevel thieving 99"},
  {"step": "npcOption", "npc": "Martin the Master Gardener", "option": "Pickpocket", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[pickpocket.attempt who=Martin the Master Gardener]", "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 10, "comment": "past any stun"},
  {"step": "npcOption", "npc": "Town Crier", "option": "Talk-to", "timeoutMs": 30000},
  {"step": "assertDialogue", "speaker": "Town Crier", "contains": "[town_crier.greeting]", "timeoutMs": 20000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[town_crier.later]"},
  {"step": "assertDialogue", "contains": "[town_crier.later]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "speaker": "Town Crier", "contains": "[town_crier.until]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::item 4677", "expectMessage": "Added 1 x Catspeak amulet"},
  {"step": "itemOption", "item": "Catspeak amulet", "option": "Wear"},
  {"step": "assertEquipment", "slot": "neck", "item": "Catspeak amulet"},
  {"step": "command", "text": "::tele 3308 3512 1", "expectMessage": "Teleported to 3308, 3512, 1", "comment": "upstairs in the Lumber Yard"},
  {"step": "npcOption", "npc": "Gertrude's cat", "option": "Talk-to", "timeoutMs": 30000},
  {"step": "assertDialogue", "contains": "[fluffs.hello]", "timeoutMs": 20000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "speaker": "Gertrude's cat", "contains": "[fluffs.can_talk]"},
  {"step": "finishDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
