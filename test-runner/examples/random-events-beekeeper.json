{
  "name": "Random events: the Bee keeper's field, the beehive window, a wrong build, talking to reopen it, and six wrong sending the player home",
  "account": "test",
  "runOnLogin": false,
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"comment": "Off first, so the timer can't send a second event mid-script.", "step": "command", "text": "::randomevent off", "expectMessage": "Random events off"},
    {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied"},
    {"step": "command", "text": "::tele 3222 3218", "expectMessage": "Teleported to 3222, 3218"},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0},
    {"step": "command", "text": "::randomevent beekeeper", "expectMessage": "Started random event beekeeper"},
    {"step": "npcOption", "npc": "Bee keeper", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.help", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[beekeeper.ooh]"},
    {"step": "assertDialogue", "contains": "[beekeeper.ooh]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.drag_away", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[beekeeper.what_expect]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.jumbled]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[beekeeper.take_a_look]"},
    {"step": "continueDialogue"},
    {"comment": "The beehive window: look that four parts spin in the top row and can be dragged into the slots (drag one by hand if watching).", "step": "assertInterface", "interfaceId": 420, "timeoutMs": 20000},
    {"step": "clickWidget", "interfaceId": 420, "component": 22},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.not_right]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.tries_5]"},
    {"step": "continueDialogue"},
    {"step": "assertInterface", "interfaceId": 420, "timeoutMs": 20000},
    {"step": "clickWidget", "interfaceId": 420, "component": 26},
    {"step": "assertInterface", "interfaceId": 420, "absent": true, "timeoutMs": 5000},
    {"step": "npcOption", "npc": "Bee keeper", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.ready]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[beekeeper.get_on]"},
    {"step": "assertDialogue", "contains": "[beekeeper.get_on]"},
    {"step": "continueDialogue"},
    {"step": "assertInterface", "interfaceId": 420, "timeoutMs": 20000},
    {"step": "clickWidget", "interfaceId": 420, "component": 22},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.not_right]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.tries_4]"},
    {"step": "continueDialogue"},
    {"step": "assertInterface", "interfaceId": 420, "timeoutMs": 20000},
    {"step": "clickWidget", "interfaceId": 420, "component": 22},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.not_right]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.tries_3]"},
    {"step": "continueDialogue"},
    {"step": "assertInterface", "interfaceId": 420, "timeoutMs": 20000},
    {"step": "clickWidget", "interfaceId": 420, "component": 22},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.not_right]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.tries_2]"},
    {"step": "continueDialogue"},
    {"step": "assertInterface", "interfaceId": 420, "timeoutMs": 20000},
    {"step": "clickWidget", "interfaceId": 420, "component": 22},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.not_right]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.tries_1]"},
    {"step": "continueDialogue"},
    {"step": "assertInterface", "interfaceId": 420, "timeoutMs": 20000},
    {"step": "clickWidget", "interfaceId": 420, "component": 22},
    {"step": "assertDialogue", "speaker": "Bee keeper", "contains": "[beekeeper.fed_up]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertMessage", "contains": "[beekeeper.teleported_away]", "timeoutMs": 20000},
    {"step": "waitTicks", "ticks": 3},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0},
    {"step": "assertInventory", "item": "Lamp", "count": 0}
  ]
}
