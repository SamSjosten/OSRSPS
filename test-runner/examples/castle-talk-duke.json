{
 "name": "Lumbridge Castle: Talk-to Duke Horacio (::keys on, so keys show whatever data/dialogue.txt holds)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::tele 3207 3222 1",
   "expectMessage": "Teleported to 3207, 3222, 1",
   "comment": "The Duke wanders 5 tiles, so he can go out through a door another script opened and be shut out of his room; with both doors on his west wall open he can be reached wherever he is"
  },
  {
   "step": "command",
   "text": "::resetlocs 1",
   "expectMessage": "Put the locs within 1 of"
  },
  {
   "step": "locOption",
   "loc": "Door",
   "option": "Open",
   "x": 3207,
   "y": 3222
  },
  {
   "step": "assertLoc",
   "loc": "Door",
   "option": "Close",
   "x": 3208,
   "y": 3222,
   "comment": "open before the teleport, which cancels a click the server hasn't carried out yet"
  },
  {
   "step": "command",
   "text": "::tele 3207 3227 1",
   "expectMessage": "Teleported to 3207, 3227, 1"
  },
  {
   "step": "command",
