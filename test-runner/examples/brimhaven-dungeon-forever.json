{
  "name": "Karamja step K3.3: Saniboch's Pay option taking 875 coins, then a million on top for good; the entrance letting the player in twice with no fee used up (::keys on; the varbit is cleared before and after so the script can run again)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::varbit 8123 0", "expectMessage": "-> 0", "comment": "karam_dungeon_doordata: nothing paid"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "any scenario: ::reset at the end puts the account's backpack and levels back"},
    {"step": "command", "text": "::empty"},
    {"step": "command", "text": "::item 995 1000875"},
    {"step": "command", "text": "::tele 2744 3152 0", "expectMessage": "Teleported to 2744, 3152, 0", "comment": "before the dungeon entrance, by Saniboch"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "Saniboch", "option": "Pay", "timeoutMs": 20000},
    {"step": "chooseOption", "text": "[saniboch.pay_once]"},
    {"step": "continueDialogue", "comment": "[saniboch.give_875]"},
    {"step": "continueDialogue", "comment": "[saniboch.many_thanks]"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "npcOption", "npc": "Saniboch", "option": "Pay", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[saniboch.lovely_coins]"},
    {"step": "chooseOption", "text": "[saniboch.permanent]"},
    {"step": "continueDialogue", "comment": "the player asks"},
    {"step": "continueDialogue", "comment": "[saniboch.suppose_so]"},
    {"step": "chooseOption", "text": "[saniboch.heres_million]"},
    {"step": "continueDialogue", "comment": "the player says it"},
    {"step": "continueDialogue", "comment": "[saniboch.give_million]"},
    {"step": "continueDialogue", "comment": "[saniboch.thanks_forever]"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 20877, "option": "Enter", "x": 2743, "y": 3153},
    {"step": "assertLocation", "x": 2713, "y": 9564, "plane": 0, "timeoutMs": 10000, "comment": "inside, by the exit"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 20878, "option": "Leave", "x": 2714, "y": 9564},
    {"step": "assertLocation", "x": 2744, "y": 3152, "plane": 0, "timeoutMs": 10000},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 20877, "option": "Enter", "x": 2743, "y": 3153},
    {"step": "assertLocation", "x": 2713, "y": 9564, "plane": 0, "timeoutMs": 10000, "comment": "in again, nothing more to pay"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 20878, "option": "Leave", "x": 2714, "y": 9564},
    {"step": "assertLocation", "x": 2744, "y": 3152, "plane": 0, "timeoutMs": 10000},

    {"step": "command", "text": "::varbit 8123 0", "expectMessage": "-> 0"},
    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
