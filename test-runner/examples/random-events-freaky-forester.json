{
  "name": "Random events: the Freaky Forester's forest, a pheasant handed in, and the portal back with a Lederhosen piece",
  "account": "test",
  "runOnLogin": false,
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"comment": "Off first, so the timer can't send a second event mid-script.", "step": "command", "text": "::randomevent off", "expectMessage": "Random events off"},
    {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied"},
    {"step": "command", "text": "::tele 3222 3218", "expectMessage": "Teleported to 3222, 3218"},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0},
    {"step": "command", "text": "::randomevent freaky_forester", "expectMessage": "Started random event freaky_forester"},
    {"step": "npcOption", "npc": "Freaky Forester", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Freaky Forester", "contains": "[freaky_forester.help", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[freaky_forester.okay]"},
    {"step": "assertDialogue", "contains": "[freaky_forester.okay]"},
    {"step": "continueDialogue"},
    {"comment": "In the forest: his question names two, three or four tails, but he takes any pheasant.", "step": "assertDialogue", "speaker": "Freaky Forester", "contains": "[freaky_forester.ask_", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "Pheasant", "option": "Kill", "timeoutMs": 20000},
    {"step": "waitTicks", "ticks": 4},
    {"step": "takeItem", "item": "Raw pheasant"},
    {"step": "assertInventory", "item": "Raw pheasant", "count": 1},
    {"step": "npcOption", "npc": "Freaky Forester", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Freaky Forester", "contains": "[freaky_forester.thanks", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertInventory", "item": "Raw pheasant", "count": 0},
    {"step": "locOption", "loc": "Exit portal", "option": "Use", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Freaky Forester", "contains": "[freaky_forester.reward", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0}
  ]
}
