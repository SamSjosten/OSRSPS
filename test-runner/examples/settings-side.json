{
 "name": "Settings side panel (settings piece, step 1): tabs, toggles, attack priority, volumes and mute, each held by the server and kept over a relog",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::varbit 9683 0", "expectMessage": "Varbit 9683", "comment": "settings_side_panel_tab: start on Controls"},
  {"step": "command", "text": "::varbit 4180 0", "expectMessage": "Varbit 4180", "comment": "option_acceptaid off"},
  {"step": "command", "text": "::varbit 13131 0", "expectMessage": "Varbit 13131", "comment": "skull_prevent_enabled off"},
  {"step": "command", "text": "::varbit 6357 0", "expectMessage": "Varbit 6357", "comment": "camera_zoom_mouse_disabled off: scroll-wheel zoom on"},
  {"step": "command", "text": "::varp 173 0", "expectMessage": "Varp 173", "comment": "option_run: walking"},
  {"step": "command", "text": "::varp 1107 0", "expectMessage": "Varp 1107", "comment": "option_attackpriority: by combat level"},
  {"step": "command", "text": "::varp 3796 1", "expectMessage": "Varp 3796", "comment": "first a value it can't already be, so the next one is a change the server sends: after a failed run the client can be left at 58 with the server at 100, and the knob would then sit under the click"},
  {"step": "command", "text": "::varp 3796 100", "expectMessage": "Varp 3796", "comment": "option_master_volume"},
  {"step": "command", "text": "::varp 168 1", "expectMessage": "Varp 168"},
  {"step": "command", "text": "::varp 168 20", "expectMessage": "Varp 168", "comment": "option_music"},
  {"step": "clickWidget", "interfaceId": 548, "component": 52, "comment": "toplevel:stone11, the settings tab, in the fixed frame the VM's client uses"},

  {"step": "clickWidget", "interfaceId": 116, "component": 66, "comment": "settings_side:audio_tab"},
  {"step": "assertVarbit", "id": 9683, "value": 1, "comment": "the server holds the tab the client switched to, so a relog opens on it"},
  {"step": "clickWidget", "interfaceId": 116, "component": 67, "comment": "settings_side:display_tab"},
  {"step": "assertVarbit", "id": 9683, "value": 2},
  {"step": "clickWidget", "interfaceId": 116, "component": 43, "comment": "settings_side:zoom_toggle op 1, scroll-wheel zoom off"},
  {"step": "assertVarbit", "id": 6357, "value": 1, "comment": "bit 29 of varp 1055, which also holds the side stones' layout"},
  {"step": "clickWidget", "interfaceId": 116, "component": 58, "comment": "settings_side:settings_tab, Controls"},
  {"step": "assertVarbit", "id": 9683, "value": 0},

  {"step": "clickWidget", "interfaceId": 116, "component": 29, "comment": "settings_side:acceptaid"},
  {"step": "assertVarbit", "id": 4180, "value": 1},
  {"step": "clickWidget", "interfaceId": 116, "component": 5, "comment": "settings_side:skull_prevention"},
  {"step": "assertVarbit", "id": 13131, "value": 1},
  {"step": "clickWidget", "interfaceId": 116, "component": 30, "comment": "settings_side:runmode"},
  {"step": "assertVarp", "id": 173, "value": 1, "comment": "run on in the server's copy too, so the next walk runs"},
  {"step": "clickWidget", "interfaceId": 116, "component": 30},
  {"step": "assertVarp", "id": 173, "value": 0},

  {"step": "mouseClick", "interfaceId": 116, "component": 6, "slot": 0, "comment": "settings_side:attack_priority_player's box: the dropdown opens on the mouse click itself"},
  {"step": "clickWidget", "interfaceId": 116, "component": 38, "slot": 3, "comment": "its third option, Left-click where available: child 3 of attack_priority_player_buttons"},
  {"step": "waitTicks", "ticks": 2, "comment": "the client reads the varp again 30 client cycles after the pick (settings_side_dropdown_timer); a server that ignored the pick would show it jump back"},
  {"step": "assertVarp", "id": 1107, "value": 2},

  {"step": "clickWidget", "interfaceId": 116, "component": 66, "comment": "Audio, for the volume sliders"},
  {"step": "waitTicks", "ticks": 1, "comment": "so the Audio tab's sliders are laid out before the mouse lands on them"},
  {"step": "mouseClick", "interfaceId": 116, "component": 94, "comment": "settings_side:master_bobble_container, clicked in its middle: settings_side_master_volume_op puts master at 58% and sends IF_SCRIPT_TRIGGER. It takes a real click (the client sent nothing when the runner ran the slider's script itself) and bit 23 of the bobble's events, which login sets (VM, 2026-10-29)"},
  {"step": "assertVarp", "id": 3796, "value": 58},
  {"step": "mouseClick", "interfaceId": 116, "component": 108, "comment": "settings_side:music_bobble_container, the same width, so music at 58% too"},
  {"step": "assertVarp", "id": 168, "value": 58},
  {"step": "clickWidget", "interfaceId": 116, "component": 96, "comment": "settings_side:master_icon, Mute"},
  {"step": "assertVarp", "id": 3796, "value": 0},
  {"step": "assertVarbit", "id": 14817, "value": 58, "comment": "option_master_volume_saved, for the unmute"},

  {"step": "logout", "comment": "auto login logs back in a few seconds later"},
  {"step": "waitForLogin"},
  {"step": "assertVarbit", "id": 4180, "value": 1, "comment": "everything is still set after the relog"},
  {"step": "assertVarbit", "id": 13131, "value": 1},
  {"step": "assertVarbit", "id": 6357, "value": 1},
  {"step": "assertVarp", "id": 1107, "value": 2},
  {"step": "assertVarp", "id": 168, "value": 58},
  {"step": "assertVarp", "id": 3796, "value": 0},
  {"step": "assertVarbit", "id": 9683, "value": 1, "comment": "the panel opens on Audio, the last tab picked"},

  {"step": "clickWidget", "interfaceId": 548, "component": 52},
  {"step": "clickWidget", "interfaceId": 116, "component": 96, "comment": "Unmute: back to the saved 58"},
  {"step": "assertVarp", "id": 3796, "value": 58},
  {"step": "command", "text": "::varp 3796 100", "expectMessage": "Varp 3796", "comment": "put the account back"},
  {"step": "command", "text": "::varp 168 20", "expectMessage": "Varp 168"},
  {"step": "command", "text": "::varp 1107 0", "expectMessage": "Varp 1107"},
  {"step": "command", "text": "::varbit 4180 0", "expectMessage": "Varbit 4180"},
  {"step": "command", "text": "::varbit 13131 0", "expectMessage": "Varbit 13131"},
  {"step": "command", "text": "::varbit 6357 0", "expectMessage": "Varbit 6357"},
  {"step": "command", "text": "::varbit 9683 0", "expectMessage": "Varbit 9683"}
 ]
}
