{
 "name": "Raid bows: the twisted bow's numbers and a shot at a man; the Venator bow shooting two men in a zone ::multi makes multi-way",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::setlevel ranged 99", "expectMessage": "99", "comment": "the twisted bow needs 75 Ranged and the Venator bow 80"},
  {"step": "command", "text": "::item twisted bow", "expectMessage": "Added 1 x Twisted bow"},
  {"step": "itemOption", "item": "Twisted bow", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Twisted bow"},
  {"step": "command", "text": "::item bronze arrow 3", "expectMessage": "Added 3 x Bronze arrow"},
  {"step": "itemOption", "item": "Bronze arrow", "option": "Wield"},
  {"step": "assertEquipment", "slot": "ammo", "item": "Bronze arrow"},
  {"step": "command", "text": "::combat man", "expectMessage": "Accurate (accurate, ranged standard), speed 6", "comment": "a man's Magic is 1: the bow's 40% accuracy and 54% damage"},
  {"step": "command", "text": "::tele 3216 3219 0", "expectMessage": "Teleported to 3216, 3219, 0"},
  {"step": "npcOption", "npc": "Man", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertAnimation", "id": 426, "timeoutMs": 20000, "comment": "human_bow"},
  {"step": "assertHitsplat", "npc": "Man", "timeoutMs": 20000},
  {"step": "command", "text": "::kill man", "expectMessage": "Killed Man #", "comment": "the man fights back once shot; ::kill picks the one being fought"},
  {"step": "waitTicks", "ticks": 4},
  {"step": "command", "text": "::item venator bow", "expectMessage": "Added 1 x Venator bow"},
  {"step": "itemOption", "item": "Venator bow", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Venator bow"},
  {"step": "command", "text": "::item bronze arrow 20", "expectMessage": "Added 20 x Bronze arrow"},
  {"step": "itemOption", "item": "Bronze arrow", "option": "Wield"},
  {"step": "command", "text": "::god", "expectMessage": "You can't be hurt now", "comment": "two men will fight back"},
  {"step": "command", "text": "::tele 3236 3220 0", "expectMessage": "Teleported to 3236, 3220, 0", "comment": "the grass east of the castle; the zone 3232-3239, 3216-3223"},
  {"step": "command", "text": "::npc man", "expectMessage": "Spawned Man"},
  {"step": "command", "text": "::tele 3236 3222 0", "expectMessage": "Teleported to 3236, 3222, 0"},
  {"step": "command", "text": "::npc man", "expectMessage": "Spawned Man", "comment": "two tiles north of the first: in a bounce's reach"},
  {"step": "command", "text": "::tele 3236 3216 0", "expectMessage": "Teleported to 3236, 3216, 0"},
  {"step": "command", "text": "::multi on", "expectMessage": "Combat is multi-way"},
  {"step": "npcOption", "npc": "Man", "option": "Attack", "timeoutMs": 20000, "comment": "the nearer man, four tiles north"},
  {"step": "assertAnimation", "id": 9858, "timeoutMs": 20000, "comment": "human_weapon_bow_venator01_shoot"},
  {"step": "assertHitsplat", "npc": "Man", "timeoutMs": 20000},
  {"step": "waitTicks", "ticks": 10, "comment": "watch for the bounce arrows going man to man"},
  {"step": "command", "text": "::delnpc mine", "expectMessage": "you put in.", "comment": "both men, whether the shots and bounces killed them or not (::npc men don't come back)"},
  {"step": "command", "text": "::multi off", "expectMessage": "Combat is single-way"},
  {"step": "command", "text": "::god", "expectMessage": "You can be hurt again."},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
