{
 "name": "Combat step 4: let a castle man hit you with auto retaliate off, then on; ::god and ::heal",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried, and no fight going on; ::reset at the end puts the account back"},
  {"step": "command", "text": "::tele 3217 3219 0", "expectMessage": "Teleported to 3217, 3219, 0"},
  {"step": "command", "text": "::npc man", "expectMessage": "Spawned Man", "comment": "a man who stays on 3217, 3219 (wander 0): a wandering one led the player off and the walk-off tile out of view (nightly 25 Nov 2026)"},
  {"step": "command", "text": "::tele 3216 3219 0", "expectMessage": "Teleported to 3216, 3219, 0", "comment": "beside him, so Attack picks him"},
  {"step": "command", "text": "::heal", "expectMessage": "Healed to "},
  {"step": "command", "text": "::varp 172 1", "expectMessage": "Varp 172:", "comment": "auto retaliate off"},
  {"step": "npcOption", "npc": "Man", "option": "Attack"},
  {"step": "assertAnimation", "id": 422, "timeoutMs": 20000, "comment": "human_unarmedpunch on the first swing: the nearest man may have wandered a few tiles off, and ::fight only names him once the walk up is over (nightly 22 Nov 2026 asked after a fixed 6 ticks, still walking)"},
  {"step": "assertHitsplat", "npc": "Man", "timeoutMs": 20000, "comment": "a hit or a miss (0); he turns on you"},
  {"step": "command", "text": "::fight", "expectMessage": "You are fighting Man #"},
  {"step": "walk", "x": 3214, "y": 3219, "comment": "walk off; he follows and keeps hitting"},
  {"step": "waitTicks", "ticks": 10},
  {"step": "command", "text": "::fight", "expectMessage": "You are not fighting anything."},
  {"step": "command", "text": "::hp", "expectMessage": "under attack by Man #"},
  {"step": "command", "text": "::varp 172 0", "expectMessage": "Varp 172: 1 -> 0", "comment": "auto retaliate on: his next hit starts your fight"},
  {"step": "waitTicks", "ticks": 6},
  {"step": "command", "text": "::fight", "expectMessage": "You are fighting Man #"},
  {"step": "command", "text": "::god", "expectMessage": "You can't be hurt now"},
  {"step": "command", "text": "::heal", "expectMessage": "Healed to "},
  {"step": "waitTicks", "ticks": 10},
  {"step": "command", "text": "::hp", "expectMessage": "; ::god is on."},
  {"step": "command", "text": "::god", "expectMessage": "You can be hurt again."},
  {"step": "command", "text": "::kill man", "expectMessage": "Killed Man #", "comment": "end the fight so the next script starts clean"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
