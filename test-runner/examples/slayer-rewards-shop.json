{
 "name": "Slayer steps 4 and 5 at Vannaka in Edgeville Dungeon: Trade opening the Slayer Equipment shop, Talk-to's Look at shop opening it again, Look at rewards opening the rewards screen (426), the Buy tab's Buy 1 on the slayer ring for 75 points and Buy 1 set of broad bolts for 35, read off assertInventory and the points varbit, with ::keys on",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "keys", "comment": "the Slayer lines' words aren't all filled yet, so the script reads their keys"},
  {"step": "command", "text": "::tele 3147 9912 0", "expectMessage": "Teleported to 3147, 9912, 0", "comment": "beside Vannaka, by the gate north of the middle of Edgeville Dungeon"},
  {"step": "command", "text": "::slayer points 200", "expectMessage": "Streak 0, 200 points."},
  {"step": "npcOption", "npc": "Vannaka", "option": "Trade", "timeoutMs": 20000},
  {"step": "assertInterface", "interfaceId": 300, "comment": "the Slayer Equipment shop (shopmain)"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 300, "component": 1, "slot": 11, "op": 1, "comment": "shopmain:frame's close button, as in al-kharid-shops.json"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "npcOption", "npc": "Vannaka", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[slayer_master.greeting]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[slayer_master.rewards]"},
  {"step": "assertDialogue", "contains": "[slayer_master.rewards]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[slayer_master.rewards_answer]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[slayer_master.look_shop]"},
  {"step": "assertInterface", "interfaceId": 300},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 300, "component": 1, "slot": 11, "op": 1},
  {"step": "waitTicks", "ticks": 2},
  {"step": "npcOption", "npc": "Vannaka", "option": "Rewards", "timeoutMs": 20000},
  {"step": "assertInterface", "interfaceId": 426, "comment": "slayer_rewards"},
  {"step": "assertVarbit", "id": 17868, "value": 3, "comment": "slayer_master_in_focus: Vannaka"},
  {"step": "waitTicks", "ticks": 2, "comment": "lets the client draw the tabs before clicking the Buy tab's items"},
  {"step": "clickWidget", "interfaceId": 426, "component": 25, "slot": 0, "op": 2, "comment": "buy_items child 0, the slayer ring (8): Buy 1"},
  {"step": "assertInventory", "item": "Slayer ring (8)", "count": 1},
  {"step": "assertVarbit", "id": 4068, "value": 125, "comment": "slayer_points: 200 less 75"},
  {"step": "waitTicks", "ticks": 1},
  {"step": "clickWidget", "interfaceId": 426, "component": 25, "slot": 1, "op": 2, "comment": "child 1, broad bolts: Buy 1 set of 250"},
  {"step": "assertInventory", "item": "Broad bolts", "count": 250},
  {"step": "assertVarbit", "id": 4068, "value": 90},
  {"step": "waitTicks", "ticks": 1},
  {"step": "clickWidget", "interfaceId": 426, "component": 2, "slot": 11, "op": 1, "comment": "the steelborder frame's close button (426:2 runs steelborder, as shopmain:frame does)"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "command", "text": "::slayer", "expectMessage": "No task; streak 0, 90 points."},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
