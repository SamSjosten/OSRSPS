{
  "name": "Random events: Evil Bob's island, the servant's cutscene, a fishlike thing netted and uncooked, and the portal home",
  "account": "test",
  "runOnLogin": false,
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"comment": "Off first, so the timer can't send a second event mid-script.", "step": "command", "text": "::randomevent off", "expectMessage": "Random events off"},
    {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied"},
    {"step": "command", "text": "::tele 3222 3218", "expectMessage": "Teleported to 3222, 3218"},
    {"step": "command", "text": "::randomevent evil_bob", "expectMessage": "Started random event evil_bob"},
    {"step": "npcOption", "npc": "Evil Bob", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Evil Bob", "contains": "[evil_bob.come_fishing", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[evil_bob.yes]"},
    {"comment": "His island: look that it is the ScapeRune island with the portal, the pots and the four statues.", "step": "assertDialogue", "contains": "[evil_bob.huh]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[evil_bob.where_am_i]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Evil Bob", "contains": "[evil_bob.my_island]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[evil_bob.your_leader]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Evil Bob", "contains": "[evil_bob.i_am_leader]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[evil_bob.not_a_slave]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Evil Bob", "contains": "[evil_bob.ahaha]"},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"step": "npcOption", "npc": "Servant", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[evil_bob_servant.kidnapped]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Servant", "contains": "[evil_bob_servant.cant_help]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[evil_bob_servant.listen]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Servant", "contains": "[evil_bob_servant.fish_he_likes]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Servant", "contains": "[evil_bob_servant.over_there]"},
    {"step": "continueDialogue"},
    {"comment": "The cutscene: look that the camera swings to one statue and its spots under \"Watch the statue! Fish here!\", then comes back.", "step": "assertInterface", "interfaceId": 186, "timeoutMs": 20000},
    {"step": "assertInterface", "interfaceId": 186, "absent": true, "timeoutMs": 20000},
    {"step": "takeItem", "item": "Small fishing net", "timeoutMs": 20000},
    {"step": "assertInventory", "item": "Small fishing net", "count": 1, "timeoutMs": 20000},
    {"comment": "The nearest spot: right or wrong, the catch is a fishlike thing.", "step": "locOption", "loc": "Fishing spot", "option": "Net", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[evil_bob.catch]", "timeoutMs": 30000},
    {"step": "continueDialogue"},
    {"step": "assertInventory", "item": "Fishlike thing", "count": 1},
    {"step": "itemOption", "item": "Fishlike thing", "option": "Eat"},
    {"step": "assertDialogue", "contains": "[evil_bob.not_eating]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "useItemOnLoc", "item": "Fishlike thing", "loc": "Uncooking pot", "timeoutMs": 20000},
    {"step": "assertInventory", "item": "Raw fishlike thing", "count": 1, "timeoutMs": 20000},
    {"step": "npcOption", "npc": "Evil Bob", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[evil_bob.let_me_out]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Evil Bob", "contains": "[evil_bob.never_let_go"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[evil_bob.to_bob]"},
    {"step": "assertDialogue", "contains": "[evil_bob.to_bob]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Evil Bob", "contains": "[evil_bob.i_am_bob]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Evil Bob", "contains": "[evil_bob.incarnation]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[evil_bob.mirror]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Evil Bob", "contains": "[evil_bob.servant_called"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Evil Bob", "contains": "[evil_bob.fish_for_me]"},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"comment": "The portal before he sleeps: home with nothing, the island's net and fish gone.", "step": "locOption", "loc": "Portal", "option": "Enter", "timeoutMs": 20000},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0, "timeoutMs": 20000},
    {"step": "assertInventory", "item": "Small fishing net", "count": 0},
    {"step": "assertInventory", "item": "Raw fishlike thing", "count": 0}
  ]
}
