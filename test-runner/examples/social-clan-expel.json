{
 "name": "Clan expel, one player: test joins a clan made by ::clanmake as a recruiter (the owner's rank) and accepts the test applicant (rank 0), then on the members page picks Expel for the second column, is refused on the owner, answers No and then Yes to expelling the applicant",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "keys"},
  {"step": "command", "text": "::clandisband", "expectMessage": "lan", "comment": "test's own clan from another run, if any: 'Clan ... deleted' or 'You aren't in a clan'"},
  {"step": "command", "text": "::clandisband Expel Gate", "expectMessage": "lan", "comment": "the last run's clan, if any"},
  {"step": "command", "text": "::clanmake Expel Gate", "expectMessage": "Clan Expel Gate made"},
  {"step": "command", "text": "::clanjoin Expel Gate recruiter", "expectMessage": "Joined clan Expel Gate as a recruiter"},
  {"step": "command", "text": "::clanapplicant", "expectMessage": "Applicant applied to Expel Gate"},
  {"step": "runClientScript", "id": 915, "args": [7], "comment": "shows the Clans side tab (toplevel_sidebutton_switch), so its panels count as open"},
  {"step": "clickWidget", "interfaceId": 707, "component": 3, "comment": "the Clans tab's Your Clan tab"},
  {"step": "assertInterface", "interfaceId": 701},
  {"step": "clickWidget", "interfaceId": 701, "component": 9, "comment": "Settings: the clan's settings page (clans_info)"},
  {"step": "assertInterface", "interfaceId": 690},
  {"step": "clickWidget", "interfaceId": 690, "component": 21, "comment": "Applications: the applicants page"},
  {"step": "assertInterface", "interfaceId": 699},
  {"step": "clickWidget", "interfaceId": 699, "component": 12, "op": 1, "comment": "Review on the list's first entry: the op is on the slot's own component (clans_applicants:00), which clan_applicants_entry_init gives Review"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 699, "component": 40, "comment": "Accept: the applicant is a member at rank 0, third in the clan settings"},
  {"step": "assertMessage", "contains": "[clan.applicant_accepted name=Applicant]"},
  {"step": "clickWidget", "interfaceId": 699, "component": 33, "comment": "Back: the settings page"},
  {"step": "assertInterface", "interfaceId": 690},
  {"step": "clickWidget", "interfaceId": 690, "component": 20, "comment": "Members: the members page (clans_members)"},
  {"step": "assertInterface", "interfaceId": 693},
  {"step": "clickWidget", "interfaceId": 693, "component": 20, "slot": 7, "op": 1, "comment": "the second column's dropdown entry 7: Expel (enum_3793 entry 6)"},
  {"step": "waitTicks", "ticks": 1},
  {"step": "clickWidget", "interfaceId": 693, "component": 13, "slot": 0, "op": 1, "comment": "Expel on the owner, whose rank isn't below test's"},
  {"step": "assertMessage", "contains": "[clan.expel_too_high name=~test owner]"},
  {"step": "clickWidget", "interfaceId": 693, "component": 13, "slot": 2, "op": 1, "comment": "Expel on the applicant"},
  {"step": "assertDialogue", "contains": "[clan.expel_confirm name=Applicant]"},
  {"step": "chooseOption", "text": "[clan.confirm_no]"},
  {"step": "command", "text": "::clan", "expectMessage": "Applicant (rank 0)"},
  {"step": "clickWidget", "interfaceId": 693, "component": 13, "slot": 2, "op": 1, "comment": "Expel on the applicant again"},
  {"step": "assertDialogue", "contains": "[clan.expel_confirm name=Applicant]"},
  {"step": "chooseOption", "text": "[clan.confirm_yes]"},
  {"step": "assertMessage", "contains": "[clan.expelled_member name=Applicant]"},
  {"step": "clickWidget", "interfaceId": 693, "component": 25, "comment": "Back: the settings page"},
  {"step": "assertInterface", "interfaceId": 690},
  {"step": "clickWidget", "interfaceId": 690, "component": 3, "comment": "close the settings page, so no window is left open for the next script"},
  {"step": "assertInterface", "interfaceId": 690, "absent": true},
  {"step": "command", "text": "::clandisband Expel Gate", "expectMessage": "Clan Expel Gate deleted"},
  {"step": "runClientScript", "id": 915, "args": [3], "comment": "back to the inventory tab"}
 ]
}
