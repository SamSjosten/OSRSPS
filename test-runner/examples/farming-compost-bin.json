{
 "name": "Farming step 7: at the Falador compost bin, 15 weeds put in, the bin closed, rotted with ::farmtick 16, opened and emptied into 15 buckets of compost; then 15 watermelons made into supercompost, turned into ultracompost with 25 volcanic ash, a bucket taken and the rest dumped, read off farming_transmit_e (varbit 4775) (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario farming", "expectMessage": "Started scenario farming.", "comment": "::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::farmclock pause", "expectMessage": "Farming clock paused", "comment": "the bin rots only by ::farmtick"},
  {"step": "command", "text": "::tele 3056 3311 0", "expectMessage": "Teleported to 3056, 3311, 0", "comment": "south of the Falador compost bin (farming_compost_bin_1, 3056, 3312)"},
  {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied."},
  {"step": "command", "text": "::item 6055 15", "comment": "15 weeds"},
  {"step": "useItemOnLoc", "itemId": 6055, "locId": 7836, "x": 3056, "y": 3312, "comment": "the multiloc farming_compost_bin_1"},
  {"step": "assertVarbit", "id": 4775, "value": 15, "timeoutMs": 30000, "comment": "full of compostable items: Close"},
  {"step": "locOption", "locId": 7836, "option": "Close", "x": 3056, "y": 3312, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.bin_closed]", "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 4775, "value": 31, "timeoutMs": 5000, "comment": "rotting"},
  {"step": "command", "text": "::farmtick 16", "expectMessage": "Farming clock moved on 16 ticks", "comment": "two 40-minute ticks"},
  {"step": "assertVarbit", "id": 4775, "value": 94, "timeoutMs": 5000, "comment": "the compost is ready"},
  {"step": "locOption", "locId": 7836, "option": "Open", "x": 3056, "y": 3312, "timeoutMs": 20000},
  {"step": "assertVarbit", "id": 4775, "value": 30, "timeoutMs": 5000, "comment": "full of compost: Take"},
  {"step": "command", "text": "::item 1925 15", "comment": "15 empty buckets"},
  {"step": "locOption", "locId": 7836, "option": "Take", "x": 3056, "y": 3312, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.bin_emptied]", "timeoutMs": 60000},
  {"step": "assertVarbit", "id": 4775, "value": 0, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Compost", "count": 15, "timeoutMs": 5000},
  {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied."},
  {"step": "command", "text": "::item 5982 15", "comment": "15 watermelons"},
  {"step": "useItemOnLoc", "itemId": 5982, "locId": 7836, "x": 3056, "y": 3312},
  {"step": "assertVarbit", "id": 4775, "value": 47, "timeoutMs": 30000, "comment": "full of supercompostable items"},
  {"step": "locOption", "locId": 7836, "option": "Close", "x": 3056, "y": 3312, "timeoutMs": 20000},
  {"step": "assertVarbit", "id": 4775, "value": 95, "timeoutMs": 5000},
  {"step": "command", "text": "::farmtick 16", "expectMessage": "Farming clock moved on 16 ticks"},
  {"step": "assertVarbit", "id": 4775, "value": 126, "timeoutMs": 5000},
  {"step": "locOption", "locId": 7836, "option": "Open", "x": 3056, "y": 3312, "timeoutMs": 20000},
  {"step": "assertVarbit", "id": 4775, "value": 62, "timeoutMs": 5000},
  {"step": "command", "text": "::item 21622 25", "comment": "25 volcanic ash"},
  {"step": "useItemOnLoc", "itemId": 21622, "locId": 7836, "x": 3056, "y": 3312},
  {"step": "assertMessage", "contains": "[farming.bin_upgraded compost=ultracompost]", "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 4775, "value": 190, "timeoutMs": 5000, "comment": "full of ultracompost"},
  {"step": "command", "text": "::item 1925 1", "comment": "one empty bucket"},
  {"step": "useItemOnLoc", "itemId": 1925, "locId": 7836, "x": 3056, "y": 3312},
  {"step": "assertInventory", "item": "Ultracompost", "count": 1, "timeoutMs": 15000},
  {"step": "assertVarbit", "id": 4775, "value": 189, "timeoutMs": 5000},
  {"step": "locOption", "locId": 7836, "option": "Dump", "x": 3056, "y": 3312, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.bin_dumped]", "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 4775, "value": 0, "timeoutMs": 5000},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
