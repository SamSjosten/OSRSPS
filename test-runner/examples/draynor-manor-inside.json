  {
   "step": "locOption",
   "loc": "Door",
   "option": "Open",
   "x": 3123,
   "y": 3361
  },
  {
   "step": "assertLocation",
   "x": 3123,
   "y": 3361,
   "plane": 0,
   "comment": "out through the back door"
  },
  {
   "step": "waitTicks",
   "ticks": 5,
   "comment": "the door shuts again"
  },
  {
   "step": "locOption",
   "loc": "Door",
   "option": "Open",
   "x": 3123,
   "y": 3361
  },
  {
   "step": "assertMessage",
   "contains": "[draynor_manor.back_door_locked]",
   "timeoutMs": 10000
  },
  {
   "step": "command",
   "text": "::god off",
   "expectMessage": "You can be hurt again."
  },
  {
   "step": "command",
   "text": "::keys off",
   "expectMessage": "Dialogue shows words"
  },
  {
   "step": "command",
   "text": "::reset",
   "expectMessage": "Back to how you were"
  }
 ]
}
