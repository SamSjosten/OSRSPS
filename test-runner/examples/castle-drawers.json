{
 "name": "Lumbridge Castle: the Duke's floor drawers open, have nothing in them, and shut",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::tele 3213 3215 1",
   "expectMessage": "Teleported to 3213, 3215, 1",
   "comment": "south of the drawers: since 242 the red bed covers 3212, 3215 and 3212, 3216"
  },
  {
   "step": "assertLocation",
   "x": 3213,
   "y": 3215,
   "plane": 1
  },
  {
   "step": "locOption",
   "loc": "Drawers",
   "option": "Open",
   "x": 3213,
   "y": 3216
  },
  {
   "step": "locOption",
   "loc": "Drawers",
   "option": "Search",
   "x": 3213,
   "y": 3216,
   "comment": "only there once the drawers have opened"
  },
  {
   "step": "assertMessage",
   "contains": "[search.drawers_empty]"
  },
  {
   "step": "locOption",
   "loc": "Drawers",
   "option": "Shut",
   "x": 3213,
   "y": 3216
  },
  {
   "step": "assertLoc",
   "loc": "Drawers",
   "option": "Open",
   "x": 3213,
   "y": 3216,
   "comment": "shut again"
  }
 ]
}
