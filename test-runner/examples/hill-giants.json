{
 "name": "Edgeville piece step 11: the hill giants. The brass key taken, the shed's door locked and then unlocked, the ladder down, a hill giant killed for its big bones, Obor's gate refusing, and back up (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now", "comment": "the hill giants are aggressive"},
  {"step": "command", "text": "::setlevel attack 99", "expectMessage": "Attack set to level 99"},
  {"step": "command", "text": "::setlevel strength 99", "expectMessage": "Strength set to level 99"},
  {"step": "command", "text": "::tele 3131 9863 0", "expectMessage": "Teleported to 3131, 9863, 0", "comment": "the small room north of the hill giants"},
  {"step": "assertGroundItem", "item": "Brass key", "timeoutMs": 10000},
  {"step": "takeItem", "item": "Brass key"},
  {"step": "assertInventory", "item": "Brass key", "timeoutMs": 15000},
  {"step": "command", "text": "::tele 3115 3449 0", "expectMessage": "Teleported to 3115, 3449, 0", "comment": "outside the shed west of the Cooks' Guild"},
  {"step": "locOption", "locId": 1804, "option": "Open", "x": 3115, "y": 3450},
  {"step": "assertMessage", "contains": "edgeville_dungeon.door_locked", "timeoutMs": 10000},
  {"step": "useItemOnLoc", "item": "Brass key", "locId": 1804, "x": 3115, "y": 3450},
  {"step": "assertMessage", "contains": "edgeville_dungeon.door_unlock", "timeoutMs": 10000},
  {"step": "assertLocation", "x": 3115, "y": 3450, "plane": 0, "timeoutMs": 10000, "comment": "inside the shed"},
  {"step": "command", "text": "::tele 3116 3451 0", "expectMessage": "Teleported to 3116, 3451, 0", "comment": "south of the shed's ladder"},
  {"step": "locOption", "locId": 17384, "option": "Climb-down", "x": 3116, "y": 3452},
  {"step": "assertLocation", "x": 3116, "y": 9851, "plane": 0, "timeoutMs": 10000, "comment": "the dungeon's 6400 below where the player stood"},
  {"step": "npcOption", "npc": "Hill Giant", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertHitsplat", "npc": "Hill Giant", "timeoutMs": 20000},
  {"step": "assertGroundItem", "item": "Big bones", "timeoutMs": 90000, "comment": "a hill giant always drops big bones"},
  {"step": "command", "text": "::tele 3096 9832 0", "expectMessage": "Teleported to 3096, 9832, 0", "comment": "east of the gate to Obor's lair"},
  {"step": "locOption", "locId": 29487, "option": "Open", "x": 3095, "y": 9832},
  {"step": "assertMessage", "contains": "edgeville_dungeon.obor_closed", "timeoutMs": 10000},
  {"step": "command", "text": "::tele 3116 9851 0", "expectMessage": "Teleported to 3116, 9851, 0", "comment": "south of the ladder"},
  {"step": "locOption", "locId": 17385, "option": "Climb-up", "x": 3116, "y": 9852},
  {"step": "assertLocation", "x": 3116, "y": 3451, "plane": 0, "timeoutMs": 10000, "comment": "back in the shed"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
