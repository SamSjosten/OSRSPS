{
 "name": "Dragon warhammer Smash: the spec orb lit, a giant frog spawned east of the castle and put on 100 hitpoints hit for half the energy, its Defence drained 30% (6 to 5) read off ::npcs, the warhammer's animation and graphic, then the bar refused at 0%",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "full special attack energy, nothing worn; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys", "comment": "game messages show their keys, whatever data/dialogue.txt holds"},
  {"step": "assertVarp", "id": 300, "value": 1000, "comment": "sa_energy, full"},
  {"step": "command", "text": "::setlevel strength 60", "expectMessage": "60", "comment": "the warhammer needs 60 Strength (item-requirements.tsv)"},
  {"step": "command", "text": "::item dragon_warhammer", "expectMessage": "Added 1 x Dragon warhammer"},
  {"step": "itemOption", "item": "Dragon warhammer", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "itemId": 13576},
  {"step": "command", "text": "::god", "expectMessage": "You can't be hurt now"},
  {"step": "command", "text": "::sure max", "expectMessage": "Your attacks can't miss and your melee hits deal their max now", "comment": "a miss drains nothing, and nor does a hit of 0, so every hit deals its max"},
  {"step": "command", "text": "::tele 3236 3220 0", "expectMessage": "Teleported to 3236, 3220, 0", "comment": "the grass east of the castle, away from the courtyard's men"},
  {"step": "command", "text": "::npc giant_frog_nodrops", "expectMessage": "Spawned Giant frog", "comment": "level 13, Defence 6 (OSRS Wiki, Giant frog); put in with ::npc, it stays dead once killed"},
  {"step": "command", "text": "::npchp 100 mine", "expectMessage": "1 NPC now on 100 hitpoints", "comment": "Smash's max of 24 would kill its 23; this way it lives to be read"},
  {"step": "clickWidget", "interfaceId": 160, "component": 36, "op": 1, "comment": "orbs:specbutton"},
  {"step": "assertVarp", "id": 301, "value": 1, "timeoutMs": 5000, "comment": "sa_attack, the bar lit"},
  {"step": "npcOption", "npc": "Giant frog", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertAnimation", "id": 1378, "timeoutMs": 20000, "comment": "dragon_warhammer_sa_player"},
  {"step": "assertSpotanim", "id": 1292, "timeoutMs": 5000, "comment": "dragon_warhammer_sa_spotanim on the player"},
  {"step": "waitTicks", "ticks": 2, "comment": "the hit, and its drain, land a tick after the swing's animation"},
  {"step": "command", "text": "::npcs 5", "expectMessage": "; drained defence 5/6, a level back in ", "comment": "30% of 6, rounded down: 1"},
  {"step": "assertVarp", "id": 300, "value": 500, "timeoutMs": 5000, "comment": "half the energy taken"},
  {"step": "assertVarp", "id": 301, "value": 0, "comment": "and the bar out"},
  {"step": "command", "text": "::spec 0", "expectMessage": "Special attack energy 0%, 10% back in "},
  {"step": "clickWidget", "interfaceId": 593, "component": 41, "op": 1, "comment": "combat_interface:special_attack, the combat tab's bar"},
  {"step": "assertMessage", "contains": "[combat.spec_not_enough]", "timeoutMs": 5000},
  {"step": "assertVarp", "id": 301, "value": 0},
  {"step": "command", "text": "::god", "expectMessage": "You can be hurt again"},
  {"step": "command", "text": "::sure", "expectMessage": "Your attacks can miss again"},
  {"step": "command", "text": "::delnpc mine", "expectMessage": "you put in."},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
