{
 "name": "Misthalin piece 7 step 1: the rest of Lumbridge Swamp: through the shed and its tools, the Water Altar's ruins refusing a talisman, the raft both ways (Grapple, then Jump-to), the stepping stone to the desert and back, and one coal in the west mine (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats and an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},

  {"step": "command", "text": "::tele 3200 3169 0", "comment": "west of the swamp shed's door"},
  {"step": "assertLocation", "x": 3200, "y": 3169, "plane": 0},
  {"step": "locOption", "locId": 2406, "option": "Open", "x": 3202, "y": 3169},
  {"step": "assertLocation", "x": 3202, "y": 3169, "plane": 0, "timeoutMs": 10000, "comment": "through the door, into the shed"},
  {"step": "locOption", "locId": 10375, "option": "Take", "x": 3203, "y": 3170},
  {"step": "chooseOption", "text": "[lumbridge_swamp.tools_spade]", "comment": "neither held: a choice of the two"},
  {"step": "assertInventory", "item": "Spade", "count": 1, "timeoutMs": 10000},
  {"step": "locOption", "locId": 10375, "option": "Take", "x": 3203, "y": 3170},
  {"step": "assertInventory", "item": "Rake", "count": 1, "timeoutMs": 10000, "comment": "a spade held: the rake, with no choice"},
  {"step": "assertLoc", "locId": 2406, "x": 3202, "y": 3169, "timeoutMs": 10000, "comment": "the door shut again behind the player"},
  {"step": "locOption", "locId": 2406, "option": "Open", "x": 3202, "y": 3169},
  {"step": "assertLocation", "x": 3201, "y": 3169, "plane": 0, "timeoutMs": 10000, "comment": "and out again"},

  {"step": "command", "text": "::item 1444", "expectMessage": "Added 1 x Water talisman"},
  {"step": "command", "text": "::tele 3184 3161 0", "comment": "south of the Water Altar's ruins"},
  {"step": "assertLocation", "x": 3184, "y": 3161, "plane": 0},
  {"step": "useItemOnLoc", "item": "Water talisman", "locId": 34815, "x": 3184, "y": 3164},
  {"step": "assertMessage", "contains": "[lumbridge_swamp.runecraft_closed]", "timeoutMs": 10000, "comment": "Runecraft isn't built"},

  {"step": "command", "text": "::setlevel agility 66", "expectMessage": "66", "comment": "the desert stone's level; the raft's Grapple wants 8, its Jump-to 48"},
  {"step": "command", "text": "::setlevel strength 19", "expectMessage": "19"},
  {"step": "command", "text": "::setlevel ranged 37", "expectMessage": "37"},
  {"step": "command", "text": "::item 837", "expectMessage": "Added 1 x Crossbow"},
  {"step": "itemOption", "item": "Crossbow", "option": "Wield"},
  {"step": "command", "text": "::item 9419", "expectMessage": "Added 1 x Mith grapple"},
  {"step": "itemOption", "item": "Mith grapple", "option": "Wield"},
  {"step": "assertEquipment", "slot": "ammo", "item": "Mith grapple"},
  {"step": "command", "text": "::tele 3246 3179 0", "comment": "the River Lum's west bank, at the raft's shortcut icon"},
  {"step": "assertLocation", "x": 3246, "y": 3179, "plane": 0},
  {"step": "locOption", "locId": 17068, "option": "Grapple", "x": 3252, "y": 3179},
  {"step": "assertLocation", "x": 3259, "y": 3179, "plane": 0, "timeoutMs": 20000, "comment": "across to the east bank; the timing and animations are guessed"},
  {"step": "waitTicks", "ticks": 2, "comment": "synced: a click while the crossing's script runs is dropped"},
  {"step": "locOption", "locId": 17070, "option": "Jump-to", "x": 3253, "y": 3180},
  {"step": "assertLocation", "x": 3246, "y": 3179, "plane": 0, "timeoutMs": 20000, "comment": "back by jumping, no grapple needed at 48 Agility"},
  {"step": "waitTicks", "ticks": 2},

  {"step": "command", "text": "::tele 3214 3140 0", "comment": "the swamp's south bank, north of the stepping stone"},
  {"step": "assertLocation", "x": 3214, "y": 3140, "plane": 0},
  {"step": "locOption", "locId": 16513, "option": "Jump-to", "x": 3214, "y": 3135},
  {"step": "assertLocation", "x": 3214, "y": 3131, "plane": 0, "timeoutMs": 20000, "comment": "on the desert side; both bank tiles are inferred from the map"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "locOption", "locId": 16513, "option": "Jump-to", "x": 3214, "y": 3135},
  {"step": "assertLocation", "x": 3214, "y": 3140, "plane": 0, "timeoutMs": 20000, "comment": "and back into the swamp"},
  {"step": "waitTicks", "ticks": 2},

  {"step": "command", "text": "::setlevel mining 30", "expectMessage": "30"},
  {"step": "command", "text": "::item bronze_pickaxe", "expectMessage": "Added 1 x Bronze pickaxe"},
  {"step": "command", "text": "::tele 3145 3150 0", "comment": "the west swamp mine, among its coal"},
  {"step": "assertLocation", "x": 3145, "y": 3150, "plane": 0},
  {"step": "locOption", "locId": 11367, "option": "Mine", "x": 3144, "y": 3150},
  {"step": "assertInventory", "item": "Coal", "count": 1, "timeoutMs": 120000, "comment": "the west mine works with no swamp code: Mining knows the rock by its type"},

  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
