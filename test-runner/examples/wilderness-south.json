{
  "name": "Wilderness step W2.2: a mammoth fought south-east of Ferox Enclave (level 10), iron mined at the South Wilderness mine (level 7) and coal at the South-west mine (level 10) (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "99 Mining and a rune pickaxe; ::reset at the end puts the account back"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "mammoths, skeletons and thugs are aggressive"},

    {"step": "command", "text": "::tele 3160 3591 0", "expectMessage": "Teleported to 3160, 3591, 0", "comment": "beside the mammoth at 3159, 3593"},
    {"step": "npcOption", "npc": "Mammoth", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Mammoth", "timeoutMs": 20000},

    {"step": "command", "text": "::tele 3103 3570 0", "expectMessage": "Teleported to 3103, 3570, 0", "comment": "west of ironrock1 at 3104, 3570"},
    {"step": "locOption", "locId": 11364, "option": "Mine", "x": 3104, "y": 3570},
    {"step": "assertInventory", "item": "Iron ore", "count": 1, "timeoutMs": 60000},
    {"step": "assertMessage", "contains": "mining.get_ore ore=iron"},

    {"step": "command", "text": "::tele 3015 3592 0", "expectMessage": "Teleported to 3015, 3592, 0", "comment": "west of coalrock1 at 3016, 3592"},
    {"step": "locOption", "locId": 11366, "option": "Mine", "x": 3016, "y": 3592},
    {"step": "assertInventory", "item": "Coal", "count": 1, "timeoutMs": 60000},
    {"step": "assertMessage", "contains": "mining.get_ore ore=coal"},

    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."},
    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
