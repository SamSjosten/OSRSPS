{
 "name": "Equipment (task 15): Wield, the combat tab, the stats screen, two-handed and shield, a level requirement, a relog, Remove",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "assertEquipment", "slot": "weapon", "empty": true},
  {"step": "assertEquipment", "slot": "shield", "empty": true},
  {"step": "command", "text": "::item bronze axe", "expectMessage": "Added 1 x Bronze axe"},
  {"step": "itemOption", "item": "Bronze axe", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Bronze axe", "comment": "in the worn inventory and in the player's hand on the model"},
  {"step": "assertInventory", "item": "Bronze axe", "count": 0},
  {"step": "assertWidgetText", "interfaceId": 593, "component": 5, "contains": "Axe", "comment": "combat_interface:category, from varbit 357 by the client's own script"},
  {"step": "assertWidgetText", "interfaceId": 593, "contains": "Chop", "comment": "an axe's first style button"},
  {"step": "assertPose", "idle": 808, "comment": "human_ready: an axe keeps the plain stance"},
  {"step": "clickWidget", "interfaceId": 387, "component": 1, "comment": "View equipment stats"},
  {"step": "assertWidgetText", "interfaceId": 84, "component": 25, "contains": "Slash: +4"},
  {"step": "assertWidgetText", "interfaceId": 84, "component": 36, "contains": "Melee strength: +5"},
  {"step": "assertWidgetText", "interfaceId": 84, "component": 52, "contains": "Base: 3.0s", "comment": "equipment:attackspeedbase, 52 since cache 241.4"},
  {"step": "command", "text": "::item wooden shield", "expectMessage": "Added 1 x Wooden shield"},
  {"step": "clickWidget", "interfaceId": 85, "component": 0, "slot": 0, "op": 1, "comment": "Equip on the stats screen's own inventory, where the shield is the only item"},
  {"step": "assertEquipment", "slot": "shield", "item": "Wooden shield"},
  {"step": "assertWidgetText", "interfaceId": 84, "component": 25, "contains": "Slash: +4", "comment": "the stats screen is still open"},
  {"step": "command", "text": "::item bronze 2h sword", "expectMessage": "Added 1 x Bronze 2h sword"},
  {"step": "itemOption", "item": "Bronze 2h sword", "option": "Wield", "comment": "clicking an item also closes the stats screen"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Bronze 2h sword"},
  {"step": "assertEquipment", "slot": "shield", "empty": true, "comment": "a two-handed weapon takes the shield off"},
  {"step": "assertInventory", "item": "Wooden shield", "count": 1},
  {"step": "assertInventory", "item": "Bronze axe", "count": 1},
  {"step": "assertPose", "idle": 2561, "comment": "human_dh_weapon_ready; which weapon gets which stance is guessed (Weapons.kt)"},
  {"step": "command", "text": "::item abyssal whip", "expectMessage": "Added 1 x Abyssal whip"},
  {"step": "itemOption", "item": "Abyssal whip", "option": "Wield"},
  {"step": "assertMessage", "contains": "You are not a high enough level to use this item."},
  {"step": "assertEquipment", "slot": "weapon", "item": "Bronze 2h sword"},
  {"step": "command", "text": "::setlevel attack 70", "expectMessage": "set to level 70"},
  {"step": "itemOption", "item": "Abyssal whip", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Abyssal whip"},
  {"step": "logout", "comment": "auto login logs back in a few seconds later"},
  {"step": "waitForLogin"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Abyssal whip", "comment": "still worn after the relog"},
  {"step": "wornOption", "slot": "weapon", "option": "Remove"},
  {"step": "assertEquipment", "slot": "weapon", "empty": true},
  {"step": "assertInventory", "item": "Abyssal whip", "count": 1},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
