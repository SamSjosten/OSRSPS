{
  "name": "Karamja step K4.2b: ::tbwevent making a hack's next roll the gout tuber (dug with a spade), a gem rock (mined three times) and a jungle spider (killed under ::god for its carcass) (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "any scenario: ::reset at the end puts the account's backpack and levels back"},
    {"step": "command", "text": "::empty"},
    {"step": "command", "text": "::varp tbw_cleanup 31", "comment": "met Murcaily, hacked, repaired and had his first sticks"},
    {"step": "command", "text": "::setlevel woodcutting 99"},
    {"step": "command", "text": "::setlevel mining 99"},
    {"step": "command", "text": "::item 975 1", "comment": "a machete"},
    {"step": "command", "text": "::item 952 1", "comment": "a spade"},
    {"step": "command", "text": "::item 1275 1", "comment": "a rune pickaxe"},
    {"step": "command", "text": "::tele 2770 3060 0", "expectMessage": "Teleported to 2770, 3060, 0", "comment": "south of the light jungle at 2770,3061"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "command", "text": "::resetlocs 5", "comment": "the jungle whole again, whatever an earlier run left (the three light jungles at 2770,3061, 2771,3062 and 2774,3058 on the 242 map)"},
    {"step": "command", "text": "::tbwevent tuber", "expectMessage": "Your next Tai Bwo Wannai jungle event: tuber"},
    {"step": "locOption", "locId": 9010, "option": "Hack", "x": 2770, "y": 3061},
    {"step": "assertMessage", "contains": "tbw_event.tuber", "timeoutMs": 15000},
    {"step": "waitTicks", "ticks": 2},
    {"step": "useItemOnLoc", "item": "Spade", "locId": 9033, "x": 2770, "y": 3061},
    {"step": "assertInventory", "item": "Gout tuber", "count": 1, "timeoutMs": 10000},
    {"step": "command", "text": "::tele 2771 3063 0", "expectMessage": "Teleported to 2771, 3063, 0", "comment": "north of the light jungle at 2771,3062"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "command", "text": "::tbwevent gems", "expectMessage": "Your next Tai Bwo Wannai jungle event: gems"},
    {"step": "locOption", "locId": 9010, "option": "Hack", "x": 2771, "y": 3062},
    {"step": "assertMessage", "contains": "tbw_event.gems", "timeoutMs": 15000},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 9030, "option": "Mine", "x": 2771, "y": 3062},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 9031, "option": "Mine", "x": 2771, "y": 3062, "timeoutMs": 30000},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 9032, "option": "Mine", "x": 2771, "y": 3062, "timeoutMs": 30000},
    {"step": "assertLoc", "locId": 9014, "x": 2771, "y": 3062, "timeoutMs": 30000, "comment": "the third gem: the rock goes and the jungle shows chopped away (light jungle's chopped loc)"},
    {"step": "command", "text": "::god on"},
    {"step": "command", "text": "::tele 2774 3059 0", "expectMessage": "Teleported to 2774, 3059, 0", "comment": "north of the light jungle at 2774,3058"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "command", "text": "::tbwevent spider", "expectMessage": "Your next Tai Bwo Wannai jungle event: spider"},
    {"step": "locOption", "locId": 9010, "option": "Hack", "x": 2774, "y": 3058},
    {"step": "assertMessage", "contains": "tbw_event.monster", "timeoutMs": 15000},
    {"step": "command", "text": "::kill Jungle spider", "expectMessage": "Killed Jungle spider"},
    {"step": "assertGroundItem", "item": "Spider carcass", "timeoutMs": 10000},
    {"step": "command", "text": "::god off"},

    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
