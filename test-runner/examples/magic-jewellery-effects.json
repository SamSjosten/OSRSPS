{
 "name": "Magic utility step U6a: the jewellery that saves its wearer, hit with ::hit n me at 10 Hitpoints. A phoenix necklace heals 3 when a hit leaves 2; a necklace of faith restores 10 of 40 Prayer when a hit leaves 1; a ring of life takes its wearer back to Lumbridge when a hit leaves 1 (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats (10 Hitpoints), nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::item 11090", "expectMessage": "Added 1 x Phoenix necklace"},
  {"step": "itemOption", "item": "Phoenix necklace", "option": "Wear"},
  {"step": "assertEquipment", "slot": "neck", "item": "Phoenix necklace", "timeoutMs": 5000},
  {"step": "command", "text": "::hit 8 me", "expectMessage": "Hit yourself for 8: 5/10 hp", "comment": "2 left, healed by 3 before the reply"},
  {"step": "assertMessage", "contains": "[jewellery_effect.phoenix]", "timeoutMs": 5000},
  {"step": "assertEquipment", "slot": "neck", "empty": true, "timeoutMs": 5000},
  {"step": "command", "text": "::heal", "expectMessage": "Healed to 10 hitpoints."},
  {"step": "command", "text": "::setlevel prayer 40", "expectMessage": "Prayer set to level 40"},
  {"step": "command", "text": "::boost prayer 5", "expectMessage": "Prayer is now 5/40"},
  {"step": "command", "text": "::item 21157", "expectMessage": "Added 1 x Necklace of faith"},
  {"step": "itemOption", "item": "Necklace of faith", "option": "Wear"},
  {"step": "assertEquipment", "slot": "neck", "item": "Necklace of faith", "timeoutMs": 5000},
  {"step": "command", "text": "::hit 9 me", "expectMessage": "Hit yourself for 9: 1/10 hp"},
  {"step": "assertMessage", "contains": "[jewellery_effect.faith]", "timeoutMs": 5000},
  {"step": "assertEquipment", "slot": "neck", "empty": true, "timeoutMs": 5000},
  {"step": "command", "text": "::heal", "expectMessage": "Healed to 10 hitpoints."},
  {"step": "command", "text": "::tele 3235 3235", "expectMessage": "Teleported to 3235, 3235"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "command", "text": "::item 2570", "expectMessage": "Added 1 x Ring of life"},
  {"step": "itemOption", "item": "Ring of life", "option": "Wear"},
  {"step": "assertEquipment", "slot": "ring", "item": "Ring of life", "timeoutMs": 5000},
  {"step": "command", "text": "::hit 9 me", "expectMessage": "Hit yourself for 9: 1/10 hp"},
  {"step": "assertMessage", "contains": "[jewellery_effect.ring_of_life]", "timeoutMs": 5000},
  {"step": "assertEquipment", "slot": "ring", "empty": true, "timeoutMs": 5000},
  {"step": "waitTicks", "ticks": 3, "comment": "lands within 2 of 3221, 3219, so no exact tile to assert"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
