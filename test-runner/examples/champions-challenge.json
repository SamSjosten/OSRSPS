{
 "name": "Post-quest step 9: the Champions' Challenge. Larxus with a giant champion scroll held, the duel arranged, the Champion Statue opened and climbed down, the giant champion killed (its bit of varp 617 set), the portcullis and ladder back up, and the Chest of Champions' lamp rubbed (::keys on). The runner has no use-item-on-NPC step, so ::varp arranges the duel as the scroll would (HeadlessChampionsChallengeTest uses the scroll on him)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::empty", "comment": "room for the scroll and the lamp"},
  {"step": "command", "text": "::varp 617 0", "expectMessage": "-> 0", "comment": "champions_defeated: no champion beaten, no lamp claimed"},
  {"step": "command", "text": "::varp champions_challenge 0", "comment": "no duel arranged"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now"},
  {"step": "command", "text": "::tele 3186 9758 0", "expectMessage": "Teleported to 3186, 9758, 0", "comment": "the Champions' Guild's basement, by Larxus and the statue"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "locId": 10556, "option": "Open", "x": 3184, "y": 9758, "comment": "no duel arranged yet"},
  {"step": "assertDialogue", "contains": "[larxus.arrange_first]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "command", "text": "::item 6800 1", "expectMessage": "Giant champion scroll"},
  {"step": "npcOption", "npc": "Larxus", "option": "Talk-to", "timeoutMs": 10000},
  {"step": "assertDialogue", "contains": "[larxus.greeting]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[larxus.challenge]", "comment": "offered with a scroll held"},
  {"step": "assertDialogue", "contains": "[larxus.challenge]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[larxus.hand_it]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "command", "text": "::varp champions_challenge 3", "comment": "the giant's duel arranged, as the scroll used on Larxus and his yes do"},
  {"step": "locOption", "locId": 10556, "option": "Open", "x": 3184, "y": 9758},
  {"step": "assertLoc", "locId": 10557, "x": 3184, "y": 9758, "timeoutMs": 10000, "comment": "the statue open"},
  {"step": "locOption", "locId": 10557, "option": "Climb-down", "x": 3184, "y": 9758},
  {"step": "assertLocation", "x": 3178, "y": 9758, "plane": 0, "timeoutMs": 15000, "comment": "the arena (guessed tile)"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "command", "text": "::kill Giant Champion", "expectMessage": "Killed Giant Champion"},
  {"step": "assertVarp", "id": 617, "value": 4, "timeoutMs": 10000, "comment": "the giant's bit (2): its banner shows and the chest opens"},
  {"step": "locOption", "locId": 10553, "option": "Open", "x": 3181, "y": 9758, "comment": "the portcullis out of the arena"},
  {"step": "assertLocation", "x": 3182, "y": 9758, "plane": 0, "timeoutMs": 15000},
  {"step": "locOption", "locId": 10554, "option": "Climb-up", "x": 3183, "y": 9758},
  {"step": "assertLocation", "x": 3185, "y": 9758, "plane": 0, "timeoutMs": 15000, "comment": "beside the statue (guessed tile)"},
  {"step": "command", "text": "::tele 3168 9775 0", "expectMessage": "Teleported to 3168, 9775, 0", "comment": "south of the Chest of Champions"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "locOption", "locId": 31944, "option": "Search", "x": 3168, "y": 9776, "comment": "the map's multiloc 31945, open with a champion beaten"},
  {"step": "assertDialogue", "contains": "[champions_chest.reward_giant]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "item": "Champion's lamp", "count": 1, "timeoutMs": 5000},
  {"step": "itemOption", "item": "Champion's lamp", "option": "Rub"},
  {"step": "assertDialogue", "contains": "[champions_chest.lamp_giant", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[champions_chest.proceed]"},
  {"step": "assertDialogue", "contains": "[champions_chest.gained", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "item": "Champion's lamp", "count": 0, "timeoutMs": 5000},
  {"step": "assertVarp", "id": 617, "value": 262148, "timeoutMs": 5000, "comment": "the giant's lamp claimed: bit 18 beside bit 2"},
  {"step": "command", "text": "::varp 617 0", "expectMessage": "-> 0", "comment": "put the account back"},
  {"step": "command", "text": "::god off"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"}
 ]
}
