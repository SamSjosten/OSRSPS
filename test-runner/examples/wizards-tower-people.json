{
  "name": "Draynor piece step 15b: the Wizards' Tower's people: Professor Onglewip's talk, Wizard Traiborn's wizard branch, Wizard Grayzag's lines, and Wizard Mizgog turning away a player without the beads, then trading the four beads for an amulet of accuracy",
  "account": "test",
  "steps": [
    {
      "step": "waitForLogin"
    },
    {
      "step": "command",
      "text": "::scenario lumbridge-bare",
      "expectMessage": "Started scenario lumbridge-bare.",
      "comment": "::reset at the end puts the account back"
    },
    {
      "step": "command",
      "text": "::keys on",
      "expectMessage": "Dialogue shows keys",
      "comment": "boxes show their keys, whatever data/dialogue.txt holds"
    },
    {
      "step": "command",
      "text": "::tele 3115 3161 0",
      "expectMessage": "Teleported to 3115, 3161, 0",
      "comment": "the ground floor, beside Professor Onglewip"
    },
    {
      "step": "npcOption",
      "npc": "Professor Onglewip",
      "option": "Talk-to",
      "timeoutMs": 20000
    },
    {
      "step": "assertDialogue",
      "contains": "[onglewip.live_here]",
      "timeoutMs": 20000
    },
    {
      "step": "continueDialogue"
    },
    {
      "step": "assertDialogue",
      "contains": "[onglewip.stronghold]",
      "timeoutMs": 20000
    },
    {
      "step": "continueDialogue"
    },
    {
      "step": "assertDialogue",
      "contains": "[onglewip.where]",
      "timeoutMs": 20000
    },
    {
      "step": "continueDialogue"
    },
    {
      "step": "assertDialogue",
