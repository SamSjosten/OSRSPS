{
 "name": "Farming step 6: at the Lumbridge hops patch, four hammerstone seeds planted with a dibber, watered, grown and harvested with a spade to the last hop, then three jute seeds planted; at the Champions' Guild bush patch, a redberry bush grown, checked, its berries picked, one grown back and picked, the bare bush cleared, then another made ill with ::farmdisease, pruned, grown, checked and dug up with Clear while it has berries, read off farming_transmit_a (varbit 4771) (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario farming", "expectMessage": "Started scenario farming.", "comment": "99 Farming and every patch overgrown; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::farmdisease off", "expectMessage": "Farming diseases off", "comment": "nothing falls ill on its own through ::farmtick; ::farmdisease makes the bush ill below"},
  {"step": "command", "text": "::farmclock pause", "expectMessage": "Farming clock paused", "comment": "the crops grow only by ::farmtick"},
  {"step": "command", "text": "::tele 3228 3312 0", "expectMessage": "Teleported to 3228, 3312, 0", "comment": "south of the Lumbridge hops patch (farming_hops_patch_3, 3227-3231, 3313-3317)"},
  {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied.", "comment": "room for the hops"},
  {"step": "command", "text": "::item 5341 1", "comment": "a rake"},
  {"step": "command", "text": "::item 952 1", "comment": "a spade"},
  {"step": "command", "text": "::item 5343 1", "comment": "a seed dibber"},
  {"step": "command", "text": "::item 5340 1", "comment": "a full watering can"},
  {"step": "command", "text": "::item 5307 4", "comment": "four hammerstone seeds"},
  {"step": "command", "text": "::item 5306 3", "comment": "three jute seeds"},
