  {"step": "assertVarbit", "id": 4771, "value": 6, "timeoutMs": 5000, "comment": "well again"},
  {"step": "assertInventory", "item": "Leaves", "timeoutMs": 5000},
  {"step": "command", "text": "::farmtick 20", "expectMessage": "Farming clock moved on 20 ticks"},
  {"step": "assertVarbit", "id": 4771, "value": 250, "timeoutMs": 5000},
  {"step": "locOption", "locId": 7577, "option": "Check-health", "x": 3181, "y": 3357, "timeoutMs": 20000},
  {"step": "assertVarbit", "id": 4771, "value": 14, "timeoutMs": 5000},
  {"step": "locOption", "locId": 7577, "option": "Clear", "x": 3181, "y": 3357, "timeoutMs": 20000, "comment": "op5 on the bush with its four berries"},
