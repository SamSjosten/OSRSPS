{
  "name": "Karamja step K2.2: TzHaar-Hur-Tel's Trade and a Toktz-xil-ul bought for 375 Tokkul and sold back, TzHaar-Hur-Lek's talk into his Ore and Gem Store, and TzHaar-Mej-Roh's talk naming the player and telling the castes, and a Tzhaar air rune pack opened into 100 air runes (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts it back"},
    {"step": "command", "text": "::item 6529 1000", "comment": "1,000 Tokkul"},
    {"step": "command", "text": "::tele 2477 5146 0", "expectMessage": "Teleported to 2477, 5146, 0", "comment": "beside TzHaar-Hur-Tel's spawn tile"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "TzHaar-Hur-Tel", "option": "Trade", "timeoutMs": 20000},
    {"step": "assertInterface", "interfaceId": 300},
    {"step": "waitTicks", "ticks": 2, "comment": "lets the client draw the stock before clicking a slot"},
    {"step": "clickWidget", "interfaceId": 300, "component": 16, "slot": 1, "op": 2, "comment": "Buy 1 Toktz-xil-ul, 150% of 250"},
    {"step": "assertInventory", "item": "Toktz-xil-ul", "count": 1},
    {"step": "assertInventory", "item": "Tokkul", "count": 625},
    {"step": "waitTicks", "ticks": 1, "comment": "the runner reads the slot's item from the client's widgets, which redraw a tick after the inventory changes"},
    {"step": "clickWidget", "interfaceId": 301, "component": 0, "slot": 1, "op": 2, "comment": "Sell 1 back (slot 1, after the Tokkul)"},
    {"step": "assertInventory", "item": "Toktz-xil-ul", "count": 0},

    {"step": "command", "text": "::tele 2465 5148 0", "expectMessage": "Teleported to 2465, 5148, 0", "comment": "by TzHaar-Hur-Lek (the teleport closes the open shop)"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "TzHaar-Hur-Lek", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[tzhaar_shop.greeting name=JalYt-", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[tzhaar_shop.trade]"},
    {"step": "assertInterface", "interfaceId": 300, "timeoutMs": 10000, "comment": "the talk ends in the Ore and Gem Store"},

    {"step": "command", "text": "::tele 2462 5127 0", "expectMessage": "Teleported to 2462, 5127, 0", "comment": "by TzHaar-Mej-Roh"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "TzHaar-Mej-Roh", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[tzhaar_shop.greeting name=JalYt-", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[tzhaar_shop.what_call]"},
    {"step": "assertDialogue", "contains": "[tzhaar_shop.are_you_not name=JalYt-", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[tzhaar_shop.whats_caste caste=JalYt-"},
    {"step": "continueDialogue"},
    {"step": "continueDialogue", "comment": "the caste's line"},
    {"step": "assertDialogue", "contains": "[tzhaar_shop.suppose]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[tzhaar_shop.then_you caste=JalYt-"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[tzhaar_shop.what_are_you]"},
    {"step": "continueDialogue", "comment": "the player: what are you then?"},
    {"step": "assertDialogue", "contains": "[tzhaar_shop.i_am_mej]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[tzhaar_shop.other_types]"},
    {"step": "continueDialogue", "comment": "the player asks"},
    {"step": "assertDialogue", "contains": "[tzhaar_shop.castes_mej]"},
    {"step": "continueDialogue"},
    {"step": "command", "text": "::item 21698 1", "comment": "a Tzhaar air rune pack, as TzHaar-Mej-Roh sells"},
    {"step": "itemOption", "item": "Tzhaar air rune pack", "option": "Open"},
    {"step": "assertInventory", "item": "Air rune", "count": 100},
    {"step": "assertInventory", "item": "Tzhaar air rune pack", "count": 0},
    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
