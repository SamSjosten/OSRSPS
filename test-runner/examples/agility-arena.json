{
  "name": "Karamja step K3.4: Cap'n Izzy No-Beard's talk taking the Brimhaven Agility Arena's 200-coin fee, the ladder down, a tag of a dispenser, and the ladder back up (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "any scenario: ::reset at the end puts the account's backpack and levels back"},
    {"step": "command", "text": "::empty"},
    {"step": "command", "text": "::item 995 200"},
    {"step": "command", "text": "::tele 2808 3192 0", "expectMessage": "Teleported to 2808, 3192, 0", "comment": "the arena's hut"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "Cap'n Izzy No-Beard", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[izzy.ahoy_capn]"},
    {"step": "continueDialogue", "comment": "[izzy.ahoy_there]"},
    {"step": "continueDialogue", "comment": "[izzy.parrot_avast]"},
    {"step": "continueDialogue", "comment": "[izzy.huh]"},
    {"step": "continueDialogue", "comment": "[izzy.cracked]"},
    {"step": "chooseOption", "text": "[izzy.use_arena]"},
    {"step": "continueDialogue", "comment": "the player asks"},
    {"step": "continueDialogue", "comment": "[izzy.entrance_200]"},
    {"step": "continueDialogue", "comment": "[izzy.parrot_eight]"},
    {"step": "continueDialogue", "comment": "[izzy.warning]"},
    {"step": "chooseOption", "text": "[izzy.heres_200]"},
    {"step": "continueDialogue", "comment": "the player says it"},
    {"step": "continueDialogue", "comment": "[izzy.hand_200]"},
    {"step": "continueDialogue", "comment": "[izzy.wind]"},
    {"step": "locOption", "locId": 3617, "option": "Climb-down", "x": 2809, "y": 3194},
    {"step": "assertLocation", "x": 2805, "y": 9589, "plane": 3, "timeoutMs": 10000, "comment": "the arena's north-east pillar"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "command", "text": "::tele 2805 9578 3", "expectMessage": "Teleported to 2805, 9578, 3", "comment": "beside the pillar south of the ladder"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 3608, "option": "Tag", "x": 2805, "y": 9579},
    {"step": "assertMessage", "contains": "[agility_arena.", "timeoutMs": 10000, "comment": "a ticket if the arrow is over it, else the not-arrowed message"},
    {"step": "command", "text": "::tele 2805 9589 3", "expectMessage": "Teleported to 2805, 9589, 3"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 3618, "option": "Climb-up", "x": 2805, "y": 9590},
    {"step": "assertLocation", "x": 2810, "y": 3194, "plane": 0, "timeoutMs": 10000, "comment": "back in the hut"},

    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
