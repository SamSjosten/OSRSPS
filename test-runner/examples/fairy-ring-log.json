{
 "name": "Travel networks step T2: the fairy ring travel log opens beside the dials, lists DIS once landed on, Use code turns the dials to it, Add Favourite and Remove Favourite fill and empty slot 1 (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "nothing worn or held; ::reset at the end puts the account back, the log and favourites with it"},
  {"step": "command", "text": "::tele 3130 3496 0", "expectMessage": "Teleported to 3130, 3496, 0", "comment": "east of the Edgeville ring (DKR, 3129, 3496)"},
  {"step": "command", "text": "::item 772", "comment": "a dramen staff"},
  {"step": "itemOption", "item": "Dramen staff", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "itemId": 772},
  {"step": "command", "text": "::varbit 3985 0"},
  {"step": "command", "text": "::varbit 3986 0"},
  {"step": "command", "text": "::varbit 3987 0", "comment": "the dials at A I P"},
  {"step": "command", "text": "::varbit 3999 0", "comment": "fairyrings_log_dis: DIS not yet in the log"},
  {"step": "command", "text": "::varbit 20240 0", "comment": "favourite slot 1 empty"},
  {"step": "command", "text": "::varbit 20239 0", "comment": "the rings' Favourites option hidden"},

  {"step": "locOption", "loc": "Fairy ring", "option": "Configure", "x": 3129, "y": 3496},
  {"step": "assertInterface", "interfaceId": 398},
  {"step": "assertInterface", "interfaceId": 381, "comment": "the travel log, in the side panel"},
  {"step": "clickWidget", "interfaceId": 398, "component": 19, "op": 1, "comment": "dial 1 clockwise: A to D"},
  {"step": "assertVarbit", "id": 3985, "value": 1},
  {"step": "clickWidget", "interfaceId": 398, "component": 23, "op": 1, "comment": "dial 3 clockwise: P to S"},
  {"step": "assertVarbit", "id": 3987, "value": 1},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 398, "component": 26, "op": 1, "comment": "Confirm: DIS"},
  {"step": "assertLocation", "x": 3108, "y": 3149, "plane": 0, "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 3999, "value": 1, "comment": "DIS is in the log now"},
  {"step": "waitTicks", "ticks": 4},

  {"step": "locOption", "loc": "Fairy ring", "option": "Configure", "x": 3108, "y": 3149},
  {"step": "assertInterface", "interfaceId": 381},
  {"step": "waitTicks", "ticks": 2, "comment": "the log lays itself out"},
  {"step": "clickWidget", "interfaceId": 398, "component": 19, "op": 1, "comment": "dial 1 on, D to C"},
  {"step": "assertVarbit", "id": 3985, "value": 2},
  {"step": "clickWidget", "interfaceId": 381, "component": 114, "op": 1, "comment": "DIS's line, Use code: the dials back to D I S"},
  {"step": "assertVarbit", "id": 3985, "value": 1},
  {"step": "assertVarbit", "id": 3987, "value": 1},

  {"step": "clickWidget", "interfaceId": 381, "component": 115, "op": 1, "comment": "DIS's star, Add Favourite"},
  {"step": "assertVarbit", "id": 20240, "value": 81, "comment": "slot 1: DIS's state 17, plus 64"},
  {"step": "assertVarbit", "id": 20239, "value": 1, "comment": "the rings show Favourites"},
  {"step": "assertWidgetText", "interfaceId": 381, "component": 151, "contains": "D I S", "comment": "the favourite's code, on top of the log"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 381, "component": 161, "op": 1, "comment": "the favourite's star, Remove Favourite"},
  {"step": "assertVarbit", "id": 20240, "value": 0},
  {"step": "assertVarbit", "id": 20239, "value": 0},

  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
