{
  "name": "Wilderness step W4.6: the Lava Maze Dungeon's lever into the King Black Dragon's lair, Commune on it, the King Black Dragon fought under ::god and killed with ::kill, his kill count's key, and the lair's lever back (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "the dungeon is in the Wilderness at level 44"},
    {"step": "command", "text": "::item 1333", "comment": "a melee weapon of its own: a bow left worn with no ammo by an earlier script fights with no hitsplat (nightly 2026-11-27)"},
    {"step": "itemOption", "item": "Rune scimitar", "option": "Wield"},
    {"step": "waitTicks", "ticks": 1},
    {"step": "command", "text": "::tele 3067 10254 0", "expectMessage": "Teleported to 3067, 10254, 0", "comment": "beside the dungeon's lever at 3067,10253"},
    {"step": "locOption", "locId": 1816, "option": "Commune", "x": 3067, "y": 10253},
    {"step": "assertMessage", "contains": "[kbd.commune count=", "timeoutMs": 10000},
    {"step": "locOption", "locId": 1816, "option": "Pull", "x": 3067, "y": 10253},
    {"step": "assertLocation", "x": 2271, "y": 4680, "plane": 0, "timeoutMs": 15000},
    {"step": "npcOption", "npc": "King Black Dragon", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "King Black Dragon", "timeoutMs": 30000},
    {"step": "command", "text": "::kill", "expectMessage": "Killed King Black Dragon #"},
    {"step": "assertMessage", "contains": "[wilderness_boss.kill_count boss=King Black Dragon count=", "timeoutMs": 15000},
    {"step": "locOption", "locId": 1817, "option": "Pull", "x": 2271, "y": 4680},
    {"step": "assertLocation", "x": 3067, "y": 10253, "plane": 0, "timeoutMs": 15000, "comment": "the fight may have moved the player off the lever's tile, so the walk back adds to the pull's ticks"},
    {"step": "command", "text": "::tele 3222 3218 0", "expectMessage": "Teleported to 3222, 3218, 0", "comment": "out of the Wilderness before ::god goes off, so nothing hits the player"},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
