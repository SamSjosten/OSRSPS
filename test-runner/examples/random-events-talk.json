{
  "name": "Random events: Dr Jekyll takes a herb for a potion, the Drunken Dwarf gives a kebab and a beer, and the Strange plant gives a fruit",
  "account": "test",
  "runOnLogin": false,
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"comment": "Off first, so the timer can't send a second event mid-script.", "step": "command", "text": "::randomevent off", "expectMessage": "Random events off"},
    {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied"},
    {"step": "command", "text": "::tele 3222 3218", "expectMessage": "Teleported to 3222, 3218"},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0},
    {"step": "command", "text": "::item 249", "expectMessage": "Added"},
    {"step": "command", "text": "::item 269", "expectMessage": "Added"},
    {"step": "command", "text": "::randomevent dr_jekyll", "expectMessage": "Started random event dr_jekyll"},
    {"step": "npcOption", "npc": "Dr Jekyll", "option": "Talk-to", "timeoutMs": 20000},
    {"comment": "The highest-level herb carried: torstol over guam.", "step": "assertDialogue", "contains": "[dr_jekyll.ask herb=torstol]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[dr_jekyll.here_you_are]"},
    {"step": "assertDialogue", "contains": "[dr_jekyll.here_you_are]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Dr Jekyll", "contains": "[dr_jekyll.thank_you]"},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"step": "assertInventory", "item": "Stamina potion(4)", "count": 1},
    {"step": "assertInventory", "item": "Torstol", "count": 0},
    {"step": "assertInventory", "item": "Guam leaf", "count": 1},
    {"step": "waitTicks", "ticks": 2},
    {"step": "command", "text": "::randomevent drunken_dwarf", "expectMessage": "Started random event drunken_dwarf"},
    {"step": "npcOption", "npc": "Drunken Dwarf", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Drunken Dwarf", "contains": "[drunken_dwarf.kebab_stories]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"step": "assertInventory", "item": "Kebab", "count": 1},
    {"step": "assertInventory", "item": "Beer", "count": 1},
    {"step": "waitTicks", "ticks": 2},
    {"step": "command", "text": "::randomevent strange_plant", "expectMessage": "Started random event strange_plant"},
    {"comment": "It grows for 5 ticks (guessed) before it can be picked.", "step": "waitTicks", "ticks": 6},
    {"step": "npcOption", "npc": "Strange plant", "option": "Pick", "timeoutMs": 20000},
    {"step": "assertInventory", "item": "Strange fruit", "count": 1},
    {"step": "itemOption", "item": "Strange fruit", "option": "Eat"},
    {"step": "assertMessage", "contains": "[strange_plant.eaten]"},
    {"step": "assertInventory", "item": "Strange fruit", "count": 0}
  ]
}
