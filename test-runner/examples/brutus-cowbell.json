{
 "name": "Brutus step 4: the cowbell amulet. Air runes charge it (as many as asked), Check tells the charges, Uncharge gives the runes back, Teleport goes to the Lumbridge cow field for a charge (the last leaves it empty), and Ring in Brutus's field after a kill brings him back. Gillie's hand-over and the 13 ticks are checked in HeadlessCowbellAmuletTest",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario brutus", "expectMessage": "Started scenario brutus.", "comment": "south of the pen's gate; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys", "comment": "the amulet's words aren't on the server yet"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now"},
  {"step": "command", "text": "::item 33103 1"},
  {"step": "command", "text": "::item 556 7"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "useItemOnItem", "item": "Air rune", "onItem": "Cowbell amulet"},
  {"step": "enterAmount", "amount": 5},
  {"step": "assertDialogue", "contains": "[cowbell_amulet.added", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "itemId": 33104, "count": 1},
  {"step": "assertInventory", "itemId": 556, "count": 2},
  {"step": "itemOption", "item": "Cowbell amulet", "option": "Check"},
  {"step": "assertMessage", "contains": "cowbell_amulet.check amount=5", "timeoutMs": 10000},
  {"step": "itemOption", "item": "Cowbell amulet", "option": "Uncharge"},
  {"step": "assertDialogue", "contains": "[cowbell_amulet.uncharged", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "itemId": 33103, "count": 1},
  {"step": "assertInventory", "itemId": 556, "count": 7},
  {"step": "useItemOnItem", "item": "Air rune", "onItem": "Cowbell amulet"},
  {"step": "enterAmount", "amount": 1},
  {"step": "assertDialogue", "contains": "[cowbell_amulet.added", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "itemOption", "item": "Cowbell amulet", "option": "Teleport"},
  {"step": "assertMessage", "contains": "cowbell_amulet.ran_out", "timeoutMs": 10000},
  {"step": "assertAnimation", "id": 714, "timeoutMs": 5000},
  {"step": "waitTicks", "ticks": 6, "comment": "lands within 2 tiles of 3259, 3277"},
  {"step": "assertInventory", "itemId": 33103, "count": 1},
  {"step": "command", "text": "::tele 3262 3293 0", "comment": "back south of the gate"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "locId": 60763, "option": "Release", "x": 3262, "y": 3294},
  {"step": "assertDialogue", "contains": "[brutus.release_yes]", "timeoutMs": 10000, "comment": "on an account that once picked don't-ask-again there is no menu: drop this step and the next"},
  {"step": "chooseOption", "text": "[brutus.release_yes]"},
  {"step": "waitTicks", "ticks": 5, "comment": "the field's region drawn"},
  {"step": "itemOption", "item": "Cowbell amulet", "option": "Ring"},
  {"step": "assertDialogue", "contains": "[cowbell_amulet.ring_nothing]", "timeoutMs": 10000, "comment": "he's alive"},
  {"step": "continueDialogue"},
  {"step": "command", "text": "::kill Brutus", "expectMessage": "Killed Brutus"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "itemOption", "item": "Cowbell amulet", "option": "Ring"},
  {"step": "assertDialogue", "contains": "[cowbell_amulet.ring_approaching]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "waitTicks", "ticks": 15, "comment": "back 13 ticks after the ring"},
  {"step": "npcOption", "npc": "Brutus", "option": "Attack", "timeoutMs": 10000},
  {"step": "locOption", "locId": 60765, "option": "Quick-escape", "timeoutMs": 10000},
  {"step": "assertLocation", "x": 3262, "y": 3293, "plane": 0, "timeoutMs": 20000},
  {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
