  {"step": "assertInterface", "interfaceId": 212, "timeoutMs": 10000, "comment": "poh_add_room"},
  {"step": "clickWidget", "interfaceId": 212, "component": 9, "comment": "the kitchen's button: its op sends the kitchen's room type"},
  {"step": "chooseOption", "text": "[construction.rotate_clockwise]", "comment": "the ghost first faces one door north, onto the garden; clockwise turns it the other way that still does"},
  {"step": "waitTicks", "ticks": 2, "comment": "the redraw"},
  {"step": "chooseOption", "text": "[construction.build_room]"},
  {"step": "assertNoDialogue"},
  {"step": "assertInventory", "item": "Coins", "count": 0, "timeoutMs": 5000, "comment": "1,000 paid for the house, 5,000 for the kitchen"},
