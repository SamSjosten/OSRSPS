{
  "name": "Edgeville piece step 5: Barbarian Village. A bronze med helm bought from Peksa, wool spun in the spinning hut, a pot thrown on Tassie's wheel and fired in her oven, Tassie's talk, the lookout tower's ladders up to Hunding and down, and the first lines of Atlas, Litara, Checkal and Sigurd (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
    {"step": "command", "text": "::item coins 100", "expectMessage": "Added 100 x Coins"},
    {"step": "command", "text": "::tele 3077 3429 0", "expectMessage": "Teleported to 3077, 3429, 0", "comment": "beside Peksa's spawn, in his shop"},
    {"step": "npcOption", "npc": "Peksa", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[peksa.greeting]", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[peksa.yes]"},
    {"step": "assertInterface", "interfaceId": 300, "comment": "yes opens the Helmet Shop"},
    {"step": "waitTicks", "ticks": 2, "comment": "lets the client draw the stock before clicking a slot"},
    {"step": "clickWidget", "interfaceId": 300, "component": 16, "slot": 1, "op": 2, "comment": "Buy 1 of the first item, Bronze med helm (24 coins)"},
    {"step": "assertInventory", "item": "Bronze med helm", "count": 1},
    {"step": "command", "text": "::tele 3082 3430 0", "expectMessage": "Teleported to 3082, 3430, 0", "comment": "the spinning hut, beside the wheel; the teleport closes the shop"},
    {"step": "command", "text": "::setlevel crafting 99", "expectMessage": "Crafting set to level 99", "comment": "so no pot cracks in the oven"},
    {"step": "command", "text": "::item 1737 1", "expectMessage": "Added 1 x Wool"},
    {"step": "locOption", "locId": 14889, "option": "Spin", "x": 3081, "y": 3430},
    {"step": "assertInterface", "interfaceId": 270, "comment": "skillmulti over the wool"},
    {"step": "clickWidget", "interfaceId": 270, "component": 15, "comment": "ball of wool"},
    {"step": "assertInventory", "item": "Ball of wool", "count": 1, "timeoutMs": 10000},
    {"step": "command", "text": "::item 1761 1", "expectMessage": "Added 1 x Soft clay"},
    {"step": "command", "text": "::tele 3086 3409 0", "expectMessage": "Teleported to 3086, 3409, 0", "comment": "Tassie's studio, beside the potter's wheels"},
    {"step": "locOption", "locId": 14887, "option": "Use", "x": 3087, "y": 3409},
    {"step": "assertInterface", "interfaceId": 270, "comment": "skillmulti over the pots"},
    {"step": "clickWidget", "interfaceId": 270, "component": 15, "comment": "the pot, the first choice"},
    {"step": "assertInventory", "item": "Unfired pot", "count": 1, "timeoutMs": 10000},
    {"step": "command", "text": "::tele 3085 3407 0", "expectMessage": "Teleported to 3085, 3407, 0", "comment": "beside the pottery oven"},
    {"step": "locOption", "locId": 11601, "option": "Fire", "x": 3084, "y": 3407},
    {"step": "assertInterface", "interfaceId": 270, "comment": "skillmulti over the unfired pot"},
    {"step": "clickWidget", "interfaceId": 270, "component": 15, "comment": "the pot"},
    {"step": "assertInventory", "item": "Pot", "count": 1, "timeoutMs": 15000},
    {"step": "npcOption", "npc": "Tassie Slipcast", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[tassie_slipcast.use_wheel]", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[tassie_slipcast.tidy]"},
    {"step": "continueDialogue"},
    {"step": "command", "text": "::tele 3096 3432 0", "expectMessage": "Teleported to 3096, 3432, 0", "comment": "the lookout tower, beside its ladder"},
    {"step": "locOption", "locId": 17026, "option": "Climb-up", "x": 3096, "y": 3433},
    {"step": "assertLocation", "x": 3096, "y": 3432, "plane": 1, "timeoutMs": 10000},
    {"step": "command", "text": "::tele 3097 3432 1", "expectMessage": "Teleported to 3097, 3432, 1", "comment": "beside the first floor's ladder up"},
    {"step": "locOption", "locId": 17026, "option": "Climb-up", "x": 3097, "y": 3433},
    {"step": "assertLocation", "x": 3097, "y": 3432, "plane": 2, "timeoutMs": 10000},
    {"step": "npcOption", "npc": "Hunding", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[hunding.hello]", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[hunding.what_doing]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[hunding.kill]"},
    {"step": "assertDialogue", "contains": "[hunding.kill]", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[hunding.kill_reply]"},
    {"step": "continueDialogue"},
    {"step": "locOption", "locId": 16685, "option": "Climb-down", "x": 3097, "y": 3433},
    {"step": "assertLocation", "x": 3097, "y": 3432, "plane": 1, "timeoutMs": 10000},
    {"step": "command", "text": "::tele 3076 3439 0", "expectMessage": "Teleported to 3076, 3439, 0", "comment": "the longhall, beside Atlas"},
    {"step": "npcOption", "npc": "Atlas", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[atlas.proven]", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[atlas.again]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[atlas.why]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[atlas.fun]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[atlas.fee name="},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[atlas.no]", "comment": "no workout: the talk ends"},
    {"step": "command", "text": "::tele 3082 3421 0", "expectMessage": "Teleported to 3082, 3421, 0", "comment": "the mine, beside Litara"},
    {"step": "npcOption", "npc": "Litara", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[litara.greeting]", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[litara.passing]"},
    {"step": "assertDialogue", "contains": "[litara.passing]"},
    {"step": "continueDialogue"},
    {"step": "command", "text": "::tele 3087 3416 0", "expectMessage": "Teleported to 3087, 3416, 0", "comment": "beside Checkal"},
    {"step": "npcOption", "npc": "Checkal", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[checkal.glad name=", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[checkal.why_not]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[checkal.friends]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[checkal.sorry name="},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[checkal.understand]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[checkal.dont_let]"},
    {"step": "continueDialogue"},
    {"step": "command", "text": "::tele 3112 3413 0", "expectMessage": "Teleported to 3112, 3413, 0", "comment": "the canoe station, beside Sigurd"},
    {"step": "npcOption", "npc": "Sigurd", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[sigurd.hello]", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[sigurd.ha_ha]"},
    {"step": "continueDialogue"},
    {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
