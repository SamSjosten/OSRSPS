{
  "name": "Wilderness step W4.12: Callisto's Den's way in (Check-Fee, then Enter paying the lairs' fee from the backpack), Callisto fought under ::god and killed with ::kill, his kill count's key, and the way out into the Escape Caves (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "level 41 outside, 40 inside"},
    {"step": "command", "text": "::item 1333", "comment": "a melee weapon of its own: a bow left worn with no ammo by an earlier script fights with no hitsplat (nightly 2026-11-27)"},
    {"step": "itemOption", "item": "Rune scimitar", "option": "Wield"},
    {"step": "waitTicks", "ticks": 1},
    {"step": "command", "text": "::tele 3293 3848 0", "expectMessage": "Teleported to 3293, 3848, 0", "comment": "south of the way in at 3291,3849"},
    {"step": "locOption", "locId": 47140, "option": "Check-Fee", "x": 3291, "y": 3849},
    {"step": "assertMessage", "contains": "[wildy_lair.fee_", "timeoutMs": 10000},
    {"step": "command", "text": "::varbit 14693 0", "comment": "wbr_entrance_fee_paid back to unpaid, so the fee's menu shows every run"},
    {"step": "command", "text": "::item 995 50000", "comment": "the fee in the backpack, in case it isn't paid yet"},
    {"step": "locOption", "locId": 47140, "option": "Enter", "x": 3291, "y": 3849},
    {"step": "waitTicks", "ticks": 3},
    {"step": "chooseOption", "text": "[wildy_lair_fee.yes]"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "assertLocation", "x": 3359, "y": 10333, "plane": 0},
    {"step": "npcOption", "npc": "Callisto", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Callisto", "timeoutMs": 30000},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Callisto #"},
    {"step": "assertMessage", "contains": "[wilderness_boss.kill_count boss=Callisto count=", "timeoutMs": 15000},
    {"step": "locOption", "locId": 47122, "option": "Exit", "x": 3358, "y": 10315},
    {"step": "waitTicks", "ticks": 8},
    {"step": "command", "text": "::pos", "comment": "one of the Escape Caves' three cave mouths: 3341,10254, 3362,10297 or 3377,10256"},
    {"step": "command", "text": "::tele 3094 3493 0", "expectMessage": "Teleported to 3094, 3493, 0", "comment": "out of the Escape Caves first: their monsters killed the account after ::god off (nightly 2026-11-27)"},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
