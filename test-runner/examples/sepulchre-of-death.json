  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now", "comment": "the ankou, ghosts and skeletons are aggressive"},
  {"step": "command", "text": "::varbit 2312 0", "comment": "sos_emote_stamp: the Cradle of Life not yet searched"},
  {"step": "command", "text": "::tele 2148 5283 0", "expectMessage": "Teleported to 2148, 5283, 0", "comment": "south of the Pit of Pestilence's dripping vine down"},
  {"step": "locOption", "locId": 23706, "option": "Climb-down", "x": 2148, "y": 5284},
  {"step": "assertLocation", "x": 2358, "y": 5215, "plane": 0, "timeoutMs": 10000, "comment": "south of the Sepulchre of Death's Boney ladder (the landing is guessed)"},
  {"step": "locOption", "locId": 23921, "option": "Climb-up", "x": 2358, "y": 5216},
  {"step": "assertLocation", "x": 2148, "y": 5283, "plane": 0, "timeoutMs": 10000, "comment": "back beside the vine down"},
  {"step": "command", "text": "::tele 2364 5212 0", "expectMessage": "Teleported to 2364, 5212, 0", "comment": "beside the floor's portal"},
  {"step": "locOption", "locId": 23922, "option": "Use", "x": 2365, "y": 5212},
  {"step": "assertDialogue", "contains": "stronghold_of_security.portal_refuse", "timeoutMs": 10000, "comment": "no combat level lets this one through, only the Cradle searched (inferred)"},
  {"step": "continueDialogue"},
  {"step": "command", "text": "::tele 2349 5212 0", "expectMessage": "Teleported to 2349, 5212, 0", "comment": "north of the notice"},
  {"step": "locOption", "locId": 7054, "option": "Read", "x": 2349, "y": 5211},
  {"step": "assertDialogue", "contains": "stronghold_of_security.notice_read", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "command", "text": "::tele 2345 5214 0", "expectMessage": "Teleported to 2345, 5214, 0", "comment": "east of the Cradle of Life"},
  {"step": "locOption", "locId": 23731, "option": "Search", "x": 2344, "y": 5214},
  {"step": "assertDialogue", "contains": "stronghold_of_security.cradle_open", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "stronghold_of_security.cradle_reward", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[stronghold_of_security.cradle_fancy]"},
  {"step": "assertDialogue", "contains": "stronghold_of_security.cradle_given", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "item": "Fancy boots", "count": 1, "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 2312, "value": 1, "timeoutMs": 10000, "comment": "sos_emote_stamp: Stamp unlocked, the reward claimed"},
  {"step": "locOption", "locId": 23731, "option": "Search", "x": 2344, "y": 5214, "comment": "again: another pair of boots"},
  {"step": "assertDialogue", "contains": "stronghold_of_security.cradle_again", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[stronghold_of_security.cradle_fighting]"},
  {"step": "assertDialogue", "contains": "stronghold_of_security.cradle_given", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "item": "Fighting boots", "count": 1, "timeoutMs": 10000},
  {"step": "command", "text": "::tele 2364 5212 0", "expectMessage": "Teleported to 2364, 5212, 0", "comment": "beside the floor's portal"},
  {"step": "locOption", "locId": 23922, "option": "Use", "x": 2365, "y": 5212},
  {"step": "assertMessage", "contains": "stronghold_of_security.portal_enter", "timeoutMs": 10000},
  {"step": "assertLocation", "x": 2345, "y": 5214, "plane": 0, "timeoutMs": 10000, "comment": "beside the Cradle of Life (the landing is guessed)"},
  {"step": "command", "text": "::tele 2355 5218 0", "expectMessage": "Teleported to 2355, 5218, 0", "comment": "south of the pair of portals of death at z 5218 and 5221, north of the start"},
  {"step": "locOption", "locId": 23728, "option": "Open", "x": 2355, "y": 5218},
  {"step": "assertLocation", "x": 2355, "y": 5219, "plane": 0, "timeoutMs": 10000},
  {"step": "command", "text": "::tele 2355 5221 0", "expectMessage": "Teleported to 2355, 5221, 0"},
  {"step": "locOption", "locId": 23728, "option": "Open", "x": 2355, "y": 5221},
  {"step": "assertLocation", "x": 2355, "y": 5222, "plane": 0, "timeoutMs": 10000, "comment": "no question once the Cradle is searched"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::tele 2351 5215 0", "expectMessage": "Teleported to 2351, 5215, 0", "comment": "beside the reward room's bone chain"},
  {"step": "locOption", "locId": 23732, "option": "Climb-up", "x": 2350, "y": 5215},
  {"step": "assertLocation", "x": 2358, "y": 5215, "plane": 0, "timeoutMs": 10000, "comment": "back at the start of the floor, by its Boney ladder (inferred, as the Catacomb's ropes)"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
