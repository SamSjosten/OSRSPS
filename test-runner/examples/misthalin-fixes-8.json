{
 "name": "Misthalin fixes 8: Draynor Manor's belladonna patch raked, planted, grown with ::farmtick and picked, bare-handed for a hit and nothing, then in leather gloves for nightshade, read off farming_transmit_a (varbit 4771) (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario farming", "expectMessage": "Started scenario farming.", "comment": "99 Farming, a rake and a seed dibber; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::farmclock pause", "expectMessage": "Farming clock paused", "comment": "the crop grows only by ::farmtick"},
  {"step": "command", "text": "::farmdisease off", "expectMessage": "Farming diseases off"},
  {"step": "command", "text": "::setlevel hitpoints 99", "expectMessage": "99"},
  {"step": "command", "text": "::tele 3085 3354 0", "expectMessage": "Teleported to 3085, 3354, 0", "comment": "west of the patch, by Draynor Manor"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "assertVarbit", "id": 4771, "value": 0, "timeoutMs": 5000, "comment": "the scenario starts every patch overgrown"},
  {"step": "locOption", "locId": 7572, "option": "Rake", "x": 3086, "y": 3354, "timeoutMs": 20000, "comment": "the multiloc farming_belladonna_patch"},
  {"step": "assertMessage", "contains": "[farming.raked]", "timeoutMs": 30000},
  {"step": "assertVarbit", "id": 4771, "value": 3, "timeoutMs": 5000},
  {"step": "command", "text": "::item 5281 1", "comment": "a belladonna seed"},
  {"step": "useItemOnLoc", "item": "Belladonna seed", "locId": 7572, "x": 3086, "y": 3354},
  {"step": "assertVarbit", "id": 4771, "value": 4, "timeoutMs": 10000, "comment": "Belladonna seedling (7561)"},
  {"step": "command", "text": "::farmtick 64", "expectMessage": "Farming clock moved on 64 ticks", "comment": "four 80-minute ticks"},
  {"step": "assertVarbit", "id": 4771, "value": 8, "timeoutMs": 5000, "comment": "grown: Belladonna (7565) with Pick"},
  {"step": "locOption", "locId": 7572, "option": "Pick", "x": 3086, "y": 3354, "timeoutMs": 20000},
  {"step": "assertHitsplat", "self": true, "timeoutMs": 10000, "comment": "bare-handed: hit for 2"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "assertVarbit", "id": 4771, "value": 8, "timeoutMs": 5000, "comment": "still grown"},
  {"step": "command", "text": "::item 1059 1", "comment": "leather gloves"},
  {"step": "itemOption", "item": "Leather gloves", "option": "Wear"},
  {"step": "assertEquipment", "slot": "hands", "item": "Leather gloves"},
  {"step": "locOption", "locId": 7572, "option": "Pick", "x": 3086, "y": 3354, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.picked produce=nightshade]", "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 4771, "value": 3, "timeoutMs": 5000, "comment": "bare soil again"},
  {"step": "assertInventory", "item": "Nightshade", "timeoutMs": 5000},
  {"step": "command", "text": "::farmclock run", "comment": "back to the real clock"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
