{
 "name": "Fishing and Cooking 2 step FC5a: pastry dough through the Make-X box, an apple pie from shell to range, a pizza from base to anchovies, and a cake whose tin comes back, on the Lumbridge kitchen range (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario fishing-cooking", "expectMessage": "Started scenario fishing-cooking.", "comment": "99 Cooking; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::tele 3211 3215 0", "comment": "beside the Lumbridge Castle kitchen's Cooking range"},
  {"step": "assertLocation", "x": 3211, "y": 3215, "plane": 0},
  {"step": "command", "text": "::empty"},

  {"step": "command", "text": "::item 1933 1", "comment": "a pot of flour"},
  {"step": "command", "text": "::item 1929 1", "comment": "a bucket of water"},
  {"step": "useItemOnItem", "itemId": 1933, "onItemId": 1929},
  {"step": "assertInterface", "interfaceId": 270, "comment": "skillmulti: bread dough, pastry dough, pizza base, pitta dough"},
  {"step": "clickWidget", "interfaceId": 270, "component": 16, "comment": "the second, pastry dough"},
  {"step": "assertMessage", "contains": "cooking_mix.pastry_dough", "timeoutMs": 10000},
  {"step": "assertInventory", "itemId": 1931, "count": 1, "comment": "the pot back"},
  {"step": "assertInventory", "itemId": 1925, "count": 1, "comment": "the bucket back"},

  {"step": "command", "text": "::item 2313 1", "comment": "a pie dish"},
  {"step": "useItemOnItem", "itemId": 1953, "onItemId": 2313, "comment": "one of each: no box"},
  {"step": "assertMessage", "contains": "cooking_mix.pie_shell", "timeoutMs": 10000},
  {"step": "command", "text": "::item 1955 1", "comment": "a cooking apple"},
  {"step": "useItemOnItem", "itemId": 1955, "onItemId": 2315},
  {"step": "assertMessage", "contains": "cooking_mix.apple_pie", "timeoutMs": 10000},
  {"step": "useItemOnLoc", "itemId": 2317, "locId": 114, "x": 3212, "y": 3215},
  {"step": "assertMessage", "contains": "cooking.cooked_pie item=apple pie", "timeoutMs": 20000, "comment": "no burns from 63"},
  {"step": "assertInventory", "itemId": 2323, "count": 1, "comment": "apple pie"},

  {"step": "command", "text": "::item 2283 1", "comment": "a pizza base"},
  {"step": "command", "text": "::item 1982 1", "comment": "a tomato"},
  {"step": "command", "text": "::item 1985 1", "comment": "cheese"},
  {"step": "useItemOnItem", "itemId": 1982, "onItemId": 2283},
  {"step": "assertMessage", "contains": "cooking_mix.incomplete_pizza", "timeoutMs": 10000},
  {"step": "useItemOnItem", "itemId": 1985, "onItemId": 2285},
  {"step": "assertMessage", "contains": "cooking_mix.uncooked_pizza", "timeoutMs": 10000},
  {"step": "useItemOnLoc", "itemId": 2287, "locId": 114, "x": 3212, "y": 3215},
  {"step": "assertMessage", "contains": "cooking.cooked_pizza", "timeoutMs": 20000},
  {"step": "command", "text": "::item 319 1", "comment": "anchovies"},
  {"step": "useItemOnItem", "itemId": 319, "onItemId": 2289},
  {"step": "assertMessage", "contains": "cooking_mix.anchovy_pizza", "timeoutMs": 10000},
  {"step": "assertInventory", "itemId": 2297, "count": 1, "comment": "anchovy pizza"},

  {"step": "command", "text": "::empty"},
  {"step": "command", "text": "::item 1887 1", "comment": "a cake tin"},
  {"step": "command", "text": "::item 1944 1", "comment": "an egg"},
  {"step": "command", "text": "::item 1933 1", "comment": "a pot of flour"},
  {"step": "command", "text": "::item 1927 1", "comment": "a bucket of milk"},
  {"step": "useItemOnItem", "itemId": 1944, "onItemId": 1887},
  {"step": "assertMessage", "contains": "cooking_mix.uncooked_cake", "timeoutMs": 10000},
  {"step": "useItemOnLoc", "itemId": 1889, "locId": 114, "x": 3212, "y": 3215},
  {"step": "assertMessage", "contains": "cooking.cooked_cake", "timeoutMs": 20000},
  {"step": "assertInventory", "itemId": 1887, "count": 1, "timeoutMs": 10000, "comment": "the cake tin back"},
  {"step": "command", "text": "::item 1973 1", "comment": "a chocolate bar"},
  {"step": "useItemOnItem", "itemId": 1973, "onItemId": 1891},
  {"step": "assertMessage", "contains": "cooking_mix.chocolate_cake", "timeoutMs": 10000},
  {"step": "assertInventory", "itemId": 1897, "count": 1, "comment": "chocolate cake"},

  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
