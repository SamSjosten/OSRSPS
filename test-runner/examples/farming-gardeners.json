{
 "name": "Farming step 8: at Lumbridge's tree patch, Fayeth won't look after an empty patch, takes a noted basket of tomatoes through Pay to look after an oak, chops the grown oak down for 200 coins from her menu, and opens Farming Supplies (::keys on). Items used on a gardener or Tool Leprechaun are in the headless test only: the runner has no use-item-on-NPC step",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario farming", "expectMessage": "Started scenario farming.", "comment": "99 Farming and every patch overgrown; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::farmdisease off", "expectMessage": "Farming diseases off"},
  {"step": "command", "text": "::farmclock pause", "expectMessage": "Farming clock paused", "comment": "the oak grows only by ::farmtick"},
  {"step": "command", "text": "::setlevel woodcutting 1", "expectMessage": "1", "comment": "too low to chop an oak, so Fayeth names her price at once"},
  {"step": "command", "text": "::tele 3193 3229 0", "expectMessage": "Teleported to 3193, 3229, 0", "comment": "south of the tree patch west of Lumbridge castle; Fayeth stands by it"},
  {"step": "npcOption", "npc": "Fayeth", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "chooseOption", "text": "[gardener.look_after]"},
  {"step": "assertDialogue", "contains": "[gardener.look_after]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[gardener.no_sapling]", "comment": "nothing planted yet"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::item 5341 1", "comment": "a rake"},
  {"step": "command", "text": "::item 952 1", "comment": "a spade"},
  {"step": "command", "text": "::item 5370 1", "comment": "an oak sapling"},
  {"step": "command", "text": "::item 5969 1", "comment": "a noted basket of tomatoes, the oak's payment"},
  {"step": "locOption", "locId": 8391, "option": "Rake", "x": 3192, "y": 3230, "timeoutMs": 20000},
  {"step": "assertVarbit", "id": 4771, "value": 3, "timeoutMs": 30000},
  {"step": "useItemOnLoc", "itemId": 5370, "locId": 8391, "x": 3192, "y": 3230},
  {"step": "assertVarbit", "id": 4771, "value": 8, "timeoutMs": 10000, "comment": "the oak planted"},
  {"step": "npcOption", "npc": "Fayeth", "option": "Pay", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[gardener.paid]", "comment": "the noted basket taken"},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "itemId": 5969, "count": 0, "timeoutMs": 5000},
  {"step": "npcOption", "npc": "Fayeth", "option": "Pay", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[gardener.pay_already]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::farmtick 32", "expectMessage": "Farming clock moved on 32 ticks", "comment": "four 40-minute growths"},
  {"step": "assertVarbit", "id": 4771, "value": 12, "timeoutMs": 10000, "comment": "grown, before Check-health"},
  {"step": "command", "text": "::item 995 200", "comment": "Fayeth's fee to chop it down"},
  {"step": "npcOption", "npc": "Fayeth", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "chooseOption", "text": "[gardener.chop]"},
  {"step": "assertDialogue", "contains": "[gardener.chop]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[gardener.hard_work]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[gardener.heres_200]"},
  {"step": "assertDialogue", "contains": "[gardener.heres_200]"},
  {"step": "continueDialogue"},
  {"step": "assertVarbit", "id": 4771, "value": 3, "timeoutMs": 10000, "comment": "the oak gone, the patch clear"},
  {"step": "assertInventory", "itemId": 995, "count": 0, "timeoutMs": 5000},
  {"step": "npcOption", "npc": "Fayeth", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "chooseOption", "text": "[gardener.sell]"},
  {"step": "assertDialogue", "contains": "[gardener.sell]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[gardener.sell_what]"},
  {"step": "continueDialogue"},
  {"step": "assertInterface", "interfaceId": 300, "comment": "Farming Supplies"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
