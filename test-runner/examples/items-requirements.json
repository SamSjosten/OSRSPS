{
 "name": "Items step 2: wear requirements from item-requirements.tsv: several skills, the combat level, and a cache Crafting param that is not a wear level",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::item fire battlestaff", "expectMessage": "Added 1 x Fire battlestaff"},
  {"step": "itemOption", "item": "Fire battlestaff", "option": "Wield"},
  {"step": "assertMessage", "contains": "You need to have an Attack level of 30."},
  {"step": "assertEquipment", "slot": "weapon", "empty": true},
  {"step": "command", "text": "::setlevel attack 30", "expectMessage": "set to level 30"},
  {"step": "command", "text": "::setlevel magic 30", "expectMessage": "set to level 30"},
  {"step": "itemOption", "item": "Fire battlestaff", "option": "Wield", "comment": "the cache's param says Crafting 62, the level that makes it; the Wiki asks only 30 Attack and 30 Magic to wield"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Fire battlestaff"},
  {"step": "command", "text": "::item pegasian boots", "expectMessage": "Added 1 x Pegasian boots"},
  {"step": "command", "text": "::setlevel ranged 75", "expectMessage": "set to level 75"},
  {"step": "itemOption", "item": "Pegasian boots", "option": "Wear"},
  {"step": "assertMessage", "contains": "You need to have a Defence level of 75.", "comment": "75 Ranged alone is not enough"},
  {"step": "assertEquipment", "slot": "feet", "empty": true},
  {"step": "command", "text": "::setlevel defence 75", "expectMessage": "set to level 75"},
  {"step": "itemOption", "item": "Pegasian boots", "option": "Wear"},
  {"step": "assertEquipment", "slot": "feet", "item": "Pegasian boots"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare."},
  {"step": "command", "text": "::item black mask (10)", "expectMessage": "Added 1 x Black mask (10)"},
  {"step": "command", "text": "::setlevel strength 20", "expectMessage": "set to level 20"},
  {"step": "command", "text": "::setlevel defence 10", "expectMessage": "set to level 10"},
  {"step": "itemOption", "item": "Black mask (10)", "option": "Wear", "comment": "combat level 11 here"},
  {"step": "assertMessage", "contains": "You need to have a combat level of 40.", "comment": "wording guessed (EquipmentTab)"},
  {"step": "assertEquipment", "slot": "head", "empty": true},
  {"step": "command", "text": "::setlevel attack 80", "expectMessage": "set to level 80"},
  {"step": "command", "text": "::setlevel hitpoints 30", "expectMessage": "set to level 30", "comment": "combat level 42"},
  {"step": "itemOption", "item": "Black mask (10)", "option": "Wear"},
  {"step": "assertEquipment", "slot": "head", "item": "Black mask (10)"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
