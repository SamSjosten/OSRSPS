{
 "name": "Edgeville piece step 10: the Edgeville Dungeon's north and middle. Down the trapdoor, a zombie killed, iron mined, a metal gate opened, the north gate's refusal, the odd looking wall pushed through, and back up the ladder (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now", "comment": "the dungeon's zombies, skeletons and hobgoblins are aggressive"},
  {"step": "command", "text": "::setlevel attack 99", "expectMessage": "Attack set to level 99"},
  {"step": "command", "text": "::setlevel strength 99", "expectMessage": "Strength set to level 99"},
  {"step": "command", "text": "::setlevel mining 99", "expectMessage": "Mining set to level 99"},
  {"step": "command", "text": "::item rune_pickaxe", "expectMessage": "Added 1 x Rune pickaxe"},
  {"step": "command", "text": "::tele 3097 3469 0", "expectMessage": "Teleported to 3097, 3469, 0", "comment": "north of the trapdoor, inside the ruined house south of the bank (its south wall stands between 3097,3467 and the trapdoor)"},
  {"step": "locOption", "locId": 1579, "option": "Open", "x": 3097, "y": 3468},
  {"step": "assertLoc", "loc": "Trapdoor", "x": 3097, "y": 3468, "option": "Climb-down"},
  {"step": "locOption", "locId": 1581, "option": "Climb-down", "x": 3097, "y": 3468},
  {"step": "assertLocation", "x": 3097, "y": 9868, "plane": 0, "timeoutMs": 10000, "comment": "north of the ladder below, in the passage"},
  {"step": "command", "text": "::tele 3147 9898 0", "expectMessage": "Teleported to 3147, 9898, 0", "comment": "among the level 18 zombies east of the middle"},
  {"step": "npcOption", "npc": "Zombie", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertHitsplat", "npc": "Zombie", "timeoutMs": 20000, "comment": "the player's swing lands on a zombie (a hit or a miss, 0)"},
  {"step": "assertGroundItem", "item": "Bones", "timeoutMs": 60000, "comment": "a zombie always drops bones"},
  {"step": "command", "text": "::tele 3139 9876 0", "expectMessage": "Teleported to 3139, 9876, 0", "comment": "north of the mine's west iron rock"},
  {"step": "locOption", "locId": 11364, "option": "Mine", "x": 3139, "y": 9875, "comment": "ironrock1"},
  {"step": "assertInventory", "item": "Iron ore", "count": 1, "timeoutMs": 30000},
  {"step": "command", "text": "::tele 3104 9910 0", "expectMessage": "Teleported to 3104, 9910, 0", "comment": "east of the metal gate west of the skeletons"},
  {"step": "locOption", "locId": 1568, "option": "Open", "x": 3103, "y": 9910, "comment": "metalgateclosedl, with metalgateclosedr below it"},
  {"step": "command", "text": "::tele 3131 9916 0", "expectMessage": "Teleported to 3131, 9916, 0", "comment": "south of the gate into the Wilderness's part"},
  {"step": "locOption", "locId": 1727, "option": "Open", "x": 3131, "y": 9917},
  {"step": "assertMessage", "contains": "edgeville_dungeon.gate_closed", "timeoutMs": 10000},
  {"step": "command", "text": "::tele 3095 9895 0", "expectMessage": "Teleported to 3095, 9895, 0", "comment": "east of the odd looking wall"},
  {"step": "locOption", "locId": 1736, "option": "Push", "x": 3094, "y": 9895},
  {"step": "assertLocation", "x": 3093, "y": 9895, "plane": 0, "timeoutMs": 10000, "comment": "through to the west side"},
  {"step": "command", "text": "::tele 3097 9868 0", "expectMessage": "Teleported to 3097, 9868, 0", "comment": "north of the ladder"},
  {"step": "locOption", "locId": 17385, "option": "Climb-up", "x": 3097, "y": 9867},
  {"step": "assertLocation", "x": 3097, "y": 3468, "plane": 0, "timeoutMs": 10000, "comment": "on the trapdoor's tile above"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
