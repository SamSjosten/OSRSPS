{
 "name": "Slayer step 7: the Slayer helmet assembled from a black mask and its six parts with Malevolent Masquerade (set with ::varp) at 55 Crafting, its Check giving the gem's no-task message, then disassembled back into an uncharged black mask and the parts",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account with no task; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "keys"},
  {"step": "command", "text": "::item 8901", "expectMessage": "Added 1 x Black mask (10)"},
  {"step": "command", "text": "::item 4166", "expectMessage": "Added 1 x Earmuffs"},
  {"step": "command", "text": "::item 4164", "expectMessage": "Added 1 x Facemask"},
  {"step": "command", "text": "::item 4168", "expectMessage": "Added 1 x Nose peg"},
  {"step": "command", "text": "::item 4551", "expectMessage": "Added 1 x Spiny helmet"},
  {"step": "command", "text": "::item 4155", "expectMessage": "Added 1 x Enchanted gem"},
  {"step": "command", "text": "::item 24942", "expectMessage": "Added 1 x Reinforced goggles"},
  {"step": "useItemOnItem", "item": "Earmuffs", "onItem": "Facemask"},
  {"step": "assertMessage", "contains": "[slayer_helmet.need_unlock]"},
  {"step": "command", "text": "::varp 1076 32", "expectMessage": "Varp 1076:", "comment": "Malevolent Masquerade, slayer_unlock bit 5"},
  {"step": "command", "text": "::setlevel crafting 55", "expectMessage": "Crafting set to level 55"},
  {"step": "useItemOnItem", "item": "Earmuffs", "onItem": "Facemask"},
  {"step": "assertMessage", "contains": "[slayer_helmet.assembled]"},
  {"step": "assertInventory", "item": "Slayer helmet", "count": 1, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Black mask (10)", "count": 0},
  {"step": "assertInventory", "item": "Reinforced goggles", "count": 0},
  {"step": "itemOption", "item": "Slayer helmet", "option": "Check"},
  {"step": "assertMessage", "contains": "[slayer.gem_no_task]"},
  {"step": "itemOption", "item": "Slayer helmet", "option": "Disassemble"},
  {"step": "assertMessage", "contains": "[slayer_helmet.disassembled]"},
  {"step": "assertInventory", "item": "Black mask", "count": 1, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Earmuffs", "count": 1},
  {"step": "assertInventory", "item": "Reinforced goggles", "count": 1},
  {"step": "assertInventory", "item": "Slayer helmet", "count": 0},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
