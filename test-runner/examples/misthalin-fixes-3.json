{
 "name": "Misthalin fixes 3: the wild cadava and redberry bushes, the signposts, the Combat Scroll and the VTAM plaque, the boxes (::keys on). The onion and cabbage field the 242 cache has east of the south-east Varrock mine isn't in the cache this runner fetches, so it is left out",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts it back"},
  {"step": "command", "text": "::tele 3269 3369 0", "expectMessage": "Teleported to 3269, 3369, 0", "comment": "by the cadava bushes south-east of Varrock"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "command", "text": "::resetlocs 8", "comment": "every bush back to full, should a run before this one have picked them"},
  {"step": "waitTicks", "ticks": 1},
  {"step": "locOption", "loc": "Cadava bush", "option": "Pick-from", "x": 3268, "y": 3370, "comment": "two berries"},
  {"step": "assertMessage", "contains": "[wild_bush.cadava_picked]", "timeoutMs": 15000},
  {"step": "assertInventory", "item": "Cadava berries", "count": 1},
  {"step": "waitTicks", "ticks": 2},
  {"step": "locOption", "loc": "Cadava bush", "option": "Pick-from", "x": 3268, "y": 3370, "comment": "one berry left"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "assertInventory", "item": "Cadava berries", "count": 2},
  {"step": "locOption", "loc": "Cadava bush", "option": "Pick-from", "x": 3268, "y": 3370, "comment": "none left now"},
  {"step": "assertMessage", "contains": "[wild_bush.no_berries]", "timeoutMs": 15000},
  {"step": "locOption", "loc": "Cadava bush", "option": "Pick-from", "x": 3264, "y": 3366, "comment": "the south-western bush, always empty"},
  {"step": "assertMessage", "contains": "[wild_bush.always_empty]", "timeoutMs": 15000},
  {"step": "locOption", "loc": "Redberry bush", "option": "Pick-from", "x": 3272, "y": 3375},
  {"step": "assertMessage", "contains": "[wild_bush.redberry_picked]", "timeoutMs": 15000},
  {"step": "assertInventory", "item": "Redberries", "count": 1},
  {"step": "command", "text": "::tele 3270 3332 0", "expectMessage": "Teleported to 3270, 3332, 0", "comment": "beside the western signpost south of Varrock"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "loc": "Signpost", "option": "Read", "x": 3268, "y": 3332},
  {"step": "assertInterface", "interfaceId": 135, "timeoutMs": 15000},
  {"step": "assertWidgetText", "interfaceId": 135, "component": 2, "contains": "[signpost.west_varrock_north]"},
  {"step": "assertWidgetText", "interfaceId": 135, "component": 7, "contains": "[signpost.west_varrock_east]"},
  {"step": "assertWidgetText", "interfaceId": 135, "component": 8, "contains": "[signpost.west_varrock_south]"},
  {"step": "assertWidgetText", "interfaceId": 135, "component": 11, "contains": "[signpost.west_varrock_west]"},
  {"step": "command", "text": "::tele 3334 3348 0", "expectMessage": "Teleported to 3334, 3348, 0", "comment": "the Exam Centre's north-west entrance"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "loc": "Signpost", "option": "Read", "x": 3335, "y": 3348},
  {"step": "assertMessage", "contains": "[signpost.exam_centre]", "timeoutMs": 15000},
  {"step": "command", "text": "::tele 3254 3437 0", "expectMessage": "Teleported to 3254, 3437, 0", "comment": "the house with the dummies, by the museum"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "loc": "Combat Scroll", "option": "Read", "x": 3254, "y": 3438},
  {"step": "assertDialogue", "contains": "[varrock_reading.combat_scroll]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::tele 3241 3382 0", "expectMessage": "Teleported to 3241, 3382, 0", "comment": "outside the Phoenix Gang's hideout"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "loc": "Plaque", "option": "Read", "x": 3241, "y": 3383},
  {"step": "assertDialogue", "contains": "[varrock_reading.vtam_plaque]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::tele 3245 3246 0", "expectMessage": "Teleported to 3245, 3246, 0", "comment": "by the boxes in east Lumbridge"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "loc": "Boxes", "option": "Search", "x": 3245, "y": 3245},
  {"step": "assertMessage", "contains": "[search.boxes_empty]", "timeoutMs": 15000},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
