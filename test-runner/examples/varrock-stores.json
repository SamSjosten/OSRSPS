{
 "name": "Varrock step 5: Trade at the General Store, Aubury's, Thessalia's, the Fancy Clothes Store and Ye olde Tea Shoppe, one item bought and sold back at each, then each keeper's talk (::keys on) into their shop",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "an empty backpack; ::reset at the end puts it back"
  },
  {
   "step": "command",
   "text": "::item coins 10000",
   "expectMessage": "Added 10,000 x Coins"
  },
  {
   "step": "command",
   "text": "::tele 3218 3415 0",
   "expectMessage": "Teleported to 3218, 3415, 0",
   "comment": "the Varrock General Store's keeper: the keeper's spawn tile"
  },
  {
   "step": "npcOption",
   "npc": "Shop keeper",
   "option": "Trade",
   "timeoutMs": 20000
  },
  {
   "step": "assertInterface",
   "interfaceId": 300
  },
  {
   "step": "waitTicks",
   "ticks": 2,
   "comment": "lets the client draw the stock before clicking a slot"
  },
  {
   "step": "clickWidget",
   "interfaceId": 300,
   "component": 16,
   "slot": 1,
   "op": 2,
   "comment": "Buy 1 Pot"
  },
  {
   "step": "assertInventory",
   "item": "Pot",
   "count": 1
  },
  {
   "step": "waitTicks",
   "ticks": 1,
   "comment": "the runner reads the slot's item from the client's widgets, which redraw a tick after the inventory changes"
  },
  {
   "step": "clickWidget",
   "interfaceId": 301,
   "component": 0,
   "slot": 1,
   "op": 2,
   "comment": "Sell 1 back (slot 1, after the coins)"
  },
  {
   "step": "assertInventory",
   "item": "Pot",
   "count": 0
  },
  {
   "step": "command",
   "text": "::tele 3253 3402 0",
