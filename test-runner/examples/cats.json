{
 "name": "Post-quest step 13: a pet kitten. Dropped to follow, stroked from Interact, asked its age, and picked up again; then put back as it was (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::tele 3222 3218 0", "expectMessage": "Teleported to 3222, 3218, 0", "comment": "open ground by Lumbridge Castle"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "command", "text": "::empty"},
  {"step": "command", "text": "::varp cat 0", "comment": "a kitten with no growth"},
  {"step": "command", "text": "::varp cat.care 0", "comment": "and fresh care"},
  {"step": "command", "text": "::item 1555 1", "comment": "Pet kitten (grey and black)"},
  {"step": "assertInventory", "item": "Pet kitten", "count": 1, "timeoutMs": 5000},
  {"step": "itemOption", "item": "Pet kitten", "option": "Drop"},
  {"step": "assertInventory", "item": "Pet kitten", "count": 0, "timeoutMs": 5000, "comment": "out, following"},
  {"step": "assertVarp", "id": 448, "value": 1555, "timeoutMs": 5000, "comment": "follower_obj: the kitten's item"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "npcOption", "npcId": 5591, "option": "Interact", "timeoutMs": 10000},
  {"step": "chooseOption", "text": "[cat.stroke]", "timeoutMs": 10000},
  {"step": "assertMessage", "contains": "[cat.stroked]", "timeoutMs": 5000},
  {"step": "assertDialogue", "contains": "[cat.kitten_stroke_1]", "timeoutMs": 5000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[cat.kitten_stroke_2]", "timeoutMs": 5000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[cat.kitten_stroke_3]", "timeoutMs": 5000},
  {"step": "continueDialogue"},
  {"step": "npcOption", "npcId": 5591, "option": "Talk-to", "timeoutMs": 10000},
  {"step": "chooseOption", "text": "[cat.how_old]", "timeoutMs": 10000},
  {"step": "assertDialogue", "contains": "[cat.how_old]", "timeoutMs": 5000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[cat.kitten_under_a_month]", "timeoutMs": 5000, "comment": "no growth yet"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[cat.kitten_age]", "timeoutMs": 5000},
  {"step": "continueDialogue"},
  {"step": "npcOption", "npcId": 5591, "option": "Pick-up", "timeoutMs": 10000},
  {"step": "assertInventory", "item": "Pet kitten", "count": 1, "timeoutMs": 5000, "comment": "back in the backpack"},
  {"step": "assertVarp", "id": 448, "value": -1, "timeoutMs": 5000},
  {"step": "command", "text": "::empty", "comment": "put the account back"},
  {"step": "command", "text": "::varp cat 0"},
  {"step": "command", "text": "::varp cat.care 0"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"}
 ]
}
