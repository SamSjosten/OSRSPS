  {
   "step": "continueDialogue"
  },
  {
   "step": "assertInterface",
   "interfaceId": 300,
   "comment": "Ava's Odds and Ends"
  },
  {
   "step": "waitTicks",
   "ticks": 2,
   "comment": "lets the client draw the stock before clicking a slot"
  },
  {
   "step": "clickWidget",
   "interfaceId": 300,
   "component": 16,
   "slot": 1,
   "op": 2,
   "comment": "Buy 1 on the feathers, the first item"
  },
  {
   "step": "assertInventory",
   "item": "Feather",
   "count": 1
  },
  {
   "step": "command",
   "text": "::tele 3099 3370 0",
   "expectMessage": "Teleported to 3099, 3370, 0",
   "comment": "the witch's spawn tile, in the north-west room; the teleport closes the shop"
