{
 "name": "Draynor piece step 12b: Draynor Manor's people (::keys on): Ava's talk, her shop (one feather bought), the witch and Professor Oddenstein",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "an empty backpack; ::reset at the end puts it back"
  },
  {
   "step": "command",
   "text": "::god on",
   "expectMessage": "You can't be hurt now",
   "comment": "the manor's ghosts and rats"
  },
  {
   "step": "command",
   "text": "::item coins 1000",
   "expectMessage": "Added 1,000 x Coins"
  },
  {
   "step": "command",
   "text": "::tele 3093 3357 0",
   "expectMessage": "Teleported to 3093, 3357, 0",
   "comment": "Ava's spawn tile, in the room behind the bookcases"
  },
  {
   "step": "npcOption",
   "npc": "Ava",
   "option": "Talk-to",
   "timeoutMs": 20000
  },
  {
   "step": "assertDialogue",
   "contains": "[ava.hello]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
   "text": "[ava.more]"
  },
  {
   "step": "chooseOption",
   "text": "[ava.previous]",
   "comment": "back to her first menu"
  },
  {
   "step": "chooseOption",
   "text": "[ava.more]"
  },
  {
   "step": "chooseOption",
   "text": "[ava.head_off]"
  },
  {
   "step": "assertDialogue",
   "contains": "[ava.head_off]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[ava.bed]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertNoDialogue"
  },
  {
   "step": "npcOption",
   "npc": "Ava",
   "option": "Talk-to"
  },
  {
   "step": "assertDialogue",
   "contains": "[ava.hello]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
   "text": "[ava.more]"
  },
  {
   "step": "chooseOption",
   "text": "[ava.stuff]"
