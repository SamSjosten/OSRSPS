  {
   "step": "assertDialogue",
   "contains": "[johnathon.no_thanks"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertNoDialogue"
  },
  {
   "step": "command",
   "text": "::tele 3239 3397 0",
   "expectMessage": "Teleported to 3239, 3397, 0",
