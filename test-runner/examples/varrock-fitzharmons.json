   "comment": "Dimintheis"
  },
  {
   "step": "chooseOption",
   "text": "[dimintheis.other]"
  },
  {
   "step": "assertDialogue",
   "contains": "[dimintheis.greeting"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[dimintheis.gauntlets"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[dimintheis.returned"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
