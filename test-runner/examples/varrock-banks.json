{
 "name": "Varrock step 2: the West and East banks: a booth's Bank, a banker's talk (::keys on) and Bank, and the West Bank's locked door",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "an empty backpack and an empty bank; ::reset at the end puts both back"
  },
  {
   "step": "command",
   "text": "::item logs 3",
   "expectMessage": "Added 3 x Logs"
  },
  {
   "step": "command",
   "text": "::tele 3185 3440 0",
   "expectMessage": "Teleported to 3185, 3440, 0",
   "comment": "Varrock West Bank, in front of the booths (x 3186); the bankers stand behind them at x 3187"
  },
  {
   "step": "locOption",
   "loc": "Bank booth",
   "option": "Bank",
   "x": 3186,
   "y": 3440,
   "comment": "a booth's Bank, with nothing open"
  },
  {
   "step": "assertInterface",
   "interfaceId": 12,
   "comment": "bankmain"
  },
  {
   "step": "clickWidget",
   "interfaceId": 15,
   "component": 3,
   "slot": 0,
   "op": 8,
   "comment": "Deposit-All on the logs"
  },
  {
   "step": "assertInventory",
   "item": "Logs",
   "count": 0
  },
  {
   "step": "logout",
   "comment": "closes the bank: an open bank hides the bankers from the mouse"
  },
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys",
   "comment": "keys don't last past a logout"
  },
  {
   "step": "npcOption",
   "npc": "Banker",
   "option": "Talk-to",
   "timeoutMs": 20000
  },
  {
   "step": "assertDialogue",
   "contains": "[banker.greeting]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
   "text": "[banker.open_bank]"
  },
  {
   "step": "assertInterface",
   "interfaceId": 12,
   "comment": "asking for the bank opens it"
  },
  {
   "step": "clickWidget",
   "interfaceId": 12,
   "component": 12,
   "slot": 0,
   "op": 7,
   "comment": "Withdraw-All on the logs, the bank's first slot"
  },
  {
   "step": "assertInventory",
   "item": "Logs",
   "count": 3
  },
  {
   "step": "logout",
   "comment": "closes the bank again"
  },
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys",
   "comment": "keys don't last past a logout"
  },
  {
   "step": "command",
   "text": "::tele 3185 3446 0",
   "expectMessage": "Teleported to 3185, 3446, 0",
   "comment": "by the West Bank's locked door (3186 3446)"
  },
  {
   "step": "locOption",
   "loc": "Door",
   "option": "Knock-at",
   "x": 3186,
   "y": 3446
  },
  {
   "step": "assertDialogue",
   "contains": "[varrock_bank_door.knock]",
   "comment": "the banker behind it won't let the player in"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "command",
   "text": "::tele 3254 3420 0",
   "expectMessage": "Teleported to 3254, 3420, 0",
   "comment": "Varrock East Bank, north of the booths (z 3419); the bankers stand south of them at z 3418"
  },
  {
   "step": "npcOption",
   "npc": "Banker",
   "option": "Bank",
   "timeoutMs": 20000,
   "comment": "a banker's own Bank, across the booth"
  },
  {
   "step": "assertInterface",
   "interfaceId": 12
  },
  {
   "step": "logout",
   "comment": "closes the bank"
  },
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys",
   "comment": "keys don't last past a logout"
  },
  {
   "step": "locOption",
   "loc": "Bank booth",
   "option": "Bank",
   "x": 3254,
   "y": 3419
  },
  {
   "step": "assertInterface",
   "interfaceId": 12
  },
  {
   "step": "command",
   "text": "::reset",
   "expectMessage": "Back to how you were"
  }
 ]
}
