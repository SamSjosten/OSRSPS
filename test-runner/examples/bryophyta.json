{
 "name": "Misthalin bosses step 2: Bryophyta. The gate in with its warning and menu (the mossy key kept), Check-count, her lair, the logs' bronze axe, her fight, a kill for her giant bones, the chest taking the key for its loot and the count, and out by the rock pile (::keys on). Her growthlings are random, so they are tested headlessly (HeadlessBryophytaTest)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario bryophyta", "expectMessage": "Started scenario bryophyta.", "comment": "the sewer side of the gate with two mossy keys and a bronze axe; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::varp giant_lairs 0", "comment": "the gate not yet unlocked on this account"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now", "comment": "she hits up to 16 and poisons"},
  {"step": "command", "text": "::setlevel attack 99", "expectMessage": "Attack set to level 99"},
  {"step": "command", "text": "::setlevel strength 99", "expectMessage": "Strength set to level 99"},
  {"step": "locOption", "locId": 32534, "option": "Check-Count", "x": 3174, "y": 9901},
  {"step": "assertDialogue", "contains": "[bryophyta.check_count", "timeoutMs": 10000, "comment": "a prefix: with keys on the box shows the count too, [bryophyta.check_count count=0] (nightly 2026-11-16)"},
  {"step": "continueDialogue"},
  {"step": "locOption", "locId": 32534, "option": "Open", "x": 3174, "y": 9901},
  {"step": "assertDialogue", "contains": "[bryophyta.gate_warning]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[bryophyta.gate_title]", "timeoutMs": 10000},
  {"step": "chooseOption", "text": "[bryophyta.gate_yes]"},
  {"step": "assertMessage", "contains": "bryophyta.gate_opened", "timeoutMs": 10000},
  {"step": "assertInventory", "item": "Mossy key", "count": 2, "timeoutMs": 10000, "comment": "the key is kept"},
  {"step": "waitTicks", "ticks": 3, "comment": "the lair's region drawn; its tiles are an instance's, so the locs below are found by id"},
  {"step": "locOption", "locId": 32536, "option": "Take-axe", "comment": "a bronze axe is already in the backpack"},
  {"step": "assertDialogue", "contains": "[bryophyta.have_axe]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "assertHitsplat", "self": true, "timeoutMs": 20000, "comment": "her swing or her spell (a 0 under god mode)"},
  {"step": "npcOption", "npc": "Bryophyta", "option": "Attack", "timeoutMs": 10000},
  {"step": "assertHitsplat", "npc": "Bryophyta", "timeoutMs": 20000},
  {"step": "command", "text": "::kill Bryophyta", "expectMessage": "Killed Bryophyta"},
  {"step": "assertGroundItem", "item": "Giant bones", "timeoutMs": 20000},
  {"step": "locOption", "locId": 56378, "option": "Open"},
  {"step": "assertMessage", "contains": "bryophyta.chest_stir", "timeoutMs": 15000},
  {"step": "assertMessage", "contains": "bryophyta.chest_loot", "timeoutMs": 10000},
  {"step": "assertMessage", "contains": "bryophyta.kill_count", "timeoutMs": 10000},
  {"step": "assertInventory", "item": "Mossy key", "count": 1, "timeoutMs": 10000, "comment": "one key used"},
  {"step": "assertGroundItem", "item": "Scroll box (beginner)", "timeoutMs": 10000, "comment": "the chest's clue always comes, as its scroll box (Treasure Trails step TT9); ::scenario empties the bank, so the cap has room"},
  {"step": "locOption", "locId": 32535, "option": "Clamber", "comment": "the rock pile out"},
  {"step": "assertLocation", "x": 3174, "y": 9900, "plane": 0, "timeoutMs": 15000, "comment": "the sewer side of the gate"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
