   "comment": "the wooden larder's level (the kitchen needs 5); ::reset puts the level back"
  },
  {
   "step": "command",
   "text": "::item 995 5000",
   "expectMessage": "5,000",
   "comment": "the kitchen's price"
  },
  {
   "step": "command",
   "text": "::tele 2953 3224 0",
   "expectMessage": "Teleported to 2953, 3224, 0"
  },
  {
   "step": "waitTicks",
   "ticks": 3
  },
  {
   "step": "locOption",
   "locId": 15478,
   "option": "Build mode"
  },
  {
   "step": "waitTicks",
   "ticks": 4,
   "comment": "the house is a new instance: the region redraws"
  },
  {
   "step": "assertVarbit",
   "id": 2176,
   "value": 1,
   "comment": "poh_building_mode on"
  },
  {
   "step": "locOption",
   "locId": 15313,
   "option": "Build",
   "comment": "the nearest door hotspot to where entering puts you: the garden's south doorway, onto the yard"
  },
  {
   "step": "assertInterface",
   "interfaceId": 212,
   "timeoutMs": 10000,
   "comment": "poh_add_room"
  },
  {
   "step": "clickWidget",
   "interfaceId": 212,
   "component": 9,
   "comment": "the kitchen's button: its op sends the kitchen's room type"
  },
  {
   "step": "chooseOption",
   "text": "[construction.rotate_clockwise]",
   "comment": "the ghost first faces one door north, onto the garden; clockwise turns it the other way that still does"
  },
  {
   "step": "waitTicks",
   "ticks": 2,
   "comment": "the redraw"
  },
  {
   "step": "chooseOption",
   "text": "[construction.build_room]"
  },
  {
   "step": "assertNoDialogue"
  },
  {
   "step": "assertInventory",
   "item": "Coins",
   "count": 0,
   "timeoutMs": 5000,
   "comment": "1,000 paid for the house, 5,000 for the kitchen"
  },
  {
   "step": "command",
   "text": "::item 960 8",
   "expectMessage": "Plank",
   "comment": "the wooden larder: 8 planks and 8 nails"
  },
  {
   "step": "command",
   "text": "::item 1539 8",
   "expectMessage": "Steel nails"
  },
  {
   "step": "command",
   "text": "::item 2347 1",
   "expectMessage": "Hammer"
  },
  {
   "step": "command",
   "text": "::item 8794 1",
   "expectMessage": "Saw"
  },
  {
   "step": "locOption",
   "locId": 15403,
   "option": "Build",
   "comment": "the kitchen's larder space (poh_kitchen_5)"
  },
  {
   "step": "assertInterface",
   "interfaceId": 458,
   "timeoutMs": 10000,
   "comment": "poh_furniture_creation"
  },
  {
   "step": "clickWidget",
   "interfaceId": 458,
   "component": 4,
   "comment": "slot 1: the wooden larder"
  },
  {
   "step": "assertInventory",
   "item": "Plank",
   "count": 0,
   "timeoutMs": 5000
  },
  {
   "step": "assertStat",
   "skill": "Construction",
   "level": 10,
