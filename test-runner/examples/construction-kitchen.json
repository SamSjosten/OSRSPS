   "locId": 13565,
   "option": "Search",
   "comment": "the wooden larder (poh_larder_1)"
  },
  {
   "step": "assertInterface",
   "interfaceId": 270,
   "timeoutMs": 10000,
   "comment": "its supplies in the Make-X box (GUESSED)"
  },
  {
   "step": "clickWidget",
   "interfaceId": 270,
   "component": 15,
   "comment": "the first: tea leaves"
  },
  {
   "step": "assertInventory",
   "item": "Tea leaves",
   "count": 1,
   "timeoutMs": 5000
  },
  {
   "step": "locOption",
   "locId": 13565,
   "option": "Search",
   "comment": "again: it never runs out"
  },
  {
   "step": "assertInterface",
   "interfaceId": 270,
   "timeoutMs": 10000
  },
  {
   "step": "clickWidget",
   "interfaceId": 270,
   "component": 15
  },
  {
   "step": "assertInventory",
   "item": "Tea leaves",
   "count": 2,
   "timeoutMs": 5000
  },
  {
   "step": "command",
