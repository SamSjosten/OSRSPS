  },
  {
   "step": "assertLocation",
   "x": 3244,
   "y": 3226,
   "plane": 0
  },
  {
   "step": "npcOption",
   "npcId": 1838,
   "option": "Examine",
   "timeoutMs": 20000,
   "comment": "a drake (duck, 1838)"
  },
  {
   "step": "assertMessage",
   "contains": "[examine.npc_1838]"
  },
  {
   "step": "npcOption",
   "npcId": 1838,
   "option": "Attack",
   "timeoutMs": 20000,
   "comment": "on the water, past the bridge's railing: no way to it"
  },
  {
   "step": "assertMessage",
   "contains": "reach",
   "timeoutMs": 20000
  },
  {
