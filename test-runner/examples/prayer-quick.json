{
 "name": "Prayer: quick prayers picked in the prayer orb's Setup (Piety and Protect from Melee), Done putting the prayer book back, and the orb turning both on and then every prayer off",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys", "comment": "game messages show their keys, whatever data/dialogue.txt holds"},
  {"step": "command", "text": "::setlevel defence 99", "expectMessage": "Defence set to level 99", "comment": "Piety needs 70 Defence"},
  {"step": "command", "text": "::setlevel prayer 99", "expectMessage": "Prayer set to level 99"},
  {"step": "command", "text": "::varp 84 0", "expectMessage": "Varp 84:", "comment": "prayer1, varbit quickprayer_selected: nothing picked, whatever an earlier run left"},
  {"step": "command", "text": "::buttons on", "expectMessage": "Interface clicks are echoed"},
  {"step": "clickWidget", "interfaceId": 160, "component": 20, "op": 1, "comment": "orbs:prayerbutton, Activate"},
  {"step": "assertMessage", "contains": "[prayer.no_quick_prayers]", "timeoutMs": 10000},
  {"step": "command", "text": "::varbit 4103", "expectMessage": "= 0", "comment": "quickprayer_active: the server puts back the orb the client flipped"},
  {"step": "clickWidget", "interfaceId": 160, "component": 20, "op": 2, "comment": "Setup"},
  {"step": "assertMessage", "contains": "Button 160:20 slot -1 op 2", "timeoutMs": 10000},
  {"step": "assertInterface", "interfaceId": 77, "comment": "quickprayer, in the prayer book's place"},
  {"step": "clickWidget", "interfaceId": 77, "component": 4, "slot": 26, "op": 1, "comment": "quickprayer:buttons, Piety's child (its bit)"},
  {"step": "assertMessage", "contains": "Button 77:4 slot 26 op 1", "timeoutMs": 10000},
  {"step": "clickWidget", "interfaceId": 77, "component": 4, "slot": 14, "op": 1, "comment": "Protect from Melee's"},
  {"step": "assertMessage", "contains": "Button 77:4 slot 14 op 1", "timeoutMs": 10000},
  {"step": "command", "text": "::varp 84", "expectMessage": "Varp 84 = 67125248", "comment": "bits 26 and 14"},
  {"step": "command", "text": "::prayers", "expectMessage": "drain resistance 60: none", "comment": "picking isn't turning on"},
  {"step": "clickWidget", "interfaceId": 77, "component": 5, "op": 1, "comment": "quickprayer:close, Done"},
  {"step": "assertInterface", "interfaceId": 541, "comment": "the prayer book back"},
  {"step": "assertInterface", "interfaceId": 77, "absent": true},
  {"step": "clickWidget", "interfaceId": 160, "component": 20, "op": 1, "comment": "Activate"},
  {"step": "command", "text": "::prayers", "expectMessage": "overhead 0: Protect from Melee, Piety"},
  {"step": "command", "text": "::varbit 4103", "expectMessage": "= 1"},
  {"step": "clickWidget", "interfaceId": 160, "component": 20, "op": 1, "comment": "Deactivate"},
  {"step": "command", "text": "::prayers", "expectMessage": "drain resistance 60: none"},
  {"step": "command", "text": "::varbit 4103", "expectMessage": "= 0"},
  {"step": "command", "text": "::buttons off", "expectMessage": "Interface clicks are not echoed"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
