{
  "name": "Random events: Prison Pete, the lever's balloon window, a key tried, and leaving early with nothing",
  "account": "test",
  "runOnLogin": false,
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"comment": "Off first, so the timer can't send a second event mid-script.", "step": "command", "text": "::randomevent off", "expectMessage": "Random events off"},
    {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied"},
    {"step": "command", "text": "::tele 3222 3218", "expectMessage": "Teleported to 3222, 3218"},
    {"step": "command", "text": "::randomevent prison_pete", "expectMessage": "Started random event prison_pete"},
    {"step": "npcOption", "npc": "Evil Bob", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Evil Bob", "contains": "[prison_pete.pet]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[evil_bob.yes]"},
    {"comment": "The prison: look that it is the Party Room's ScapeRune copy, with balloon animals, the lever and three energy barriers in the east exit.", "step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.captured_too]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[prison_pete.captured]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.stuck_me]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[prison_pete.how_get_out]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.balloon_keys]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.pull_lever]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.bring_keys]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[prison_pete.okay]"},
    {"step": "assertDialogue", "contains": "[prison_pete.okay]"},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"step": "locOption", "loc": "Locked door", "option": "Open", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.this_exit]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "locOption", "loc": "Lever", "option": "Pull", "timeoutMs": 20000},
    {"comment": "The balloon window: look that it shows one balloon animal (dog, cat, sheep or goat), spinning.", "step": "assertInterface", "interfaceId": 273, "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.thats_right]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"comment": "The nearest balloon, right only by chance: Pete's verdict either way.", "step": "npcOption", "npc": "Balloon Animal", "option": "Pop", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.got_key]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.ooh_thanks]"},
    {"step": "continueDialogue"},
    {"step": "finishDialogue"},
    {"step": "assertInventory", "item": "Prison key", "count": 0},
    {"step": "npcOption", "npc": "Prison Pete", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "chooseOption", "text": "[prison_pete.how_get_out]", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[prison_pete.how_get_out]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.balloon_keys]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.pull_lever]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.bring_keys]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[prison_pete.leave_now_option]"},
    {"step": "assertDialogue", "contains": "[prison_pete.leave_now]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Prison Pete", "contains": "[prison_pete.still_stuck]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[prison_pete.yes]"},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0, "timeoutMs": 20000},
    {"step": "assertInventory", "item": "Prison key", "count": 0}
  ]
}
