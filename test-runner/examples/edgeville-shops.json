{
 "name": "Edgeville piece step 2: the General Store's Trade (a knife bought and sold back) and its assistant's talk, Oziach's shop and talk (two options), and Richard's talk into his cape shop, then a yew chopped, a bronze bar smelted at the furnace and a shrimp cooked on Evil Dave's stove (::keys on)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "an empty backpack; ::reset at the end puts it back"
  },
  {
   "step": "command",
   "text": "::item coins 10000",
   "expectMessage": "Added 10,000 x Coins"
  },
  {
   "step": "command",
   "text": "::tele 3080 3511 0",
   "expectMessage": "Teleported to 3080, 3511, 0",
   "comment": "the Edgeville General Store's shop keeper's spawn tile"
  },
  {
   "step": "npcOption",
   "npc": "Shop keeper",
   "option": "Trade",
   "timeoutMs": 20000
  },
  {
   "step": "assertInterface",
   "interfaceId": 300
  },
  {
   "step": "waitTicks",
   "ticks": 2,
   "comment": "lets the client draw the stock before clicking a slot"
  },
  {
   "step": "clickWidget",
   "interfaceId": 300,
   "component": 16,
   "slot": 12,
   "op": 2,
   "comment": "Buy 1 of the twelfth item, Knife (Edgeville's one item Al Kharid's store lacks)"
  },
  {
   "step": "assertInventory",
   "item": "Knife",
   "count": 1
  },
  {
   "step": "waitTicks",
   "ticks": 1,
   "comment": "the runner reads the slot's item from the client's widgets, which redraw a tick after the inventory changes"
  },
  {
   "step": "clickWidget",
   "interfaceId": 301,
   "component": 0,
   "slot": 1,
   "op": 2,
   "comment": "Sell 1 back (slot 1, after the coins)"
  },
  {
   "step": "assertInventory",
   "item": "Knife",
   "count": 0
  },
  {
   "step": "command",
   "text": "::tele 3081 3511 0",
   "expectMessage": "Teleported to 3081, 3511, 0",
   "comment": "the shop assistant's spawn tile; the teleport closes the shop"
  },
  {
   "step": "npcOption",
   "npc": "Shop assistant",
   "option": "Talk-to",
   "timeoutMs": 20000
  },
  {
   "step": "assertDialogue",
   "contains": "[edgeville_shop_assistant.help]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
   "text": "[edgeville_shop_assistant.selling]"
  },
  {
   "step": "assertInterface",
   "interfaceId": 300,
   "comment": "the first option opens the shop"
  },
  {
   "step": "command",
   "text": "::tele 3069 3517 0",
   "expectMessage": "Teleported to 3069, 3517, 0",
   "comment": "Oziach's spawn tile, in his hut north-west of the town"
  },
  {
   "step": "npcOption",
   "npc": "Oziach",
   "option": "Trade",
   "timeoutMs": 20000
  },
  {
   "step": "assertInterface",
   "interfaceId": 300
  },
  {
   "step": "waitTicks",
   "ticks": 2,
   "comment": "lets the client draw the stock before clicking a slot"
  },
  {
   "step": "clickWidget",
   "interfaceId": 300,
   "component": 16,
   "slot": 3,
   "op": 2,
   "comment": "Buy 1 of the third item, Anti-dragon shield (26 coins; the platebody is 84,500)"
  },
  {
   "step": "assertInventory",
   "item": "Anti-dragon shield",
   "count": 1
  },
  {
   "step": "waitTicks",
   "ticks": 1,
   "comment": "the runner reads the slot's item from the client's widgets, which redraw a tick after the inventory changes"
  },
  {
   "step": "clickWidget",
   "interfaceId": 301,
   "component": 0,
   "slot": 1,
   "op": 2,
   "comment": "Sell 1 back (slot 1, after the coins)"
  },
  {
   "step": "assertInventory",
   "item": "Anti-dragon shield",
   "count": 0
  },
  {
   "step": "command",
   "text": "::tele 3069 3517 0",
   "expectMessage": "Teleported to 3069, 3517, 0",
   "comment": "again, to close his shop for his talk"
  },
  {
   "step": "npcOption",
   "npc": "Oziach",
   "option": "Talk-to",
   "timeoutMs": 20000
  },
  {
   "step": "assertDialogue",
   "contains": "[oziach.greeting]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
