  },
  {
   "step": "command",
   "text": "::tele 3099 3518 0",
   "expectMessage": "Teleported to 3099, 3518, 0",
   "comment": "a tile south of Richard (two tiles wide), by the Wilderness Ditch north of the bank"
  },
  {
