   "npc": "Oziach",
   "option": "Talk-to",
   "timeoutMs": 20000
  },
  {
   "step": "assertDialogue",
   "contains": "[oziach.greeting]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
   "text": "[oziach.buy]"
  },
  {
   "step": "assertDialogue",
   "contains": "[oziach.buy]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertInterface",
