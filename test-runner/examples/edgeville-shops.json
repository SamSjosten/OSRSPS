  },
  {
   "step": "clickWidget",
   "interfaceId": 300,
   "component": 16,
   "slot": 1,
   "op": 2,
   "comment": "Buy 1 of the first cape, Team-6 cape (his talk ends in his shop)"
  },
  {
   "step": "assertInventory",
   "item": "Team-6 cape",
   "count": 1
  },
  {
   "step": "waitTicks",
   "ticks": 1,
   "comment": "the runner reads the slot's item from the client's widgets, which redraw a tick after the inventory changes"
  },
  {
   "step": "clickWidget",
   "interfaceId": 301,
   "component": 0,
   "slot": 1,
   "op": 2,
