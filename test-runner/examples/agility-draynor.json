{
 "name": "Agility step 2: one lap of the Draynor Village Rooftop Course, every obstacle crossed to its landing tile, 120 XP and the lap count (::keys on)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "::reset at the end puts the account back"
  },
  {
   "step": "command",
   "text": "::xprate 1",
   "expectMessage": "XP rate set to 1x",
   "comment": "live's rate; ::xprate restore at the end goes back"
  },
  {
   "step": "command",
   "text": "::setlevel agility 30",
   "expectMessage": "30",
   "comment": "13,363 XP: a lap's 120 opens no level-up box"
  },
  {
   "step": "command",
   "text": "::tele 3104 3279 0",
   "expectMessage": "Teleported to 3104, 3279, 0",
   "comment": "east of the rough wall, beside the wheat field north of Draynor's bank"
  },
