{
 "name": "Combat step 6: die with a bag of items, respawn at Lumbridge with the three most valuable, walk back and loot the grave",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare", "comment": "nothing worn or carried, whatever earlier scripts left on the account"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys", "comment": "game messages show their keys, whatever data/dialogue.txt holds"},
  {"step": "command", "text": "::heal", "expectMessage": "Healed to "},
  {"step": "command", "text": "::item rune platebody", "expectMessage": "Added 1 x Rune platebody"},
  {"step": "command", "text": "::item rune full helm", "expectMessage": "Added 1 x Rune full helm"},
  {"step": "command", "text": "::item rune scimitar", "expectMessage": "Added 1 x Rune scimitar"},
  {"step": "command", "text": "::item bronze sword", "expectMessage": "Added 1 x Bronze sword"},
  {"step": "command", "text": "::item coins 10", "expectMessage": "Added 10 x Coins"},
  {"step": "command", "text": "::tele 3218 3218 0", "expectMessage": "Teleported to 3218, 3218, 0", "comment": "the courtyard, west of the spawn"},
  {"step": "command", "text": "::hit 99 me", "expectMessage": ", dead"},
  {"step": "assertMessage", "contains": "[combat.dead]"},
  {"step": "assertAnimation", "id": 836, "comment": "human_death on the player"},
  {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0, "timeoutMs": 15000, "comment": "respawned at the spawn after the death ticks"},
  {"step": "assertInventory", "item": "Rune platebody", "count": 1, "comment": "the three most valuable are kept, the rune items by a wide margin at Grand Exchange or alchemy prices (214's price file made bones worth more than a coin, which the old lobster-sword-coin set relied on)"},
  {"step": "assertInventory", "item": "Rune full helm", "count": 1},
  {"step": "assertInventory", "item": "Rune scimitar", "count": 1},
  {"step": "assertInventory", "item": "Bronze sword", "count": 0},
  {"step": "assertInventory", "item": "Coins", "count": 0},
  {"step": "npcOption", "npc": "Grave", "option": "Examine"},
  {"step": "assertMessage", "contains": "examine.npc_9856", "comment": "the key until the words are filled on the server; run ::keys on first if words are in"},
  {"step": "walk", "x": 3220, "y": 3218, "comment": "walk back towards the grave"},
  {"step": "npcOption", "npc": "Grave", "option": "Check"},
  {"step": "assertMessage", "contains": "[combat.grave_minutes minutes=15]"},
  {"step": "npcOption", "npc": "Grave", "option": "Loot"},
  {"step": "assertInterface", "interfaceId": 672, "timeoutMs": 10000, "comment": "the gravestone, with the bronze sword and 10 coins free to reclaim"},
  {"step": "clickWidget", "interfaceId": 672, "component": 6, "slot": 0, "comment": "Take on the sword (grave slot 0, the most valuable lost; the coins are slot 1)"},
  {"step": "assertInventory", "item": "Bronze sword", "count": 1},
  {"step": "clickWidget", "interfaceId": 672, "component": 8, "comment": "Take-All"},
  {"step": "assertInventory", "item": "Coins", "count": 10},
  {"step": "assertInterface", "interfaceId": 672, "absent": true, "comment": "an emptied grave closes and goes"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were before ::scenario lumbridge-bare."}
 ]
}
