  {"step": "locOption", "locId": 11732, "option": "Steal-from", "x": 2663, "y": 3296, "timeoutMs": 20000, "comment": "Fur stall"},
  {"step": "assertDialogue", "contains": "[thieving.level level=35 stall=fur stall]", "timeoutMs": 15000},
