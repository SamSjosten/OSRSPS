{
 "name": "Museum finds cleaning: tools, a find, the table, the storage crate and a wall map (::keys on)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "waitTicks",
   "ticks": 3,
   "comment": "let the client settle: a command typed straight away can be lost"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::empty",
   "comment": "an empty backpack for the tools and finds"
  },
  {
   "step": "waitTicks",
   "ticks": 2
  },
  {
   "step": "command",
   "text": "::item 1059 1"
  },
  {
   "step": "command",
   "text": "::item 1061 1"
  },
  {
   "step": "waitTicks",
   "ticks": 2
  },
  {
   "step": "itemOption",
   "item": "Leather gloves",
   "option": "Wear"
  },
  {
   "step": "itemOption",
   "item": "Leather boots",
   "option": "Wear"
  },
  {
   "step": "command",
   "text": "::tele 3260 3443 0",
   "expectMessage": "Teleported to 3260, 3443, 0",
   "comment": "inside the museum's cleaning area"
  },
  {
   "step": "waitTicks",
   "ticks": 3
  },
  {
