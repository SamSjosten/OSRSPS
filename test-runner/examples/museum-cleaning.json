   "option": "Take",
   "x": 3263,
   "y": 3446
  },
  {
   "step": "assertInventory",
   "item": "Uncleaned find",
   "count": 1
  },
  {
   "step": "locOption",
   "loc": "Specimen table",
   "option": "Clean",
   "x": 3259,
   "y": 3444
  },
  {
   "step": "assertInventory",
   "item": "Uncleaned find",
   "count": 0,
   "timeoutMs": 15000,
