  },
  {
   "step": "command",
   "text": "::tele 3211 3247 1",
   "expectMessage": "Teleported to 3211, 3247, 1"
  },
  {
   "step": "takeItem",
   "itemId": 1957,
   "x": 3211,
   "y": 3247,
   "timeoutMs": 70000,
   "comment": "Onion, the general store's first floor; waits up to 70 s, as one taken by the last run comes back after 100 ticks"
  },
  {
   "step": "assertInventory",
   "itemId": 1957,
   "count": 1,
   "timeoutMs": 15000
  },
