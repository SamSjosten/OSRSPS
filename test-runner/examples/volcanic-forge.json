{
  "name": "Wilderness step W4.4b: the three malediction shards from ::item, one used on the Volcanic Forge at the Blighted Volcano, the forging's key and the malediction ward in the backpack (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "any scenario: ::reset at the end puts the account's backpack back"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "level 53"},
    {"step": "command", "text": "::empty"},
    {"step": "command", "text": "::item 11931"},
    {"step": "command", "text": "::item 11932"},
    {"step": "command", "text": "::item 11933"},
    {"step": "command", "text": "::tele 3366 3936 0", "expectMessage": "Teleported to 3366, 3936, 0", "comment": "south of the forge, wilderness_volcanoforge 26755"},
    {"step": "useItemOnLoc", "itemId": 11931, "locId": 26755, "x": 3366, "y": 3937},
    {"step": "assertMessage", "contains": "[volcanic_forge.forged]", "timeoutMs": 15000},
    {"step": "assertInventory", "item": "Malediction ward", "count": 1},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."},
    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
