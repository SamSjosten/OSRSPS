{
 "name": "Clan applicants, one player: test joins a clan made by ::clanmake as a recruiter, ::clanapplicant adds a test applicant, and test opens the applicants page from the settings page, reviews it, declines it, then accepts it once it applies again",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "keys"},
  {"step": "command", "text": "::clandisband", "expectMessage": "lan", "comment": "test's own clan from another run, if any: 'Clan ... deleted' or 'You aren't in a clan'"},
  {"step": "command", "text": "::clandisband Apply Gate", "expectMessage": "lan", "comment": "the last run's clan, if any"},
  {"step": "command", "text": "::clanmake Apply Gate", "expectMessage": "Clan Apply Gate made"},
  {"step": "command", "text": "::clanjoin Apply Gate recruiter", "expectMessage": "Joined clan Apply Gate as a recruiter"},
  {"step": "command", "text": "::clanapplicant", "expectMessage": "Applicant applied to Apply Gate"},
  {"step": "runClientScript", "id": 915, "args": [7], "comment": "shows the Clans side tab (toplevel_sidebutton_switch), so its panels count as open"},
  {"step": "clickWidget", "interfaceId": 707, "component": 3, "comment": "the Clans tab's Your Clan tab"},
  {"step": "assertInterface", "interfaceId": 701, "comment": "clans_sidepanel, with the clan"},
  {"step": "clickWidget", "interfaceId": 701, "component": 9, "comment": "Settings: the clan's settings page (clans_info)"},
  {"step": "assertInterface", "interfaceId": 690},
  {"step": "clickWidget", "interfaceId": 690, "component": 21, "comment": "Applications: the applicants page (clans_applicants)"},
  {"step": "assertInterface", "interfaceId": 699},
  {"step": "clickWidget", "interfaceId": 699, "component": 12, "name": "Applicant", "op": 1, "comment": "Review on the list's first entry, which sends resume_pausebutton on 699:11 slot 0"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 699, "component": 39, "comment": "Decline"},
  {"step": "assertMessage", "contains": "[clan.applicant_declined name=Applicant]"},
  {"step": "command", "text": "::clanapplicant", "expectMessage": "Applicant applied to Apply Gate", "comment": "declined, so it can apply again"},
  {"step": "clickWidget", "interfaceId": 699, "component": 34, "comment": "Refresh: the list again"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 699, "component": 12, "name": "Applicant", "op": 1, "comment": "Review again"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 699, "component": 40, "comment": "Accept"},
  {"step": "assertMessage", "contains": "[clan.applicant_accepted name=Applicant]"},
  {"step": "clickWidget", "interfaceId": 699, "component": 33, "comment": "Back: the settings page"},
  {"step": "assertInterface", "interfaceId": 690},
  {"step": "command", "text": "::clandisband Apply Gate", "expectMessage": "Clan Apply Gate deleted"},
  {"step": "runClientScript", "id": 915, "args": [3], "comment": "back to the inventory tab"}
 ]
}
