{
 "name": "Magic: Fire Strike from the spellbook on a castle man, its runes and XP, the level and rune refusals, and a staff of fire for the fire runes",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::setlevel magic 13", "expectMessage": "Magic set to level 13", "comment": "Fire Strike's level; 1,833 XP"},
  {"step": "command", "text": "::item mind rune 2", "expectMessage": "Added 2 x Mind rune"},
  {"step": "command", "text": "::item fire rune 3", "expectMessage": "Added 3 x Fire rune"},
  {"step": "command", "text": "::item air rune 4", "expectMessage": "Added 4 x Air rune"},
  {"step": "command", "text": "::tele 3216 3219 0", "expectMessage": "Teleported to 3216, 3219, 0"},
  {"step": "castOnNpc", "interfaceId": 218, "component": 19, "npc": "Man", "timeoutMs": 20000, "comment": "Fire Strike on the nearest man; in range and in sight there is no walk"},
  {"step": "assertAnimation", "id": 711, "timeoutMs": 20000, "comment": "human_caststrike, no staff"},
  {"step": "assertSpotanim", "id": 99, "timeoutMs": 20000, "comment": "firestrike_casting on the player"},
  {"step": "assertSpotanim", "npc": "Man", "ids": [101, 85], "timeoutMs": 20000, "comment": "firestrike_impact if it hit, failedspell_impact if it splashed, two to four ticks after the cast"},
  {"step": "assertStat", "skill": "Magic", "level": 13, "xp": 1844, "comment": "11.5 for the cast, more if it hit"},
  {"step": "assertInventory", "item": "Mind rune", "count": 1},
  {"step": "assertInventory", "item": "Fire rune", "count": 0},
  {"step": "assertInventory", "item": "Air rune", "count": 2},
  {"step": "castOnNpc", "interfaceId": 218, "component": 19, "npc": "Man", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "You do not have enough Fire Runes to cast this spell.", "timeoutMs": 20000, "comment": "after the first cast's 5 ticks; guessed wording"},
  {"step": "command", "text": "::setlevel magic 12", "expectMessage": "Magic set to level 12"},
  {"step": "castOnNpc", "interfaceId": 218, "component": 19, "npc": "Man", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "Your Magic level is not high enough for this spell.", "timeoutMs": 20000, "comment": "guessed wording"},
  {"step": "command", "text": "::setlevel magic 13", "expectMessage": "Magic set to level 13"},
  {"step": "command", "text": "::item staff of fire", "expectMessage": "Added 1 x Staff of fire"},
  {"step": "itemOption", "item": "Staff of fire", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Staff of fire"},
  {"step": "castOnNpc", "interfaceId": 218, "component": 19, "npc": "Man", "timeoutMs": 20000, "comment": "no fire runes left: the staff stands in for them"},
  {"step": "assertAnimation", "id": 1162, "timeoutMs": 20000, "comment": "human_caststrike_staff"},
  {"step": "assertInventory", "item": "Mind rune", "count": 0},
  {"step": "assertInventory", "item": "Air rune", "count": 0},
  {"step": "command", "text": "::kill man", "expectMessage": "Killed Man #", "comment": "the man fights back once cast on, unless the strike killed him; ::kill picks the man attacking you, so the next script finds no fight going on"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
