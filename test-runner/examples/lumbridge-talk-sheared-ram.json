{
 "name": "Rest of Lumbridge step 5: Talk-to the Sheared Ram's Bartender, a beer for 2 coins (Arthur the Clue Hunter is at the Grand Exchange since 242.1: ge-arthur.json) (::keys on, so keys show whatever data/dialogue.txt holds)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "an empty backpack; ::reset at the end puts it back"
  },
  {
   "step": "command",
   "text": "::item coins 2",
   "expectMessage": "Added 2 x Coins"
  },
  {
   "step": "command",
   "text": "::tele 3229 3238 0",
   "expectMessage": "Teleported to 3229, 3238, 0",
   "comment": "inside the Sheared Ram, in front of the bar"
  },
  {
