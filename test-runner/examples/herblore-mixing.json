  {"step": "useItemOnItem", "item": "Torstol", "onItem": "Super attack(4)"},
  {"step": "assertInterface", "interfaceId": 270, "comment": "skillmulti"},
  {"step": "clickWidget", "interfaceId": 270, "component": 15},
  {"step": "assertInventory", "item": "Super combat potion(4)", "count": 1, "timeoutMs": 10000},
  {"step": "assertInventory", "item": "Super defence(4)", "count": 0},

  {"step": "command", "text": "::item 3018 2", "expectMessage": "Added 2 x Super energy(3)"},
