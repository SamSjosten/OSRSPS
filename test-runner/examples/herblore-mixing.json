  {"step": "command", "text": "::item 10937", "expectMessage": "Added 1 x Nail beast nails"},
  {"step": "useItemOnItem", "item": "Unicorn horn dust", "onItem": "Super restore(4)"},
  {"step": "assertInterface", "interfaceId": 270},
  {"step": "clickWidget", "interfaceId": 270, "component": 15},
  {"step": "assertInventory", "item": "Mixture - step 1(4)", "count": 1, "timeoutMs": 10000},
  {"step": "useItemOnItem", "item": "Snake weed", "onItem": "Mixture - step 1(4)"},
  {"step": "assertInterface", "interfaceId": 270},
  {"step": "clickWidget", "interfaceId": 270, "component": 15},
  {"step": "assertInventory", "item": "Mixture - step 2(4)", "count": 1, "timeoutMs": 10000},
  {"step": "useItemOnItem", "item": "Nail beast nails", "onItem": "Mixture - step 2(4)"},
  {"step": "assertInterface", "interfaceId": 270},
  {"step": "clickWidget", "interfaceId": 270, "component": 15},
  {"step": "assertInventory", "item": "Sanfew serum(4)", "count": 1, "timeoutMs": 10000},

  {"step": "command", "text": "::item 2456", "expectMessage": "Added 1 x Antifire potion(2)"},
  {"step": "command", "text": "::item 11994 2", "expectMessage": "Added 2 x Lava scale shard"},
  {"step": "useItemOnItem", "item": "Lava scale shard", "onItem": "Antifire potion(2)"},
