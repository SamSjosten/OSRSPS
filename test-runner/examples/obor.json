{
 "name": "Misthalin bosses step 1: Obor. The gate in unlocked with a giant key (kept) through its menu, the lair, the rocks down into his pit, his fight, a kill for his giant bones, buried from the floor, the chest taking the key for its loot and the kill count, his respawn, and out by the rocks and the gate's menu (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario obor", "expectMessage": "Started scenario obor.", "comment": "outside the gate with two giant keys; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::varp giant_lairs 0", "comment": "the gate not yet unlocked on this account"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now", "comment": "Obor hits up to 26"},
  {"step": "command", "text": "::setlevel attack 99", "expectMessage": "Attack set to level 99"},
  {"step": "command", "text": "::setlevel strength 99", "expectMessage": "Strength set to level 99"},
  {"step": "locOption", "locId": 29487, "option": "Open", "x": 3095, "y": 9832},
  {"step": "assertDialogue", "contains": "[obor.gate_title]", "timeoutMs": 10000},
  {"step": "chooseOption", "text": "[obor.gate_yes]"},
  {"step": "assertMessage", "contains": "obor.gate_opened", "timeoutMs": 10000},
  {"step": "assertInventory", "item": "Giant key", "count": 2, "timeoutMs": 10000, "comment": "the key is kept"},
  {"step": "waitTicks", "ticks": 3, "comment": "the lair's region drawn; its tiles are an instance's, so the locs below are found by id"},
  {"step": "locOption", "locId": 29491, "option": "Climb", "comment": "the nearest of the four rocks, down into the pit"},
  {"step": "assertHitsplat", "self": true, "timeoutMs": 20000, "comment": "his swing or his rock (a 0 under god mode)"},
  {"step": "npcOption", "npc": "Obor", "option": "Attack", "timeoutMs": 10000},
  {"step": "assertHitsplat", "npc": "Obor", "timeoutMs": 20000},
  {"step": "command", "text": "::kill Obor", "expectMessage": "Killed Obor", "comment": "a knock-back stops the player's attacks, so the kill is finished by command"},
  {"step": "assertGroundItem", "item": "Giant bones", "timeoutMs": 20000},
  {"step": "groundItemOption", "item": "Giant bones", "op": 4, "option": "Take"},
  {"step": "assertMessage", "contains": "giant_bones.no_fit", "timeoutMs": 10000},
  {"step": "groundItemOption", "item": "Giant bones", "op": 3, "option": "Bury"},
  {"step": "assertMessage", "contains": "bones.buried", "timeoutMs": 10000},
  {"step": "locOption", "locId": 56380, "option": "Open"},
  {"step": "assertMessage", "contains": "obor.chest_stir", "timeoutMs": 15000},
  {"step": "assertMessage", "contains": "obor.chest_loot", "timeoutMs": 10000},
  {"step": "assertMessage", "contains": "obor.kill_count", "timeoutMs": 10000},
  {"step": "assertInventory", "item": "Giant key", "count": 1, "timeoutMs": 10000, "comment": "one key used"},
  {"step": "assertGroundItem", "item": "Clue scroll (beginner)", "timeoutMs": 10000, "comment": "the chest's clue always comes"},
  {"step": "waitTicks", "ticks": 16, "comment": "he comes back 15 ticks after the chest"},
  {"step": "command", "text": "::kill Obor", "expectMessage": "Killed Obor", "comment": "back again; killed so the climb isn't knocked back"},
  {"step": "locOption", "locId": 29491, "option": "Climb", "comment": "back up to the ledge"},
  {"step": "waitTicks", "ticks": 8, "comment": "the walk back to the rocks, then the climb's 2 ticks: an Open clicked while the climb still runs is dropped (nightly 2026-11-16 rerun: no menu after 4 ticks)"},
  {"step": "locOption", "locId": 29489, "option": "Open", "comment": "the lair's gate out"},
  {"step": "assertDialogue", "contains": "[obor.exit_title]", "timeoutMs": 10000},
  {"step": "chooseOption", "text": "[obor.exit_yes]"},
  {"step": "assertLocation", "x": 3095, "y": 9832, "plane": 0, "timeoutMs": 15000, "comment": "beside the gate in, on the hill giants' side"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
