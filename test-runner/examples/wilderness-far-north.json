{
  "name": "Wilderness step W3.5: an ice warrior fought on the Frozen Waste Plateau (level 52), then a level 135 rogue at Rogues' Castle (level 53) fought under ::god (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "ice warriors, ice spiders and white wolves are aggressive"},
    {"step": "command", "text": "::tele 2950 3930 0", "expectMessage": "Teleported to 2950, 3930, 0", "comment": "among the plateau's ice warriors"},
    {"step": "npcOption", "npc": "Ice warrior", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Ice warrior", "timeoutMs": 20000},

    {"step": "command", "text": "::tele 3285 3940 0", "expectMessage": "Teleported to 3285, 3940, 0", "comment": "inside Rogues' Castle"},
    {"step": "npcOption", "npc": "Rogue", "option": "Attack", "timeoutMs": 20000, "comment": "a level 15 or 135 rogue, whichever is nearest"},
    {"step": "assertHitsplat", "npc": "Rogue", "timeoutMs": 20000},

    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
