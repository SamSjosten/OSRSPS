{
  "name": "Karamja step K3.2b: a Brimhaven pirate examined (::keys on), fought under ::god, killed with ::kill and its bones on the floor; a tribesman west of the town examined and killed for its bones; a jungle spider north of the town killed for its carcass",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off)."},
    {"step": "command", "text": "::tele 2790 3184 0", "expectMessage": "Teleported to 2790, 3184, 0", "comment": "Palm Street, among the pirates"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npcId": 522, "option": "Examine", "timeoutMs": 20000},
    {"step": "assertMessage", "contains": "[examine.npc_522]"},
    {"step": "npcOption", "npcId": 522, "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Pirate", "timeoutMs": 30000},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Pirate #"},
    {"step": "assertGroundItem", "item": "Bones", "timeoutMs": 15000},
    {"step": "command", "text": "::tele 2726 3160 0", "expectMessage": "Teleported to 2726, 3160, 0", "comment": "the tribesmen's camp west of Brimhaven"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npcId": 530, "option": "Examine", "timeoutMs": 20000},
    {"step": "assertMessage", "contains": "[examine.npc_530]"},
    {"step": "npcOption", "npcId": 530, "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Tribesman", "timeoutMs": 30000},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Tribesman #"},
    {"step": "assertGroundItem", "item": "Bones", "timeoutMs": 15000},
    {"step": "command", "text": "::tele 2767 3206 0", "expectMessage": "Teleported to 2767, 3206, 0", "comment": "the jungle spiders north of the town"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npcId": 3020, "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Jungle spider", "timeoutMs": 30000},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Jungle spider #"},
    {"step": "assertGroundItem", "item": "Spider carcass", "timeoutMs": 15000},
    {"step": "command", "text": "::god", "comment": "off again"}
  ]
}
