{
 "name": "Thrown weapons and the ballista: rune knives thrown at a giant frog on 1000 hitpoints from the weapon slot, falling to the floor, and a light ballista firing rune javelins, then refusing bolts",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::setlevel ranged 75", "expectMessage": "Ranged set to level 75", "comment": "rune knives need 40, the light ballista 65"},
  {"step": "command", "text": "::item rune knife 3", "expectMessage": "Added 3 x Rune knife"},
  {"step": "itemOption", "item": "Rune knife", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Rune knife"},
  {"step": "command", "text": "::combat man", "expectMessage": "Accurate (accurate, ranged standard), speed 3", "comment": "knives are thrown every 3 ticks"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now"},
  {"step": "command", "text": "::tele 3236 3220 0", "expectMessage": "Teleported to 3236, 3220, 0", "comment": "the grass east of the castle, away from the courtyard's men"},
  {"step": "command", "text": "::delnpc mine", "expectMessage": "you put in.", "comment": "anything an earlier run left behind"},
  {"step": "command", "text": "::npc giant_frog_nodrops", "expectMessage": "Spawned Giant frog"},
  {"step": "command", "text": "::npchp 1000 mine", "expectMessage": "1 NPC now on 1000 hitpoints", "comment": "so it lives through every knife and javelin"},
  {"step": "npcOption", "npc": "Giant frog", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertAnimation", "id": 7617, "timeoutMs": 20000, "comment": "human_stake2_pvn; which throw animation live uses for knives is guessed"},
  {"step": "assertSpotanim", "id": 225, "timeoutMs": 20000, "comment": "rune_tknife_launch"},
  {"step": "assertHitsplat", "npc": "Giant frog", "timeoutMs": 20000},
  {"step": "assertEquipment", "slot": "weapon", "empty": true, "timeoutMs": 30000, "comment": "three knives thrown, the slot empty and the fight over"},
  {"step": "assertGroundItem", "item": "Rune knife", "timeoutMs": 15000, "comment": "with no Ava's device, a thrown knife can fall under the frog"},
  {"step": "command", "text": "::item light ballista", "expectMessage": "Added 1 x Light ballista"},
  {"step": "itemOption", "item": "Light ballista", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Light ballista"},
  {"step": "command", "text": "::item rune javelin 2", "expectMessage": "Added 2 x Rune javelin"},
  {"step": "itemOption", "item": "Rune javelin", "option": "Wield"},
  {"step": "assertEquipment", "slot": "ammo", "item": "Rune javelin"},
  {"step": "npcOption", "npc": "Giant frog", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertAnimation", "id": 7555, "timeoutMs": 20000, "comment": "ballista_attack_pvn"},
  {"step": "assertHitsplat", "npc": "Giant frog", "timeoutMs": 20000},
  {"step": "command", "text": "::item rune bolts 5", "expectMessage": "Added 5 x Rune bolts"},
  {"step": "itemOption", "item": "Rune bolts", "option": "Wield"},
  {"step": "npcOption", "npc": "Giant frog", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[combat.wrong_javelins]", "timeoutMs": 20000, "comment": "a ballista fires javelins only; guessed wording"},
  {"step": "command", "text": "::delnpc mine", "expectMessage": "you put in."},
  {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
