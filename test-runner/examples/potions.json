{
 "name": "Potions: a super combat dose boosting Attack, Strength and Defence by 19 and leaving 3 doses, a Saradomin brew healing past 99 and lowering Attack and Strength, a super restore bringing a drained Attack back, and a divine dose costing 10 hitpoints, read off ::stats and ::hp",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "comment": "the messages show their keys, whatever words the dialogue file has"},
  {"step": "command", "text": "::setlevel attack 99", "expectMessage": "Attack set to level 99"},
  {"step": "command", "text": "::setlevel strength 99", "expectMessage": "Strength set to level 99"},
  {"step": "command", "text": "::setlevel defence 99", "expectMessage": "Defence set to level 99"},
  {"step": "command", "text": "::setlevel hitpoints 99", "expectMessage": "Hitpoints set to level 99"},
  {"step": "command", "text": "::statcycles", "expectMessage": "Boost and drain cycles started again", "comment": "no boost wears off for a minute, which is longer than the rest of the script"},
  {"step": "command", "text": "::item 12695", "comment": "4dose2combat, Super combat potion(4)"},
  {"step": "assertInventory", "itemId": 12695, "count": 1},
  {"step": "itemOption", "itemId": 12695, "option": "Drink"},
  {"step": "assertMessage", "contains": "[potion.drink potion=super combat potion]", "timeoutMs": 10000},
  {"step": "assertMessage", "contains": "[potion.doses_left doses=3]", "timeoutMs": 10000},
  {"step": "assertInventory", "itemId": 12697, "count": 1, "comment": "3dose2combat"},
  {"step": "command", "text": "::stats", "expectMessage": "Attack 118/99, Defence 118/99, Strength 118/99"},
  {"step": "command", "text": "::item 6685", "comment": "4dosepotionofsaradomin, Saradomin brew(4)"},
  {"step": "waitTicks", "ticks": 3, "comment": "the drink delay"},
  {"step": "itemOption", "itemId": 6685, "option": "Drink"},
  {"step": "assertMessage", "contains": "[potion.drink_brew potion=saradomin brew]", "timeoutMs": 10000},
  {"step": "command", "text": "::hp", "expectMessage": "You have 115/99 hitpoints", "comment": "99 * 15% + 2 = 16 past the level"},
  {"step": "command", "text": "::stats", "expectMessage": "Attack 105/99, Defence 120/99, Strength 105/99", "comment": "118 - (11 + 2); Defence 99 + 21 beats the 118"},
  {"step": "command", "text": "::item 3024", "comment": "4dose2restore, Super restore(4)"},
  {"step": "command", "text": "::boost attack 50", "expectMessage": "Attack is now 50/99"},
  {"step": "waitTicks", "ticks": 3, "comment": "the drink delay"},
  {"step": "itemOption", "itemId": 3024, "option": "Drink"},
  {"step": "command", "text": "::stats", "expectMessage": "Attack 82/99", "comment": "50 + 99 * 25% + 8"},
  {"step": "command", "text": "::item 23685", "comment": "4dosedivinecombat, Divine super combat potion(4)"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "itemOption", "itemId": 23685, "option": "Drink"},
  {"step": "command", "text": "::hp", "expectMessage": "You have 105/99 hitpoints", "comment": "10 taken"},
  {"step": "command", "text": "::stats", "expectMessage": "Attack 101/99, Defence 120/99, Strength 118/99", "comment": "a boost on a drained stat adds to it: 82 + 19; Defence's 120 is already past the 118"},
  {"step": "command", "text": "::keys off"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
