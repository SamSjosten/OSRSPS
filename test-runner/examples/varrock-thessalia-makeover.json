{
  "name": "Looks step 2: Thessalia's makeover screen, from her Makeover option and from her talk: a style and a swatch previewed, walking off drops them, Confirm keeps them with her line",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::look reset", "expectMessage": "torso 18", "comment": "the default look: the tops' first style, Plain"},
    {"step": "command", "text": "::tele 3204 3417 0", "expectMessage": "Teleported to 3204, 3417, 0", "comment": "Thessalia's Fine Clothes"},
    {"step": "npcOption", "npc": "Thessalia", "option": "Makeover", "timeoutMs": 20000},
    {"step": "assertInterface", "interfaceId": 516, "comment": "makeover, on its tops (makeover_interface_type 3)"},
    {"step": "assertVarbit", "id": 4130, "value": 3},
    {"step": "waitTicks", "ticks": 2, "comment": "lets the client draw the styles before clicking one"},
    {"step": "clickWidget", "interfaceId": 516, "component": 7, "slot": 5, "op": 1, "comment": "Preview the second top, Torn (kit 24): each style is five children"},
    {"step": "assertVarp", "id": 3788, "value": 5, "comment": "makeover_hair lights the second style; check by eye that the model in the middle wears it"},
    {"step": "walk", "x": 3205, "y": 3417, "comment": "walking closes the screen without Apply"},
    {"step": "assertInterface", "interfaceId": 516, "absent": true},
    {"step": "command", "text": "::look", "expectMessage": "torso 18", "comment": "the preview gone, the saved top back"},
    {"step": "npcOption", "npc": "Thessalia", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[thessalia.greeting]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[thessalia.what_got]"},
    {"step": "continueDialogue", "comment": "the player's What have you got?"},
    {"step": "assertDialogue", "contains": "[thessalia.offer]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[thessalia.more]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[thessalia.more_1]"},
    {"step": "continueDialogue"},
    {"step": "continueDialogue"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[thessalia.more_4]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[thessalia.top]"},
    {"step": "assertDialogue", "contains": "[thessalia.catalogue]"},
    {"step": "continueDialogue"},
    {"step": "assertInterface", "interfaceId": 516},
    {"step": "waitTicks", "ticks": 2},
    {"step": "clickWidget", "interfaceId": 516, "component": 7, "slot": 5, "op": 1, "comment": "Preview Torn again"},
    {"step": "clickWidget", "interfaceId": 516, "component": 24, "slot": 6, "op": 1, "comment": "the fourth swatch (two children each)"},
    {"step": "assertVarp", "id": 3789, "value": 3},
    {"step": "clickWidget", "interfaceId": 516, "component": 28, "slot": 0, "op": 1, "comment": "Confirm; the slot is a guess at the button's text child, as the server takes any"},
    {"step": "assertInterface", "interfaceId": 516, "absent": true},
    {"step": "assertDialogue", "contains": "[thessalia.compliment_", "comment": "one of her six lines, at random"},
    {"step": "continueDialogue"},
    {"step": "command", "text": "::look", "expectMessage": "torso 24", "comment": "kept"},
    {"step": "command", "text": "::look", "expectMessage": "colours hair 0, torso 3"},
    {"step": "command", "text": "::look reset", "expectMessage": "Look: body type A", "comment": "the account back as it was"},
    {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"}
  ]
}
