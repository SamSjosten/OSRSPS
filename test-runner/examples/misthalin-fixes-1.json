{
 "name": "Misthalin fixes 1: Hans's Age (op 3), the Sheared Ram Bartender's Trade (beer 2 coins, cooked meat 4), and a members piece of the Wilderness Ditch crossed both ways (::keys on)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "an empty backpack; ::reset at the end puts it back"
  },
  {
   "step": "command",
   "text": "::tele 3222 3218",
   "expectMessage": "Teleported to 3222, 3218"
  },
  {
   "step": "npcOption",
   "npc": "Hans",
   "option": "Age",
   "timeoutMs": 70000
  },
  {
   "step": "assertDialogue",
   "speaker": "Hans",
   "contains": "[hans.newcomers]",
   "timeoutMs": 20000
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "speaker": "Hans",
   "contains": "[hans.time_played",
   "timeoutMs": 5000
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertNoDialogue"
  },
  {
   "step": "command",
   "text": "::item coins 10",
   "expectMessage": "Added 10 x Coins"
  },
  {
   "step": "command",
   "text": "::tele 3232 3239 0",
   "expectMessage": "Teleported to 3232, 3239, 0",
   "comment": "in the Sheared Ram, south of the bar"
  },
  {
   "step": "npcOption",
   "npc": "Bartender",
   "option": "Trade",
   "timeoutMs": 20000
  },
  {
   "step": "assertInterface",
   "interfaceId": 300
  },
  {
   "step": "waitTicks",
   "ticks": 2,
   "comment": "lets the client draw the stock before clicking a slot"
  },
  {
   "step": "clickWidget",
   "interfaceId": 300,
   "component": 16,
   "slot": 1,
   "op": 2,
   "comment": "Buy 1 of the first item, Beer"
  },
  {
   "step": "assertInventory",
   "item": "Beer",
   "count": 1
  },
  {
   "step": "assertInventory",
   "item": "Coins",
   "count": 8
  },
  {
   "step": "clickWidget",
   "interfaceId": 300,
   "component": 16,
   "slot": 3,
   "op": 2,
   "comment": "Buy 1 of the third item, Cooked meat"
  },
  {
   "step": "assertInventory",
   "item": "Cooked meat",
   "count": 1
  },
  {
   "step": "assertInventory",
   "item": "Coins",
   "count": 4
  },
  {
   "step": "command",
   "text": "::varbit 3857 7",
   "comment": "cws_warning_7: the ditch warning turned off, so the jump goes straight away"
  },
  {
   "step": "command",
   "text": "::tele 3330 3520 0",
   "expectMessage": "Teleported to 3330, 3520, 0",
   "comment": "south of a members piece of the ditch (ditch_wilderness_cover_members, x 3328 to 3340)"
  },
  {
   "step": "locOption",
   "loc": "Wilderness Ditch",
   "option": "Cross",
   "x": 3330,
   "y": 3521
  },
  {
   "step": "assertLocation",
   "x": 3330,
   "y": 3523,
   "plane": 0,
   "timeoutMs": 5000
  },
  {
   "step": "locOption",
   "loc": "Wilderness Ditch",
   "option": "Cross",
   "x": 3330,
   "y": 3521
  },
  {
   "step": "assertLocation",
   "x": 3330,
   "y": 3520,
   "plane": 0,
   "timeoutMs": 5000
  },
  {
   "step": "command",
   "text": "::varbit 3857 0",
   "comment": "the ditch warning back on"
  },
  {
   "step": "command",
   "text": "::reset",
   "expectMessage": "Back to how you were"
  }
 ]
}
