{
 "name": "Treasure Trails step TT2: an easy reward casket opens onto the reward screen with the three messages, and the 100th gives the minor scroll case, which opens to raise the cap (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::clue reset", "expectMessage": "No trail, no caskets opened, no scroll cases."},

  {"step": "command", "text": "::item 20546 2", "comment": "trail_reward_casket_easy"},
  {"step": "itemOption", "itemId": 20546, "option": "Open"},
  {"step": "assertInterface", "interfaceId": 73, "comment": "trail_rewardscreen"},
  {"step": "assertMessage", "contains": "trail.well_done"},
  {"step": "assertMessage", "contains": "trail.completed count=1 tier=easy"},
  {"step": "assertMessage", "contains": "trail.worth value="},
  {"step": "assertInventory", "itemId": 20546, "count": 1},
  {"step": "clickWidget", "interfaceId": 73, "component": 4, "comment": "the close button"},

  {"step": "command", "text": "::clue easy done 99", "expectMessage": "easy: 99 caskets opened, cap 2."},
  {"step": "itemOption", "itemId": 20546, "option": "Open"},
  {"step": "assertMessage", "contains": "trail.completed count=100 tier=easy"},
  {"step": "assertInventory", "itemId": 30906, "count": 1, "comment": "scroll_case_easy_minor"},
  {"step": "clickWidget", "interfaceId": 73, "component": 4},
  {"step": "itemOption", "itemId": 30906, "option": "Open"},
  {"step": "assertMessage", "contains": "trail.case_opened"},
  {"step": "assertInventory", "itemId": 30906, "count": 0},
  {"step": "command", "text": "::clue easy done 100", "expectMessage": "easy: 100 caskets opened, cap 3."},

  {"step": "command", "text": "::clue reset", "expectMessage": "No trail, no caskets opened, no scroll cases."},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
