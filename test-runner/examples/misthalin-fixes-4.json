{
 "name": "Misthalin fixes 4: Krystilia in Edgeville's jail turning away Slayer 1, warning before her first task and giving one, then her talk about her hat, and a kill of her task's monster outside the Wilderness not counting (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account at combat 3 and Slayer 1 with no task; ::reset at the end puts it back"},
  {"step": "command", "text": "::tele 3108 3514 0", "expectMessage": "Teleported to 3108, 3514, 0", "comment": "by the jail north-east of Edgeville bank"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npcId": 7663, "option": "Assignment", "timeoutMs": 20000, "comment": "slayer_master_7"},
  {"step": "assertDialogue", "contains": "[slayer_master.too_weak]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "command", "text": "::setlevel slayer 2"},
  {"step": "npcOption", "npcId": 7663, "option": "Assignment", "timeoutMs": 20000},
  {"step": "assertDialogue", "speaker": "Krystilia", "contains": "[krystilia.warn_wilderness]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[krystilia.warn_combat]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[krystilia.warn_aya]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[krystilia.warn_loot]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[krystilia.understand]"},
  {"step": "assertDialogue", "speaker": "Krystilia", "contains": "[slayer_master.new_task ", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[slayer_master.okay_great]"},
  {"step": "assertDialogue", "contains": "[slayer_master.okay_great]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[slayer_master.good_luck]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "assertVarbit", "id": 4067, "value": 7, "comment": "slayer_master: Krystilia"},
  {"step": "npcOption", "npcId": 7663, "option": "Assignment", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[krystilia.still_slaying ", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "npcOption", "npcId": 7663, "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[krystilia.greeting]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[krystilia.hat]"},
  {"step": "assertDialogue", "contains": "[krystilia.hat_said]"},
  {"step": "finishDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::slayer task cows 2 krystilia", "expectMessage": "Task: 2 cows from krystilia."},
  {"step": "command", "text": "::tele 3256 3266 0", "expectMessage": "Teleported to 3256, 3266, 0", "comment": "the cow field east of Lumbridge"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "command", "text": "::kill cow", "expectMessage": "Killed"},
  {"step": "assertMessage", "contains": "[slayer.wilderness_only]", "timeoutMs": 10000},
  {"step": "command", "text": "::slayer clear", "expectMessage": "No task."},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
