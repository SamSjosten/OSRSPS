{
 "name": "Treasure Trails step TT3: Talk-to on Hans with his easy clue gives the next clue, Search on the goblin house boxes does too, and the Lumbridge cook's challenge scroll takes its answer (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::clue reset", "expectMessage": "No trail, no caskets opened, no scroll cases."},

  {"step": "command", "text": "::clue easy cryptic:650", "expectMessage": "Clue (easy): cryptic:650", "comment": "trail_clue_easy_simple005 (2681), Speak to Hans"},
  {"step": "itemOption", "itemId": 2681, "option": "Read"},
  {"step": "assertInterface", "interfaceId": 203},
  {"step": "clickWidget", "interfaceId": 203, "component": 1},
  {"step": "command", "text": "::tele 3221 3218 0", "comment": "Hans walks the castle; he comes past the courtyard"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Hans", "option": "Talk-to"},
  {"step": "assertDialogue", "contains": "[trail.npc_clue]", "timeoutMs": 60000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[trail.another_clue]"},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "itemId": 2681, "count": 0, "comment": "swapped for the next easy clue (or the casket on a one-step trail)"},
  {"step": "command", "text": "::empty"},

  {"step": "command", "text": "::clue reset", "expectMessage": "No trail, no caskets opened, no scroll cases."},
  {"step": "command", "text": "::clue easy cryptic:774", "expectMessage": "Clue (easy): cryptic:774", "comment": "trail_clue_easy_simple003 (2679), Search the boxes in the goblin house near Lumbridge"},
  {"step": "command", "text": "::tele 3246 3245 0"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "command", "text": "::aggro 1000", "comment": "the goblins about the house"},
  {"step": "locOption", "locId": 359, "option": "Search", "x": 3245, "y": 3245},
  {"step": "assertDialogue", "contains": "[trail.another_clue]", "timeoutMs": 30000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "itemId": 2679, "count": 0, "comment": "swapped for the next easy clue"},
  {"step": "command", "text": "::empty"},

  {"step": "command", "text": "::clue reset", "expectMessage": "No trail, no caskets opened, no scroll cases."},
  {"step": "command", "text": "::clue medium anagram:42", "expectMessage": "Clue (medium): anagram:42", "comment": "trail_clue_medium_anagram002 (2843), OK CO: the Lumbridge cook"},
  {"step": "command", "text": "::tele 3209 3214 0", "comment": "the castle kitchen"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Cook", "option": "Talk-to"},
  {"step": "assertDialogue", "contains": "[trail.npc_challenge]", "timeoutMs": 30000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "itemId": 2844, "count": 1, "comment": "his challenge scroll"},
  {"step": "itemOption", "itemId": 2844, "option": "Read"},
  {"step": "assertInterface", "interfaceId": 203},
  {"step": "clickWidget", "interfaceId": 203, "component": 1},
  {"step": "npcOption", "npc": "Cook", "option": "Talk-to"},
  {"step": "enterAmount", "amount": 9, "comment": "How many cannons does Lumbridge Castle have? The cache's answer: 9"},
  {"step": "assertDialogue", "contains": "[trail.npc_right]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[trail.another_clue]"},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "itemId": 2844, "count": 0, "comment": "the challenge scroll is used up"},
  {"step": "assertInventory", "itemId": 2843, "count": 0},
  {"step": "command", "text": "::empty"},

  {"step": "command", "text": "::clue reset", "expectMessage": "No trail, no caskets opened, no scroll cases."},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
