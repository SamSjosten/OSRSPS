{
  "name": "Wilderness step W3.7: the sack between the hut's webs giving a knife, the lever down to the Mage Arena bank, Gundai's talk opening the bank, Lundail's Trade, then the Pirates' Hideout's door locked from outside and opening from inside (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "any scenario: ::reset at the end puts the account's backpack back"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "level 55 with pirates about"},
    {"step": "command", "text": "::empty", "comment": "no knife, so the sack gives one"},
    {"step": "command", "text": "::tele 3090 3956 0", "expectMessage": "Teleported to 3090, 3956, 0", "comment": "the hut's lever, magearena_lever_to_cellar"},
    {"step": "locOption", "locId": 14743, "option": "Search", "x": 3093, "y": 3956},
    {"step": "assertMessage", "contains": "[mage_arena_bank.sack_knife]", "timeoutMs": 15000},
    {"step": "assertInventory", "item": "Knife", "count": 1},
    {"step": "command", "text": "::tele 3090 3956 0", "expectMessage": "Teleported to 3090, 3956, 0"},
    {"step": "locOption", "locId": 5959, "option": "Pull", "x": 3090, "y": 3956},
    {"step": "assertLocation", "x": 2539, "y": 4712, "plane": 0, "timeoutMs": 15000, "comment": "down in the bank, on its own lever's tile"},
    {"step": "npcOption", "npc": "Gundai", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[mage_arena_bank.gundai_bank]"},
    {"step": "assertInterface", "interfaceId": 12, "timeoutMs": 10000, "comment": "bankmain, across Gundai's counter"},
    {"step": "walk", "x": 2539, "y": 4716},
    {"step": "assertLocation", "x": 2539, "y": 4716, "plane": 0, "timeoutMs": 10000},
    {"step": "npcOption", "npc": "Lundail", "option": "Trade", "timeoutMs": 20000},
    {"step": "assertInterface", "interfaceId": 300, "timeoutMs": 10000, "comment": "shopmain: Lundail's Arena-side Rune Shop."},
    {"step": "command", "text": "::tele 3037 3956 0", "expectMessage": "Teleported to 3037, 3956, 0", "comment": "west of the Pirates' Hideout's west door, outside"},
    {"step": "locOption", "locId": 11727, "option": "Open", "x": 3038, "y": 3956},
    {"step": "assertMessage", "contains": "[thieving_lock.door_locked]", "timeoutMs": 10000},
    {"step": "command", "text": "::setlevel thieving 39"},
    {"step": "locOption", "locId": 11727, "option": "Pick-lock", "x": 3038, "y": 3956},
    {"step": "assertMessage", "contains": "[thieving_lock.need_lockpick]", "timeoutMs": 10000},
    {"step": "command", "text": "::tele 3038 3956 0", "expectMessage": "Teleported to 3038, 3956, 0", "comment": "the door's own tile, inside"},
    {"step": "locOption", "locId": 11727, "option": "Open", "x": 3038, "y": 3956},
    {"step": "assertMessage", "contains": "[thieving_lock.through]", "timeoutMs": 10000},
    {"step": "assertLocation", "x": 3037, "y": 3956, "plane": 0, "timeoutMs": 10000, "comment": "out through it"},

    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."},
    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
