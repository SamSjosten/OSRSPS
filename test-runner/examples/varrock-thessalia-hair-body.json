{
  "name": "Looks step 3: the makeover screen's hair page and its body types page (body type, skin colour, pronouns), from Thessalia's Makeover option",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::look reset", "expectMessage": "Look: body type A"},
    {"step": "command", "text": "::tele 3204 3417 0", "expectMessage": "Teleported to 3204, 3417, 0", "comment": "Thessalia's Fine Clothes"},
    {"step": "npcOption", "npc": "Thessalia", "option": "Makeover", "timeoutMs": 20000},
    {"step": "assertInterface", "interfaceId": 516},
    {"step": "waitTicks", "ticks": 2},
    {"step": "clickWidget", "interfaceId": 516, "component": 31, "slot": 10, "op": 1, "comment": "the burger menu's View Hair (child 10 + 2 x page 0); the menu needn't be shown for the click to go"},
    {"step": "assertVarbit", "id": 4130, "value": 0, "comment": "makeover_interface_type 0, the hair page"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "clickWidget", "interfaceId": 516, "component": 7, "slot": 10, "op": 1, "comment": "the third hairstyle, Long (kit 2)"},
    {"step": "clickWidget", "interfaceId": 516, "component": 24, "slot": 4, "op": 1, "comment": "the third hair colour"},
    {"step": "clickWidget", "interfaceId": 516, "component": 27, "slot": 0, "op": 1, "comment": "Apply"},
    {"step": "command", "text": "::look", "expectMessage": "kits hair 2", "comment": "applied with the screen still open"},
    {"step": "clickWidget", "interfaceId": 516, "component": 31, "slot": 14, "op": 1, "comment": "View Body types: the makeover_mage interface"},
    {"step": "assertInterface", "interfaceId": 205},
    {"step": "assertVarp", "id": 261, "value": 0, "comment": "if1, body type A"},
    {"step": "clickWidget", "interfaceId": 205, "component": 8, "op": 1, "comment": "Body type B; check by eye that the model switches, keeping the long hair as body type B's"},
    {"step": "assertVarp", "id": 263, "value": 1, "comment": "if3: the pronoun follows, she/her"},
    {"step": "waitTicks", "ticks": 1},
    {"step": "clickWidget", "interfaceId": 205, "component": 13, "slot": 0, "op": 1, "comment": "the first swatch, skin colour 7 (enum 999's order)"},
    {"step": "assertVarp", "id": 262, "value": 7},
    {"step": "clickWidget", "interfaceId": 205, "component": 24, "op": 1, "comment": "They/them"},
    {"step": "assertVarp", "id": 263, "value": 2},
    {"step": "clickWidget", "interfaceId": 205, "component": 18, "op": 1, "comment": "Confirm"},
    {"step": "assertInterface", "interfaceId": 205, "absent": true},
    {"step": "command", "text": "::look", "expectMessage": "body type B; kits hair 48", "comment": "Long's body type B kit"},
    {"step": "command", "text": "::look", "expectMessage": "skin 7; pronouns they/them"},
    {"step": "command", "text": "::look reset", "expectMessage": "Look: body type A", "comment": "the account back as it was"}
  ]
}
