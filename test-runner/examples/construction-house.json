{
 "name": "Construction step CON1: the Rimmington portal refuses a player with no house, the Varrock estate agent sells the starter house for 1,000 coins with a Construction guide, Home and Build mode take you in, and the exit portal puts you back outside (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::scenario construction", "expectMessage": "Started scenario construction.", "comment": "beside the estate agent with 1,000 coins and no house; ::reset at the end takes the house away again"},
  {"step": "command", "text": "::tele 2953 3224 0", "expectMessage": "Teleported to 2953, 3224, 0", "comment": "outside the Rimmington house portal"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "locId": 15478, "option": "Home"},
  {"step": "assertMessage", "contains": "[construction.no_house]", "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 2187, "value": 0, "comment": "poh_house_location: no house"},
  {"step": "command", "text": "::tele 3241 3476 0", "expectMessage": "Teleported to 3241, 3476, 0", "comment": "back beside the estate agent"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Estate agent", "option": "Talk-to"},
  {"step": "assertDialogue", "contains": "[estate_agent.greeting]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[estate_agent.how_get]"},
  {"step": "assertDialogue", "contains": "[estate_agent.how_get]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[estate_agent.how_get_reply]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[estate_agent.want_buy]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[estate_agent.yes_please]"},
  {"step": "assertDialogue", "contains": "[estate_agent.yes_please]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[estate_agent.sold]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[estate_agent.sold_book]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "assertInventory", "item": "Coins", "count": 0},
  {"step": "assertInventory", "item": "Construction guide", "count": 1},
  {"step": "assertVarbit", "id": 2187, "value": 1, "comment": "poh_house_location: Rimmington (the value is a guess)"},
  {"step": "command", "text": "::tele 2953 3224 0", "expectMessage": "Teleported to 2953, 3224, 0"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "locId": 15478, "option": "Home"},
  {"step": "waitTicks", "ticks": 4, "comment": "the house is a new instance: the region redraws"},
  {"step": "assertVarbit", "id": 2176, "value": 0, "comment": "poh_building_mode off"},
  {"step": "locOption", "locId": 4525, "option": "Enter"},
  {"step": "assertLocation", "x": 2953, "y": 3224, "plane": 0, "timeoutMs": 10000, "comment": "outside the portal (the tile is a guess)"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "locId": 15478, "option": "Enter"},
  {"step": "chooseOption", "text": "[construction.enter_building]"},
  {"step": "waitTicks", "ticks": 4},
  {"step": "assertVarbit", "id": 2176, "value": 1, "comment": "poh_building_mode on"},
  {"step": "locOption", "locId": 4525, "option": "Enter"},
  {"step": "assertLocation", "x": 2953, "y": 3224, "plane": 0, "timeoutMs": 10000},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
