{
 "name": "Construction step CON3: in building mode, Build on the parlour's chair space opens the furniture creation menu; the crude wooden chair is built from 2 planks and 2 nails for 58 XP, and Remove takes it away again (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::scenario construction", "expectMessage": "Started scenario construction.", "comment": "beside the estate agent with 1,000 coins and no house; ::reset at the end takes the house away again"},
  {"step": "npcOption", "npc": "Estate agent", "option": "Talk-to"},
  {"step": "assertDialogue", "contains": "[estate_agent.greeting]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[estate_agent.how_get]"},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[estate_agent.yes_please]"},
  {"step": "continueDialogue"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[estate_agent.sold_book]"},
  {"step": "continueDialogue"},
  {"step": "command", "text": "::item 2347 1", "expectMessage": "Hammer", "comment": "a hammer, a saw, 2 planks and 2 steel nails"},
  {"step": "command", "text": "::item 8794 1", "expectMessage": "Saw"},
  {"step": "command", "text": "::item 960 2", "expectMessage": "Plank"},
  {"step": "command", "text": "::item 1539 2", "expectMessage": "Steel nails"},
  {"step": "command", "text": "::tele 2953 3224 0", "expectMessage": "Teleported to 2953, 3224, 0"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "locId": 15478, "option": "Build mode"},
  {"step": "waitTicks", "ticks": 4, "comment": "the house is a new instance: the region redraws"},
  {"step": "assertVarbit", "id": 2176, "value": 1, "comment": "poh_building_mode on"},
  {"step": "locOption", "locId": 4515, "option": "Build", "comment": "the parlour's first chair space, north of the garden"},
  {"step": "assertInterface", "interfaceId": 458, "timeoutMs": 10000, "comment": "poh_furniture_creation"},
  {"step": "clickWidget", "interfaceId": 458, "component": 4, "comment": "slot 1 (poh_furniture_creation:01): the crude wooden chair; its Build resumes the menu with slot 1"},
  {"step": "assertInventory", "item": "Plank", "count": 0, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Steel nails", "count": 0},
  {"step": "assertStat", "skill": "Construction", "level": 1, "xp": 58, "timeoutMs": 5000},
  {"step": "locOption", "locId": 6752, "option": "Remove", "comment": "poh_chair1, where the space was"},
  {"step": "chooseOption", "text": "[construction.remove_furniture_yes]"},
  {"step": "assertNoDialogue"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "locOption", "locId": 4515, "option": "Build", "comment": "the space is back"},
  {"step": "assertInterface", "interfaceId": 458, "timeoutMs": 10000},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
