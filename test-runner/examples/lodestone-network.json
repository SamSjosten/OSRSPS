{
 "name": "Lodestones: every stone activates once per player and turns active for them, ::lodestone opens the map (our interface 30000), Teleport on an activated stone's row or icon casts there in 28 ticks, Previous destination names the last stone, a stone not yet activated is refused, and nothing casts above level 20 Wilderness (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys", "comment": "messages and the menu show their keys, whatever data/dialogue.txt holds"},
  {"step": "command", "text": "::varp lodestones 0", "expectMessage": "Varp lodestones:", "comment": "the lodestones' varp, by name (its id follows the cache the server loaded): every stone dormant again, so the script runs the same each time"},
  {"step": "command", "text": "::varp 892 1234567", "expectMessage": "Varp 892", "comment": "aide_tele_timer, Home Teleport's last cast: a known value, to see the lodestone cast leave it alone"},

  {"step": "command", "text": "::tele 3236 3221 0", "expectMessage": "Teleported to 3236, 3221, 0", "comment": "Lumbridge: east of the stone, between it and the bridge"},
  {"step": "assertLoc", "loc": "Lodestone", "x": 3232, "y": 3220, "option": "Activate", "comment": "dormant for this player (the varbit is 0)"},
    {"step": "assertMapIcon", "loc": "Lodestone", "x": 3232, "y": 3220, "icon": 65000, "comment": "the dormant look names our map element, config archive 35, and the client has its sprite: the stone's icon on the minimap"},
  {"step": "locOption", "loc": "Lodestone", "option": "Activate", "x": 3232, "y": 3220},
  {"step": "assertMessage", "contains": "[lodestone.activated name=[lodestone.lumbridge]]", "timeoutMs": 10000},
  {"step": "command", "text": "::varbit lodestone.lumbridge", "expectMessage": "bits 0-0) = 1", "comment": "bit 0 of the lodestones' varp, by name"},
  {"step": "assertLoc", "loc": "Lodestone", "x": 3232, "y": 3220, "option": "Teleport", "comment": "the client redraws the stone active from the varbit"},
    {"step": "assertMapIcon", "loc": "Lodestone", "x": 3232, "y": 3220, "icon": 65000, "comment": "the active look keeps the icon"},
  {"step": "locOption", "loc": "Lodestone", "option": "Examine", "x": 3232, "y": 3220, "comment": "every stone shares one examine"},
  {"step": "assertMessage", "contains": "examine.loc_65000", "timeoutMs": 10000, "comment": "its key (::keys on); the words are the Words thread's"},

  {"step": "command", "text": "::tele 3102 3300 0", "expectMessage": "Teleported to 3102, 3300, 0", "comment": "Draynor Village: east of the stone, north of the oak by the north road's signpost"},
  {"step": "assertLoc", "loc": "Lodestone", "x": 3098, "y": 3298, "option": "Activate"},
  {"step": "locOption", "loc": "Lodestone", "option": "Activate", "x": 3098, "y": 3298},
  {"step": "assertMessage", "contains": "[lodestone.activated name=[lodestone.draynor]]", "timeoutMs": 10000},
  {"step": "command", "text": "::varbit lodestone.draynor", "expectMessage": "bits 1-1) = 1"},
  {"step": "assertLoc", "loc": "Lodestone", "x": 3098, "y": 3298, "option": "Teleport"},

  {"step": "command", "text": "::tele 3210 3376 0", "expectMessage": "Teleported to 3210, 3376, 0", "comment": "Varrock: west of the stone south of the south gate, away from the dark wizards' circle east of it, which hunts players up to twice its level (a low-level account hit there is in combat for 16 ticks, and a cast in combat is refused)"},
  {"step": "assertLoc", "loc": "Lodestone", "x": 3213, "y": 3375, "option": "Activate"},
  {"step": "locOption", "loc": "Lodestone", "option": "Activate", "x": 3213, "y": 3375},
  {"step": "assertMessage", "contains": "[lodestone.activated name=[lodestone.varrock]]", "timeoutMs": 10000},
  {"step": "command", "text": "::varbit lodestone.varrock", "expectMessage": "bits 2-2) = 1"},

  {"step": "command", "text": "::tele 3299 3186 0", "expectMessage": "Teleported to 3299, 3186, 0", "comment": "Al Kharid: east of the stone north of the palace's north door"},
  {"step": "assertLoc", "loc": "Lodestone", "x": 3295, "y": 3185, "option": "Activate"},
  {"step": "locOption", "loc": "Lodestone", "option": "Activate", "x": 3295, "y": 3185},
  {"step": "assertMessage", "contains": "[lodestone.activated name=[lodestone.al_kharid]]", "timeoutMs": 10000},
  {"step": "command", "text": "::varbit lodestone.al_kharid", "expectMessage": "bits 3-3) = 1"},

  {"step": "command", "text": "::tele 3076 3505 0", "expectMessage": "Teleported to 3076, 3505, 0", "comment": "Edgeville: east of the stone, on the river's east bank west of the bank"},
  {"step": "assertLoc", "loc": "Lodestone", "x": 3072, "y": 3504, "option": "Activate"},
  {"step": "locOption", "loc": "Lodestone", "option": "Activate", "x": 3072, "y": 3504},
  {"step": "assertMessage", "contains": "[lodestone.activated name=[lodestone.edgeville]]", "timeoutMs": 10000},
  {"step": "command", "text": "::varbit lodestone.edgeville", "expectMessage": "bits 4-4) = 1"},
  {"step": "command", "text": "::varp lodestones", "expectMessage": "Varp lodestones = 31", "comment": "all five bits"},

  {"step": "waitTicks", "ticks": 17, "comment": "longer than the 16-tick in-combat window, so a stray hit on the way round cannot refuse the cast below"},
  {"step": "command", "text": "::lodestone", "comment": "the map, from anywhere: our interface 30000, served through the cache overlay (LodestoneMap.kt names the components)"},
  {"step": "assertInterface", "interfaceId": 30000, "timeoutMs": 10000},
  {"step": "assertWidgetText", "interfaceId": 30000, "component": 3, "contains": "[lodestone.title]", "comment": "the title"},
  {"step": "assertWidgetText", "interfaceId": 30000, "component": 12, "contains": "[lodestone.lumbridge]", "comment": "Lumbridge's row (each stone has five components from 8: lit icon, grey icon, the icon's button, the row, the row's name)"},
  {"step": "assertWidgetText", "interfaceId": 30000, "component": 32, "contains": "[lodestone.edgeville]", "comment": "Edgeville's row"},
  {"step": "clickWidget", "interfaceId": 30000, "component": 11, "op": 1, "comment": "Teleport on Lumbridge's row"},
  {"step": "assertInterface", "interfaceId": 30000, "absent": true, "timeoutMs": 10000, "comment": "the map closes on the pick"},
  {"step": "assertAnimation", "id": 65000, "timeoutMs": 10000, "comment": "the cast's first stage, our own sequence (step 8): the arms-raised pose, held while the white pulse builds; the client has it from the overlay"},
  {"step": "assertSpotanim", "id": 65000, "timeoutMs": 10000, "comment": "the pulse: Tele Other's graphic drawn white-cyan, our own spotanim, on the player"},
  {"step": "assertAnimation", "id": 65001, "timeoutMs": 25000, "comment": "the rise (Tele Other's recipient's frames), 3 ticks before the landing"},
  {"step": "assertAnimation", "id": 65003, "timeoutMs": 10000, "comment": "the landing (step 8b): the rise backwards on the arrival tile, 1.4 s, so it is waited for before the tile is checked"},
  {"step": "assertLocation", "x": 3233, "y": 3221, "plane": 0, "timeoutMs": 10000, "comment": "the stone's centre, 28 ticks after the pick"},
  {"step": "command", "text": "::varp 892", "expectMessage": "Varp 892 = 1234567", "comment": "no cooldown: a lodestone cast leaves the home teleport timer as it was"},
  {"step": "command", "text": "::varbit lodestone.previous", "expectMessage": "bits 8-11) = 1", "comment": "Previous destination: Lumbridge's index plus one, in the lodestones' varp"},

  {"step": "locOption", "loc": "Lodestone", "option": "Teleport", "x": 3232, "y": 3220, "comment": "Teleport on an active stone opens the same map"},
  {"step": "assertInterface", "interfaceId": 30000, "timeoutMs": 10000},
  {"step": "assertWidgetText", "interfaceId": 30000, "component": 7, "contains": "[lodestone.previous name=[lodestone.lumbridge]]", "comment": "the Previous destination button names the last stone"},
  {"step": "clickWidget", "interfaceId": 30000, "component": 15, "op": 1, "comment": "Teleport on Draynor's icon on the map"},
  {"step": "assertInterface", "interfaceId": 30000, "absent": true, "timeoutMs": 10000},
  {"step": "assertLocation", "x": 3099, "y": 3299, "plane": 0, "timeoutMs": 25000},

  {"step": "command", "text": "::lodestone"},
  {"step": "assertInterface", "interfaceId": 30000, "timeoutMs": 10000},
  {"step": "assertWidgetText", "interfaceId": 30000, "component": 7, "contains": "[lodestone.previous name=[lodestone.draynor]]"},
  {"step": "clickWidget", "interfaceId": 30000, "component": 4, "op": 1, "comment": "the close button: no cast"},
  {"step": "assertInterface", "interfaceId": 30000, "absent": true, "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 3},
  {"step": "assertLocation", "x": 3099, "y": 3299, "plane": 0, "comment": "still at Draynor's stone"},

  {"step": "command", "text": "::varp lodestones 1", "expectMessage": "Varp lodestones:", "comment": "only Lumbridge activated again, and no previous destination"},
  {"step": "command", "text": "::lodestone varrock"},
  {"step": "assertMessage", "contains": "[lodestone.locked name=[lodestone.varrock]]", "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 3},
  {"step": "assertLocation", "x": 3099, "y": 3299, "plane": 0, "comment": "still at Draynor's stone"},
  {"step": "command", "text": "::lodestone"},
  {"step": "assertInterface", "interfaceId": 30000, "timeoutMs": 10000},
  {"step": "assertWidgetText", "interfaceId": 30000, "component": 22, "contains": "[lodestone.varrock]", "comment": "Varrock's row, greyed: the real client offers no Teleport on it (no events), so only the name is checked"},
  {"step": "clickWidget", "interfaceId": 30000, "component": 4, "op": 1},
  {"step": "assertInterface", "interfaceId": 30000, "absent": true, "timeoutMs": 10000},

  {"step": "command", "text": "::tele 3100 3700 0", "expectMessage": "Teleported to 3100, 3700, 0", "comment": "level 23 Wilderness"},
  {"step": "command", "text": "::lodestone lumbridge"},
  {"step": "assertMessage", "contains": "[home_teleport.wilderness]", "timeoutMs": 10000, "comment": "the first of live's two lines"},
  {"step": "assertMessage", "contains": "[home_teleport.wilderness_2]", "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 30},
  {"step": "assertLocation", "x": 3100, "y": 3700, "plane": 0, "comment": "no cast above level 20"},

  {"step": "command", "text": "::tele 3222 3218 0", "expectMessage": "Teleported to 3222, 3218, 0", "comment": "back to the courtyard; the lodestone varp stays as the player's own"},
  {"step": "command", "text": "::varp 892 0", "expectMessage": "Varp 892", "comment": "the home teleport timer back to none"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"}
 ]
}
