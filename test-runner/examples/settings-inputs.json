  {"step": "command", "text": "::varp 2992 0", "expectMessage": "Varp 2992", "comment": "option_chat_colour_public_opaque (Chat row 26, colour 87): 0, the row's default"},
  {"step": "clickWidget", "interfaceId": 162, "component": 11, "op": 3, "comment": "chatbox:chat_public, Show standard: the filter the run starts from"},
  {"step": "clickWidget", "interfaceId": 548, "component": 52, "comment": "toplevel:stone11, the settings tab, in the fixed frame the VM's client uses"},
  {"step": "clickWidget", "interfaceId": 116, "component": 32, "comment": "settings_side:settings_open, All Settings"},
  {"step": "assertInterface", "interfaceId": 134},

  {"step": "clickWidget", "interfaceId": 134, "component": 24, "slot": 2, "comment": "Chat"},
  {"step": "assertVarbit", "id": 9656, "value": 2},
  {"step": "clickWidget", "interfaceId": 134, "component": 20, "slot": 15, "comment": "the loot notification value's Select: settings_input_op, then the server's prompt"},
  {"step": "enterAmount", "amount": 5000},
  {"step": "assertVarbit", "id": 5400, "value": 5000},
  {"step": "assertVarbit", "id": 9657, "value": 39, "comment": "settings_selected_setting"},

  {"step": "clickWidget", "interfaceId": 134, "component": 20, "slot": 26, "comment": "public chat's colour: the server opens colour_pallet over the window"},
  {"step": "assertInterface", "interfaceId": 288},
  {"step": "assertVarbit", "id": 9657, "value": 87, "comment": "colour_pallet finds the row by it"},
  {"step": "clickWidget", "interfaceId": 288, "component": 11, "slot": 0, "comment": "colour_pallet:pallet_colours child 0, the first swatch: enum 3760 has no key 0, so it is the row's default, 0x0000ff"},
  {"step": "clickWidget", "interfaceId": 288, "component": 13, "comment": "colour_pallet:submit, Save: resume_countdialog with the colour (script614)"},
  {"step": "assertInterface", "interfaceId": 288, "absent": true},
  {"step": "assertVarp", "id": 2992, "value": 256, "comment": "the colour plus 1 (settings_get_colour subtracts it)"},
  {"step": "clickWidget", "interfaceId": 134, "component": 20, "slot": 26},
  {"step": "assertInterface", "interfaceId": 288},
  {"step": "clickWidget", "interfaceId": 288, "component": 12, "comment": "colour_pallet:cancel, which sends 2^31 - 1"},
  {"step": "assertInterface", "interfaceId": 288, "absent": true},
  {"step": "waitTicks", "ticks": 2},
  {"step": "assertVarp", "id": 2992, "value": 256},

  {"step": "clickWidget", "interfaceId": 134, "component": 24, "slot": 7, "comment": "Warnings"},
  {"step": "assertVarbit", "id": 9656, "value": 7},
  {"step": "clickWidget", "interfaceId": 134, "component": 20, "slot": 28, "comment": "the Alchemy spells warning value"},
  {"step": "enterAmount", "amount": 12345},
  {"step": "assertVarbit", "id": 6091, "value": 12345},

  {"step": "clickWidget", "interfaceId": 134, "component": 4, "comment": "settings:close"},
  {"step": "assertInterface", "interfaceId": 134, "absent": true},
  {"step": "clickWidget", "interfaceId": 162, "component": 11, "op": 4, "comment": "Public: Show friends; the client sends SET_CHATFILTERSETTINGS and the label waits for the server's answer"},
  {"step": "assertWidgetText", "interfaceId": 162, "component": 11, "contains": "Friends"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "logout"},
  {"step": "waitForLogin"},
  {"step": "assertVarbit", "id": 5400, "value": 5000},
  {"step": "assertVarbit", "id": 6091, "value": 12345},
  {"step": "assertVarp", "id": 2992, "value": 256},
  {"step": "assertWidgetText", "interfaceId": 162, "component": 11, "contains": "Friends", "comment": "the filter the server saved and sent at login"},

  {"step": "clickWidget", "interfaceId": 162, "component": 11, "op": 3, "comment": "everything back as the script found it"},
  {"step": "command", "text": "::varbit 5400 0", "expectMessage": "Varbit 5400"},
  {"step": "command", "text": "::varbit 6091 0", "expectMessage": "Varbit 6091"},
  {"step": "command", "text": "::varp 2992 0", "expectMessage": "Varp 2992"},
  {"step": "command", "text": "::varp 2855 0", "expectMessage": "Varp 2855"}
 ]
