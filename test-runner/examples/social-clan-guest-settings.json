{
 "name": "Clan guest settings, one player: test joins a clan made by ::clanmake as a recruiter (the owner's rank), blocks and permits guests and sets a guest requirement on the permissions page",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "keys"},
  {"step": "command", "text": "::clandisband", "expectMessage": "lan", "comment": "test's own clan from another run, if any"},
  {"step": "command", "text": "::clandisband Guest Rules", "expectMessage": "lan", "comment": "the last run's clan, if any"},
  {"step": "command", "text": "::clanmake Guest Rules", "expectMessage": "Clan Guest Rules made"},
  {"step": "command", "text": "::clanjoin Guest Rules recruiter", "expectMessage": "Joined clan Guest Rules as a recruiter"},
  {"step": "command", "text": "::clanguests", "expectMessage": "Guests permitted; combat 0, skill_total 0, quest_points 0, iron_status 0"},
  {"step": "runClientScript", "id": 915, "args": [7], "comment": "shows the Clans side tab, so its panels count as open"},
  {"step": "clickWidget", "interfaceId": 707, "component": 3, "comment": "the Clans tab's Your Clan tab"},
  {"step": "assertInterface", "interfaceId": 701},
  {"step": "clickWidget", "interfaceId": 701, "component": 9, "comment": "Settings: clans_info"},
  {"step": "assertInterface", "interfaceId": 690},
  {"step": "clickWidget", "interfaceId": 690, "component": 23, "comment": "Permissions: clans_permissions"},
  {"step": "assertInterface", "interfaceId": 706},
  {"step": "clickWidget", "interfaceId": 706, "component": 12, "slot": 10, "op": 1, "comment": "Guests may listen in chat (shows Permitted)"},
  {"step": "assertDialogue", "contains": "[clan.guest_listen_title]"},
  {"step": "chooseOption", "text": "[clan.guest_blocked]"},
  {"step": "command", "text": "::clanguests", "expectMessage": "Guests blocked; combat 0, skill_total 0, quest_points 0, iron_status 0", "comment": "the page now shows Blocked, and N/A for the requirements"},
  {"step": "clickWidget", "interfaceId": 706, "component": 12, "slot": 10, "op": 1, "comment": "Guests may listen again"},
  {"step": "assertDialogue", "contains": "[clan.guest_listen_title]"},
  {"step": "chooseOption", "text": "[clan.guest_permitted]"},
  {"step": "clickWidget", "interfaceId": 706, "component": 12, "slot": 11, "op": 1, "comment": "Guest minimum combat: the amount prompt"},
  {"step": "enterAmount", "amount": 50},
  {"step": "command", "text": "::clanguests", "expectMessage": "Guests permitted; combat 50, skill_total 0, quest_points 0, iron_status 0", "comment": "the page shows 50"},
  {"step": "clickWidget", "interfaceId": 706, "component": 12, "slot": 14, "op": 1, "comment": "Guest Iron status: the list"},
  {"step": "assertDialogue", "contains": "[clan.guest_iron_title]"},
  {"step": "chooseOption", "text": "[clan.iron_none]"},
  {"step": "command", "text": "::clanguests", "expectMessage": "Guests permitted; combat 50, skill_total 0, quest_points 0, iron_status 0"},
  {"step": "assertInterface", "interfaceId": 706, "comment": "the permissions page stayed open"},
  {"step": "clickWidget", "interfaceId": 706, "component": 5, "comment": "Back: the settings page"},
  {"step": "assertInterface", "interfaceId": 690},
  {"step": "clickWidget", "interfaceId": 690, "component": 3, "comment": "close the settings page, so no window is left open for the next script"},
  {"step": "assertInterface", "interfaceId": 690, "absent": true},
  {"step": "command", "text": "::clandisband Guest Rules", "expectMessage": "Clan Guest Rules deleted"},
  {"step": "runClientScript", "id": 915, "args": [3], "comment": "back to the inventory tab"}
 ]
}
