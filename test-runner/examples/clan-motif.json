{
 "name": "The clan motif (Icon customisation): in a clan made by ::clanmake, as its top rank, the settings page's motif opens Icon customisation; red picked and saved turns the blue clan cloak held red, and a second opening's Cancel changes nothing",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::clandisband", "expectMessage": "lan", "comment": "test's own clan from another run, if any"},
  {"step": "command", "text": "::clandisband Motif Gate", "expectMessage": "lan", "comment": "the last run's clan, if any"},
  {"step": "command", "text": "::clanmake Motif Gate", "expectMessage": "Clan Motif Gate made"},
  {"step": "command", "text": "::clanjoin Motif Gate recruiter", "expectMessage": "Joined clan Motif Gate as a recruiter", "comment": "the top rank: the Icons permission allows it"},
  {"step": "command", "text": "::item 25715", "comment": "a blue clan cloak, the colour of a clan that never picked one"},
  {"step": "assertInventory", "itemId": 25715, "count": 1, "timeoutMs": 10000},
  {"step": "runClientScript", "id": 915, "args": [7], "comment": "shows the Clans side tab, so its panels count as open"},
  {"step": "clickWidget", "interfaceId": 707, "component": 3, "comment": "the Clans tab's Your Clan tab"},
  {"step": "assertInterface", "interfaceId": 701},
  {"step": "clickWidget", "interfaceId": 701, "component": 9, "comment": "Settings: clans_info"},
  {"step": "assertInterface", "interfaceId": 690},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 690, "component": 5, "op": 1, "comment": "the motif's Edit: Icon customisation in clans_info:popup"},
  {"step": "assertInterface", "interfaceId": 694, "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 694, "component": 13, "slot": 12, "op": 1, "comment": "red, enum_3819's fourth colour: each colour is 4 children of colour_picker (its square, its hover square and a thinbox's 2)"},
  {"step": "clickWidget", "interfaceId": 694, "component": 8, "op": 1, "comment": "Save"},
  {"step": "assertInterface", "interfaceId": 694, "absent": true, "timeoutMs": 10000},
  {"step": "assertInventory", "itemId": 25716, "count": 1, "timeoutMs": 10000, "comment": "the cloak held is the red one now"},
  {"step": "assertInventory", "itemId": 25715, "count": 0},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 690, "component": 5, "op": 1, "comment": "Edit again"},
  {"step": "assertInterface", "interfaceId": 694, "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 694, "component": 13, "slot": 16, "op": 1, "comment": "green, picked but not saved"},
  {"step": "clickWidget", "interfaceId": 694, "component": 7, "op": 1, "comment": "Cancel"},
  {"step": "assertInterface", "interfaceId": 694, "absent": true, "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 2},
  {"step": "assertInventory", "itemId": 25716, "count": 1, "comment": "still red"},
  {"step": "clickWidget", "interfaceId": 690, "component": 3, "comment": "close the settings page"},
  {"step": "command", "text": "::clandisband Motif Gate", "expectMessage": "Clan Motif Gate deleted"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
