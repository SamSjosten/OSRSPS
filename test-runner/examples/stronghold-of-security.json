{
 "name": "Edgeville piece step 12: the Stronghold of Security's first floor. Down the entrance, the Dead Explorer's notes, the portal to the reward room, the Gift of Peace once (coins and the Flap emote), the gates letting the player through without questions once it is claimed, and back up the ladder (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now"},
  {"step": "command", "text": "::varbit 2309 0", "comment": "sos_emote_flap: the Gift of Peace not yet claimed"},
  {"step": "command", "text": "::tele 3081 3421 0", "expectMessage": "Teleported to 3081, 3421, 0", "comment": "beside the entrance in the Barbarian Village mine"},
  {"step": "locOption", "locId": 20790, "option": "Climb-down", "x": 3081, "y": 3420},
  {"step": "assertLocation", "x": 1859, "y": 5243, "plane": 0, "timeoutMs": 10000, "comment": "south of the floor's ladder up (the landing is guessed)"},
  {"step": "command", "text": "::tele 1860 5241 0", "expectMessage": "Teleported to 1860, 5241, 0", "comment": "beside the Dead Explorer"},
  {"step": "locOption", "locId": 20788, "option": "Search", "x": 1860, "y": 5240},
  {"step": "assertMessage", "contains": "stronghold_of_security.explorer_find", "timeoutMs": 10000},
  {"step": "assertInventory", "item": "Stronghold notes", "timeoutMs": 10000},
  {"step": "locOption", "locId": 20788, "option": "Search", "x": 1860, "y": 5240},
  {"step": "assertMessage", "contains": "stronghold_of_security.explorer_nothing", "timeoutMs": 10000},
  {"step": "command", "text": "::setlevel attack 30", "expectMessage": "Attack set to level 30"},
  {"step": "command", "text": "::setlevel strength 30", "expectMessage": "Strength set to level 30"},
  {"step": "command", "text": "::setlevel defence 30", "expectMessage": "Defence set to level 30"},
  {"step": "command", "text": "::setlevel hitpoints 30", "expectMessage": "Hitpoints set to level 30", "comment": "combat level 34: the portal's 26 met"},
  {"step": "command", "text": "::tele 1863 5239 0", "expectMessage": "Teleported to 1863, 5239, 0", "comment": "beside the portal"},
  {"step": "locOption", "locId": 20786, "option": "Use", "x": 1863, "y": 5238},
  {"step": "assertLocation", "x": 1910, "y": 5222, "plane": 0, "timeoutMs": 10000, "comment": "the reward room (the landing is guessed)"},
  {"step": "command", "text": "::tele 1907 5223 0", "expectMessage": "Teleported to 1907, 5223, 0", "comment": "north of the Gift of Peace"},
  {"step": "locOption", "locId": 20656, "option": "Open", "x": 1907, "y": 5222},
  {"step": "assertDialogue", "contains": "stronghold_of_security.gift_open", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "stronghold_of_security.gift_reward", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "item": "Coins", "count": 2000, "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 2309, "value": 1, "timeoutMs": 10000, "comment": "sos_emote_flap: the Flap emote unlocked, the reward claimed"},
  {"step": "locOption", "locId": 20656, "option": "Open", "x": 1907, "y": 5222},
  {"step": "assertDialogue", "contains": "stronghold_of_security.gift_claimed", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "command", "text": "::tele 1903 5203 0", "expectMessage": "Teleported to 1903, 5203, 0", "comment": "west of the pair of gates at x 1904 and 1907"},
  {"step": "locOption", "locId": 19206, "option": "Open", "x": 1904, "y": 5203},
  {"step": "assertLocation", "x": 1904, "y": 5203, "plane": 0, "timeoutMs": 10000, "comment": "in the passage between the pair"},
  {"step": "command", "text": "::tele 1906 5203 0", "expectMessage": "Teleported to 1906, 5203, 0"},
  {"step": "locOption", "locId": 19206, "option": "Open", "x": 1907, "y": 5203},
  {"step": "assertLocation", "x": 1907, "y": 5203, "plane": 0, "timeoutMs": 10000, "comment": "the second gate asks no question once the reward is claimed"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::tele 1913 5225 0", "expectMessage": "Teleported to 1913, 5225, 0", "comment": "south of the reward room's ladder"},
  {"step": "locOption", "locId": 20784, "option": "Climb-up", "x": 1913, "y": 5226},
  {"step": "assertLocation", "x": 3081, "y": 3421, "plane": 0, "timeoutMs": 10000, "comment": "beside the entrance"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
