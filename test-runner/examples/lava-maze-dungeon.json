{
  "name": "Wilderness step W3.4b: the Lava Maze's pen ladder down to the King Black Dragon's end of its dungeon and back up, then the muddy chest refused without a key and opened with one, then the metal gates opened and closed, then a black dragon in the dungeon killed (::keys on)",
  "account": "test2",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "any scenario: ::reset at the end takes the chest's loot back off the account"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "the pen's lesser demons and the dungeon's poison spiders are aggressive"},
    {"step": "command", "text": "::item 1333", "comment": "a melee weapon of its own: a bow left worn with no ammo by an earlier script fights with no hitsplat (nightly 2026-11-27)"},
    {"step": "itemOption", "item": "Rune scimitar", "option": "Wield"},
    {"step": "waitTicks", "ticks": 1},
    {"step": "command", "text": "::tele 3017 3848 0", "expectMessage": "Teleported to 3017, 3848, 0", "comment": "in the lesser demons' pen, south of wildymirrorladdertop1 at 3017, 3849"},
    {"step": "locOption", "locId": 18987, "option": "Climb-down", "x": 3017, "y": 3849},
    {"step": "assertLoc", "locId": 1816, "x": 3067, "y": 10253, "timeoutMs": 10000, "comment": "the King Black Dragon's lever: the ladder comes out at the dungeon's east end"},
    {"step": "locOption", "locId": 18988, "option": "Climb-up", "x": 3069, "y": 10256},
    {"step": "assertLoc", "locId": 18987, "x": 3017, "y": 3849, "timeoutMs": 10000, "comment": "back up in the pen"},

    {"step": "command", "text": "::tele 3089 3858 0", "expectMessage": "Teleported to 3089, 3858, 0", "comment": "south of muddy_chestclosed at 3089, 3859"},
    {"step": "locOption", "locId": 170, "option": "Open", "x": 3089, "y": 3859},
    {"step": "assertMessage", "contains": "lava_maze.chest_locked", "timeoutMs": 10000},
    {"step": "command", "text": "::item 991", "comment": "a muddy key"},
    {"step": "assertInventory", "item": "Muddy key", "count": 1},
    {"step": "locOption", "locId": 170, "option": "Open", "x": 3089, "y": 3859},
    {"step": "assertMessage", "contains": "lava_maze.chest_treasure", "timeoutMs": 10000},
    {"step": "assertInventory", "item": "Uncut ruby", "count": 1, "comment": "with 2 noted mithril bars, 5 law, 5 death and 15 chaos runes always"},
    {"step": "assertInventory", "item": "Muddy key", "count": 0},

    {"step": "command", "text": "::tele 3075 3866 0", "expectMessage": "Teleported to 3075, 3866, 0", "comment": "south of the metal gates north of the maze's middle"},
    {"step": "locOption", "locId": 1568, "option": "Open", "x": 3075, "y": 3867},
    {"step": "assertLoc", "locId": 1571, "x": 3075, "y": 3868, "timeoutMs": 5000, "comment": "swung open a tile north"},
    {"step": "locOption", "locId": 1571, "option": "Close", "x": 3075, "y": 3868},
    {"step": "assertLoc", "locId": 1568, "x": 3075, "y": 3867, "timeoutMs": 5000},

    {"step": "command", "text": "::tele 3046 10266 0", "expectMessage": "Teleported to 3046, 10266, 0", "comment": "beside a black dragon's spawn (3048, 10266) in the dungeon"},
    {"step": "npcOption", "npc": "Black dragon", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Black dragon", "timeoutMs": 20000},
    {"step": "command", "text": "::drops", "expectMessage": "Black dragon always drops: Dragon bones, Black dragonhide"},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Black dragon #"},
    {"step": "assertGroundItem", "item": "Dragon bones", "timeoutMs": 15000},

    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
