{
 "name": "Achievement diaries: an easy lamp rubbed for 2,500 Mining XP (::keys on)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "waitTicks",
   "ticks": 3,
   "comment": "let the client settle: a command typed straight away can be lost"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "::reset at the end puts the account back"
  },
  {
   "step": "command",
   "text": "::setlevel mining 30"
  },
  {
   "step": "command",
   "text": "::item 13145 1",
   "comment": "an easy diary lamp"
  },
  {
   "step": "waitTicks",
   "ticks": 2
  },
  {
   "step": "itemOption",
   "item": "Antique lamp",
   "option": "Rub"
  },
  {
   "step": "assertInterface",
   "interfaceId": 240
  },
  {
   "step": "assertWidgetText",
   "interfaceId": 240,
   "component": 26,
   "contains": "antique_lamp.title"
  },
  {
   "step": "clickWidget",
   "interfaceId": 240,
   "component": 15,
   "op": 1,
   "comment": "xpreward:mining. The icons run in enum_681's order from component 3 (Agility is 10, as random-events-genie.json clicks), so Mining is 15; 17 was Fishing, greyed out at level 1"
  },
  {
   "step": "waitTicks",
   "ticks": 1
  },
  {
   "step": "clickWidget",
   "interfaceId": 240,
   "component": 27,
   "op": 1,
   "comment": "Confirm: Mining"
  },
  {
   "step": "assertMessage",
   "contains": "antique_lamp.granted"
  },
  {
   "step": "assertInterface",
   "interfaceId": 240,
   "absent": true
  },
  {
   "step": "command",
   "text": "::keys off"
  },
  {
   "step": "command",
   "text": "::reset",
   "expectMessage": "Back to how you were"
  }
 ]
}
