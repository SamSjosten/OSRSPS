{
 "name": "Rotten potato step 2: Peel teleports to a tile, spawns an item and opens the bank away from any booth (needs runner 0.24.0)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys", "comment": "the menu shows its keys, as live's words aren't in git"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "the Lumbridge spawn, out of reach of any bank; ::reset at the end puts the account back"},
  {"step": "command", "text": "::item 5733", "expectMessage": "Added 1 x Rotten potato"},
  {"step": "itemOption", "item": "Rotten potato", "option": "Peel"},
  {"step": "chooseOption", "text": "Teleport to a tile"},
  {"step": "enterText", "text": "3222 3220", "comment": "the text prompt, meslayer mode 9"},
  {"step": "assertMessage", "contains": "Teleported to 3222, 3220, 0"},
  {"step": "itemOption", "item": "Rotten potato", "option": "Peel"},
  {"step": "chooseOption", "text": "Spawn an item"},
  {"step": "enterText", "text": "coins 50"},
  {"step": "assertInventory", "item": "Coins", "count": 50, "timeoutMs": 5000},
  {"step": "itemOption", "item": "Rotten potato", "option": "Peel"},
  {"step": "chooseOption", "text": "[rotten_potato.bank_menu]"},
  {"step": "assertInterface", "interfaceId": 12, "comment": "bankmain"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were", "comment": "closes the bank too"}
 ]
}
