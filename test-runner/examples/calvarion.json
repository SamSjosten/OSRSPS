{
  "name": "Wilderness step W4.9: the Skeletal Tomb's way in (Check-Fee, then Enter paying the lairs' fee from the backpack) down to level 1, Calvar'ion fought under ::god, ::kill bringing back his enraged form and a second ::kill ending it, his kill count's key, and the way out (::keys on)",
  "account": "test2",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "level 20 outside, 21 inside"},
    {"step": "command", "text": "::item 1333", "comment": "a melee weapon of its own: a bow left worn with no ammo by an earlier script fights with no hitsplat (nightly 2026-11-27)"},
    {"step": "itemOption", "item": "Rune scimitar", "option": "Wield"},
    {"step": "waitTicks", "ticks": 1},
    {"step": "command", "text": "::tele 3180 3682 0", "expectMessage": "Teleported to 3180, 3682, 0", "comment": "south of the way in at 3180,3683"},
    {"step": "locOption", "locId": 46996, "option": "Check-Fee", "x": 3180, "y": 3683},
    {"step": "assertMessage", "contains": "[wildy_lair.fee_", "timeoutMs": 10000},
    {"step": "command", "text": "::varbit 14693 0", "comment": "wbr_entrance_fee_paid back to unpaid, so the fee's menu shows every run"},
    {"step": "command", "text": "::item 995 50000", "comment": "the fee in the backpack, in case it isn't paid yet"},
    {"step": "locOption", "locId": 46996, "option": "Enter", "x": 3180, "y": 3683},
    {"step": "waitTicks", "ticks": 3},
    {"step": "chooseOption", "text": "[wildy_lair_fee.yes]"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "assertLocation", "x": 1887, "y": 11553, "plane": 1},
    {"step": "npcOption", "npc": "Calvar'ion", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Calvar'ion", "timeoutMs": 30000},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Calvar'ion #", "comment": "his normal form held at 0: he comes back enraged"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Calvar'ion #", "comment": "his enraged form"},
    {"step": "assertMessage", "contains": "[wilderness_boss.kill_count boss=Calvar'ion count=", "timeoutMs": 15000},
    {"step": "locOption", "locId": 46925, "option": "Exit", "x": 1886, "y": 11534},
    {"step": "waitTicks", "ticks": 6},
    {"step": "assertLocation", "x": 3180, "y": 3682, "plane": 0},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
