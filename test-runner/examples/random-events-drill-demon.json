{
  "name": "Random events: Sergeant Damien's camp, a go on a mat, his next order, and leaving early with nothing",
  "account": "test",
  "runOnLogin": false,
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"comment": "Off first, so the timer can't send a second event mid-script.", "step": "command", "text": "::randomevent off", "expectMessage": "Random events off"},
    {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied"},
    {"step": "command", "text": "::tele 3222 3218", "expectMessage": "Teleported to 3222, 3218"},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0},
    {"step": "command", "text": "::randomevent drill_demon", "expectMessage": "Started random event drill_demon"},
    {"step": "npcOption", "npc": "Sergeant Damien", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Sergeant Damien", "contains": "[drill_demon.recommended", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[drill_demon.yes_sir]"},
    {"step": "assertDialogue", "contains": "[drill_demon.yes_sir]"},
    {"step": "continueDialogue"},
    {"comment": "In the camp: the signs in front of the mats are drawn from varbits macro_drilldemon_post_1 to _4; look that each shows a picture.", "step": "assertDialogue", "speaker": "Sergeant Damien", "contains": "[drill_demon.move_yourself]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Sergeant Damien", "contains": "[drill_demon.order_", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"comment": "The item box with the exercise's picture.", "step": "assertDialogue", "contains": "[drill_demon.box_", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[drill_demon.okay]"},
    {"step": "assertDialogue", "contains": "[drill_demon.okay]"},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"comment": "Any mat: right or wrong, he gives a new order and the signs shuffle.", "step": "locOption", "loc": "Exercise mat", "option": "Use", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Sergeant Damien", "contains": "[drill_demon.", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[drill_demon.box_", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[drill_demon.leave]"},
    {"step": "assertDialogue", "contains": "[drill_demon.leave]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Sergeant Damien", "contains": "[drill_demon.pathetic]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0},
    {"step": "assertInventory", "item": "Camo top", "count": 0}
  ]
}
