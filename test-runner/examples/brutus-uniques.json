{
 "name": "Brutus step 5: the bottomless milk bucket and the cow slippers. The bucket fills after its first-time warning (as many buckets as asked), Check, milked into at a dairy cow, churned into cream, chocolate dust makes chocolatey milk, and Empty after its warning; Swap on the slippers. The mooleta's stats are the cache's. HeadlessBrutusUniquesTest checks the ticks and the rare style",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys", "comment": "the bucket's words aren't on the server yet"},
  {"step": "command", "text": "::item 33091 1"},
  {"step": "command", "text": "::item 1927 3"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "itemOption", "itemId": 33091, "option": "Fill"},
  {"step": "assertDialogue", "contains": "[bottomless_milk_bucket.first_warning]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[bottomless_milk_bucket.yes]"},
  {"step": "enterAmount", "amount": 3},
  {"step": "assertMessage", "contains": "bottomless_milk_bucket.filled amount=3", "timeoutMs": 10000},
  {"step": "assertInventory", "itemId": 33089, "count": 1},
  {"step": "assertInventory", "itemId": 1925, "count": 3, "comment": "the buckets back"},
  {"step": "itemOption", "itemId": 33089, "option": "Check"},
  {"step": "assertMessage", "contains": "bottomless_milk_bucket.check amount=3", "timeoutMs": 10000},
  {"step": "command", "text": "::tele 3255 3273 0", "comment": "Gillie's dairy cows"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "loc": "Dairy cow", "option": "Milk"},
  {"step": "waitTicks", "ticks": 20, "comment": "a use every 7 ticks, ahead of the empty buckets"},
  {"step": "assertInventory", "itemId": 1925, "count": 3, "comment": "the empty buckets left alone"},
  {"step": "itemOption", "itemId": 33089, "option": "Check"},
  {"step": "assertMessage", "contains": "bottomless_milk_bucket.check amount=", "timeoutMs": 10000},
  {"step": "command", "text": "::setlevel cooking 99"},
  {"step": "command", "text": "::tele 3226 3293 0", "comment": "beside the Lumbridge east farm's dairy churn"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "useItemOnLoc", "itemId": 33089, "locId": 11695, "x": 3226, "y": 3294},
  {"step": "assertInterface", "interfaceId": 270, "comment": "skillmulti: cream, butter, cheese"},
  {"step": "clickWidget", "interfaceId": 270, "component": 15, "comment": "cream"},
  {"step": "assertMessage", "contains": "cooking_mix.churn_cream", "timeoutMs": 30000},
  {"step": "walk", "x": 3226, "y": 3291, "comment": "stops the churning"},
  {"step": "command", "text": "::item 1975 1", "comment": "chocolate dust"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "useItemOnItem", "item": "Chocolate dust", "onItem": "Bottomless milk bucket"},
  {"step": "assertInventory", "itemId": 1977, "count": 1, "comment": "chocolatey milk", "timeoutMs": 5000},
  {"step": "itemOption", "itemId": 33089, "option": "Empty"},
  {"step": "assertDialogue", "contains": "[bottomless_milk_bucket.empty_warning]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[bottomless_milk_bucket.empty_yes]"},
  {"step": "assertMessage", "contains": "bottomless_milk_bucket.emptied", "timeoutMs": 10000},
  {"step": "assertInventory", "itemId": 33091, "count": 1},
  {"step": "command", "text": "::item 33093 1"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "itemOption", "itemId": 33093, "option": "Swap"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "assertInventory", "itemId": 33093, "count": 0, "comment": "another style (33096, or the rare 33098)"},
  {"step": "command", "text": "::item 33101 1", "comment": "the mooleta"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "itemOption", "itemId": 33101, "option": "Wield"},
  {"step": "assertEquipment", "slot": "shield", "itemId": 33101, "timeoutMs": 5000},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
