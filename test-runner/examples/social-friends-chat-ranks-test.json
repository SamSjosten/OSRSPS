{
 "name": "Friends chat ranks and kicks, two players (run with social-friends-chat-ranks-test2.json on the other VM at the same time): test makes test2 a friend, names its channel Rank Hut, ranks test2 Corporal from the setup screen's list, sees test2 join at that rank, kicks test2 from its channel's list and leaves",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::clearfriends", "expectMessage": "Friends list emptied"},
  {"step": "logout", "comment": "so the Friends tab starts empty"},
  {"step": "waitForLogin", "comment": "auto login"},
  {"step": "command", "text": "::keys on", "expectMessage": "keys"},
  {"step": "command", "text": "::tele 3222 3218 0", "expectMessage": "Teleported"},
  {"step": "addFriend", "name": "test2"},
  {"step": "assertFriend", "name": "test2", "world": 301, "timeoutMs": 180000, "comment": "test2 logged in"},
  {"step": "setFriendsChatName", "name": "Rank Hut"},
  {"step": "assertWidgetText", "interfaceId": 94, "component": 10, "contains": "Rank Hut"},
  {"step": "clickWidget", "interfaceId": 94, "component": 28, "name": "test2", "op": 4, "comment": "the setup list's Corporal on test2's row (op 1 takes a rank away, 2 to 7 are Recruit to General)"},
  {"step": "walk", "x": 3221, "y": 3218, "comment": "closes the setup screen"},
  {"step": "joinFriendsChat", "owner": "test"},
  {"step": "assertMessage", "contains": "[friends_chat.now_talking name=Rank Hut]"},
  {"step": "assertFriendsChat", "owner": "test", "member": "test2", "rank": 3, "timeoutMs": 180000, "comment": "test2 joins, shown as a Corporal"},
  {"step": "waitTicks", "ticks": 5},
  {"step": "clickWidget", "interfaceId": 7, "component": 12, "name": "test2", "op": 6, "comment": "Kick user on test2's row"},
  {"step": "assertFriendsChat", "owner": "test", "member": "test2", "absent": true, "timeoutMs": 30000},
  {"step": "waitTicks", "ticks": 60, "comment": "test2 tries to join again and is refused"},
  {"step": "assertFriendsChat", "owner": "test", "member": "test2", "absent": true},
  {"step": "clickWidget", "interfaceId": 7, "component": 18, "comment": "Leave Chat"},
  {"step": "assertFriendsChat", "absent": true},
  {"step": "command", "text": "::clearfriends", "expectMessage": "Friends list emptied", "comment": "leaves no friend or rank for the next script"}
 ]
}
