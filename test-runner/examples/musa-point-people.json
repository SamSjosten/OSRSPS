{
  "name": "Karamja step K1.3: Musa Point's man by the dock and a snake west of the store examined (::keys on), the snake fought under ::god, killed with ::kill and its bones on the floor",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off)."},
    {"step": "command", "text": "::tele 2947 3146 0", "expectMessage": "Teleported to 2947, 3146, 0", "comment": "by the dock, near the Karamja man's spawn"},
    {"step": "npcOption", "npcId": 3652, "option": "Examine", "timeoutMs": 20000, "comment": "the man (Karamja version)"},
    {"step": "assertMessage", "contains": "[examine.npc_3652]"},
    {"step": "command", "text": "::tele 2874 3166 0", "expectMessage": "Teleported to 2874, 3166, 0", "comment": "by the northernmost snake west of the general store (spawn 2875,3164), away from the other three so that no other snake is already fighting the player when Attack is clicked"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npcId": 2845, "option": "Examine", "timeoutMs": 20000},
    {"step": "assertMessage", "contains": "[examine.npc_2845]"},
    {"step": "npcOption", "npc": "Snake", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Snake", "timeoutMs": 30000},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Snake #"},
    {"step": "assertGroundItem", "item": "Bones", "timeoutMs": 15000},
    {"step": "command", "text": "::god", "comment": "off again"}
  ]
}
