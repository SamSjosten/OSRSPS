{
 "name": "Raid step 31: a Hardcore Ironman's death in The Fractured Archive: the status lost, and the grave's paid item at an Ironman's half and the raid's quarter, Unlock refused with no coins in the bank and paid with them",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare", "comment": "nothing worn, carried or banked; ::reset at the end puts the account back, its varps with it"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::heal", "expectMessage": "Healed to "},
  {"step": "command", "text": "::varbit 1777 3", "expectMessage": "-> 3", "comment": "ironman: a Hardcore Ironman"},
  {"step": "command", "text": "::varp 5894 0", "expectMessage": "-> 0", "comment": "total_completed_thefracturedarchive: no clears, so a death in the raid costs a quarter"},
  {"step": "command", "text": "::item dragon boots 4", "expectMessage": "Added 4 x Dragon boots", "comment": "between 100,000 and 1,000,000 coins on the Grand Exchange: 1,000 to take back; three are kept, one goes in the grave"},
  {"step": "command", "text": "::tele 4127 5560 0", "expectMessage": "Teleported to 4127, 5560, 0", "comment": "the lobby, in front of the Archive Door"},
  {"step": "locOption", "locId": 62768, "option": "Enter", "timeoutMs": 20000},
  {"step": "waitTicks", "ticks": 6},
  {"step": "command", "text": "::raid run", "expectMessage": "You're in the nexus's entrance"},
  {"step": "command", "text": "::raid tp guardian", "expectMessage": "To Archive Guardian's room"},
  {"step": "command", "text": "::hit 99 me", "expectMessage": ", dead", "comment": "alone: the party wipes, the grave goes up in the lobby, made in the raid"},
  {"step": "assertLocation", "x": 4127, "y": 5560, "plane": 0, "timeoutMs": 15000},
  {"step": "assertMessage", "contains": "[combat.hardcore_lost]", "timeoutMs": 10000, "comment": "a death in the raid is always dangerous (OSRS Wiki, The Fractured Archive); the words are guessed, a key here"},
  {"step": "assertVarbit", "id": 1777, "value": 1, "comment": "an Ironman now"},
  {"step": "assertInventory", "item": "Dragon boots", "count": 3},
  {"step": "npcOption", "npc": "Grave", "option": "Loot"},
  {"step": "assertInterface", "interfaceId": 672, "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 10472, "value": 2, "comment": "where the free list starts, plus one: the paid list is the first slot, the boots"},
  {"step": "clickWidget", "interfaceId": 672, "component": 15, "comment": "Unlock: 1,000, an Ironman's half, the raid's quarter of that"},
  {"step": "assertMessage", "contains": "[combat.grave_cant_pay fee=125]", "timeoutMs": 10000, "comment": "nothing in the bank"},
  {"step": "command", "text": "::item coins 125", "expectMessage": "Added 125 x Coins"},
  {"step": "command", "text": "::openbank"},
  {"step": "assertInterface", "interfaceId": 12},
  {"step": "clickWidget", "interfaceId": 12, "component": 47, "op": 1, "comment": "Deposit inventory: the coins and the three boots"},
  {"step": "assertInventory", "item": "Coins", "count": 0},
  {"step": "npcOption", "npc": "Grave", "option": "Loot"},
  {"step": "assertInterface", "interfaceId": 672, "timeoutMs": 10000},
  {"step": "clickWidget", "interfaceId": 672, "component": 15, "comment": "Unlock, the coins in the bank now"},
  {"step": "assertMessage", "contains": "[combat.grave_paid fee=125]", "timeoutMs": 10000},
  {"step": "clickWidget", "interfaceId": 672, "component": 15, "comment": "Take-All on the paid list once the fee is paid"},
  {"step": "assertInventory", "item": "Dragon boots", "count": 1, "timeoutMs": 10000},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were", "comment": "the ironman varbit and the clears back as they were"}
 ]
}
