{
  "name": "Edgeville piece step 4: the monastery's ladders stop a player outside the order, Abbot Langley refuses at 30 Prayer and takes them in at 31, the climb, a robe taken, the altar's recharge, Brother Jered, the climb down, the Abbot's and a monk's heal, Brother Althric and a cabbage picked (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's levels (Prayer 1) and an empty backpack; ::reset at the end puts the account back"},
    {"step": "command", "text": "::varbit 4907 0", "expectMessage": "Varbit 4907", "comment": "monastery_enter: not one of the order yet, so a rerun starts the same way"},
    {"step": "command", "text": "::tele 3057 3484 0", "expectMessage": "Teleported to 3057, 3484, 0", "comment": "beside the south-eastern ladder"},
    {"step": "locOption", "locId": 2641, "option": "Climb-up", "x": 3057, "y": 3483},
    {"step": "assertDialogue", "contains": "[abbot_langley.members_only]", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[abbot_langley.join]"},
    {"step": "assertDialogue", "contains": "[abbot_langley.join]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[abbot_langley.too_low]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[abbot_langley.requirement]"},
    {"step": "continueDialogue"},
    {"step": "assertVarbit", "id": 4907, "value": 0},
    {"step": "command", "text": "::setlevel prayer 31", "expectMessage": "Prayer set to level 31"},
    {"step": "locOption", "locId": 2641, "option": "Climb-up", "x": 3057, "y": 3483},
    {"step": "assertDialogue", "contains": "[abbot_langley.members_only]", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[abbot_langley.join]"},
    {"step": "assertDialogue", "contains": "[abbot_langley.join]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[abbot_langley.accepted]"},
    {"step": "continueDialogue"},
    {"step": "assertVarbit", "id": 4907, "value": 1},
    {"step": "locOption", "locId": 2641, "option": "Climb-up", "x": 3057, "y": 3483},
    {"step": "assertLocation", "x": 3057, "y": 3484, "plane": 1, "timeoutMs": 10000, "comment": "upstairs, beside the ladder's top (the landing tile is the ladder code's)"},
    {"step": "takeItem", "item": "Monk's robe top", "x": 3059, "y": 3487},
    {"step": "assertInventory", "item": "Monk's robe top", "count": 1, "timeoutMs": 15000},
    {"step": "locOption", "locId": 2640, "option": "Pray-at", "x": 3051, "y": 3498},
    {"step": "assertMessage", "contains": "[altar.recharge]", "timeoutMs": 20000, "comment": "31 Prayer is below the altar's 33 (2 over the level)"},
    {"step": "npcOption", "npc": "Brother Jered", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "chooseOption", "text": "[brother_jered.praise]"},
    {"step": "assertDialogue", "contains": "[brother_jered.praise]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[brother_jered.praise_reply]"},
    {"step": "continueDialogue"},
    {"step": "command", "text": "::tele 3057 3484 1", "expectMessage": "Teleported to 3057, 3484, 1"},
    {"step": "locOption", "locId": 16679, "option": "Climb-down", "x": 3057, "y": 3483},
    {"step": "assertLocation", "x": 3057, "y": 3484, "plane": 0, "timeoutMs": 10000},
    {"step": "npcOption", "npc": "Abbot Langley", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[abbot_langley.greeting]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[abbot_langley.heal]", "comment": "one of the order now: three options, the access one gone"},
    {"step": "assertDialogue", "contains": "[abbot_langley.heal]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[abbot_langley.heal_yes]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[abbot_langley.healed]"},
    {"step": "continueDialogue"},
    {"step": "command", "text": "::tele 3050 3490 0", "expectMessage": "Teleported to 3050, 3490, 0", "comment": "the courtyard, where the monks wander"},
    {"step": "npcOption", "npc": "Monk", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[edgeville_monk.greeting]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[edgeville_monk.heal]"},
    {"step": "assertDialogue", "contains": "[edgeville_monk.heal]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[edgeville_monk.heal_yes]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[edgeville_monk.healed]"},
    {"step": "continueDialogue"},
    {"step": "command", "text": "::tele 3049 3505 0", "expectMessage": "Teleported to 3049, 3505, 0", "comment": "the rose garden"},
    {"step": "npcOption", "npc": "Brother Althric", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[brother_althric.roses]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[brother_althric.roses_reply]"},
    {"step": "continueDialogue"},
    {"step": "locOption", "locId": 1161, "option": "Pick", "x": 3050, "y": 3504},
    {"step": "assertInventory", "item": "Cabbage", "count": 1, "timeoutMs": 15000},
    {"step": "command", "text": "::varbit 4907 0", "expectMessage": "Varbit 4907"},
    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
