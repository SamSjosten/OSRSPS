{
 "name": "Farming step 3: compost on Falador's north-west allotment, potatoes planted, made ill with ::farmdisease and cured with a plant cure, then made ill again, left to die and cleared with a spade, read off farming_transmit_a (varbit 4771) (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario farming", "expectMessage": "Started scenario farming.", "comment": "beside the Falador allotments with 99 Farming and the tools; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::farmclock pause", "expectMessage": "Farming clock paused", "comment": "the crop grows and dies only by ::farmtick"},
  {"step": "command", "text": "::item 6032 1", "comment": "one bucket of compost"},
  {"step": "command", "text": "::item 6036 1"},
  {"step": "locOption", "locId": 8550, "option": "Rake", "x": 3052, "y": 3307, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.raked]", "timeoutMs": 30000},
  {"step": "useItemOnLoc", "item": "Compost", "locId": 8550, "x": 3052, "y": 3307},
  {"step": "assertMessage", "contains": "[farming.composted compost=compost]", "timeoutMs": 15000},
  {"step": "assertInventory", "item": "Bucket", "timeoutMs": 5000},
  {"step": "useItemOnLoc", "item": "Potato seed", "locId": 8550, "x": 3052, "y": 3307},
  {"step": "assertVarbit", "id": 4771, "value": 6, "timeoutMs": 15000},
  {"step": "command", "text": "::farmtick 2", "expectMessage": "Farming clock moved on 2 ticks (10 minutes)", "comment": "a crop's first growth brings no disease"},
  {"step": "command", "text": "::farmdisease falador_allotment_nw", "expectMessage": "falador_allotment_nw is diseased"},
  {"step": "assertVarbit", "id": 4771, "value": 135, "timeoutMs": 5000, "comment": "Diseased potatoes with Cure"},
  {"step": "locOption", "locId": 8550, "option": "Cure", "x": 3052, "y": 3307, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.cured crop=potato]", "timeoutMs": 15000},
  {"step": "assertVarbit", "id": 4771, "value": 7, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Vial", "timeoutMs": 5000},
  {"step": "command", "text": "::farmdisease falador_allotment_nw", "expectMessage": "falador_allotment_nw is diseased"},
  {"step": "command", "text": "::farmtick 4", "expectMessage": "Farming clock moved on 4 ticks (20 minutes)", "comment": "left ill, it dies at the next 20-minute tick"},
  {"step": "assertVarbit", "id": 4771, "value": 199, "timeoutMs": 5000, "comment": "Dead potatoes with Clear"},
  {"step": "locOption", "locId": 8550, "option": "Clear", "x": 3052, "y": 3307, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.cleared]", "timeoutMs": 15000},
  {"step": "assertVarbit", "id": 4771, "value": 3, "timeoutMs": 5000},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
