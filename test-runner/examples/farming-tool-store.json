{
 "name": "Farming step 9: the Tool Leprechaun by Lumbridge's tree patch: Deposit-all with nothing to store says so, Yes please opens his store (125 and 126), rakes go in by Store-1 and Store-5 and come out by Remove-X, noted compost goes in with the All button and comes out with Banknotes, and a second watering can is refused (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario farming", "expectMessage": "Started scenario farming.", "comment": "::reset at the end puts the account back, store included"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::empty"},
  {"step": "command", "text": "::varbit 1435 0", "expectMessage": "-> 0", "comment": "the store's rakes, compost, watering can and quantity, from nothing"},
  {"step": "command", "text": "::varbit 8357 0", "expectMessage": "-> 0"},
  {"step": "command", "text": "::varbit 1442 0", "expectMessage": "-> 0"},
  {"step": "command", "text": "::varbit 6266 0", "expectMessage": "-> 0"},
  {"step": "command", "text": "::varbit 1439 0", "expectMessage": "-> 0"},
  {"step": "command", "text": "::varbit 7792 0", "expectMessage": "-> 0", "comment": "default quantity 1"},
  {"step": "command", "text": "::tele 3193 3229 0", "expectMessage": "Teleported to 3193, 3229, 0", "comment": "south of the tree patch west of Lumbridge castle; the Tool Leprechaun stands by it"},
  {"step": "npcOption", "npc": "Tool Leprechaun", "option": "Deposit-all", "timeoutMs": 20000, "comment": "first, while the pack is empty and before the store covers the screen (live run 2026-11-15: a walk click with the store open found no Walk here)"},
  {"step": "assertMessage", "contains": "[tool_store.nothing]", "timeoutMs": 10000},
  {"step": "npcOption", "npc": "Tool Leprechaun", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[tool_leprechaun.greeting]"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[tool_leprechaun.yes_please]", "comment": "Exchange opening it is farms-roads.json's"},
  {"step": "command", "text": "::item 5341 6", "comment": "six rakes"},
  {"step": "assertInterface", "interfaceId": 125},
  {"step": "assertInterface", "interfaceId": 126},
  {"step": "clickWidget", "interfaceId": 126, "component": 1, "op": 1, "comment": "Store-1 on the rakes"},
  {"step": "assertVarbit", "id": 1435, "value": 1},
  {"step": "clickWidget", "interfaceId": 126, "component": 1, "op": 2, "comment": "Store-5: six stored, as 2 x 3 extra + 0"},
  {"step": "assertVarbit", "id": 8357, "value": 3},
  {"step": "assertVarbit", "id": 1435, "value": 0},
  {"step": "assertInventory", "itemId": 5341, "count": 0},
  {"step": "assertWidgetText", "interfaceId": 125, "component": 8, "contains": "6/100"},
  {"step": "clickWidget", "interfaceId": 125, "component": 8, "op": 3, "comment": "Remove-X"},
  {"step": "enterAmount", "amount": 3},
  {"step": "assertInventory", "itemId": 5341, "count": 3},
  {"step": "assertWidgetText", "interfaceId": 125, "component": 8, "contains": "3/100"},
  {"step": "command", "text": "::item 6033 300", "comment": "300 noted compost"},
  {"step": "clickWidget", "interfaceId": 125, "component": 7, "op": 1, "comment": "the All button"},
  {"step": "assertVarbit", "id": 7792, "value": 2},
  {"step": "clickWidget", "interfaceId": 126, "component": 10, "op": 1, "comment": "Store-All on the compost: 300 is 44 + 256"},
  {"step": "assertVarbit", "id": 1442, "value": 44},
  {"step": "assertVarbit", "id": 6266, "value": 1},
  {"step": "assertInventory", "itemId": 6033, "count": 0},
  {"step": "clickWidget", "interfaceId": 125, "component": 17, "op": 9, "comment": "Banknotes on the compost"},
  {"step": "assertInventory", "itemId": 6033, "count": 300},
  {"step": "command", "text": "::item 5336 1", "comment": "a watering can with 4 doses"},
  {"step": "clickWidget", "interfaceId": 126, "component": 5, "op": 1, "comment": "Store on the watering can"},
  {"step": "assertVarbit", "id": 1439, "value": 5},
  {"step": "command", "text": "::item 5331 1", "comment": "an empty can"},
  {"step": "clickWidget", "interfaceId": 126, "component": 5, "op": 1},
  {"step": "assertMessage", "contains": "[tool_store.full]", "timeoutMs": 10000},
  {"step": "clickWidget", "interfaceId": 125, "component": 12, "op": 1, "comment": "Remove the stored can"},
  {"step": "assertInventory", "itemId": 5336, "count": 1},
  {"step": "assertVarbit", "id": 1439, "value": 0},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
