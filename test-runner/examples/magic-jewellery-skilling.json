{
 "name": "Magic utility step U6b: charged jewellery. At Lumbridge's furnace a ring of forging smelts all five iron ores into bars, its Check then showing 135 uses left; at Rimmington mine a bracelet of clay mines soft clay (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::setlevel smithing 15", "expectMessage": "Smithing set to level 15"},
  {"step": "command", "text": "::item 2568", "expectMessage": "Added 1 x Ring of forging"},
  {"step": "itemOption", "item": "Ring of forging", "option": "Wear"},
  {"step": "assertEquipment", "slot": "ring", "item": "Ring of forging", "timeoutMs": 5000},
  {"step": "wornOption", "slot": "ring", "option": "Check"},
  {"step": "assertMessage", "contains": "[jewellery_effect.check item=ring of forging count=140]", "timeoutMs": 5000},
  {"step": "command", "text": "::item 440 5", "expectMessage": "Added 5 x Iron ore"},
  {"step": "locOption", "locId": 24009, "option": "Smelt", "x": 3226, "y": 3256},
  {"step": "assertInterface", "interfaceId": 270, "comment": "skillmulti, the Make-X box over the bars"},
  {"step": "clickWidget", "interfaceId": 270, "component": 16, "comment": "the iron bar, second in the box"},
  {"step": "assertInventory", "item": "Iron bar", "count": 5, "timeoutMs": 30000, "comment": "none too impure with the ring"},
  {"step": "assertInventory", "item": "Iron ore", "count": 0},
  {"step": "wornOption", "slot": "ring", "option": "Check"},
  {"step": "assertMessage", "contains": "[jewellery_effect.check item=ring of forging count=135]", "timeoutMs": 5000},
  {"step": "command", "text": "::item 1265", "expectMessage": "Added 1 x Bronze pickaxe"},
  {"step": "command", "text": "::item 11074", "expectMessage": "Added 1 x Bracelet of clay"},
  {"step": "itemOption", "item": "Bracelet of clay", "option": "Wear"},
  {"step": "assertEquipment", "slot": "hands", "item": "Bracelet of clay", "timeoutMs": 5000},
  {"step": "command", "text": "::tele 2984 3240", "expectMessage": "Teleported to 2984, 3240"},
  {"step": "waitTicks", "ticks": 3, "comment": "a new region"},
  {"step": "locOption", "locId": 11362, "option": "Mine", "comment": "the nearest clay rock"},
  {"step": "assertInventory", "item": "Soft clay", "count": 1, "timeoutMs": 60000},
  {"step": "assertInventory", "item": "Clay", "count": 0},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
