{
  "name": "Karamja step K2.3: a hot vent door refusing a player without access, a fire cape shown to the barrier guard (::keys on) and the player then JalYt-...-Xo, the door both ways, TzHaar-Ket-Yil's Bank, TzHaar-Hur-Zal's Trade and TzHaar-Mej-Dir's talk",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts it back"},
    {"step": "command", "text": "::varp mor_ul_rek_access 0", "expectMessage": "Varp mor_ul_rek_access", "comment": "no access yet, whatever an earlier run left; set back to 0 at the end"},
    {"step": "command", "text": "::tele 2436 5121 0", "expectMessage": "Teleported to 2436, 5121, 0", "comment": "north of the west hot vent door, by its guard"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "locOption", "locId": 30266, "option": "Pass", "x": 2436, "y": 5120},
    {"step": "assertMessage", "contains": "[tzhaar_guard.no_pass]", "timeoutMs": 5000},
    {"step": "assertLocation", "x": 2436, "y": 5121, "plane": 0},

    {"step": "command", "text": "::item 6570 1", "comment": "a fire cape"},
    {"step": "npcOption", "npc": "TzHaar-Ket", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[tzhaar_guard.greeting name=JalYt-", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[tzhaar_guard.why_cant]"},
    {"step": "continueDialogue", "comment": "the player asks"},
    {"step": "assertDialogue", "contains": "[tzhaar_guard.closed]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[tzhaar_guard.whys_that]"},
    {"step": "continueDialogue", "comment": "the player asks"},
    {"step": "assertDialogue", "contains": "[tzhaar_guard.not_trusted]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[tzhaar_guard.prove]"},
    {"step": "continueDialogue", "comment": "the player asks"},
    {"step": "assertDialogue", "contains": "[tzhaar_guard.acceptable name=JalYt-"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[tzhaar_guard.fire_cape]"},
    {"step": "continueDialogue", "comment": "the player tells of TzTok-Jad"},
    {"step": "continueDialogue", "comment": "the box with the fire cape"},
    {"step": "assertDialogue", "contains": "[tzhaar_guard.impressive name=JalYt-"},
    {"step": "continueDialogue"},
    {"step": "continueDialogue", "comment": "the player: surely this proves it"},
    {"step": "assertDialogue", "contains": "[tzhaar_guard.granted]"},
    {"step": "continueDialogue"},
    {"step": "npcOption", "npc": "TzHaar-Ket", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "-Xo-", "timeoutMs": 15000, "comment": "the player is Xo now"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[tzhaar_guard.fine]"},
    {"step": "continueDialogue"},
    {"step": "locOption", "locId": 30266, "option": "Pass", "x": 2436, "y": 5120},
    {"step": "assertLocation", "x": 2436, "y": 5119, "plane": 0, "timeoutMs": 10000, "comment": "inside"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "locOption", "locId": 30266, "option": "Pass", "x": 2436, "y": 5120},
    {"step": "assertLocation", "x": 2436, "y": 5121, "plane": 0, "timeoutMs": 10000, "comment": "and out"},

    {"step": "command", "text": "::tele 2542 5142 0", "expectMessage": "Teleported to 2542, 5142, 0", "comment": "the east bank"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "TzHaar-Ket-Yil", "option": "Bank", "timeoutMs": 20000},
    {"step": "assertInterface", "interfaceId": 12, "timeoutMs": 10000, "comment": "the bank"},
    {"step": "command", "text": "::tele 2490 5072 0", "expectMessage": "Teleported to 2490, 5072, 0", "comment": "TzHaar-Hur-Zal's Equipment Store (the teleport closes the bank)"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "TzHaar-Hur-Zal", "option": "Trade", "timeoutMs": 20000},
    {"step": "assertInterface", "interfaceId": 300, "timeoutMs": 10000},
    {"step": "command", "text": "::tele 2550 5130 0", "expectMessage": "Teleported to 2550, 5130, 0", "comment": "the eastern terminal chamber"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "TzHaar-Mej-Dir", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[tzhaar_elder.hello name=JalYt-", "timeoutMs": 15000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[tzhaar_elder.whats_happening]"},
    {"step": "finishDialogue", "comment": "the rest of the elder's talk, closed before the commands below"},
    {"step": "command", "text": "::varp mor_ul_rek_access 0", "expectMessage": "Varp mor_ul_rek_access"},
    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
