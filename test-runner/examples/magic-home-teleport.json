{
 "name": "Magic: Home Teleport opens the lodestone menu; the Lumbridge pick lands on the stone after the five stages with no cooldown; walking away stops a cast (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys", "comment": "messages and the menu show their keys, whatever data/dialogue.txt holds"},
  {"step": "command", "text": "::varp 892 0", "expectMessage": "Varp 892", "comment": "aide_tele_timer, OSRS's home teleport cooldown: cleared, to see the lodestone cast leave it alone"},
  {"step": "command", "text": "::varp lodestones 1", "expectMessage": "Varp lodestones:", "comment": "only Lumbridge's stone activated, so the menu is the same each run"},
  {"step": "command", "text": "::tele 3236 3220 0", "expectMessage": "Teleported to 3236, 3220, 0", "comment": "east of the castle, off the stone"},
  {"step": "clickWidget", "interfaceId": 218, "component": 6, "op": 1, "comment": "magic_spellbook:teleport_home_standard, Cast"},
  {"step": "assertDialogue", "contains": "[lodestone.title]", "timeoutMs": 10000, "comment": "the lodestone menu, as RS3's Home Teleport opens the network"},
  {"step": "chooseOption", "text": "[lodestone.lumbridge]"},
  {"step": "assertAnimation", "id": 4847, "timeoutMs": 10000, "comment": "aide_drawing_chalk_circle, the first stage"},
  {"step": "assertSpotanim", "id": 800, "timeoutMs": 10000, "comment": "aide_chalk_circle"},
  {"step": "assertAnimation", "id": 4857, "timeoutMs": 25000, "comment": "aide_player_teleporting, the last stage, 22 ticks in (guessed)"},
  {"step": "assertLocation", "x": 3233, "y": 3221, "plane": 0, "timeoutMs": 10000, "comment": "the Lumbridge stone's centre, 28 ticks after the pick"},
  {"step": "command", "text": "::varp 892", "expectMessage": "Varp 892 = 0", "comment": "no cooldown: a lodestone teleport leaves OSRS's timer alone"},

  {"step": "clickWidget", "interfaceId": 218, "component": 6, "op": 1, "comment": "a second cast right away: the menu again, no cooldown refusal"},
  {"step": "assertDialogue", "contains": "[lodestone.title]", "timeoutMs": 10000},
  {"step": "chooseOption", "text": "[lodestone.lumbridge]"},
  {"step": "assertAnimation", "id": 4847, "timeoutMs": 10000},
  {"step": "walk", "x": 3236, "y": 3221, "comment": "walking removes the cast's weak queue"},
  {"step": "waitTicks", "ticks": 32},
  {"step": "assertLocation", "x": 3236, "y": 3221, "plane": 0, "comment": "still here: the cast stopped"},

  {"step": "command", "text": "::tele 3100 3700 0", "expectMessage": "Teleported to 3100, 3700, 0", "comment": "level 23 Wilderness: refused before the menu opens"},
  {"step": "clickWidget", "interfaceId": 218, "component": 6, "op": 1},
  {"step": "assertMessage", "contains": "[home_teleport.wilderness]", "timeoutMs": 10000},
  {"step": "assertMessage", "contains": "[home_teleport.wilderness_2]", "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 30},
  {"step": "assertLocation", "x": 3100, "y": 3700, "plane": 0, "comment": "no cast above level 20"},

  {"step": "command", "text": "::tele 3222 3218 0", "expectMessage": "Teleported to 3222, 3218, 0", "comment": "back to the courtyard"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"}
 ]
}
