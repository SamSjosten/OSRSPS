{
 "name": "Farming step 5: at Catherby's fruit tree patch, an apple sapling planted with a spade in ultracompost (natural disease off), grown, checked, its six apples picked and a seventh grown and picked, the bare tree chopped down and its stump cleared; then another made ill with ::farmdisease and pruned with secateurs, read off farming_transmit_a (varbit 4771) (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario farming", "expectMessage": "Started scenario farming.", "comment": "99 Farming and every patch overgrown; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::farmdisease off", "expectMessage": "Farming diseases off", "comment": "the tree can't fall ill on its own through ::farmtick 192; ::farmdisease makes it ill below"},
  {"step": "command", "text": "::farmclock pause", "expectMessage": "Farming clock paused", "comment": "the tree grows only by ::farmtick"},
  {"step": "command", "text": "::tele 2860 3432 0", "expectMessage": "Teleported to 2860, 3432, 0", "comment": "south of Catherby's fruit tree patch (fruit_tree_patch_4, 2860-2861, 3433-3434)"},
  {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied.", "comment": "room for the apples"},
  {"step": "command", "text": "::item 5341 1", "comment": "a rake"},
  {"step": "command", "text": "::item 952 1", "comment": "a spade"},
  {"step": "command", "text": "::item 21483 1", "comment": "ultracompost, for its XP and the soil"},
  {"step": "command", "text": "::item 5496 2", "comment": "two apple saplings"},
  {"step": "command", "text": "::item 1351 1", "comment": "a bronze axe"},
  {"step": "locOption", "locId": 7965, "option": "Rake", "x": 2860, "y": 3433, "timeoutMs": 20000, "comment": "the multiloc fruit_tree_patch_4, drawn as Fruit Tree Patch while overgrown"},
  {"step": "assertMessage", "contains": "[farming.raked]", "timeoutMs": 30000},
  {"step": "assertVarbit", "id": 4771, "value": 3, "timeoutMs": 5000},
  {"step": "useItemOnLoc", "itemId": 21483, "locId": 7965, "x": 2860, "y": 3433},
  {"step": "assertMessage", "contains": "[farming.composted", "timeoutMs": 10000},
  {"step": "useItemOnLoc", "itemId": 5496, "locId": 7965, "x": 2860, "y": 3433},
  {"step": "assertMessage", "contains": "[farming.sapling_planted sapling=apple sapling patch=[farming.patch_fruit_tree]]", "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 4771, "value": 8, "timeoutMs": 5000, "comment": "Apple tree, stage 1"},
  {"step": "command", "text": "::farmtick 192", "expectMessage": "Farming clock moved on 192 ticks", "comment": "six 160-minute growths"},
  {"step": "assertVarbit", "id": 4771, "value": 34, "timeoutMs": 5000, "comment": "Apple tree with Check-health"},
  {"step": "locOption", "locId": 7965, "option": "Check-health", "x": 2860, "y": 3433, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.checked]", "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 4771, "value": 20, "timeoutMs": 5000, "comment": "six apples on the tree"},
  {"step": "useItemOnLoc", "itemId": 1351, "locId": 7965, "x": 2860, "y": 3433},
  {"step": "assertMessage", "contains": "[farming.pick_first]", "timeoutMs": 10000, "comment": "no Chop-down while it has fruit"},
  {"step": "locOption", "locId": 7965, "option": "Pick-apple", "x": 2860, "y": 3433, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.fruit_gone]", "timeoutMs": 30000},
  {"step": "assertVarbit", "id": 4771, "value": 14, "timeoutMs": 5000, "comment": "no apples left: Chop-down"},
  {"step": "assertInventory", "item": "Cooking apple", "count": 6, "timeoutMs": 5000},
  {"step": "command", "text": "::farmtick 8", "expectMessage": "Farming clock moved on 8 ticks", "comment": "one 40-minute tick: one apple grows"},
  {"step": "assertVarbit", "id": 4771, "value": 15, "timeoutMs": 5000},
  {"step": "locOption", "locId": 7965, "option": "Pick-apple", "x": 2860, "y": 3433, "timeoutMs": 20000},
  {"step": "assertInventory", "item": "Cooking apple", "count": 7, "timeoutMs": 15000},
  {"step": "assertVarbit", "id": 4771, "value": 14, "timeoutMs": 5000},
  {"step": "locOption", "locId": 7965, "option": "Chop-down", "x": 2860, "y": 3433, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.fruit_chopped]", "timeoutMs": 20000},
  {"step": "assertVarbit", "id": 4771, "value": 33, "timeoutMs": 5000, "comment": "Apple tree stump"},
  {"step": "locOption", "locId": 7965, "option": "Clear", "x": 2860, "y": 3433, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.stump_cleared]", "timeoutMs": 20000},
  {"step": "assertVarbit", "id": 4771, "value": 3, "timeoutMs": 5000},
  {"step": "useItemOnLoc", "itemId": 5496, "locId": 7965, "x": 2860, "y": 3433, "comment": "the second sapling"},
  {"step": "assertVarbit", "id": 4771, "value": 8, "timeoutMs": 15000},
  {"step": "command", "text": "::farmtick 32", "expectMessage": "Farming clock moved on 32 ticks", "comment": "one growth: the first can't bring disease"},
  {"step": "assertVarbit", "id": 4771, "value": 9, "timeoutMs": 5000},
  {"step": "command", "text": "::farmdisease catherby_fruit_tree"},
  {"step": "assertVarbit", "id": 4771, "value": 21, "timeoutMs": 5000, "comment": "Diseased apple tree with Prune"},
  {"step": "command", "text": "::item 5329 1", "comment": "secateurs"},
  {"step": "locOption", "locId": 7965, "option": "Prune", "x": 2860, "y": 3433, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.pruned]", "timeoutMs": 60000, "comment": "3 tries in 4 work"},
  {"step": "assertVarbit", "id": 4771, "value": 9, "timeoutMs": 5000, "comment": "well again"},
  {"step": "assertInventory", "item": "Leaves", "timeoutMs": 5000},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
