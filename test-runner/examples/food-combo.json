  {"step": "assertInventory", "itemId": 3144, "count": 1},
  {"step": "itemOption", "itemId": 385, "option": "Eat"},
  {"step": "itemOption", "itemId": 3144, "option": "Eat", "comment": "a combo food: it has its own timer, so it can follow the shark at once"},
  {"step": "assertInventory", "itemId": 3144, "count": 0},
  {"step": "command", "text": "::hp", "expectMessage": "You have 88/99 hitpoints"},
