{
 "name": "Grand Exchange step 5: the trade history and its Buy-offer, and the guide prices screen from the equipment tab",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "at the spawn, an empty backpack and no offers; ::reset at the end puts it back"},
  {"step": "command", "text": "::gemarket off", "expectMessage": "The Grand Exchange market is off."},
  {"step": "command", "text": "::item coins 1000", "expectMessage": "Added 1,000 x Coins", "comment": "inventory slot 0"},
  {"step": "command", "text": "::item logs 2", "expectMessage": "Added 2 x Logs", "comment": "slots 1 and 2"},
  {"step": "command", "text": "::geoffer buy feather 10 5", "expectMessage": "Placed: Slot 0: buy 10 x Feather (314) at 5"},
  {"step": "command", "text": "::gefill 0", "expectMessage": "Filled 10 in slot 0.", "comment": "finished, so into the history"},
  {"step": "command", "text": "::ge"},
  {"step": "assertInterface", "interfaceId": 465, "timeoutMs": 10000},
  {"step": "clickWidget", "interfaceId": 465, "component": 3, "comment": "History"},
  {"step": "assertInterface", "interfaceId": 383, "timeoutMs": 10000, "comment": "ge_history, with one line: Bought Feather x 10 for 50 coins"},
  {"step": "clickWidget", "interfaceId": 383, "component": 3, "slot": 0, "op": 1, "comment": "Buy-offer on the feathers' row"},
  {"step": "assertInterface", "interfaceId": 465, "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 4439, "value": 2, "comment": "a buy set up in slot 1, slot 0 still holding the finished offer"},
  {"step": "assertVarp", "id": 1151, "value": 314, "comment": "for feathers"},
  {"step": "clickWidget", "interfaceId": 465, "component": 4, "comment": "Back"},
  {"step": "command", "text": "::geoffer collect 0", "expectMessage": "Collected from slot 0."},
  {"step": "walk", "x": 3222, "y": 3219, "comment": "walking closes the offers screen"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "clickWidget", "interfaceId": 548, "component": 68, "comment": "toplevel:stone4, the equipment tab, in the fixed frame the VM's client uses"},
  {"step": "clickWidget", "interfaceId": 387, "component": 3, "comment": "Guide prices"},
  {"step": "assertInterface", "interfaceId": 464, "timeoutMs": 10000, "comment": "ge_pricechecker"},
  {"step": "assertInterface", "interfaceId": 238, "timeoutMs": 10000, "comment": "ge_pricechecker_side"},
  {"step": "clickWidget", "interfaceId": 238, "component": 0, "slot": 1, "op": 4, "comment": "Add-All on the logs"},
  {"step": "assertInventory", "item": "Logs", "count": 0, "comment": "out of the inventory, into the screen"},
  {"step": "clickWidget", "interfaceId": 464, "component": 2, "slot": 0, "op": 1, "comment": "Remove one"},
  {"step": "assertInventory", "item": "Logs", "count": 1},
  {"step": "walk", "x": 3222, "y": 3218, "comment": "walking closes the screen, and the log left in it comes back"},
  {"step": "waitTicks", "ticks": 2},
  {"step": "assertInterface", "interfaceId": 464, "absent": true},
  {"step": "assertInventory", "item": "Logs", "count": 2},
  {"step": "command", "text": "::gemarket on", "expectMessage": "The Grand Exchange market is on."},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
