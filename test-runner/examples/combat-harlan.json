{
 "name": "Lumbridge 242 step 1: Captain Harlan hands over a shortsword and shield, then nothing more for 30 minutes (::keys on, so keys show whatever data/dialogue.txt holds)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare"
  },
  {
   "step": "command",
   "text": "::varp harlan.claimed 0"
  },
  {
   "step": "command",
   "text": "::tele 3218 3236 0",
   "expectMessage": "Teleported to 3218, 3236, 0"
  },
  {
   "step": "assertLocation",
   "x": 3218,
   "y": 3236,
   "plane": 0
  },
  {
   "step": "npcOption",
   "npc": "Captain Harlan",
   "option": "Examine"
  },
  {
   "step": "assertMessage",
   "contains": "[examine.npc_16821]"
  },
  {
   "step": "npcOption",
   "npc": "Captain Harlan",
   "option": "Talk-to"
  },
  {
   "step": "assertDialogue",
   "contains": "[captain_harlan.greeting]",
   "speaker": "Captain Harlan"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
   "text": "[captain_harlan.weapons]"
  },
  {
   "step": "assertDialogue",
   "contains": "[captain_harlan.weapons]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[captain_harlan.offer_all]",
   "speaker": "Captain Harlan"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
   "text": "[captain_harlan.ask_melee]"
  },
  {
   "step": "assertDialogue",
   "contains": "[captain_harlan.ask_melee]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertInventory",
   "item": "Bronze shortsword",
   "count": 1
  },
  {
   "step": "assertInventory",
   "item": "Wooden shield",
   "count": 1
  },
  {
   "step": "assertDialogue",
   "contains": "[captain_harlan.gives_melee]",
   "comment": "the box with both items"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[captain_harlan.anything_else]",
   "speaker": "Captain Harlan"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
   "text": "[captain_harlan.ask_ranged]"
  },
  {
   "step": "assertDialogue",
   "contains": "[captain_harlan.ask_ranged]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[captain_harlan.too_soon_all minutes=30]",
   "speaker": "Captain Harlan",
   "comment": "one kind per 30 minutes"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertNoDialogue"
  },
  {
   "step": "assertInventory",
   "item": "Shortbow",
   "count": 0
  },
  {
   "step": "itemOption",
   "item": "Bronze shortsword",
   "option": "Wield"
  },
  {
   "step": "assertEquipment",
   "slot": "weapon",
   "item": "Bronze shortsword"
  },
  {
   "step": "itemOption",
   "item": "Wooden shield",
   "option": "Wield"
  },
  {
   "step": "assertEquipment",
   "slot": "shield",
   "item": "Wooden shield"
  },
  {
   "step": "command",
   "text": "::reset",
   "expectMessage": "Back to how you were before ::scenario lumbridge-bare."
  }
 ]
}
