{
 "name": "Scurrius step 1: the lair. Peek on the broken bars, into the public lair, a food pile, out by the sewage water and the delay before coming back, a private lair and out of it, and Historian Aldo's talk (::keys on). His fight is the next step",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario scurrius", "expectMessage": "Started scenario scurrius.", "comment": "the sewer side of the broken bars; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now", "comment": "he is aggressive"},
  {"step": "locOption", "locId": 14203, "option": "Peek (normal)", "x": 3282, "y": 9867},
  {"step": "assertMessage", "contains": "scurrius.peek", "timeoutMs": 10000, "comment": "peek or peek_empty, as others may be in"},
  {"step": "locOption", "locId": 14203, "option": "Climb-through (normal)", "x": 3282, "y": 9867},
  {"step": "assertLocation", "x": 3290, "y": 9867, "plane": 0, "timeoutMs": 15000, "comment": "the public lair, east of the water"},
  {"step": "command", "text": "::kill Scurrius", "expectMessage": "Killed Scurrius", "comment": "so nothing attacks while eating"},
  {"step": "waitTicks", "ticks": 6},
  {"step": "locOption", "locId": 14205, "option": "Eat", "x": 3307, "y": 9867},
  {"step": "assertMessage", "contains": "scurrius.eat_", "timeoutMs": 20000, "comment": "eat_healed, or eat_wait within ten minutes of a run before"},
  {"step": "locOption", "locId": 14204, "option": "Cross", "x": 3288, "y": 9867},
  {"step": "assertLocation", "x": 3281, "y": 9867, "plane": 0, "timeoutMs": 20000, "comment": "outside the bars"},
  {"step": "locOption", "locId": 14203, "option": "Climb-through (private)", "x": 3282, "y": 9867},
  {"step": "assertMessage", "contains": "scurrius.reentry", "timeoutMs": 10000, "comment": "15 seconds before coming back in"},
  {"step": "waitTicks", "ticks": 26},
  {"step": "locOption", "locId": 14203, "option": "Climb-through (private)", "x": 3282, "y": 9867},
  {"step": "waitTicks", "ticks": 3, "comment": "the lair's region drawn; its tiles are an instance's, so the water is found by id"},
  {"step": "locOption", "locId": 14204, "option": "Quick-escape"},
  {"step": "assertLocation", "x": 3281, "y": 9867, "plane": 0, "timeoutMs": 20000},
  {"step": "npcOption", "npc": "Historian Aldo", "option": "Talk-to", "timeoutMs": 10000},
  {"step": "assertDialogue", "contains": "[historian_aldo.hello]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[historian_aldo.goodbye]"},
  {"step": "assertDialogue", "contains": "[historian_aldo.goodbye]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
