{
 "name": "Achievement diaries: the Explorer's ring 3 teleports to the cabbage patch and counts its uses, and Twiggy O'Korn talks south of Draynor bank (::keys on)",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "::reset at the end puts the account back"
  },
  {
   "step": "waitTicks",
   "ticks": 3,
   "comment": "let the client settle: a command typed straight away can be lost"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::item 13127 1",
   "comment": "Explorer's ring 3: unlimited cabbage-patch teleports"
  },
  {
   "step": "waitTicks",
   "ticks": 1
  },
  {
   "step": "itemOption",
   "item": "Explorer's ring 3",
   "option": "Teleport"
  },
  {
   "step": "assertLocation",
   "x": 3052,
   "y": 3291,
   "plane": 0,
   "timeoutMs": 10000
  },
  {
   "step": "waitTicks",
   "ticks": 3,
   "comment": "a new region after the teleport"
  },
  {
   "step": "itemOption",
   "item": "Explorer's ring 3",
   "option": "Check"
  },
  {
   "step": "assertMessage",
   "contains": "[explorers_ring.check_unlimited"
  },
  {
   "step": "command",
   "text": "::tele 3096 3229 0",
   "expectMessage": "Teleported to 3096, 3229, 0"
  },
  {
   "step": "waitTicks",
   "ticks": 3
  },
  {
   "step": "npcOption",
   "npc": "Twiggy O'Korn",
   "option": "Talk-to"
  },
  {
   "step": "assertDialogue",
   "contains": "[twiggy.hey_there]"
  },
  {
   "step": "walk",
   "x": 3099,
   "y": 3231,
   "comment": "walking away ends the talk, whichever way it goes next: 1 time in 50 her chocolate bar comes before the menu (the headless test covers both)"
  },
  {
   "step": "assertNoDialogue"
  },
  {
   "step": "command",
   "text": "::reset",
   "expectMessage": "Back to how you were"
  },
  {
   "step": "command",
   "text": "::keys off"
  }
 ]
}
