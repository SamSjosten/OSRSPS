{
  "name": "Karamja step K1.1: Captain Tobias's Musa Point option sailing from Port Sarim for 30 coins, the ship journey screen, the landing on Musa Point's deck and the gangplank ashore; the customs officer's Port Sarim option taking Karamjan rum, then her talk sailing back for 30 coins and the gangplank ashore at Port Sarim (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "any scenario: ::reset at the end puts the account's backpack back"},
    {"step": "command", "text": "::empty"},
    {"step": "command", "text": "::item 995 100"},
    {"step": "command", "text": "::tele 3029 3216 0", "expectMessage": "Teleported to 3029, 3216, 0", "comment": "Port Sarim's dock, beside Captain Tobias"},
    {"step": "npcOption", "npc": "Captain Tobias", "option": "Musa Point", "timeoutMs": 20000},
    {"step": "assertMessage", "contains": "[karamja_ship.paid fare=30]", "timeoutMs": 10000},
    {"step": "assertInterface", "interfaceId": 299, "timeoutMs": 5000, "comment": "ship_journey"},
    {"step": "assertLocation", "x": 2956, "y": 3143, "plane": 1, "timeoutMs": 15000, "comment": "the deck of the ship at Musa Point"},
    {"step": "continueDialogue", "comment": "[karamja_ship.arrives_musa_point]"},
    {"step": "assertInventory", "item": "Coins", "count": 70},
    {"step": "locOption", "locId": 2082, "option": "Cross", "x": 2956, "y": 3144},
    {"step": "assertLocation", "x": 2956, "y": 3146, "plane": 0, "timeoutMs": 10000, "comment": "Musa Point's dock"},
    {"step": "command", "text": "::item 431 1", "comment": "Karamjan rum"},
    {"step": "npcOption", "npc": "Customs officer", "option": "Port Sarim", "timeoutMs": 20000},
    {"step": "assertMessage", "contains": "[karamja_ship.confiscated]", "timeoutMs": 10000},
    {"step": "assertInventory", "item": "Coins", "count": 70, "comment": "no fare taken with the rum"},
    {"step": "npcOption", "npc": "Customs officer", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[karamja_ship.customs_help]"},
    {"step": "chooseOption", "text": "[karamja_ship.journey]"},
    {"step": "continueDialogue", "comment": "the player asks"},
    {"step": "continueDialogue", "comment": "[karamja_ship.know_you]"},
    {"step": "continueDialogue", "comment": "[karamja_ship.boarding_charge]"},
    {"step": "chooseOption", "text": "[karamja_ship.ok]"},
    {"step": "continueDialogue", "comment": "the player agrees"},
    {"step": "assertMessage", "contains": "[karamja_ship.paid fare=30]", "timeoutMs": 10000},
    {"step": "assertLocation", "x": 3032, "y": 3217, "plane": 1, "timeoutMs": 15000, "comment": "the deck of the ship at Port Sarim"},
    {"step": "continueDialogue", "comment": "[karamja_ship.arrives_port_sarim]"},
    {"step": "assertInventory", "item": "Coins", "count": 40},
    {"step": "locOption", "locId": 2084, "option": "Cross", "x": 3031, "y": 3217},
    {"step": "assertLocation", "x": 3029, "y": 3217, "plane": 0, "timeoutMs": 10000, "comment": "Port Sarim's dock"},

    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
