{
  "name": "Random events: Capt' Arnav's chest, the lock's columns rolled, and two wrong tries sending him off",
  "account": "test",
  "runOnLogin": false,
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"comment": "Off first, so the timer can't send a second event mid-script.", "step": "command", "text": "::randomevent off", "expectMessage": "Random events off"},
    {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied"},
    {"step": "command", "text": "::tele 3222 3218", "expectMessage": "Teleported to 3222, 3218"},
    {"step": "command", "text": "::randomevent capt_arnav", "expectMessage": "Started random event capt_arnav"},
    {"step": "npcOption", "npc": "Capt' Arnav", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Capt' Arnav", "contains": "[capt_arnav.dug_up]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Capt' Arnav", "contains": "[capt_arnav.fiddly]"},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[capt_arnav.yes]"},
    {"step": "assertDialogue", "contains": "[capt_arnav.yes]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Capt' Arnav", "contains": "[capt_arnav.columns]"},
    {"step": "continueDialogue"},
    {"comment": "The lock: look that each column shows pictures with a word underneath, and that the arrows roll them.", "step": "assertInterface", "interfaceId": 26, "timeoutMs": 20000},
    {"step": "clickWidget", "interfaceId": 26, "component": 5},
    {"step": "clickWidget", "interfaceId": 26, "component": 9},
    {"step": "clickWidget", "interfaceId": 26, "component": 11},
    {"comment": "Unlock, right only by chance: the script expects a wrong try (rerun if he says well done).", "step": "clickWidget", "interfaceId": 26, "component": 25},
    {"step": "assertDialogue", "speaker": "Capt' Arnav", "contains": "[capt_arnav.nowhere_near]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[capt_arnav.misunderstood]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Capt' Arnav", "contains": "[capt_arnav.arrows]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Capt' Arnav", "contains": "[capt_arnav.middle_row]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Capt' Arnav", "contains": "[capt_arnav.clearer]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[capt_arnav.try_again]"},
    {"step": "continueDialogue"},
    {"step": "assertInterface", "interfaceId": 26, "timeoutMs": 20000},
    {"step": "clickWidget", "interfaceId": 26, "component": 6},
    {"step": "clickWidget", "interfaceId": 26, "component": 25},
    {"step": "assertDialogue", "speaker": "Capt' Arnav", "contains": "[capt_arnav.someone_else]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"step": "assertInventory", "item": "Coins", "count": 0}
  ]
}
