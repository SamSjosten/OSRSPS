{
 "name": "The Clan Hub's Clerk: his talk's first menus, then, in a clan made by ::clanmake, a clan cloak and a clan vexillum in the clan's colour (blue, as it never picked one) from the items box, which opens again while there is room (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::clandisband", "expectMessage": "lan", "comment": "test's own clan from another run, if any"},
  {"step": "command", "text": "::clandisband Clerk Gate", "expectMessage": "lan", "comment": "the last run's clan, if any"},
  {"step": "command", "text": "::tele 3181 3469 0", "expectMessage": "Teleported to 3181, 3469, 0", "comment": "in the Clan Hub, south of the Clerk (3181, 3471)"},
  {"step": "waitTicks", "ticks": 3, "comment": "a teleport into a new region"},
  {"step": "npcOption", "npc": "Clerk", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[clan_clerk.good_day]", "timeoutMs": 20000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[clan_clerk.give]", "comment": "in no clan yet"},
  {"step": "assertDialogue", "contains": "[clan_clerk.give]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[clan_clerk.not_in_clan]"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::clanmake Clerk Gate", "expectMessage": "Clan Clerk Gate made"},
  {"step": "command", "text": "::clanjoin Clerk Gate recruiter", "expectMessage": "Joined clan Clerk Gate as a recruiter"},
  {"step": "command", "text": "::item 1511 26", "comment": "26 logs: room for two"},
  {"step": "npcOption", "npc": "Clerk", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[clan_clerk.good_day]", "timeoutMs": 20000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[clan_clerk.give]"},
  {"step": "assertDialogue", "contains": "[clan_clerk.give]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[clan_clerk.certainly]"},
  {"step": "continueDialogue"},
  {"step": "assertInterface", "interfaceId": 270, "comment": "the items box: the clan cloak and the clan vexillum"},
  {"step": "clickWidget", "interfaceId": 270, "component": 15, "comment": "the cloak"},
  {"step": "assertInventory", "item": "Clan cloak", "count": 1, "timeoutMs": 10000},
  {"step": "assertInterface", "interfaceId": 270, "comment": "again, as there is room"},
  {"step": "clickWidget", "interfaceId": 270, "component": 16, "comment": "the vexillum"},
  {"step": "assertInventory", "item": "Clan vexillum", "count": 1, "timeoutMs": 10000},
  {"step": "assertDialogue", "contains": "[clan_clerk.thanks]", "comment": "the inventory is full"},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "npcOption", "npc": "Clerk", "option": "Items", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[clan_clerk.no_space]", "timeoutMs": 20000},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::clandisband Clerk Gate", "expectMessage": "Clan Clerk Gate deleted"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
