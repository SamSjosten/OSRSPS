{
 "name": "Ranged: wield a shortbow and bronze arrows, shoot a castle man from range, run the quiver dry, and wrong ammo",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys", "comment": "game messages show their keys, whatever data/dialogue.txt holds"},
  {"step": "command", "text": "::item shortbow", "expectMessage": "Added 1 x Shortbow"},
  {"step": "itemOption", "item": "Shortbow", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "item": "Shortbow"},
  {"step": "command", "text": "::item bronze arrow 3", "expectMessage": "Added 3 x Bronze arrow"},
  {"step": "itemOption", "item": "Bronze arrow", "option": "Wield"},
  {"step": "assertEquipment", "slot": "ammo", "item": "Bronze arrow"},
  {"step": "command", "text": "::combat man", "expectMessage": "Accurate (accurate, ranged standard), speed 4", "comment": "the nearest man"},
  {"step": "command", "text": "::tele 3216 3219 0", "expectMessage": "Teleported to 3216, 3219, 0"},
  {"step": "npcOption", "npc": "Man", "option": "Attack", "timeoutMs": 20000, "comment": "the nearest man; in range and in sight there is no walk"},
  {"step": "assertAnimation", "id": 426, "timeoutMs": 20000, "comment": "human_bow on the first shot"},
  {"step": "assertHitsplat", "npc": "Man", "timeoutMs": 20000, "comment": "a hit or a miss (0), two or three ticks after the shot"},
  {"step": "command", "text": "::fight", "expectMessage": "You are fighting Man #"},
  {"step": "assertMessage", "contains": "[combat.no_ammo]", "timeoutMs": 30000, "comment": "three arrows, one every 4 ticks, then the empty quiver"},
  {"step": "assertEquipment", "slot": "ammo", "empty": true},
  {"step": "command", "text": "::kill man", "expectMessage": "Killed Man #", "comment": "the man fights back once shot; kill him (::kill picks the man attacking you), or a click on another man is refused for him"},
  {"step": "waitTicks", "ticks": 6, "comment": "his body stays 4 ticks, and the next Attack would pick it as the nearest man"},
  {"step": "command", "text": "::item steel arrow 5", "expectMessage": "Added 5 x Steel arrow"},
  {"step": "itemOption", "item": "Steel arrow", "option": "Wield"},
  {"step": "npcOption", "npc": "Man", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[combat.wrong_arrows]", "timeoutMs": 20000, "comment": "a plain shortbow fires bronze and iron arrows only; guessed wording"},
  {"step": "assertEquipment", "slot": "ammo", "item": "Steel arrow"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
