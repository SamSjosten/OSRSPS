{
 "name": "Edgeville piece step 13a: the Stronghold of Security's second floor. Down the Vault of War's ladder, back up and down again, the Grain of Plenty once (coins and the Slap Head emote), the portal to it, a pair of Rickety doors passed without a question once it is claimed, and up a rope to the start of the floor (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now", "comment": "the flesh crawlers and zombies are aggressive"},
  {"step": "command", "text": "::varbit 2310 0", "comment": "sos_emote_doh: the Grain of Plenty not yet searched"},
  {"step": "command", "text": "::tele 1903 5222 0", "expectMessage": "Teleported to 1903, 5222, 0", "comment": "beside the Vault of War's ladder down, in its reward room"},
  {"step": "locOption", "locId": 20785, "option": "Climb-down", "x": 1902, "y": 5222},
  {"step": "assertLocation", "x": 2042, "y": 5245, "plane": 0, "timeoutMs": 10000, "comment": "south of the Catacomb of Famine's ladder up (the landing is guessed)"},
  {"step": "locOption", "locId": 19003, "option": "Climb-up", "x": 2042, "y": 5246},
  {"step": "assertLocation", "x": 1903, "y": 5222, "plane": 0, "timeoutMs": 10000, "comment": "back beside the ladder down"},
  {"step": "locOption", "locId": 20785, "option": "Climb-down", "x": 1902, "y": 5222},
  {"step": "assertLocation", "x": 2042, "y": 5245, "plane": 0, "timeoutMs": 10000},
  {"step": "command", "text": "::tele 2021 5216 0", "expectMessage": "Teleported to 2021, 5216, 0", "comment": "north of the Grain of Plenty"},
  {"step": "locOption", "locId": 19000, "option": "Search", "x": 2021, "y": 5215},
  {"step": "assertDialogue", "contains": "stronghold_of_security.grain_open", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "stronghold_of_security.grain_reward", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "item": "Coins", "count": 3000, "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 2310, "value": 1, "timeoutMs": 10000, "comment": "sos_emote_doh: Slap Head unlocked, the reward claimed"},
  {"step": "command", "text": "::tele 2040 5240 0", "expectMessage": "Teleported to 2040, 5240, 0", "comment": "beside the floor's portal"},
  {"step": "locOption", "locId": 19005, "option": "Use", "x": 2039, "y": 5240},
  {"step": "assertMessage", "contains": "stronghold_of_security.portal_enter", "timeoutMs": 10000},
  {"step": "assertLocation", "x": 2023, "y": 5215, "plane": 0, "timeoutMs": 10000, "comment": "beside the Grain of Plenty (the landing is guessed)"},
  {"step": "command", "text": "::tele 1996 5215 0", "expectMessage": "Teleported to 1996, 5215, 0", "comment": "west of the pair of Rickety doors at x 1997 and 1999"},
  {"step": "locOption", "locId": 17009, "option": "Open", "x": 1997, "y": 5215},
  {"step": "assertLocation", "x": 1997, "y": 5215, "plane": 0, "timeoutMs": 10000},
  {"step": "command", "text": "::tele 1999 5215 0", "expectMessage": "Teleported to 1999, 5215, 0"},
  {"step": "locOption", "locId": 17100, "option": "Open", "x": 1999, "y": 5215},
  {"step": "assertLocation", "x": 2000, "y": 5215, "plane": 0, "timeoutMs": 10000, "comment": "no question once the grain is searched"},
  {"step": "assertNoDialogue"},
  {"step": "command", "text": "::tele 2017 5211 0", "expectMessage": "Teleported to 2017, 5211, 0", "comment": "beside a rope"},
  {"step": "locOption", "locId": 19001, "option": "Climb-up", "x": 2017, "y": 5210},
  {"step": "assertLocation", "x": 2042, "y": 5245, "plane": 0, "timeoutMs": 10000, "comment": "back at the start of the floor, by its ladder up (inferred from Jagex's 2011 guide)"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
