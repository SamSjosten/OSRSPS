{
 "name": "Dinh's bulwark Shield Bash: the combat tab's bar lit in a ::multi zone east of the castle, a giant frog attacked, and the bash's animation and a hitsplat on a man beside it who was never attacked, for half the energy",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "full special attack energy, nothing worn; ::reset at the end puts the account back"},
  {"step": "command", "text": "::setlevel attack 75", "expectMessage": "75", "comment": "the bulwark needs 75 Attack and 75 Defence"},
  {"step": "command", "text": "::setlevel defence 75", "expectMessage": "75"},
  {"step": "command", "text": "::item dinhs_bulwark", "expectMessage": "Added 1 x Dinh's bulwark"},
  {"step": "itemOption", "item": "Dinh's bulwark", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "itemId": 21015},
  {"step": "command", "text": "::god", "expectMessage": "You can't be hurt now"},
  {"step": "command", "text": "::tele 3236 3220 0", "expectMessage": "Teleported to 3236, 3220, 0", "comment": "the grass east of the castle, away from the courtyard's men"},
  {"step": "command", "text": "::multi on", "expectMessage": "Combat is multi-way in ", "comment": "the bash hits around the player only in multi-way combat"},
  {"step": "command", "text": "::npc giant_frog_nodrops", "expectMessage": "Spawned Giant frog", "comment": "the target"},
  {"step": "command", "text": "::npc man", "expectMessage": "Spawned Man", "comment": "within 5 tiles: the bash hits him too; put in with ::npc, both taken away at the end"},
  {"step": "command", "text": "::npchp 100 mine", "expectMessage": "now on 100 hitpoints", "comment": "so neither dies to the bash before it shows"},
  {"step": "clickWidget", "interfaceId": 593, "component": 41, "op": 1, "comment": "combat_interface:special_attack, the combat tab's bar"},
  {"step": "assertVarp", "id": 301, "value": 1, "timeoutMs": 5000, "comment": "sa_attack, the bar lit"},
  {"step": "npcOption", "npc": "Giant frog", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertAnimation", "id": 7511, "timeoutMs": 20000, "comment": "human_dinhs_bulwark_bash"},
  {"step": "assertHitsplat", "npc": "Man", "timeoutMs": 5000, "comment": "the man, whom the player never attacked, hit by the bash (a miss shows 0)"},
  {"step": "assertVarp", "id": 300, "value": 500, "timeoutMs": 5000, "comment": "half the energy taken"},
  {"step": "command", "text": "::delnpc mine", "expectMessage": "you put in."},
  {"step": "command", "text": "::multi off", "expectMessage": "Combat is single-way in "},
  {"step": "command", "text": "::god", "expectMessage": "You can be hurt again"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
