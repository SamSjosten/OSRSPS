{
 "name": "Magic utility step U1: High and Low Level Alchemy cast on inventory items, the warning on a valuable item, coins refused (::keys on); needs runner 0.29.0 for castOnItem",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::setlevel magic 55", "expectMessage": "Magic set to level 55"},
  {"step": "command", "text": "::varbit 6091 1000", "expectMessage": "Varbit 6091", "comment": "All Settings 66, the alchemy warning value, as a new account has it (test's save predates the default)"},
  {"step": "command", "text": "::varbit 6092 1", "expectMessage": "Varbit 6092", "comment": "All Settings 65, untradeables warn"},
  {"step": "command", "text": "::item 561 3", "expectMessage": "Added 3 x Nature rune"},
  {"step": "command", "text": "::item 554 13", "expectMessage": "Added 13 x Fire rune"},
  {"step": "command", "text": "::item 1333", "expectMessage": "Added 1 x Rune scimitar"},
  {"step": "command", "text": "::item 1925 2", "expectMessage": "Added 2 x Bucket"},
  {"step": "command", "text": "::item 995 1", "expectMessage": "Added 1 x Coins"},
  {"step": "castOnItem", "interfaceId": 218, "component": 47, "item": "Coins", "comment": "High Level Alchemy on coins"},
  {"step": "assertMessage", "contains": "[alchemy.coins]", "timeoutMs": 5000},
  {"step": "castOnItem", "interfaceId": 218, "component": 47, "item": "Rune scimitar", "comment": "worth more than 1,000 coins at the Grand Exchange: the warning"},
    {"step": "chooseOption", "text": "alchemy.warning_yes"},
  {"step": "assertAnimation", "id": 713, "timeoutMs": 5000, "comment": "human_casthighlvlalchemy"},
  {"step": "assertSpotanim", "id": 113, "timeoutMs": 5000, "comment": "highlvlalchemy_casting"},
  {"step": "assertInventory", "item": "Rune scimitar", "count": 0, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Coins", "count": 15361, "comment": "60% of 25,600, and the 1 coin held"},
  {"step": "assertInventory", "item": "Nature rune", "count": 2},
  {"step": "assertInventory", "item": "Fire rune", "count": 8},
  {"step": "waitTicks", "ticks": 5, "comment": "High Level Alchemy's 5 ticks"},
  {"step": "castOnItem", "interfaceId": 218, "component": 24, "item": "Bucket", "comment": "Low Level Alchemy: a bucket's value is 2, 40% is no coins"},
  {"step": "assertAnimation", "id": 712, "timeoutMs": 5000, "comment": "human_castlowlvlalchemy"},
  {"step": "assertInventory", "item": "Bucket", "count": 1, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Coins", "count": 15361},
  {"step": "assertInventory", "item": "Fire rune", "count": 5},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
