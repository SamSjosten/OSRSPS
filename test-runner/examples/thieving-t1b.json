  {"step": "command", "text": "::tele 2576 3300 0", "expectMessage": "Teleported to 2576, 3300, 0", "comment": "East Ardougne Castle's ground floor: paladins"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Paladin", "option": "Pickpocket", "timeoutMs": 20000},
