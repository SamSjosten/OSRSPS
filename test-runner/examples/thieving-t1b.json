  {"step": "command", "text": "::tele 2572 3385 0", "expectMessage": "Teleported to 2572, 3385, 0", "comment": "the warriors' camp north-west of the castle"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Warrior", "option": "Pickpocket", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[pickpocket.attempt who=warrior]", "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 14, "comment": "past a stun, if there was one (heroes' is 10 ticks)"},
  {"step": "command", "text": "::tele 2546 3114 1", "expectMessage": "Teleported to 2546, 3114, 1", "comment": "the Watchtower's first floor: watchmen"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Watchman", "option": "Pickpocket", "timeoutMs": 20000},
