{
 "name": "Thieving 2 step T1b: a Knight of Ardougne, a hero, a paladin, a warrior, a watchman, a gnome and a rogue pickpocketed at 99, reached by ::tele (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario thieving", "expectMessage": "Started scenario thieving.", "comment": "99 Thieving with the gloves of silence; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
