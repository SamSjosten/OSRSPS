  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Knight of Ardougne", "option": "Pickpocket", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[pickpocket.attempt who=Knight of Ardougne]", "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 14, "comment": "past a stun, if there was one (heroes' is 10 ticks)"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Hero", "option": "Pickpocket", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[pickpocket.attempt who=hero]", "timeoutMs": 10000},
