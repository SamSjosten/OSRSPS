  {"step": "command", "text": "::tele 2402 3420 0", "expectMessage": "Teleported to 2402, 3420, 0", "comment": "the Tree Gnome Stronghold"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Gnome", "option": "Pickpocket", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[pickpocket.attempt who=gnome]", "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 14, "comment": "past a stun, if there was one (heroes' is 10 ticks)"},
  {"step": "command", "text": "::tele 3284 3931 0", "expectMessage": "Teleported to 3284, 3931, 0", "comment": "Rogues' Castle, deep Wilderness"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Rogue", "option": "Pickpocket", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[pickpocket.attempt who=rogue]", "timeoutMs": 10000},
