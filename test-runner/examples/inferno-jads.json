{
  "name": "Inferno step IN3: wave 67's JalTok-Jad and wave 68's three, one killed with ::kill (::keys on, ::god on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off)."},
    {"step": "command", "text": "::inferno 67", "expectMessage": "Inferno: wave 67"},
    {"step": "assertMessage", "contains": "[inferno.wave wave=67]", "timeoutMs": 15000},
    {"step": "command", "text": "::inferno status", "expectMessage": "JalTok-Jad"},
    {"step": "command", "text": "::inferno 68", "expectMessage": "Inferno: wave 68"},
    {"step": "assertMessage", "contains": "[inferno.wave wave=68]", "timeoutMs": 15000},
    {"step": "command", "text": "::inferno status", "expectMessage": "JalTok-Jad"},
    {"step": "command", "text": "::kill JalTok-Jad", "expectMessage": "Killed JalTok-Jad #"},
    {"step": "waitTicks", "ticks": 2},
    {"step": "command", "text": "::inferno status", "expectMessage": "JalTok-Jad"},
    {"step": "command", "text": "::inferno leave", "expectMessage": "Left the Inferno."},
    {"step": "command", "text": "::empty"},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
