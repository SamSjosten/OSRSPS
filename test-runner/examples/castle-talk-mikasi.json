   "option": "Talk-to"
  },
  {
   "step": "assertDialogue",
   "contains": "[mikasi.who_are_you]"
  },
  {
   "step": "chooseOption",
   "text": "[mikasi.farewell]"
  },
  {
   "step": "assertDialogue",
   "contains": "[mikasi.farewell]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[mikasi.goodbye]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[mikasi.who_are_you]"
  }
 ]
