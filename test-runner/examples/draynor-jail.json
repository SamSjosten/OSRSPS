   "contains": "[leela.friend]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[leela.here]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[leela.point]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertDialogue",
   "contains": "[leela.luck]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "assertNoDialogue"
