   "loc": "Prison Gate",
   "x": 3123,
   "y": 3243,
   "comment": "and it shut behind"
  },
  {
   "step": "locOption",
   "loc": "Prison Gate",
   "option": "Open",
   "x": 3123,
   "y": 3243
  },
  {
   "step": "assertMessage",
   "contains": "[draynor_jail.locked]"
  },
  {
   "step": "command",
   "text": "::tele 3125 3248 0",
