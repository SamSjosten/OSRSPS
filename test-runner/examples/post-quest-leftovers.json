{
 "name": "Post-quest step 16: Rat Burgiss's broken cart searched, and the Lumbridge Swamp's bubbles filling ogre bellows by Suck and by using one on them (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::tele 3265 3335 0", "expectMessage": "Teleported to 3265, 3335, 0", "comment": "the crossroads south of Varrock, beside Rat Burgiss's cart"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "locId": 23055, "option": "Search", "x": 3265, "y": 3333},
  {"step": "assertDialogue", "contains": "[post_quest_leftovers.cart]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "assertNoDialogue", "timeoutMs": 5000},
  {"step": "command", "text": "::tele 3166 3193 0", "expectMessage": "Teleported to 3166, 3193, 0", "comment": "the Lumbridge Swamp, by the bubbles at 3164, 3193 and 3165, 3194"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "command", "text": "::empty"},
  {"step": "command", "text": "::item 2871 2", "comment": "two empty ogre bellows"},
  {"step": "assertInventory", "item": "Ogre bellows", "count": 2, "timeoutMs": 5000},
  {"step": "locOption", "locId": 684, "option": "Suck", "x": 3164, "y": 3193},
  {"step": "assertMessage", "contains": "[post_quest_leftovers.bellows_filled]", "timeoutMs": 10000},
  {"step": "assertInventory", "item": "Ogre bellows (3)", "count": 2, "timeoutMs": 5000, "comment": "both filled at once"},
  {"step": "command", "text": "::item 2873 1", "comment": "a bellows with two loads"},
  {"step": "assertInventory", "item": "Ogre bellows (2)", "count": 1, "timeoutMs": 5000},
  {"step": "useItemOnLoc", "item": "Ogre bellows (2)", "locId": 684, "x": 3165, "y": 3194},
  {"step": "assertInventory", "item": "Ogre bellows (3)", "count": 3, "timeoutMs": 10000},
  {"step": "command", "text": "::empty"},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"}
 ]
