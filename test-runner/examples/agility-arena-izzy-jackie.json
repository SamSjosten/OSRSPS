{
  "name": "Karamja step K3.4: Cap'n Izzy No-Beard selling the Agility cape and hood at 99 Agility for 99,000 coins, the free hood for an owner, and Pirate Jackie the Fruit's talk (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::scenario gathering", "expectMessage": "Started scenario gathering.", "comment": "any scenario: ::reset at the end puts the account's backpack and levels back"},
    {"step": "command", "text": "::empty"},
    {"step": "command", "text": "::setlevel agility 99", "expectMessage": "99"},
    {"step": "command", "text": "::item 995 99000"},
    {"step": "command", "text": "::tele 2808 3192 0", "expectMessage": "Teleported to 2808, 3192, 0", "comment": "the arena's hut"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "npcOption", "npc": "Cap'n Izzy No-Beard", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[izzy.ahoy_capn]"},
    {"step": "continueDialogue", "comment": "[izzy.ahoy_there]"},
    {"step": "continueDialogue", "comment": "[izzy.parrot_avast]"},
    {"step": "continueDialogue", "comment": "[izzy.huh]"},
    {"step": "continueDialogue", "comment": "[izzy.cracked]"},
    {"step": "chooseOption", "text": "[izzy.cape_sell]"},
    {"step": "continueDialogue", "comment": "[izzy.buy_cape]"},
    {"step": "continueDialogue", "comment": "[izzy.price]"},
    {"step": "chooseOption", "text": "[izzy.here_you_go]"},
    {"step": "continueDialogue", "comment": "the player says it"},
    {"step": "continueDialogue", "comment": "[izzy.suits_you]"},
    {"step": "assertInventory", "item": "Agility cape(t)", "count": 1, "comment": "trimmed: the gathering scenario's 99 Mining is another 99"},
    {"step": "assertInventory", "item": "Agility hood", "count": 1},
    {"step": "npcOption", "npc": "Cap'n Izzy No-Beard", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[izzy.ahoy_capn]"},
    {"step": "continueDialogue", "comment": "[izzy.ahoy_there]"},
    {"step": "continueDialogue", "comment": "[izzy.parrot_avast]"},
    {"step": "continueDialogue", "comment": "[izzy.huh]"},
    {"step": "continueDialogue", "comment": "[izzy.cracked]"},
    {"step": "chooseOption", "text": "[izzy.cape_sell]"},
    {"step": "chooseOption", "text": "[izzy.hood]"},
    {"step": "continueDialogue", "comment": "[izzy.another_hood]"},
    {"step": "continueDialogue", "comment": "[izzy.free]"},
    {"step": "continueDialogue", "comment": "[izzy.hood_given]"},
    {"step": "assertInventory", "item": "Agility hood", "count": 2},

    {"step": "npcOption", "npc": "Pirate Jackie the Fruit", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "continueDialogue", "comment": "[pirate_jackie.ahoy]"},
    {"step": "chooseOption", "text": "[pirate_jackie.what_place]"},
    {"step": "continueDialogue", "comment": "the player asks"},
    {"step": "continueDialogue", "comment": "[pirate_jackie.welcome]"},
    {"step": "continueDialogue", "comment": "[pirate_jackie.ask_izzy]"},
    {"step": "chooseOption", "text": "[pirate_jackie.trade_in]"},
    {"step": "continueDialogue", "comment": "the player says it"},
    {"step": "continueDialogue", "comment": "[pirate_jackie.right_tack]"},

    {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
  ]
}
