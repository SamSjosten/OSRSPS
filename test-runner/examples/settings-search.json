{
 "name": "All Settings search (needs runner 0.12.0): typed with real key presses, a found row clicked, and a window closed mid-search reopening on its category",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::varbit 12378 0", "expectMessage": "Varbit 12378", "comment": "option_hide_rooftops (Display row 4, toggle 7)"},
  {"step": "command", "text": "::varp 2855 1", "expectMessage": "Varp 2855", "comment": "settings_tracking with floater_is_searching on, as a window closed mid-search leaves it, and a relog so the client's keyboard flag (a varc) starts clear"},
  {"step": "logout"},
  {"step": "waitForLogin"},
  {"step": "clickWidget", "interfaceId": 548, "component": 52, "comment": "toplevel:stone11, the settings tab, in the fixed frame the VM's client uses"},
  {"step": "clickWidget", "interfaceId": 116, "component": 32, "comment": "settings_side:settings_open, All Settings"},
  {"step": "assertInterface", "interfaceId": 134},
  {"step": "assertVarbit", "id": 16073, "value": 0, "comment": "the window opens on its category, not stuck in a search with no search box"},
  {"step": "clickWidget", "interfaceId": 134, "component": 11, "comment": "settings:searchbar_image, Search"},
  {"step": "assertVarbit", "id": 16073, "value": 1, "comment": "floater_is_searching, the server's copy too"},
  {"step": "typeText", "text": "roof", "comment": "real key presses: searchbar_keypress reads each character"},
  {"step": "assertWidgetText", "interfaceId": 134, "component": 12, "contains": "roof", "comment": "settings:search_text shows what was typed"},
  {"step": "clickWidget", "interfaceId": 134, "component": 20, "slot": 220, "comment": "a found row: while searching, children count across every category, so Display's row 4 is child 220"},
  {"step": "assertVarbit", "id": 12378, "value": 1, "comment": "roofs hidden, by the client and the server"},
  {"step": "clickWidget", "interfaceId": 134, "component": 4, "comment": "settings:close, mid-search"},
  {"step": "assertInterface", "interfaceId": 134, "absent": true},
  {"step": "clickWidget", "interfaceId": 116, "component": 32, "comment": "All Settings again"},
  {"step": "assertInterface", "interfaceId": 134},
  {"step": "assertVarbit", "id": 16073, "value": 0, "comment": "reopened on its category"},
  {"step": "clickWidget", "interfaceId": 134, "component": 11, "comment": "Search again"},
  {"step": "typeText", "text": "roof"},
  {"step": "assertWidgetText", "interfaceId": 134, "component": 12, "contains": "roof"},
  {"step": "clickWidget", "interfaceId": 134, "component": 20, "slot": 220, "comment": "roofs shown again"},
  {"step": "assertVarbit", "id": 12378, "value": 0},
  {"step": "clickWidget", "interfaceId": 134, "component": 24, "slot": 0, "comment": "Activities, which ends the search"},
  {"step": "assertVarbit", "id": 16073, "value": 0},
  {"step": "clickWidget", "interfaceId": 134, "component": 4, "comment": "settings:close"},
  {"step": "assertInterface", "interfaceId": 134, "absent": true},
  {"step": "command", "text": "::varp 2855 0", "expectMessage": "Varp 2855", "comment": "the account back as it was"}
 ]
}
