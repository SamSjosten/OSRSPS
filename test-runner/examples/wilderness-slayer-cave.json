{
  "name": "Wilderness step W6.2: the Wilderness Slayer Cave's level 18 stairs down and its southern opening back up, then the level 29 stairs down, a crevice at Agility 77, Attack on an abyssal demon off task stopped by Peeve, and a hellhound attacked (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "level 18"},
    {"step": "command", "text": "::tele 3259 3663 0", "expectMessage": "Teleported to 3259, 3663, 0", "comment": "south of the stairs at 3259,3664"},
    {"step": "locOption", "locId": 40388, "option": "Walk-down", "x": 3259, "y": 3664},
    {"step": "waitTicks", "ticks": 3},
    {"step": "assertLocation", "x": 3385, "y": 10052, "plane": 0},
    {"step": "locOption", "locId": 40389, "option": "Exit", "x": 3384, "y": 10050},
    {"step": "waitTicks", "ticks": 3},
    {"step": "assertLocation", "x": 3259, "y": 3663, "plane": 0},
    {"step": "command", "text": "::tele 3294 3749 0", "expectMessage": "Teleported to 3294, 3749, 0", "comment": "by the level 29 stairs at 3293,3746"},
    {"step": "locOption", "locId": 40390, "option": "Walk-down", "x": 3293, "y": 3746},
    {"step": "waitTicks", "ticks": 3},
    {"step": "assertLocation", "x": 3406, "y": 10145, "plane": 0},
    {"step": "command", "text": "::setlevel agility 77", "comment": "the crevices' level"},
    {"step": "command", "text": "::tele 3434 10090 0", "expectMessage": "Teleported to 3434, 10090, 0", "comment": "below the east crevice at 3434,10091"},
    {"step": "locOption", "locId": 53259, "option": "Squeeze-Through", "x": 3434, "y": 10091},
    {"step": "waitTicks", "ticks": 5},
    {"step": "assertLocation", "x": 3434, "y": 10094, "plane": 0},
    {"step": "command", "text": "::slayer clear", "expectMessage": "No task."},
    {"step": "command", "text": "::setlevel slayer 85", "comment": "abyssal demons' level, so the task is what stops the attack"},
    {"step": "command", "text": "::tele 3342 10162 0", "expectMessage": "Teleported to 3342, 10162, 0", "comment": "among the abyssal demons in the north-west"},
    {"step": "npcOption", "npc": "Abyssal demon", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[peeve.woo]", "timeoutMs": 20000, "comment": "Peeve's chat, wherever he is in the cave"},
    {"step": "finishDialogue", "comment": "Peeve's chat closed, so the chatbox is free for the next command (nightly 2026-11-28, s25)"},
    {"step": "command", "text": "::tele 3441 10086 0", "expectMessage": "Teleported to 3441, 10086, 0", "comment": "the hellhounds"},
    {"step": "npcOption", "npc": "Hellhound", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Hellhound", "timeoutMs": 30000},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Hellhound #"},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
