{
 "name": "Trade request, two players (run with social-trade-request-test2.json on the other VM at the same time): test asks test2 to trade, test2 accepts, both trade screens open, and test declines",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "keys"},
  {"step": "command", "text": "::tele 3222 3218 0", "expectMessage": "Teleported"},
  {"step": "playerOption", "player": "test2", "option": "Trade with", "timeoutMs": 180000, "comment": "once test2 is in view, beside us"},
  {"step": "assertMessage", "contains": "[trade.sending]"},
  {"step": "assertInterface", "interfaceId": 335, "timeoutMs": 60000, "comment": "test2 accepted"},
  {"step": "assertInterface", "interfaceId": 336},
  {"step": "waitTicks", "ticks": 5},
  {"step": "clickWidget", "interfaceId": 335, "component": 13, "comment": "Decline"},
  {"step": "assertInterface", "interfaceId": 335, "absent": true}
 ]
}
