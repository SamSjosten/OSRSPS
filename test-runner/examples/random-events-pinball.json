{
  "name": "Random events: Pinball, Flippa's invitation, Tilt's rules, the score window and leaving by the exit",
  "account": "test",
  "runOnLogin": false,
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"comment": "Off first, so the timer can't send a second event mid-script.", "step": "command", "text": "::randomevent off", "expectMessage": "Random events off"},
    {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied"},
    {"step": "command", "text": "::tele 3222 3218", "expectMessage": "Teleported to 3222, 3218"},
    {"step": "command", "text": "::randomevent pinball", "expectMessage": "Started random event pinball"},
    {"step": "npcOption", "npcId": 6744, "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Flippa", "contains": "[pinball.invite", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[pinball.yes]"},
    {"step": "assertDialogue", "contains": "[pinball.yes]"},
    {"step": "continueDialogue"},
    {"comment": "The room: look that the player stands among five posts with runes on top, one with glowing rings, and two trolls with clubs by the exit.", "step": "assertDialogue", "speaker": "Tilt", "contains": "[pinball.arrival]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"comment": "The score window: look that the bottom right shows Score: 0.", "step": "assertInterface", "interfaceId": 542, "timeoutMs": 20000},
    {"step": "npcOption", "npcId": 5428, "option": "Talk-To", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[pinball.what_to_do]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Tilt", "contains": "[pinball.poke_pillars]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[pinball.all_of_them]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Tilt", "contains": "[pinball.not_rings]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[pinball.flashing]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Tilt", "contains": "[pinball.ten_times]"},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"comment": "Out by the exit before ten: home with nothing. Tagging the posts, the reward and the other ways out are the headless test's part.", "step": "locOption", "locId": 9293, "option": "Exit", "timeoutMs": 20000},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0, "timeoutMs": 20000},
    {"comment": "Look that the score window has gone.", "step": "assertInterface", "interfaceId": 542, "absent": true, "timeoutMs": 10000}
  ]
}
