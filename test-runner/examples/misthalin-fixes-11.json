{
 "name": "Misthalin fixes 11: Murky Matt's Decant combines two games necklace(1)s and two glory(1)s, and his talk enchants two ruby rings into rings of forging for 500 coins (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts it back"},
  {"step": "command", "text": "::item 3867 2", "comment": "two games necklace(1)s"},
  {"step": "command", "text": "::item 1706 2", "comment": "two amulet of glory(1)s"},
  {"step": "command", "text": "::tele 3172 3481 0", "expectMessage": "Teleported to 3172, 3481, 0", "comment": "by Murky Matt, east of the Grand Exchange's middle"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Murky Matt (runes)", "option": "Decant", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[murky_matt.all_done]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "item": "Games necklace(2)", "count": 1, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Amulet of glory(2)", "count": 1, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Amulet of glory", "count": 1, "timeoutMs": 5000, "comment": "the leftover glory, uncharged"},
  {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied."},
  {"step": "command", "text": "::item 1641 2", "comment": "two ruby rings"},
  {"step": "command", "text": "::item 995 500"},
  {"step": "npcOption", "npc": "Murky Matt (runes)", "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[murky_matt.greeting]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[murky_matt.forging]"},
  {"step": "assertDialogue", "contains": "[murky_matt.forging]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[murky_matt.how_many]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "enterAmount", "amount": 2},
  {"step": "assertDialogue", "contains": "[murky_matt.pleasure]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "assertInventory", "item": "Ring of forging", "count": 2, "timeoutMs": 5000},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
