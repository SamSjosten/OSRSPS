{
 "name": "Farming step 2: Falador's flower patch planted with limpwurt, watered, grown and picked once, and its herb patch planted with guam, grown and picked with a spade until it is empty, read off farming_transmit_c and _d (varbits 4773 and 4774) (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario farming", "expectMessage": "Started scenario farming.", "comment": "beside the Falador patches with 99 Farming, the tools and limpwurt and guam seeds; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::farmclock pause", "expectMessage": "Farming clock paused", "comment": "the crops grow only by ::farmtick"},
  {"step": "locOption", "locId": 7847, "option": "Rake", "x": 3054, "y": 3307, "timeoutMs": 20000, "comment": "the multiloc farming_flower_patch_1, drawn as Flower Patch while overgrown"},
  {"step": "assertMessage", "contains": "[farming.raked]", "timeoutMs": 30000},
  {"step": "assertVarbit", "id": 4773, "value": 3, "timeoutMs": 5000},
  {"step": "useItemOnLoc", "item": "Limpwurt seed", "locId": 7847, "x": 3054, "y": 3307},
  {"step": "assertVarbit", "id": 4773, "value": 28, "timeoutMs": 15000, "comment": "Limpwurt plant, the seed"},
  {"step": "useItemOnLoc", "item": "Watering can(8)", "locId": 7847, "x": 3054, "y": 3307},
  {"step": "assertVarbit", "id": 4773, "value": 92, "timeoutMs": 10000, "comment": "watered"},
  {"step": "command", "text": "::farmtick 4", "expectMessage": "Farming clock moved on 4 ticks (20 minutes)", "comment": "a flower grows every 5-minute tick"},
  {"step": "assertVarbit", "id": 4773, "value": 32, "timeoutMs": 5000, "comment": "grown: Limpwurt plant with Pick"},
  {"step": "locOption", "locId": 7847, "option": "Pick", "x": 3054, "y": 3307, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.picked produce=limpwurt root]", "timeoutMs": 10000},
  {"step": "assertVarbit", "id": 4773, "value": 3, "timeoutMs": 5000, "comment": "picked once, bare soil again"},
  {"step": "assertInventory", "item": "Limpwurt root", "timeoutMs": 5000, "comment": "3 to 12 at 99"},
  {"step": "locOption", "locId": 8150, "option": "Rake", "x": 3058, "y": 3311, "timeoutMs": 20000, "comment": "the multiloc farming_herb_patch_1"},
  {"step": "assertMessage", "contains": "[farming.raked]", "timeoutMs": 30000},
  {"step": "assertVarbit", "id": 4774, "value": 3, "timeoutMs": 5000},
  {"step": "useItemOnLoc", "item": "Guam seed", "locId": 8150, "x": 3058, "y": 3311},
  {"step": "assertVarbit", "id": 4774, "value": 4, "timeoutMs": 15000, "comment": "the guam seed"},
  {"step": "command", "text": "::farmtick 16", "expectMessage": "Farming clock moved on 16 ticks (80 minutes)", "comment": "four 20-minute herb ticks"},
  {"step": "assertVarbit", "id": 4774, "value": 8, "timeoutMs": 5000, "comment": "grown: Herbs with Pick"},
  {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied.", "comment": "room for every herb: a spade and 27 free slots"},
  {"step": "command", "text": "::item 952 1", "comment": "a spade"},
  {"step": "command", "text": "::setlevel farming 50", "expectMessage": "50", "comment": "a herb keeps its life about 21% of the time at 50, and level 51 is over 10,000 XP away, so no level-up box stops the picking"},
  {"step": "locOption", "locId": 8150, "option": "Pick", "x": 3058, "y": 3311, "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[farming.harvest_start patch=[farming.patch_herb]]", "timeoutMs": 10000},
  {"step": "assertMessage", "contains": "[farming.empty patch=[farming.patch_herb]]", "timeoutMs": 120000, "comment": "a herb every 4 ticks until the lives are gone"},
  {"step": "assertVarbit", "id": 4774, "value": 3, "timeoutMs": 5000},
  {"step": "assertInventory", "item": "Grimy guam leaf", "timeoutMs": 5000},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
