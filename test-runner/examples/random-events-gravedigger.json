{
  "name": "Random events: Leo's graveyard, a gravestone read, a coffin taken and checked, the reminder, and leaving early with nothing",
  "account": "test",
  "runOnLogin": false,
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"comment": "Off first, so the timer can't send a second event mid-script.", "step": "command", "text": "::randomevent off", "expectMessage": "Random events off"},
    {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied"},
    {"step": "command", "text": "::tele 3222 3218", "expectMessage": "Teleported to 3222, 3218"},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0},
    {"step": "command", "text": "::randomevent gravedigger", "expectMessage": "Started random event gravedigger"},
    {"step": "npcOption", "npc": "Leo", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "assertDialogue", "speaker": "Leo", "contains": "[gravedigger.help", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "chooseOption", "text": "[gravedigger.okay]"},
    {"step": "assertDialogue", "contains": "[gravedigger.okay]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Leo", "contains": "[gravedigger.wrong_coffins", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Leo", "contains": "[gravedigger.pick_up]"},
    {"step": "continueDialogue"},
    {"step": "assertNoDialogue"},
    {"step": "waitTicks", "ticks": 3},
    {"comment": "The gravestone window: look that it shows a profession's picture.", "step": "locOption", "loc": "Gravestone", "option": "Read", "timeoutMs": 20000},
    {"step": "assertInterface", "interfaceId": 175, "timeoutMs": 20000},
    {"step": "locOption", "loc": "Grave", "option": "Take-Coffin", "timeoutMs": 20000},
    {"step": "assertInventory", "item": "Coffin", "count": 1, "timeoutMs": 20000},
    {"comment": "The coffin window: look that it shows a skull, bones and a profession's belongings.", "step": "itemOption", "item": "Coffin", "option": "Check"},
    {"step": "assertInterface", "interfaceId": 141, "timeoutMs": 20000},
    {"step": "npcOption", "npc": "Leo", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "chooseOption", "text": "[gravedigger.remind]", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[gravedigger.remind]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Leo", "contains": "[gravedigger.pick_up]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "contains": "[gravedigger.instructions]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "npcOption", "npc": "Leo", "option": "Talk-to", "timeoutMs": 20000},
    {"step": "chooseOption", "text": "[gravedigger.leave]", "timeoutMs": 20000},
    {"step": "assertDialogue", "contains": "[gravedigger.leave]"},
    {"step": "continueDialogue"},
    {"step": "assertDialogue", "speaker": "Leo", "contains": "[gravedigger.take_you_back]", "timeoutMs": 20000},
    {"step": "continueDialogue"},
    {"step": "waitTicks", "ticks": 3},
    {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0},
    {"step": "assertInventory", "item": "Coffin", "count": 0}
  ]
}
