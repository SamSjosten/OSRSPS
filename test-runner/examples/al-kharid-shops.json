   "step": "npcOption",
   "npc": "Shop keeper",
   "option": "Trade",
   "timeoutMs": 20000
  },
  {
   "step": "assertInterface",
   "interfaceId": 300
  },
  {
   "step": "waitTicks",
   "ticks": 2,
   "comment": "lets the client draw the stock before clicking a slot"
  },
  {
   "step": "clickWidget",
   "interfaceId": 300,
   "component": 16,
   "slot": 1,
   "op": 2,
   "comment": "Buy 1 of the first item, Pot"
  },
  {
   "step": "assertInventory",
   "item": "Pot",
   "count": 1
  },
  {
   "step": "waitTicks",
   "ticks": 1,
   "comment": "the runner reads the slot's item from the client's widgets, which redraw a tick after the inventory changes"
