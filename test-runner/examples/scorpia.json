{
  "name": "Wilderness step W4.4: Enter on the Scorpion Pit's north-west cavern down to Scorpia's cave, Scorpia fought under ::god and killed with ::kill, her kill count's key, then Use on the crevice back up (::keys on)",
  "account": "test",
  "steps": [
    {"step": "waitForLogin"},
    {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
    {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "level 54, multi-way, offspring about"},
    {"step": "command", "text": "::tele 3232 3950 0", "expectMessage": "Teleported to 3232, 3950, 0", "comment": "south of the north-west cavern, wilderness_scorpion_entrance"},
    {"step": "locOption", "locId": 26762, "option": "Enter", "x": 3231, "y": 3951},
    {"step": "assertLocation", "x": 3232, "y": 10351, "plane": 0, "timeoutMs": 15000, "comment": "below its crevice in the cave (guessed tile)"},
    {"step": "npcOption", "npc": "Scorpia", "option": "Attack", "timeoutMs": 20000},
    {"step": "assertHitsplat", "npc": "Scorpia", "timeoutMs": 30000},
    {"step": "command", "text": "::kill", "expectMessage": "Killed Scorpia #"},
    {"step": "assertMessage", "contains": "[wilderness_boss.kill_count boss=Scorpia count=", "timeoutMs": 15000},
    {"step": "command", "text": "::tele 3232 10351 0", "expectMessage": "Teleported to 3232, 10351, 0"},
    {"step": "locOption", "locId": 26763, "option": "Use", "x": 3232, "y": 10352},
    {"step": "assertLocation", "x": 3232, "y": 3950, "plane": 0, "timeoutMs": 15000, "comment": "back out in front of the cavern"},
    {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."}
  ]
}
