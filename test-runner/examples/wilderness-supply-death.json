{
 "name": "Exploit review R65X-1: a Wilderness death to no player deletes the lost shark, super combat potion and phoenix necklace, and the grave gives back only the bones (OSRS Wiki, Grave: food, potions and phoenix necklaces are deleted in the Wilderness); no scenario, since a scenario death never counts as a Wilderness one (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied.", "comment": "assumes nothing worn is worth more than the rune pieces, so they are the three kept"},
  {"step": "command", "text": "::skull off", "expectMessage": "Your skull is gone.", "comment": "unskulled, so the three most valuable are kept"},
  {"step": "command", "text": "::item 1127", "expectMessage": "Rune platebody"},
  {"step": "command", "text": "::item 1163", "expectMessage": "Rune full helm"},
  {"step": "command", "text": "::item 1333", "expectMessage": "Rune scimitar"},
  {"step": "command", "text": "::item 385", "expectMessage": "Shark"},
  {"step": "command", "text": "::item 12695", "expectMessage": "Super combat potion(4)"},
  {"step": "command", "text": "::item 11090", "expectMessage": "Phoenix necklace"},
  {"step": "command", "text": "::item 526", "expectMessage": "Bones"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off).", "comment": "whatever wanders at level 13"},
  {"step": "command", "text": "::wildy 13", "expectMessage": ": level 13 Wilderness"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."},
  {"step": "command", "text": "::hit 99 me", "expectMessage": ", dead"},
  {"step": "assertMessage", "contains": "[combat.dead]"},
  {"step": "assertLocation", "x": 3222, "y": 3218, "plane": 0, "timeoutMs": 15000, "comment": "respawned at the spawn"},
  {"step": "assertInventory", "item": "Rune platebody", "count": 1, "comment": "kept, with the helm and scimitar"},
  {"step": "assertInventory", "item": "Rune full helm", "count": 1},
  {"step": "assertInventory", "item": "Rune scimitar", "count": 1},
  {"step": "assertInventory", "item": "Shark", "count": 0},
  {"step": "assertInventory", "item": "Bones", "count": 0, "comment": "in the grave"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now (::god again to turn it off)."},
  {"step": "command", "text": "::wildy 13", "expectMessage": ": level 13 Wilderness", "comment": "the same tile as before, where the grave stands"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "npcOption", "npc": "Grave", "option": "Loot", "timeoutMs": 10000},
  {"step": "assertInterface", "interfaceId": 672, "timeoutMs": 10000},
  {"step": "clickWidget", "interfaceId": 672, "component": 8, "comment": "Take-All"},
  {"step": "assertInventory", "item": "Bones", "count": 1, "comment": "the bones came back"},
  {"step": "assertInventory", "item": "Shark", "count": 0, "comment": "deleted, not graved"},
  {"step": "assertInventory", "item": "Super combat potion(4)", "count": 0},
  {"step": "assertInventory", "item": "Phoenix necklace", "count": 0},
  {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."},
  {"step": "command", "text": "::tele 3222 3218 0", "expectMessage": "Teleported to 3222, 3218, 0"},
  {"step": "command", "text": "::empty", "expectMessage": "Inventory emptied."},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"}
 ]
}
