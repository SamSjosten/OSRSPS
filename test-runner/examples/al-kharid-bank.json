{
 "name": "Al Kharid step 2: the bank: a banker's talk (::keys on) that opens the bank, a booth's Bank, and a banker's Bank across the booth",
 "account": "test",
 "steps": [
  {
   "step": "waitForLogin"
  },
  {
   "step": "command",
   "text": "::keys on",
   "expectMessage": "Dialogue shows keys"
  },
  {
   "step": "command",
   "text": "::scenario lumbridge-bare",
   "expectMessage": "Started scenario lumbridge-bare.",
   "comment": "an empty backpack and an empty bank; ::reset at the end puts both back"
  },
  {
   "step": "command",
   "text": "::item logs 3",
   "expectMessage": "Added 3 x Logs"
  },
  {
   "step": "command",
   "text": "::tele 3270 3167 0",
   "expectMessage": "Teleported to 3270, 3167, 0",
   "comment": "Al Kharid's bank, in front of the booths (x 3268); the bankers stand behind them at x 3267"
  },
  {
   "step": "npcOption",
   "npc": "Banker",
   "option": "Talk-to",
   "timeoutMs": 20000,
   "comment": "first, while nothing covers the game view: the open bank hides the bankers from the mouse (VM 215, 2026-10-30)"
  },
  {
   "step": "assertDialogue",
   "contains": "[banker.greeting]"
  },
  {
   "step": "continueDialogue"
  },
  {
   "step": "chooseOption",
   "text": "[banker.open_bank]"
  },
  {
   "step": "assertInterface",
   "interfaceId": 12,
   "comment": "asking for the bank opens it"
  },
  {
   "step": "clickWidget",
   "interfaceId": 15,
   "component": 3,
   "slot": 0,
   "op": 8,
   "comment": "Deposit-All on the logs"
  },
  {
   "step": "assertInventory",
   "item": "Logs",
   "count": 0
  },
  {
   "step": "locOption",
   "loc": "Bank booth",
   "option": "Bank",
   "x": 3268,
   "y": 3166,
   "comment": "a booth's Bank; a loc click closes the open bank and opens it again, as in draynor-village.json"
  },
  {
   "step": "assertInterface",
   "interfaceId": 12,
   "comment": "bankmain"
  },
  {
   "step": "clickWidget",
   "interfaceId": 12,
   "component": 12,
   "slot": 0,
   "op": 7,
   "comment": "Withdraw-All on the logs, the bank's first slot"
  },
  {
   "step": "assertInventory",
   "item": "Logs",
   "count": 3
  },
  {
   "step": "logout",
   "comment": "closes the bank, so the bankers can be clicked again"
  },
  {
   "step": "waitForLogin"
  },
  {
   "step": "npcOption",
   "npc": "Banker",
   "option": "Bank",
   "timeoutMs": 20000,
   "comment": "a banker's own Bank, across the booth"
  },
  {
   "step": "assertInterface",
   "interfaceId": 12
  },
  {
   "step": "command",
   "text": "::reset",
   "expectMessage": "Back to how you were"
  }
 ]
}
