{
 "name": "Raid step 30: the Fractured Archive's uniques worn: the Obligator taking the Rondache off, its combat tab and Smash every 3 ticks; the ascension crossbows refusing rune bolts and shooting ascension bolts at a man; Zorya's tome charged with ::tome, its own spell cast on a man from one Attack click",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried, no charges; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys", "comment": "game messages show their keys, whatever data/dialogue.txt holds"},
  {"step": "command", "text": "::setlevel attack 85", "expectMessage": "85", "comment": "the Obligator needs 85 Attack"},
  {"step": "command", "text": "::setlevel defence 80", "expectMessage": "80", "comment": "the Rondache needs 80 Defence"},
  {"step": "command", "text": "::setlevel ranged 80", "expectMessage": "80", "comment": "the crossbows and their bolts need 80 Ranged"},
  {"step": "command", "text": "::setlevel magic 99", "expectMessage": "99", "comment": "the tome needs 85 Magic; its spell's max hit is a third of Magic less 9, then its +15%"},
  {"step": "command", "text": "::tele 3216 3219 0", "expectMessage": "Teleported to 3216, 3219, 0", "comment": "the castle courtyard, where the men are"},
  {"step": "command", "text": "::god on", "expectMessage": "You can't be hurt now", "comment": "the men can't hurt the player while they fight them"},

  {"step": "command", "text": "::item rondache", "expectMessage": "Added 1 x Rondache"},
  {"step": "itemOption", "item": "Rondache", "option": "Wield"},
  {"step": "assertEquipment", "slot": "shield", "itemId": 34719},
  {"step": "command", "text": "::item obligator", "expectMessage": "Added 1 x Obligator"},
  {"step": "itemOption", "item": "Obligator", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "itemId": 34715},
  {"step": "assertInventory", "itemId": 34719, "timeoutMs": 10000, "comment": "two-handed: the Rondache comes off"},
  {"step": "assertVarbit", "id": 357, "value": 36, "comment": "combat_weapon_category: the extending chainmace's row of dbtable 78 (Thrust, Thrust, Smash)"},
  {"step": "command", "text": "::combat man", "expectMessage": "Thrust (accurate, crush), speed 5"},
  {"step": "clickWidget", "interfaceId": 593, "component": 14, "op": 1, "comment": "the third style button, Smash"},
  {"step": "command", "text": "::combat man", "expectMessage": "Smash (aggressive, crush), speed 3", "comment": "Smash attacks every 3 ticks (OSRS Wiki, Obligator)"},

  {"step": "command", "text": "::item ascension_crossbows", "expectMessage": "Added 1 x Ascension crossbows"},
  {"step": "itemOption", "item": "Ascension crossbows", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "itemId": 34681},
  {"step": "assertVarbit", "id": 357, "value": 5, "comment": "the crossbows' combat tab"},
  {"step": "command", "text": "::item xbows_crossbow_bolts_runite 10", "expectMessage": "Added 10 x Runite bolts"},
  {"step": "itemOption", "item": "Runite bolts", "option": "Wield"},
  {"step": "npcOption", "npc": "Man", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertMessage", "contains": "[combat.wrong_bolts]", "timeoutMs": 20000, "comment": "only ascension bolts (OSRS Wiki, Ascension crossbows); the words are guessed, a key here"},
  {"step": "command", "text": "::item ascension_bolts 20", "expectMessage": "Added 20 x Ascension bolts"},
  {"step": "itemOption", "item": "Ascension bolts", "option": "Wield"},
  {"step": "assertEquipment", "slot": "ammo", "itemId": 34684},
  {"step": "command", "text": "::combat man", "expectMessage": "Accurate (accurate, ranged heavy), speed 3"},
  {"step": "npcOption", "npc": "Man", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertAnimation", "id": 15116, "timeoutMs": 20000, "comment": "tfa_human_ascension_crossbow_fire_right_pvn (guessed: one hand of the two)"},
  {"step": "waitTicks", "ticks": 10},

  {"step": "command", "text": "::item zoryas_tome", "expectMessage": "Added 1 x Zorya's tome"},
  {"step": "command", "text": "::tome 100", "expectMessage": "[combat.staff_check staff=Zorya's tome charges=100]", "comment": "charging with Charge asks for a count, which the runner can't type yet; the headless test covers it"},
  {"step": "itemOption", "item": "Zorya's tome", "option": "Check"},
  {"step": "assertMessage", "contains": "charges=100]", "timeoutMs": 10000},
  {"step": "itemOption", "item": "Zorya's tome", "option": "Wield"},
  {"step": "assertEquipment", "slot": "weapon", "itemId": 34725},
  {"step": "assertVarbit", "id": 357, "value": 37, "comment": "the self-powering book's row of dbtable 78 (Accurate, Accurate, Longrange)"},
  {"step": "command", "text": "::combat man", "expectMessage": "Accurate (Zorya's tome), speed 3", "comment": "its own spell, with no autocast picked"},
  {"step": "npcOption", "npc": "Man", "option": "Attack", "timeoutMs": 20000},
  {"step": "assertAnimation", "id": 15139, "timeoutMs": 20000, "comment": "tfa_human_zorya_tome_attack"},
  {"step": "assertSpotanim", "id": 4433, "timeoutMs": 20000, "comment": "vfx_zorya_tome_standard_spotanim on the player (guessed: the cast)"},
  {"step": "waitTicks", "ticks": 12},
  {"step": "command", "text": "::tome", "expectMessage": "[combat.staff_check staff=Zorya's tome charges=9", "comment": "99 or fewer: a charge a cast"},
  {"step": "command", "text": "::god off", "expectMessage": "You can be hurt again."},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
