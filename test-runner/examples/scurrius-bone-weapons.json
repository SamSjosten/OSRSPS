{
 "name": "Scurrius step 4: the rat bone weapons. A bone shortbow fletched from a spine and a yew shortbow, a bone staff crafted from a spine, a battlestaff and 1,000 chaos runes, a combat lamp traded to Historian Aldo for a spine and rubbed (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario scurrius", "expectMessage": "Started scenario scurrius.", "comment": "the sewer side of the broken bars, beside Aldo; ::reset at the end puts the account back"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::empty", "comment": "room for what follows"},
  {"step": "command", "text": "::setlevel fletching 35", "expectMessage": "35"},
  {"step": "command", "text": "::setlevel crafting 35", "expectMessage": "35"},
  {"step": "command", "text": "::item 28798 3", "expectMessage": "Added 3 x Scurrius' spine"},
  {"step": "command", "text": "::item 946", "expectMessage": "Added 1 x Knife"},
  {"step": "command", "text": "::item 857", "expectMessage": "Added 1 x Yew shortbow"},
  {"step": "useItemOnItem", "item": "Knife", "onItem": "Scurrius' spine"},
  {"step": "assertInventory", "item": "Bone shortbow", "count": 1, "timeoutMs": 10000},
  {"step": "command", "text": "::item 1755", "expectMessage": "Added 1 x Chisel"},
  {"step": "command", "text": "::item 1391", "expectMessage": "Added 1 x Battlestaff"},
  {"step": "command", "text": "::item 562 1000", "expectMessage": "Added 1000 x Chaos rune"},
  {"step": "useItemOnItem", "item": "Chisel", "onItem": "Scurrius' spine"},
  {"step": "assertInventory", "item": "Bone staff", "count": 1, "timeoutMs": 10000},
  {"step": "itemOption", "item": "Bone staff", "option": "Check"},
  {"step": "assertMessage", "contains": "charges=1,000", "timeoutMs": 10000},
  {"step": "npcOption", "npc": "Historian Aldo", "option": "Talk-to", "timeoutMs": 10000, "comment": "a first talk shows his Trade"},
  {"step": "assertDialogue", "contains": "[historian_aldo.hello]", "timeoutMs": 10000},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[historian_aldo.goodbye]"},
  {"step": "continueDialogue"},
  {"step": "npcOption", "npc": "Historian Aldo", "option": "Trade", "timeoutMs": 10000},
  {"step": "chooseOption", "text": "[historian_aldo.trade_yes]"},
  {"step": "assertInventory", "item": "Antique lamp", "count": 1, "timeoutMs": 10000},
  {"step": "itemOption", "item": "Antique lamp", "option": "Rub"},
  {"step": "chooseOption", "text": "Attack"},
  {"step": "assertMessage", "contains": "rat_bone.lamp_rubbed", "timeoutMs": 10000},
  {"step": "command", "text": "::keys off", "expectMessage": "Dialogue shows words"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
