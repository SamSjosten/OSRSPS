{
 "name": "Museum Kudos step 1: the necklace's secret and a Dig Site display case (::keys on). The museum-finds scenario clears the museum's varbits and the saved charges, so this repeats on one account, and ::reset puts them back",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "waitTicks", "ticks": 3, "comment": "let the client settle: a command typed straight away can be lost"},
  {"step": "command", "text": "::scenario museum-finds", "expectMessage": "Started scenario museum-finds.", "comment": "beside Barnabus Hurma, an old symbol and a clean necklace carried, nothing on display"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "assertVarbit", "id": 3637, "value": 0, "comment": "vm_kudos"},
  {"step": "useItemOnLoc", "itemId": 11182, "locId": 12137, "timeoutMs": 30000, "comment": "vm_digsite_symbol_old's case, before an archaeologist has sent the player there"},
  {"step": "assertMessage", "contains": "[museum_case.not_shown]"},
  {"step": "assertVarbit", "id": 3646, "value": 0},
  {"step": "command", "text": "::tele 3254 3446 0", "expectMessage": "Teleported to 3254, 3446, 0", "comment": "back beside Barnabus Hurma (3253,3445)"},
  {"step": "npcOption", "npcId": 1903, "option": "Talk-to", "timeoutMs": 20000},
  {"step": "assertDialogue", "contains": "[museum_archaeologist.greeting_"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[museum_archaeologist.interesting]"},
  {"step": "assertDialogue", "contains": "[museum_archaeologist.interesting]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[museum_archaeologist.lets_look]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[museum_archaeologist.necklace_", "comment": "the necklace comes before every other find"},
  {"step": "finishDialogue"},
  {"step": "assertVarbit", "id": 3639, "value": 1, "comment": "vm_necklace: the secret learnt"},
  {"step": "assertInventory", "itemId": 11195, "count": 0, "comment": "he keeps it"},
  {"step": "assertVarbit", "id": 3637, "value": 0, "comment": "the necklace is no Kudos"},
  {"step": "npcOption", "npcId": 1903, "option": "Talk-to", "timeoutMs": 10000},
  {"step": "assertDialogue", "contains": "[museum_archaeologist.greeting_"},
  {"step": "continueDialogue"},
  {"step": "chooseOption", "text": "[museum_archaeologist.interesting]"},
  {"step": "assertDialogue", "contains": "[museum_archaeologist.interesting]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[museum_archaeologist.lets_look]"},
  {"step": "continueDialogue"},
  {"step": "assertDialogue", "contains": "[museum_case_find.old_symbol]", "comment": "first time: he sends the player to the case"},
  {"step": "finishDialogue"},
  {"step": "useItemOnLoc", "itemId": 11182, "locId": 12137, "timeoutMs": 30000},
  {"step": "assertMessage", "contains": "[museum_case.placed]"},
  {"step": "assertVarbit", "id": 3646, "value": 1, "comment": "the case shows the symbol"},
  {"step": "assertVarbit", "id": 3637, "value": 10, "comment": "10 Kudos, the count the client shows"},
  {"step": "assertInventory", "itemId": 11182, "count": 0},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were before ::scenario museum-finds."}
 ]
}
