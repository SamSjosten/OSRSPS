{
 "name": "Misthalin fixes 6: the Restless Ghost's coffin opened, searched and closed, the Wizards' Tower basement altar searched, and Pickpocket on Curator Haig Halen giving the storeroom key (::keys on)",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::keys on", "expectMessage": "Dialogue shows keys"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "an empty backpack; ::reset at the end puts it back"},
  {"step": "command", "text": "::tele 3250 3194 0", "expectMessage": "Teleported to 3250, 3194, 0", "comment": "Lumbridge graveyard, by the coffin"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "command", "text": "::resetlocs 4", "comment": "the coffin shut, should a run before this one have left it open"},
  {"step": "waitTicks", "ticks": 1},
  {"step": "locOption", "loc": "Coffin", "option": "Open", "x": 3249, "y": 3192},
  {"step": "assertMessage", "contains": "[restless_ghost.open]", "timeoutMs": 15000},
  {"step": "waitTicks", "ticks": 2},
  {"step": "locOption", "loc": "Coffin", "option": "Search", "x": 3249, "y": 3192},
  {"step": "assertDialogue", "contains": "[restless_ghost.complete_skeleton]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "locOption", "loc": "Coffin", "option": "Close", "x": 3249, "y": 3192},
  {"step": "waitTicks", "ticks": 3},
  {"step": "assertLoc", "loc": "Coffin", "option": "Open", "x": 3249, "y": 3192, "comment": "shut again"},
  {"step": "command", "text": "::tele 3120 9568 0", "expectMessage": "Teleported to 3120, 9568, 0", "comment": "the Wizards' Tower basement"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "locOption", "loc": "Altar", "option": "Search", "x": 3120, "y": 9566},
  {"step": "assertDialogue", "contains": "[restless_ghost.altar_empty]", "timeoutMs": 15000},
  {"step": "continueDialogue"},
  {"step": "command", "text": "::tele 3258 3449 0", "expectMessage": "Teleported to 3258, 3449, 0", "comment": "the Varrock Museum's ground floor"},
  {"step": "waitTicks", "ticks": 3},
  {"step": "command", "text": "::setlevel thieving 99"},
  {"step": "npcOption", "npc": "Curator Haig Halen", "option": "Pickpocket", "timeoutMs": 30000},
  {"step": "assertMessage", "contains": "[pickpocket.attempt who=Curator Haig Halen]", "timeoutMs": 10000},
  {"step": "waitTicks", "ticks": 12, "comment": "the attempt, and a whole stun if caught: about 1 in 16 is at 99, so four tries"},
  {"step": "npcOption", "npc": "Curator Haig Halen", "option": "Pickpocket", "timeoutMs": 30000},
  {"step": "waitTicks", "ticks": 12, "comment": "the attempt, and a whole stun if caught"},
  {"step": "npcOption", "npc": "Curator Haig Halen", "option": "Pickpocket", "timeoutMs": 30000},
  {"step": "waitTicks", "ticks": 12, "comment": "the attempt, and a whole stun if caught"},
  {"step": "npcOption", "npc": "Curator Haig Halen", "option": "Pickpocket", "timeoutMs": 30000},
  {"step": "waitTicks", "ticks": 12, "comment": "the attempt, and a whole stun if caught"},
  {"step": "assertInventory", "itemId": 29906, "timeoutMs": 10000, "comment": "the storeroom key, in the live cache"},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
