{
 "name": "Magic: Ice Barrage from the Ancient book freezes two imps standing together in a multi-way zone",
 "account": "test",
 "steps": [
  {"step": "waitForLogin"},
  {"step": "command", "text": "::scenario lumbridge-bare", "expectMessage": "Started scenario lumbridge-bare.", "comment": "a new account's stats, nothing worn or carried; ::reset at the end puts the account back"},
  {"step": "command", "text": "::setlevel magic 94", "expectMessage": "Magic set to level 94", "comment": "Ice Barrage needs 94"},
  {"step": "command", "text": "::spellbook ancient", "expectMessage": "Your spellbook is ancient now.", "comment": "the magic tab redraws as Ancient Magicks"},
  {"step": "command", "text": "::item water rune 6", "expectMessage": "Added 6 x Water rune"},
  {"step": "command", "text": "::item blood rune 2", "expectMessage": "Added 2 x Blood rune"},
  {"step": "command", "text": "::item death rune 4", "expectMessage": "Added 4 x Death rune"},
  {"step": "command", "text": "::god", "expectMessage": "You can't be hurt now", "comment": "the imps fight back once hit"},
  {"step": "command", "text": "::sure", "expectMessage": "Your attacks can't miss now", "comment": "a splash freezes nothing, so both imps' accuracy rolls pass"},
  {"step": "command", "text": "::tele 3224 3232 0", "expectMessage": "Teleported to 3224, 3232, 0", "comment": "north of the castle, on the road to the general store"},
  {"step": "command", "text": "::npc imp 0", "expectMessage": "Spawned Imp", "comment": "imps, not men: on the VM the nearest Man was a castle man behind the courtyard wall, out of reach"},
  {"step": "command", "text": "::tele 3225 3232 0", "expectMessage": "Teleported to 3225, 3232, 0"},
  {"step": "command", "text": "::npc imp 0", "expectMessage": "Spawned Imp", "comment": "beside the first, inside the 3x3 around it"},
  {"step": "command", "text": "::npchp 1000 mine", "expectMessage": "2 NPCs now on 1000 hitpoints", "comment": "a barrage can hit for 30, which would kill an imp before its freeze shows"},
  {"step": "command", "text": "::tele 3228 3232 0", "expectMessage": "Teleported to 3228, 3232, 0"},
  {"step": "command", "text": "::multi on", "expectMessage": "Combat is multi-way", "comment": "the 8x8 zone from 3224, 3232, which holds both imps"},
  {"step": "castOnNpc", "interfaceId": 218, "component": 87, "npc": "Imp", "timeoutMs": 20000, "comment": "Ice Barrage on the nearest imp, the second, 3 tiles away; the castle's own imp keeps to the courtyard"},
  {"step": "assertAnimation", "id": 1979, "timeoutMs": 20000, "comment": "zaros_vertical_casting (guessed for Barrage)"},
  {"step": "assertSpotanim", "npc": "Imp", "id": 369, "timeoutMs": 20000, "comment": "ice_barrage_impact on the imp cast on"},
  {"step": "assertInventory", "item": "Death rune", "count": 0, "comment": "four death runes, once for both imps"},
  {"step": "command", "text": "::tele 3224 3232 0", "expectMessage": "Teleported to 3224, 3232, 0"},
  {"step": "command", "text": "::npcs 0", "expectMessage": "; frozen ", "comment": "the first imp, which wasn't cast on, frozen for 32 ticks too"},
  {"step": "command", "text": "::tele 3225 3232 0", "expectMessage": "Teleported to 3225, 3232, 0"},
  {"step": "command", "text": "::npcs 0", "expectMessage": "; frozen ", "comment": "the imp cast on"},
  {"step": "command", "text": "::multi off", "expectMessage": "Combat is single-way"},
  {"step": "command", "text": "::delnpc mine", "expectMessage": "Removed 2 NPCs you put in."},
  {"step": "command", "text": "::sure", "expectMessage": "Your attacks can miss again."},
  {"step": "command", "text": "::god", "expectMessage": "You can be hurt again."},
  {"step": "command", "text": "::spellbook standard", "expectMessage": "Your spellbook is standard now."},
  {"step": "command", "text": "::reset", "expectMessage": "Back to how you were"}
 ]
}
